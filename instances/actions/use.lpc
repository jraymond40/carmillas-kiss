#include <config.h>
#include <std_defs.h>

inherit "/classes/living/human/manipulate";

int
setup_menu1(object tp)
{
   // Handle the second menu (numbered 0-2).
   tp->menu1("Objects", objects_list(tp, INANIMATE | TRANSIENT | 
       INTRANSIENT | DYNAMIC, AND, INVENTORY | IMMEDIATE) );
   return SUCCEED;
}

int
setup_menu2(object tp, string direct_obj_name)
{
   object obj;

   if (direct_obj_name) obj = locally_present(direct_obj_name);
   if (obj)
   {
      if ((int) obj->query_multiple_uses())
         return ((int) obj->setup_menu2(tp, direct_obj_name));
      else
      {
         tp->set_preposition(4, "with");
         tp->menu2("Objects", objects_list(tp, ALL, OR, INVENTORY | IMMEDIATE) );
      } 
   }
   return SUCCEED;
}
