#include <config.h>
#include <std_defs.h>
#include <english.h>

inherit "/classes/living/actions";
 
//
// When this cmd is selected, set up menu1 with 
// items appropriate to put.
//
private 
int
setup_menu1(object tp)
{
   tp->menu1("With You", objects_list(tp, ALL, OR, INVENTORY) );
   return SUCCEED;
}

private
int
setup_menu2(object tp, string direct_obj_name)
{
   tp->set_preposition(4, "in/on");
   tp->menu2("Objects", objects_list(tp, ALL, OR, INVENTORY | IMMEDIATE) );
   return SUCCEED;
}

//
// Here's where we attempt to take this action
//
private 
int
action_main(string action_str, string *prefix_strs, int present_tense_form)
{
   string  cmd, obj_name, dest_name, verb, adverb, move_msg, fail_reason;
   object  env, tp, obj, dest;
   string *str_array;
   int     succeed;

   tp   = this_player();
   if (!valid_action(tp)) return FAIL;

   cmd  = query_verb();
   env  = tp;

   if (!action_str) { notify_fail("Str = " + action_str + "\n"); return FAIL; }
   str_array = explode( action_str, " ");

   if (! (obj = locally_present(str_array[0], env)) ) 
   {
      notify_fail("There is no " + str_array[0] + " here now.\n");
      return FAIL;
   }
   obj_name = specific_obj(obj);
      
   if (sizeof(str_array) > 1)
   {
      if (! (dest = locally_present(str_array[1], environment(tp))) ) 
      {
        notify_fail("There is no " + str_array[1] + " here now.\n");
        return FAIL;
      }  
      dest_name = specific_obj(dest);

      if ( dest == tp ) 
      {
        notify_fail("Your already carrying " + obj_name + ".\n");
        return FAIL;
      }  

      if ((int) dest->query_container() == TRUE) adverb = "into";
      else adverb = "onto";  
   }
   else 
   {
      adverb = "down";
      dest = environment(tp);
   }
   verb = "put";
   move_msg = (string) obj->move(dest);

   if (move_msg == SUCCEED_STR) 
   {
      succeed = TRUE; 
      fail_reason = " ";
   }
   else 
   {
      succeed = FALSE;
      fail_reason = " You " + (random(2) > 0 ? "realize" : "find") + " " +
         obj_name + " is " + move_msg +  " for you to put there.";
   }

   effect(LOCAL, tp,
      prefix_strs[0] + " " + proper_present_tense_verb(verb, 
         SUBJECT_ONE, present_tense_form, succeed) + " " + 
         obj_name + " " + adverb + (dest_name ? " " + dest_name + "." : ".") + 
         (succeed == TRUE ? "" : fail_reason) + "\n",
      prefix_strs[1] + " " + proper_present_tense_verb(verb, 
         SUBJECT_THREE, present_tense_form, succeed) + " " + 
         obj_name + " " + adverb + (dest_name ? " " + dest_name + "." : ".") + 
         (succeed == TRUE ? "" : fail_reason) + "\n");

   return SUCCEED;
}
