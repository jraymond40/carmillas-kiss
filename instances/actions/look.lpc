#include <config.h>
#include <std_defs.h>
#include <english.h>

inherit "/classes/living/actions";

int verbose_moves;
string *inventory();

void verbose_mode(int mode)     { verbose_moves = mode;}

//
// If we just "look", then give a description of this location.
//
int
selected_cmd0(object tp, string said)
{
   int    rndm, present_tense_form;
   string verb, adverb, obj_str;
   string *prefix_strs, *com_action_strs;

   if (! valid_action(this_player()) ) return FAIL;

   prefix_strs =  ({"","",""});
   com_action_strs = ({"","",""});

   rndm = random(10);
   if (rndm < 3) verb = "look";
   else if (rndm < 6) verb = "glance";
   else verb = "gaze";

   rndm = random(10);
   if (rndm > 4) adverb = "about";
   else adverb = "around";

   rndm = random(10);
   if (rndm < 3) obj_str = "the place";
   else if (rndm < 6) obj_str = "the surroundings";
   else if (rndm < 8) obj_str = "the area";
   else obj_str = "the room";

   if (!said || said == "")
   {
      present_tense_form = SIMPLE;
      prefix_strs[0] = "You";
      prefix_strs[1] = (string) tp->query_cap_name();
      prefix_strs[2] = (string) tp->query_cap_name();
   }

   // The user has something to say.
   else
   {
      present_tense_form = CONTINUOUS;
      format_for_simple_verb(
         assume_a_verb(said, com_action_strs),com_action_strs);
      prefix_strs[0] = "\"" + said + "\", " +  com_action_strs[0] + ", ";
      prefix_strs[1] = "\"" + said + "\", " +  com_action_strs[1] + ", ";
      prefix_strs[2] = "\"" + said + "\", " +  com_action_strs[2] + ", ";
   }

   effect(LOCAL, tp,
       prefix_strs[0] + " " + proper_present_tense_verb(verb, 
          SUBJECT_ONE, present_tense_form, TRUE) + " " + adverb + " " + 
          obj_str + ". " +  (string) environment(tp)->query_long() +
          "\n",
       prefix_strs[1] + " " + proper_present_tense_verb(verb, 
          SUBJECT_THREE, present_tense_form, TRUE) + " " + adverb + " " + 
          obj_str + ".\n"
   );

   return SUCCEED;
}

//
// Menu1 should show objects on and around me, that we 
// would like to look "at".
//
int
setup_menu1(object tp)
{
   tp->set_preposition(2, "at");
   tp->menu1("OBJECTS", objects_list(tp, ALL, OR, INVENTORY | IMMEDIATE) );
   return SUCCEED;
}

//
// Default menu2 is suitable (there is no menu2 for look.)
//


//
// This currently isn't used, it'll be replaced by a function that records where
// youv'e been and give you a full description automatically the first few times
// you're in the area.
//
int 
brief() 
{
   verbose_mode(!verbose_moves);
   write("Verbose mode " + (verbose_moves ? "on" : "off") + ".\n");
   return SUCCEED;
}

//
// The user is looking at something.
//
int
action_main(string action_str, string *prefix_strs, int present_tense_form)
{
   int     rndm;
   string  verb;
   string *com_action_strs;
   object  tp, ob;

   tp = this_player();
   if (!valid_action(tp)) return FAIL;
   com_action_strs = ({"","",""});

   rndm = random(10);
   if (rndm < 5) verb = "inspect";
   else verb = "examine";

   /* For looking at something in this place */
   if (action_str == "yourself") ob = tp;
   else ob = locally_present(action_str, environment(tp));
   if (!ob) // Check it in lowercase.
      ob = locally_present(lower_case(action_str), environment(tp));
   if (ob) 
   {
      if (ob == tp) inventory();
      else effect(LOCAL, tp,
         prefix_strs[0] + " " + proper_present_tense_verb(verb, 
            SUBJECT_ONE, present_tense_form, TRUE) + " " + 
            specific_obj(ob) + ". " +  (string) ob->query_long() + "\n",
         prefix_strs[1] + " " + proper_present_tense_verb(verb, 
            SUBJECT_THREE, present_tense_form, TRUE) + " " + 
            specific_obj(ob) + ".\n",
         prefix_strs[2] + " " + proper_present_tense_verb(verb, 
            SUBJECT_THREE, present_tense_form, TRUE) + " you.\n"
       );
      return SUCCEED;
   }

   /* For looking at something in our possession */
   ob = locally_present(action_str, tp);
   if (ob)
   {
      effect(LOCAL, tp,
         prefix_strs[0] + " " + 
         proper_present_tense_verb(verb, SUBJECT_ONE, present_tense_form, SUCCEED) + " " + 
            specific_obj(ob) + ". " +  (string) ob->query_long() + "\n",
         prefix_strs[1] + " " +
            proper_present_tense_verb("find", SUBJECT_THREE, present_tense_form, SUCCEED) + " " + 
            specific_obj(ob) + " amongst " + 
            (string) tp->query_possessive() + " things and " + 
            proper_present_tense_verb(verb, SUBJECT_THREE, present_tense_form, SUCCEED) + " it.\n",
         prefix_strs[2] + " as " + (string) tp->query_pronoun() + " " +
            proper_present_tense_verb("find", SUBJECT_THREE, present_tense_form, SUCCEED) + " " + 
            specific_obj(ob) + " amongst " + 
            (string) tp->query_possessive() + " things and " + 
            proper_present_tense_verb(verb, SUBJECT_THREE, present_tense_form, SUCCEED) + " it.\n"
       );
      return SUCCEED;
   }
   else // It ain't here...
      return selected_cmd0(tp, 0);
}


int 
inventory() 
{
   int i;
   int rndm;
   object *tmp_list;
   object *obj_list;
   object tp;
   string tmp;
   string my_perception;
   string others_perception;
  
   tp = this_player();

   obj_list = accessible_inventory(ALL, OR, tp);

   if (!obj_list || sizeof(obj_list) == 0)
   {
      my_perception = tp->query_long() + 
         "Searching about, you realize you aren't carrying anything.\n";
   }
   else 
   {
      my_perception = tp->query_long() + 
         " Searching amongst your belongings, you find " + 
         obj_list_phrase(obj_list) + ".\n";
   }
   if (rndm < 4) others_perception = tp->query_cap_name() + 
      " searches through " + tp->query_possessive() + " belongings.\n";
   else if (rndm < 8) 
      others_perception = tp->query_cap_name() + 
      " appears to be looking for something among " + tp->query_possessive() + 
      " belongings.\n";
   else others_perception = tp->query_cap_name() + " inventories the items " + 
      tp->query_pronoun() + " is carrying.\n";

   effect(LOCAL, tp, my_perception, others_perception);
 
   return SUCCEED;
}
