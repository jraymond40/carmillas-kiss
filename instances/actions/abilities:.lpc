#include <std_defs.h>

inherit "/classes/living/communicate";

//
// User selected cmd0 and possibly said something.
//
int
selected_cmd0(object tp, string said)
{
   // Say users lines (if there), but tell them they haven't told us what to
   // express.

   if (said!="") tp->say(said);
   effect(LOCAL, tp,
        " No expressions were exhibited because you need to use the right" +
        " arrow -> to put the expression you'd like to exhibit onto the" +
        " `DO:` line.");
   return SUCCEED;
}

//
// Upon selecting 'expressions:' show the list of available expressions
//
int
setup_menu1(object tp)
{
   // Handle the expressions menu.
   tp->menu1("ABILITIES", 
   ({
       "bite",
       "scan", 
   }) );
   return SUCCEED;
}
   
// Handle communication with actions.
int
selection_parse(string str, object tp)
{
   object  doee;
   string *action, *action_strs;
   string  actions, said;
   int     range, num_cmds, rndm, num_actions;

   rndm = random(10);
   action_strs = ({"", "", ""});
   range = LOCAL;

   // Merely cmd0 has been selected.
   if (!str) 
      return selected_cmd0(tp, "");

   // Cmd0 and something said.
   else if (sscanf(str, "*>[say] %s", said) > 0)
      return selected_cmd0(tp, said);

   num_cmds = sscanf(str, "%s *>[say] %s", actions, said);
   if(!actions) actions = str;
   action = explode(actions, " ");
   num_actions = sizeof(action);

   if (num_cmds > 1)
   {
      if (num_actions == 1)
      {
         // Say and do it.
         switch(action[0])
         {
            case "yell" :
            case "scream" :
            case "shout" :
               format_for_simple_verb(action[0], action_strs);
               range = GLOBAL;
               break;

            case "mumble" :
               if (rndm < 5) 
                  format_for_simple_verb(action[0], action_strs);
               else 
               {
                  action_strs[0] = "you mumble under your breath"; 
                  action_strs[1] = tp->query_cap_name() + " mumbles under " 
                         + tp->query_possessive() + " breath";
               }
               break;

            default :
               format_for_simple_verb(action[0], action_strs);
               break;
         }
         communicate(range, said, action_strs);
      }
      else
      {
         // Direct this action toward someone.
         doee = find_living(action[1]);

         switch(action[0])
         {
            case "interrupt" :
               action_strs[0] = "you interrupt " + action[1];
               action_strs[1] = tp->query_cap_name() + " interrupts " + 
                                action[1];
               action_strs[2] = tp->query_cap_name() + " interrupts you";
               break;

            case "philosophize" :
            case "theorize" :
               action_strs[0] = "you " + action[0] + " with " + action[1];
               action_strs[1] = tp->query_cap_name() + " " + 
                  pluralize(action[0]) +" with " + action[1];
               action_strs[2] = tp->query_cap_name() + " " + 
                  pluralize(action[0]) +" with you";
               break;

             case "read" :
               action_strs[0] = "you " + action[0] + " to " + action[1];
               action_strs[1] = tp->query_cap_name() + " " + 
                  pluralize(action[0]) +" to " + action[1];
               action_strs[2] = tp->query_cap_name() + " " + 
                  pluralize(action[0]) +" to you";
               break;

            default :
               action_strs[0] = "you " + action[0] + " at " + action[1];
               action_strs[1] = tp->query_cap_name() + " " + action[0] + 
                                "s at " + action[1];
               action_strs[2] = tp->query_cap_name() + " " + action[0] + 
                                "s at you";
               break;
         }
         communicate(LOCAL, said, action_strs, doee);
      }
   }
   else if (action[0] == "*>[menu1]") setup_menu1(tp);
   else if (num_actions < 2)
   {
      // Nothing to say, just action.
      switch(action[0])
      {
         case "yell" :
         case "scream" :
         case "shout" :
            action_strs[0] = "You " + action[0] + ".\n";
            action_strs[1] = "You hear a " +  (string) tp->query_gender() +
               " voice " + action[0] + "ing.\n";
            range = GLOBAL;
            break;
         case "sneeze" :
            if      (rndm < 4) said = "Achoooo!"; 
            else if (rndm < 8) said = "ha... Ha... HA-Choooo!"; 
            else               said = "achoo, achoo, HachooO!"; 
            format_for_simple_verb("sneeze", action_strs);
            communicate(LOCAL, said, action_strs); 
            return SUCCEED;
            break;
         case "mumble" :
            if (rndm < 5)
            {
               action_strs[0] = "You mumble under your breath.\n";
               action_strs[1] = tp->query_cap_name() + " mumbles under " +
                  tp->query_possessive() + " breath.\n";
            }
            else
            {
               action_strs[0] = "You begin mumbling.\n";
               action_strs[1] = tp->query_cap_name() + " begins mumbling.\n";
            }
            break;

         default :
            action_strs[0] = "You " + action[0] + ".\n", 
            action_strs[1] = tp->query_cap_name() + " " + action[0] + "s.\n";
            break;
      }
      effect(range, tp, action_strs[0], action_strs[1]);
   }
   else if (action[1] == "*>[menu2]")
   {
      // Handle the third menu (numbered 0-2).
      switch(action[0])
      {
         // Those actions that don't need another menu.
         case "mutter" :
         case "sneeze" :
         case "yawn" :
            doupdate();
            return SUCCEED;
            break;

         // We can interrupt someone (but not "at" them).
         case "interrupt" :
            tp->set_preposition(0, "");
            tp->menu2("People", living_list(tp) );
            break;

         // The rest can be directed "at" someone.
         default :
            tp->set_preposition(4, "at");
            tp->menu2("People", living_list(tp) );
            break;
      }
   }
   else
   {
      // Direct this action toward someone w/ nothing to say.
      doee = find_living(action[1]);
      switch(action[0])
      {
         case "*>[say]" :
            // User didn't finish entering an expression.
            notify_fail("Expression not fully selected.\n");
            command(str);
            return FAIL;
            break;

         case "interrupt" :
            action_strs[0] = "You interrupt " + action[1] + ".";
            action_strs[1] = tp->query_cap_name() + " interrupts " + 
               action[1] + ".";
            action_strs[2] = tp->query_cap_name() + " interrupts you.";
            break;

         default :
            action_strs[0] = "You " + action[0] + " at " + action[1] + ".\n";
            action_strs[1] = tp->query_cap_name() + " " + action[0] + 
               "s at " + action[1] + ".\n";
            action_strs[2] = tp->query_cap_name() + " " + action[0] + 
               "s at you.\n";
            break;
      }
      effect(LOCAL, tp, action_strs[0], action_strs[1], doee, action_strs[2]);
   }
   return SUCCEED;
}

