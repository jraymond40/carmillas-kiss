#include <std_defs.h>
#include <config.h>

//            This should match w/ below  ________  
//                                       V        V
inherit "/classes/inanimate/transients/inanm_trns_holder";

void 
create()
{
//  ________  This should match the inherit filename above.
// V        V
   inanm_trns_holder::create();

   set_id        ( ({"stool,wobbly"}) );  // How Sicose find this item.
   set_short        ("wobbly stool");     // This items name.
   set_long         ("This is a small green wooden stool.  One of the legs doesn't quite " +
                     "touch the floor, and one of the cross bars on the legs seems to be " +
                     "a bit cracked.");
   set_flammability (MEDIUM);            // NONE | LOW | MEDIUM | HIGH
   set_burn_duration(300);            // Sec. Time in seconds it will burn.
   set_weight       (10);             // Kg.  Objects weight.
   set_height       (65);             // cm.  These are looked at to see if the 
   set_width        (25);             // cm.  potential object to be contained
   set_depth        (25);             // cm.  will fit within.
   set_form         (SOLID);          // GAS | LIQUID | SOLID
   set_rigidity     (RIGID);          // RIGID | LIMP
   set_dynamacy     (DYNAMIC);        // Is it usable in some way? 

// Necessary for holders, containers, and vessels:
// (must append '_holder', '_container', '_vessel' to inherit string above.)
//
   set_liquid_tight (FALSE);    	// Won't hold liquids
   set_max_bearable (100); 	// Strong enough to hold whatever

   // How is the item held on/in this holder?   
   set_manner_held  ("sitting precariously on the wobbly stool.");  
}

use(object tp, object recipient)
{
   if (!recipient)
      return ( ({
         ".  It wobbles uncertainly under your weight.",
         ".  The stool wobbles threateningly.",
         ".  It wobbles uncertainly.",
         "sit",
         0,
         "on"}));
   else return (inanm_trns_holder::use(tp, recipient));
}
