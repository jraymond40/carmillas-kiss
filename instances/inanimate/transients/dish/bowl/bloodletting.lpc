#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/transients/bowl";

void 
create()
{
   bowl::create();

   set_weight (3);    // Kg.  It is iron afterall

   set_short("bloodletting bowl");
   set_long ("A rather large iron bowl used for gathering blood during " + 
             "blood-letting operations, common of the 15th century.");
}
