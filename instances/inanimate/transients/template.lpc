#include <std_defs.h>
#include <config.h>

//            This should match w/ below  ________  
//                                       V        V
inherit "/classes/inanimate/transients/inanm_trns";

void 
create()
{
//  ________  This should match the inherit filename above.
// V        V
   inanm_trns::create();

   set_id        ( ({"TEMPLATE"}) );  // How Sicose find this item.
   set_short        ("TEMPLATE");     // This items name.
   set_long         ("DESCRIPTION."); // It's full description.
   set_flammability (LOW);            // NONE | LOW | MEDIUM | HIGH
   set_burn_duration(600);            // Sec. Time in seconds it will burn.
   set_weight       (40);             // Kg.  Objects weight.
   set_height       (100);            // cm.  These are looked at to see if the 
   set_width        (60);             // cm.  potential object to be contained
   set_depth        (60);             // cm.  will fit within.
   set_form         (SOLID);          // GAS | LIQUID | SOLID
   set_rigidity     (RIGID);          // RIGID | LIMP
   set_dynamacy     (DYNAMIC);        // Is it usable in some way? 

// Necessary for holders, containers, and vessels:
// (must append '_holder', '_container', '_vessel' to inherit string above.)
//
   set_liquid_tight (FALSE);    	// Won't hold liquids
   set_max_bearable (INFINITE); 	// Strong enough to hold whatever

   // How is the item held on/in this holder?   
   set_manner_held  ("scattered across it's granite surface");  
   set_intransient_list( ({"item"}) );	// Intransients held here.
   set_transient_list  ( ({"item"}) );	// Transients held here.


// Necessary for containers and vessel:
// (must append '_container' or '_vessel' to inherit string above).
//
   set_closable     (TRUE); 		// Can it be closed/opened?
}
