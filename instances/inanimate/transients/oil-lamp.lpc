#include <std_defs.h>

inherit "/classes/inanimate/transients/inanm_trns";
inherit "/classes/liquid";

void 
create()
{
   inanm_trns::create();
   liquid::create();

   set_liquid_name  ("oil");
   set_id        ( ({"oil"}) );
   set_short        ("lamp oil");
   set_long         ("A yellow, oily, foul smelling, liquid known as " +
                     "lamp oil.");

   set_flammability (HIGH);
   set_burn_duration(60);
   set_weight       (4);
   set_volume       (120);
}
