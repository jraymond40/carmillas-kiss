#include <std_defs.h>

inherit "/classes/inanimate/transients/inanm_trns_vr";

void 
create()
{
   inanm_trns_vr::create();

   set_id        ( ({"crucifix"}) );
   set_short        ("crucifix");
   set_long         ("A small, ruby encrusted crucifix.");
   set_flammability (NONE);
   set_burn_duration(0);

   set_weight       (1);
   set_height       (10);
   set_width        (6);
   set_depth        (2);
   set_form         (SOLID);
   set_rigidity     (RIGID);
   set_vamp_repellant(1.0);
}

