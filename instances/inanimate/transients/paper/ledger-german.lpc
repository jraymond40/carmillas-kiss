#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/transients/paper";

void 
create()
{
   paper::create();

   set_id( ({"page"}) );
   set_long         
      ("It appears to be a page from a bookkeeping ledger. " + 
       "Scrawled on it in a nearly illegible hand, are the " +
       "lines 'Der Fuerher war ein armes Schwein/Er hatte " +
       "keinen Fuerherschein!'");
}
