#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/transients/paper";

void 
create()
{
   paper::create();

   set_long         
      ("It appears to be a page torn from a book.  It reads: '" +
       "38. Thus it appears certain to me, by a great variety of " +
       "proofs, that Cambyses was raving mad; he would not else have " +
       "set himself to make a mock of holy rites and long-established " +
       "usages.  For if one were to offer men to choose out of all the " +
       "customs in the world such as seemed to them the best, they would " +
       "examine the whole number, and end by preferring their own; so " +
       "convinced are they that their own usages far surpass those of " +
       "all others.  Unless, therefore, a man was mad, it is not likely " +
       "he would make sport of such matters.'");
}
