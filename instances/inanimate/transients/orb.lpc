#include <std_defs.h>

inherit "/classes/inanimate/transients/inanm_trns";

void 
create()
{
   inanm_trns::create();

   set_id        ( ({"orb"}) );
   set_short        ("glass orb");
   set_long         ("The orb catches the light of the room bending it in crazy patterns.  "+
                     "Nearly in the exact center of the baulble lies something that glints "+
                     "back at you, perhaps a small flaw.\n");
   set_flammability (NONE);
   set_burn_duration(0);
   set_weight       (2);
   set_height       (10);
   set_width        (10);
   set_depth        (10);
   set_form         (SOLID);
   set_rigidity     (RIGID);
}
