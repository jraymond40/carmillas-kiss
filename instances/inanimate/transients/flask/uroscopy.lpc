#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/transients/inanm_trns_container";

void 
create()
{
   inanm_trns_container::create();

   set_id        ( ({"flask"}) );
   set_short        ("uroscopy flask");
   set_long ("A rather large glass flask, apparently used for uroscopy.");
   set_flammability (NONE);  // NONE | LOW | MEDIUM | HIGH
   set_burn_duration(0);  // Sec. Time in seconds it will burn.
   set_weight       (0.5);   // Kg.  Objects weight.
   set_height       (30);  // cm.  These are looked at to see if the 
   set_width        (10);   // cm.  potential object to be contained will
   set_depth        (10);   // cm.  fit within.
   set_form         (SOLID);// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);// RIGID | LIMP
   set_dynamacy     (DYNAMIC); // Is it usable in some way? 

   // How is the item held on this holder?   
   set_manner_held  ("inside");  

// Necessary for containers:
// (must add '_container' at end of inherit string above).
//
   set_closable     (FALSE); 		// Can it be closed/opened?
}

use(object tp, object recipient)
{
   if (!recipient)
      return ( ({
         ", but realize there is no appropriate place to make use of it.",
         ", but realizes there is no appropriate place to make use of it.",
         ", but realizes there is no appropriate place to make use of it.",
         "consider",
         0,
         "using"}));
   else return (inanm_trns_container::use(tp, recipient));
}
