#include <commons.h>
#include <config.h>
#include <std_defs.h>

// inherit "/classes/inanimate/transients/inanm_trns_vessel";
inherit "/classes/inanimate/transients/inanm_trns_container";
nosave object Commons_mgr; // The Commons_mgr object
void 
create()
{
//   inanm_trns_vessel::create();
   inanm_trns_container::create();

   set_id        ( ({"yliastrum"}) );
   set_short        ("yliastrum flask");
   set_long         ("Not Used.");
   set_flammability (NONE); // NONE | LOW | MEDIUM | HIGH
   set_burn_duration(0);    // Sec. Time in seconds it will burn.
   set_weight       (1);    // Kg.  Objects weight.
   set_height       (18);   // cm.  These are looked at to see if the 
   set_width        (12);   // cm.  potential object to be contained will
   set_depth        (12);   // cm.  fit within.
   set_form         (SOLID);// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);// RIGID | LIMP

   // Necessary for containers:
   set_closable     (TRUE);    
   set_closed       (TRUE);

   Commons_mgr = find_object(COMMONS_MGR);
   return;
}

