string
query_long()
{
   int     lvl, i;
   int    *rnge;
   string  result;
   string *lvl_str;

#define FLASK_INCREMENTS 12
 
   lvl  = Commons_mgr->query_visible_level();
   rnge = Commons_mgr->potential_earnings();
   lvl_str = allocate(FLASK_INCREMENTS/2);

   // Fill up the flask-o-meter.
   for (i=1; i<= FLASK_INCREMENTS/2; i++)
   {
      if (lvl > (COMMONS_MAX_LEVEL/FLASK_INCREMENTS) * 2 * i)
         lvl_str[i-1] = "::::";
      else if (lvl > ((COMMONS_MAX_LEVEL/FLASK_INCREMENTS) * ((2 * i) - 1)))
         lvl_str[i-1] = "....";
      else 
         lvl_str[i-1] = "    ";
   }

   return("According to the chart, with the current content level, possible energy yields are:\n" +
          " |" + lvl_str[5] + "|     If you:     Effect range:   Range extremes occur when:\n" +
          " |" + lvl_str[4] + "|     - Sip          " + rnge[0] + " to " + rnge[1] + "    You sip       vs. All sip\n" + 
          " |" + lvl_str[3] + "|     - Gulp*       " + rnge[2] + " to " + rnge[3] + "    An inhale     vs. Others sip\n" +
          " |" + lvl_str[2] + "|     - Inhale      " + rnge[4] + " to " + rnge[5] + "     You inhale    vs. All inhale\n" +
          " |" + lvl_str[1] + "|     - Blow into   " + rnge[7] + " to " + rnge[6] + "     You blow into vs. All blow into\n" +
          " |" + lvl_str[0] + "|     * Full effects are, as yet, unstudied." );
}

int
setup_menu2(object tp, string str)
{
   tp->set_preposition(4, "-");
   tp->menu2("HOW", ({"sip", "gulp", "inhale", "blow_into"}) );

   return SUCCEED;
}

string* use(object user, object other_obj)
{
   notify_fail(" Your attempts to use the Yliastrum " + 
        " failed because you need to use the right arrow -> to define how" +
        " you'd like to use it, onto the `DO:` line.\n");

   return FAIL;
}

int
sip()
{
   int sips;
   object tp;
   tp = this_player();
   if (! valid_action(tp)) return FAIL;

   /* Only one action per round... */
   if ((int) tp->query_role() != WITHDRAW)
   {
      effect(INDIV, tp,
             "As you begin to tip the bottle up, you realize the full effects " +
             "of your last encounter still haven't subsided. Immediately your stomach " +
             "objects to anymore, and convinces you against another sip, as yet.\n");
      return SUCCEED;
   }
   
   tp->set_role(SIP);
   sips = tp->query_sips();
   switch(sips)
   {
      case 1:
         effect(INDIV, tp,
             "You gently sip the bubbling elixir, and feel it's warmth " +
             "descend into the depths of your stomach. A slight dizziness " +
             "overcomes you, then quickly subsides. While it's true effects " +
             "won't be evident for a few moments more, it's apparent no one " + 
             "has noticed your recent actions.\n");
         break;

      case 2:
         effect(INDIV, tp,
             "A quick sip from the gold rimmed flask warms your lips and " +
             "throat on its way down. A slight hiccup bubbles up, but don't " +
             "worry, no one seems to have noticed.\n");
         break;

      case 3:
         effect(INDIV, tp,
            "The sip instantly brings images of strength and renewal " +
            "that are now beginning to occur within in you.\n");
         break;

      default:
         effect(INDIV, tp,
             "Sipping from the flask, you prepare yourself for the surge " +
             "of energy to strengthen and revitalize you.\n");
         break;
   }

   Commons_mgr->cooper_select(tp);
   return SUCCEED;
}

int
gulp()
{
   object tp;
   tp = this_player();
   if (! valid_action(tp)) return FAIL;

   /* Only one action per round... */
   if ((int) tp->query_role() != WITHDRAW)
   {
      effect(INDIV, tp,
             "Suddenly a violent cramp strikes your stomach, nearly sending " +
             "you to the floor. It appears to be too soon to subject your " +
             "body to doses of the elixir as you are still awaiting the full " +
             "effects of your last encounter.\n");
      return SUCCEED;
   }

 
   switch(tp->query_gulps() + 1)
   {
      case 1:
         effect(INDIV, tp,
             "A hasty gulp from the flask makes you wonder if you haven't " +
             "actually consumed liquid fire, bringing an instant sweat to your " +
             "brow. The room about you appears to swim, as tears amass " +
             "in your eyes, and things appear to dissolve. You await "  +
             "the full extent of the elixirs effects with trepidation.\n");
         break;

      case 2:
         effect(INDIV, tp,
             "As you gulp the liquid into your body, consciousness begins to " +
             "fade to a swirling crimson sea. A rhythmic pounding echos through " +
             "your body, as if you were a shore being beaten by crashing ruby waves. " + 
             "Slowly the deliriousness of the elixir subsides.\n");
         break;

      case 3:
         effect(INDIV, tp,
             "You gulp the elixir with ease, having quickly become accustom to it's " + 
             "fiery flavor and delirious effects. You do, however, perceive a very " + 
             "slight, yet repetitive, swooshing sound.\n");
         break;

      case 7:
         effect(INDIV, tp,
             "Gulping from the flask, you notice a woman enter the room. As " +
             "you lower the flask, the approaching long dark hair, pale smooth skin" +
             "and full red lips are so distracting that you hardly notice the " +
             "elixirs fiery flavor. \n");
         effect(INDIV, tp,
             "She reaches up and gently closes your eyes, her skin so soft, " +
             "sweet, and cool. A finger slowly brushes down the side of your " +
             "cheek and stops on your lips.\n");
         effect(INDIV, tp,
             "Startled, you open your eyes to find no one actually there.\n");
         break;

      case 12:
         effect(INDIV, tp,
             "You gulp the elixir, and await it's effects.\n");
         effect(INDIV, tp,
             "From the corner of your eye, your almost certain you saw Carmilla. " + 
             "Was she beckoning you?\n");
         break;

      default:
         effect(INDIV, tp,
             "You gulp the elixir, and await it's effects.\n");
         break;
   }

   tp->set_role(GULP);
   tp->inc_vamp_level();  // Every time you gulp, you gain vamp experience.
   Commons_mgr->exploit_select(tp);

   return SUCCEED;
}

int
inhale()
{
   int inhales;
   object tp;
   tp = this_player();
   if (! valid_action(tp)) return FAIL;

   /* Only one action per round... */
   if ((int) tp->query_role() != WITHDRAW)
   {
      effect(INDIV, tp,
             "Bringing the flask to your mouth, a nauseating spinning sensation " +
             "begins to overcome you, preventing you from inhaling the elixir. " +
             "Apparently, you are still under the influence of Yliastrum from " +
             "previously.\n");
      return SUCCEED;
   }
   tp->set_role(INHALE);
   inhales = tp->query_inhales();
   switch(inhales)
   {
      case 1:
         effect(INDIV, tp,
             "As you inhale the vapors from the flask, you're overwhelmed by " +
             "it's pungent odor. You now feel quite drained, yet strangely " + 
             "enlightened, as if many doors have opened in the recesses of " +
             "your mind.\n");
         break;

      case 2:
         effect(INDIV, tp,
             "The Yliastrums aroma is familiar, from somewhere, sometime a " +
             "long time ago. A draining sensation overcomes you, leaving you " +
             "exhausted, yet confident and afraid of nothing.\n");
         break;

      case 3:
         effect(INDIV, tp,
             "Despite your now very exhausted state, your newly heightened senses " +
             "bring light to the blackest reaches of your mind. Fear is an " +
             "alien concept to you, at least while under the protection and " +
             "guidance of the elixir.\n");
         break;

      default:
         effect(INDIV, tp,
             "Inhaling the elixir, your senses are immediately heightened.\n");
         break;
   }
/*
// I'm afraid this ones just too... abstract..

   else if (rndm < 7)
   {
      write("As the whisping vapors tickle your nostrils, you inhale the\n");
      write("acrid elixir. Waves of dizziness lap over you, and a vision\n");
      write("begins to form. A man by the seaside pouring over ancient \n");
      write("tomes fails to notice how rapidly night is falling. He begins\n");
      write("a frantic search for a source of illumination, but is only\n");
      write("able to produce a single, nearly exhausted candle. He realizes\n");
      write("the location of more candles are revealed in his books, and \n");
      write("begins an even more frenzied pouring over of the tomes. Now,\n");
      write("however, the tide has come in and laps at his chair...\n\n");
      write("You come to, exhausted, confused, yet realize somewhere you\n");
      write("have stored 'a candle' away, that may illuminate your way.\n");
   }
*/
   Commons_mgr->police_select(tp);

   return SUCCEED;
}

int
blow_into()
{
   int blows;
   object tp;

   tp = this_player();

   if (! valid_action(tp)) return FAIL;

   /* Only one action per round... */
   if ((int) tp->query_role() != WITHDRAW)
   {
      effect(INDIV, tp,
             "It apparently is too soon to blow into the Yliastrum because blowing " +
             "into the flask is having no effect. Guess you'll have to wait for " +
             "the last dose to wear off.\n");
      return SUCCEED;
   }
   tp->set_role(BLOW_INTO);
   blows = tp->blow_intos();   

   switch(blows)
   {
      case 1:
         effect(INDIV, tp,
             "Blowing into the flask creates this very strange, yet exhaustive " +
             "euphoria. A feeling of great satisfaction overcomes you, content " +
             "in the knowledge that while it cost you, you have increased the " + 
             "energy yield of all who sip from the Yliastrum.\n");
         break;

      default:
         effect(INDIV, tp, "You blow into the flask.\n");
         break; 

   }
   Commons_mgr->reward_select(tp);
   return SUCCEED;
}

int
query_multiple_uses()
{
   return TRUE;
}

int
multiple_use(string str)
{
   switch(str)
   {
      case "gulp":
         return gulp();
         break;
      case "sip":
         return sip();
         break;
      case "inhale":
         return inhale();
         break;
      case "blow_into":
         return blow_into();
         break;

      default:
         return FAIL;
   }
}

