#include <std_defs.h>
#include <config.h>

varargs void initialize(object where, string num);
inherit "/classes/inanimate/transients/key";

void
initialize(object where, string num)
{
   set_id ( ({"key,`#"+num+"'"}) );  // How Sicose find this item.
   set_short ("guest room key, #" + num);
   set_long  ("Made of brass, the number " +num+ " is engraved into it.");
   set_key   (ROOM_KEY_STR+num);
   key::initialize(where);
}

