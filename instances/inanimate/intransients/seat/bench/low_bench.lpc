#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/bench";

void
create()
{
   bench::create();

   set_short        ("wooden bench");
   set_long         ("This bench is constructed in a manner similar to the table, of wood " +
                     "and iron bands.  A few of the bands appear to be a bit loose.");
}

use(object tp, object recipient)
{
   if (!recipient)
      return ( ({
         ". The bench squeaks slightly as you sit down.",
         ".  The bench squeaks slightly.",
         ".",
         "sit",
         0,
         "on"}));
   else return (bench::use(tp, recipient));
}
