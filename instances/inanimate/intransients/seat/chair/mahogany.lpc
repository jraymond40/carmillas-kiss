#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/chair";

void
create()
{
   chair::create();

   set_short ("mahogany chair");
   set_long  ("Carved from a rich red-black wood, the armed chairs are " + 
      "decorated with the same figures carved into the dining table. " + 
      "Serpentine carved vines come to form the arms, while a rose, "+ 
      "carved within another, forms the head of the chair.");

// Note: In heraldry (on Coat-Of-Arms) the rose symbolizes the 7th son. One
//       part of the vampire myth states that the 7th son of the 7th is a vampire.
//       Certainly, the rose has come to be associated with the vampire.
}
