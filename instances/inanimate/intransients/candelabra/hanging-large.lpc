#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/candelabra";

void
create()
{
   candelabra::create();

   set_long         ("It is intricately, and "
      "elegantly adorned, and only recently converted to electricity, from " + 
      "the candles that once filled it.");	

   set_weight       (60);		// Kg.  (although, it is intransient)
   set_height       (150);		// cm.    
   set_width        (250);		// cm.   
   set_depth        (250);		// cm.   
}
