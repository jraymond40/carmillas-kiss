#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/candelabra";

void
create()
{
   candelabra::create();

   set_long         ("Smaller then the center candelabra, this candelabra, " + 
      "like the others, is intricately, and elegantly adorned, and only " +
      "recently converted to electricity, from the candles that once " + 
      "filled it."); 
}
