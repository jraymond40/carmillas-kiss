#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/fireplace";

void
create()
{
   fireplace::create();

   set_long ("A beautiful white marble masonry surrounds the mouth of " + 
      "the fireplace, while a recently polished brass logholder sits " + 
      "within. Despite your efforts, you're unable to discern many " + 
      "details of the room on the other side of the wall that shares " + 
      "this fireplace.");
}
