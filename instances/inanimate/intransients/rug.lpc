#include <std_defs.h>

inherit "/classes/inanimate/intransients/inanm_intrns";
inherit "/classes/cloth";

void
create()
{
   inanm_intrns::create();
   cloth::create();

   set_id(         ({"rug"}) );
   set_short        ("rug");
   set_long         ("Kneeling down, you rub the rug between your " +
                     "fingers. Musty as it is, its quality " +
                     "workmanship is evident.");
   set_flammability (LOW);
   set_burn_duration(300);
   set_weight       (30);
   set_height       (200);
   set_width        (300);
   set_depth        (1);
}
