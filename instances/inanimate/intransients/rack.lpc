#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns_holder";

void
create()
{
   inanm_intrns_holder::create();

   set_id        ( ({"rack"}) );	// How sicose finds this item.
   set_short        ("medical implements rack"); // The name of this item.

   // The in-depth description.
   set_long         ("An ornate rack, with many hooks and a shelf that " + 
                     "was once used to hold medical instruments.");	

   set_flammability (LOW);		// NONE | LOW | MEDIUM | HIGH
   set_burn_duration(600);  		// Sec. Burn duration in seconds 
   set_weight       (10);		// Kg.  (although, it is intransient)
   set_height       (100);		// cm.    
   set_width        (60);		// cm.   
   set_depth        (60);		// cm.   
   set_form         (SOLID);		// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);		// RIGID | FLEXIBLE

// Necessary for holders:
   set_liquid_tight (FALSE);    	// Won't hold liquids
   set_max_bearable (INFINITE); 	// Strong enough to hold whatever

   // How is the item held on this holder?   
   set_manner_held  ("hung by the racks hooks");  
//   set_intransient_list( ({"item"}) );	// Intransients held here.
//   set_transient_list  ( ({"item"}) );	// Transients held here.

}
