#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns";

void
create()
{
   inanm_intrns::create();

   set_id        ( ({"sign"}) );	// How sicose finds this item.
   set_short        ("sign");		// The name of this item.
   set_long         (
    "\n                    +---------------------------+\n" +
      "                    | Geschlossen zum Umbilden: |\n" +
      "                    |        Kein Eintritt      |\n" +
      "                    |---------------------------|\n" +
      "                    |  Closed For Remodelling   |\n" +
      "                    |         No Entrance       |\n" +
      "                    +---------------------------+");

   set_flammability (LOW);		// NONE | LOW | MEDIUM | HIGH
   set_burn_duration(120);  		// Sec. Burn duration in seconds 
   set_weight       (2);		// Kg.  (although, it is intransient)
   set_height       (25);		// cm.    
   set_width        (30);		// cm.   
   set_depth        (2);		// cm.   
   set_form         (SOLID);		// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);		// RIGID | FLEXIBLE
}
