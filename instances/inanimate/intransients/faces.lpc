#include <std_defs.h>

inherit "/classes/inanimate/intransients/inanm_intrns";

void
create()
{
   inanm_intrns::create();

   set_id        ( ({"faces"}) );
   set_short        ("faces");
   set_long         (
      "The faces are typical of the period, some ghastly hideous, " +
      "others lost in lament.\n");
   set_flammability (NONE);
   set_burn_duration(0);
   set_form         (SOLID);
   set_rigidity     (RIGID);
}
