#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/door";

void
create()
{
   door::create();
   set_id( ({"door,`private'"}) );
   set_long("The door is marked `Private'.");
   set_lock("Oma's room key");
   lock();
}
