#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/door";

void
create()
{
   door::create();

   set_id        ( ({"doors"}) );	// How sicose finds this item.
   set_short        ("doors");	// The full description of this item.

   // The in-depth description.
   set_long         (
      "Recently refinished, and restored to their original lustre, the " + 
      "goldleaf showcases ornate designs against a gloss white backdrop.");

   set_weight       (30);		// Kg.  (although, it is intransient)
   set_width        (300);		// cm.   

// Note, no lock defined for these doors.
   set_aggregate(TRUE);              // These are door_s_, plural.
}
