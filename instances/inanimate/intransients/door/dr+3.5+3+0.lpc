#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/door";

void
create()
{
   door::create();
   set_id( ({"door,oak"}) );

   set_long         (
      "The varnished oak door complements both the ballrooms parquay floor, " +
      "as well as the wooden floor of the armory, between which the door " + 
      "provides access.");

   set_lock("armory north door key");
   lock();
}
