#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("hall, outside rooms #8 & #9");
   set_long (
      "You're between room #8 to the west and #9 to the east. The hall " +
      "continues north and south.");

   set_adjacent_locations(
      ({ "loc+3+2+1", "loc+3+4+1", "loc+4+3+1",  "loc+2+3+1"}),
      ({ "north",     "south",     "east",       "west"}),
      ({ "",          "",          "dr+3.5+3+1", "dr+2.5+3+1"}) );
}
