#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("Room #11");
   set_long (
      "A stripe quilted, full size bed and a wooden chair sit against " + 
      "the southern wall and a bureau against the northern wall. A small " +
      "flower filled vase rests upon the bureau.");

   set_adjacent_locations(
      ({ "loc+3+5+1"}),
      ({ "east"}),
      ({ "dr+2.5+5+1"}) );

   set_intransient_list( 
      ({"seat/chair/wooden", "bed/full-striped", "bureau/guests"}) );
}
