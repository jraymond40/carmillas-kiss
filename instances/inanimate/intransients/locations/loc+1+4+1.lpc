#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("entrance to Rooms #3 & #4");
   set_long ("You find yourself at the entrances to room #3 to the west " + 
       "and to room #4 to the east. The hall continues north and south.");

   set_adjacent_locations(
      ({ "loc+1+3+1", "loc+1+5+1", "loc+2+4+1",  "loc+0+4+1"}),
      ({ "north",     "south",     "east",       "west"}),
      ({ "",          "",          "dr+1.5+4+1", "dr+0.5+4+1"}) );
}
