#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("top of the southern staircase");
   set_long (
      "A set of stairs leads down from here. A sign on the wall points " + 
      "west for rooms 1-6 and east for rooms 7-13.");

   set_adjacent_locations(
      ({ "loc+3+6+1",  "loc+1+6+1", "loc+2+6+0"}),
      ({ "east",       "west",      "down"}),
      ({ "",           "",          ""}) );
}
