#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("northern armoury");
   set_long (
      "The northern armoury is full of all kinds of weapons of destruction " +
      "all safely held behind security glass, at least until the designer " + 
      "can design them, their uses, and their safeguards.");

   set_adjacent_locations(({ "loc+4+4+0", "loc+3+3+0"}),
                          ({ "south",     "west" }),
                          ({ "",          "dr+3.5+3+0" }) );
}
