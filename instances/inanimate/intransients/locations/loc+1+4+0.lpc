#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("northwestern dining hall");
   set_long ("Here at the northwestern corner of the dining hall, a dark " + 
      "mahogany covers the walls, and a candelabra hangs overhead. A " 
      "matching mahogany table and accompanying chairs fills the room. The " + 
      "ballroom is accessible through the door in the northern wall, while " + 
      "the swinging door to the west leads to the kitchen.");

   set_adjacent_locations(
      ({ "loc+1+3+0",  "loc+1+5+0",  "loc+2+4+0", "loc+0+4+0"}),
      ({ "north",      "south",      "east",      "west"}),
      ({ "dr+1+3.5+0", "",           "",          "dr+0.5+4+0"}) );

   set_intransient_list( 
      ({"candelabra/hanging-small", "table/dining"}) );
}
