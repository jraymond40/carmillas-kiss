#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("Room #12");
   set_long (
      "Along the northern wall of the room is a full size bed, while " + 
      "along the southern wall is a chair and bureau. A small flower " + 
      "filled vase sits upon the bureau, and window provides a pleasant " + 
      "view.");

   set_adjacent_locations(
      ({ "loc+3+5+1"}),
      ({ "west"}),
      ({ "dr+3.5+5+1"}) );

   set_intransient_list( 
      ({"seat/chair/wooden", "bed/full-striped", "bureau/guests", "window/east"}) );
}
