#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("northwestern ballroom");
   set_long (
      "Here in the northwestern corner of the ballroom, a candelabra " + 
      "hangs overhead.");

   set_adjacent_locations(
      ({ "loc+1+3+0", "loc+2+2+0"}),
      ({ "south",     "east"}),
      ({ "",          ""}) );

   set_intransient_list( 
      ({"candelabra/hanging-small", "floor/parquet"}) );
}
