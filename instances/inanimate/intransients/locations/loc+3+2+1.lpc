#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("hall outside Room #7");
   set_long (
      "You find yourself in the hall, outside room number 7. A sign on " + 
      "the wall points south for rooms 8-13, and west for rooms 1-6.");

   set_adjacent_locations(
      ({ "loc+3+3+1", "loc+4+2+1",  "loc+2+2+1"}),
      ({ "south",     "east",       "west"}),
      ({ "",          "dr+3.5+2+1", ""}) );
}
