#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("southwestern ballroom");
   set_long (
      "You find yourself in the southwestern corner of the ballroom. " + 
      "A rich oak paneling proceeds halfway up the wall, and is met " +
      "by an emerald green that reaches down from the two-story ceiling. " +
      "There is a door set in the southern wall.");

   set_adjacent_locations(
      ({ "loc+1+2+0", "loc+1+4+0",  "loc+2+3+0"}),
      ({ "north",     "south",      "east"}),
      ({ "",          "dr+1+3.5+0", ""}) );

   set_intransient_list( 
      ({"candelabra/hanging-small", "floor/parquet"}) );
}
