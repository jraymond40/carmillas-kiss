#include "/std_defs.h"

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("western foyer");
   set_long("In the western foyer, " +
            "once beautiful, now deeply scarred, marble " + 
            "floors line the magnificent hall. A pair of roughly " +
            "hewn mammoth pillars shoulder the arches forming the " +
            "ceiling.");

   set_adjacent_locations(({ "loc+2+0+0", "loc+0+0+0"}),
                          ({ "east",      "west"}),
                          ({ "",          ""}) );

   set_intransient_list(({"floor/marble", "pillars", "arches",
                          "ceiling_+1+0+0"}) );
}

