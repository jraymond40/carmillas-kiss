#include "/std_defs.h"

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("northwest corner of the master suite");
   set_long(
   "You are in the northwest corner of the master suite. The expanse " +
   "of the canopy bed extends here, while the edge of a huge " +
   "fireplace begins along the northern wall of the room, overhung " +
   "by a silk tapestry.");

   set_adjacent_locations(({ "loc+3+1+1", "loc+2+0+1", "loc+4+0+1"}),
                          ({ "south",     "west",      "east"}),
                          ({ "",          "",          ""}) );

   set_intransient_list(({"bed/master", "fireplace/gothic", "tapestry"}) );
}
