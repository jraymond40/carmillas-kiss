#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("operating room");
   set_long (
      "The operating room provided a location to perform both surgeries as " + 
      "well as autopsies. Floored in a white marble tile, a medical " + 
      "instrument rack hangs upon the wall. A velvet curtain serves to " + 
      "seperate this room from the adjoined emergency room.");

   set_adjacent_locations(({ "loc+0+1+0", "loc+0+3+0"}),
                          ({ "north",     "south"}),
                          ({ "",          ""}) );

   set_intransient_list( 
      ({"table/patient", "counter/+0+2+0", "curtain", "rack", "floor/tile"}) );
}
