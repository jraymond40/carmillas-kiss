#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("foot of the southern staircase");
   set_long (
      "You find yourself at the foot of the southern staircase. There's " + 
      "an unmarked door to the west, and another with a small plaque " +  
      "marked `Private' to the east.");

   set_adjacent_locations(
      ({ "loc+2+5+0",  "loc+3+6+0",  "loc+1+6+0",  "loc+2+6+1"}),
      ({ "north",      "east",       "west",       "up"}),
      ({ "",           "dr+2.5+6+0", "dr+1.5+6+0", ""}) );
}
