#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("Room #5");
   set_long (
      "A wooden chair sits in one corner of the room, while a small bureau " + 
      "resides in the other, and a full size bed is pushed against the " + 
      "northern wall. A pair of windows in the west wall appear to " + 
      "provide a view.");

   set_adjacent_locations(
      ({ "loc+1+5+1"}),
      ({ "east"}),
      ({ "dr+0.5+5+1"}) );

   set_intransient_list( 
      ({"seat/chair/wooden", "bed/full-white", "bureau/guests", "window/west"}) );
}
