#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("pantry");
   set_long (
      "A bare, paint encrusted bulb hangs by its wires, illuminating the " + 
      "the mostly bare shelves of the pantry. A few musty tarps overhang " +
      "some of shelves.");

   // Add down to the cellar later (?)
   set_adjacent_locations(
      ({ "loc+0+5+0"}),
      ({ "north"}),
      ({ "" }) );

   set_transient_list( ({"bottle-oil", "rag"}) );
}
