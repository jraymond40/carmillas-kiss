#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("bust gallery");
   set_long (
      "You enter the southwestern section of the gallery. It is " +
      "filled with a variety of sculptured busts of various royal " +
      "family members.");

   set_adjacent_locations(({ "loc+0+0+1", "loc+1+1+1"}),
                          ({ "north",     "east"}),
                          ({ "",          ""}) );


   set_intransient_list( ({"busts", "busts"}) );
}
