#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("Oma's bedroom");
   set_long (
      "A surprisingly stark room with merely a bureau and a small white " + 
      "bed. Not a single picture adorns the walls, nor are any personal " + 
      "belongings visible. Whomever owns this " +
      "room is not only an ascetic, but is also very meticulous, as not a " + 
      "speck of dust can be found in here.");

   set_intransient_list( ({"bed/single-white", "bureau/simple"}) );

   set_adjacent_locations(
      ({ "loc+2+6+0" }),
      ({ "west" }),
      ({ "dr+2.5+6+0"}) );
}
