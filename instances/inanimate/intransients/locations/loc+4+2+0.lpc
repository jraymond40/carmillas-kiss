#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("southern section of the library");
   set_long (
      "The southern section of the library holds a small table, " + 
      "and that unique odor that always accompanies " + 
      "old books, which the walls are full of.");

   set_adjacent_locations(({ "loc+4+1+0", "loc+3+2+0"}),
                          ({ "north",     "west" }),
                          ({ "",          "" }) );

   set_intransient_list( ({"shelves/+4+2+0", "table/small"}) );
}
