#include "/std_defs.h"
#define  ROPED_STR "roped off by velveteen ropes, not permitting access " + \
                   "to the rest of the Chateau"

inherit "/classes/inanimate/intransients/locations/location";

restrict_access()
{
   add_delta_adjective(ROPED_STR);

   // Even if you could go out the front, you'll only end up here again.
   set_adjacent_locations(({"loc+2+0+0" }),
                          ({ "north" }),
                          ({ "dr+2-0.5+0" }) );
}

void 
create()
{   
   location::create();

   set_short("main entry way");
   set_long( 
            "Standing before the huge oak counter that is the front " +
            "desk of the chateau, you see a  chrome service bell " +
            "sits upon the counter, with a sign beneath it. " + 
            "Along the northern wall are the main doors. ");

   set_intransient_list( ({"counter/+2+0+0", "sign/service", "ropes_+2+0+0"}) );

#ifdef BETAMODE
   add_exits();
#else
   restrict_access();
#endif
}

void
add_exits()
{
   set_adjacent_locations(({"loc+2+0+0","loc+2+1+0", "loc+3+0+0", "loc+1+0+0"}),
                          ({ "north",   "south",     "east",      "west"}),
                          ({ "dr+2-0.5+0", "",          "",          ""}) );

   remove_delta_adjective(ROPED_STR);
}

void
restart()
{
   location::restart();
   restrict_access();
}
