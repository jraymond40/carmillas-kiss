#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("hall outside Room #13");
   set_long (
      "In the southern end of the hall, room #13 is to the east, while " +
      "a set of stairs and more rooms are west of here. A sign on the " + 
      "wall points north to rooms 7-12.");

   set_adjacent_locations(
      ({ "loc+3+5+1", "loc+4+6+1",  "loc+2+6+1"}),
      ({ "north",     "east",       "west"}),
      ({ "",          "dr+3.5+6+1", ""}) );
}
