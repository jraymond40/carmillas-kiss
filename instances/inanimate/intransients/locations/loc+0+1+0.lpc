#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("emergency room");
   set_long (
      "This is apparently the emergency room where Paracelsus provided " + 
      "immediate aid to his patients. A waiting bench lines the northern " +
      "wall, while a patient table lines the western wall, and counter " + 
      "the eastern. The operating room to the south is seperated by a " + 
      "curtain.");

   set_adjacent_locations(({ "loc+0+2+0", "loc+1+1+0"}),
                          ({ "south",     "east"}),
                          ({ "",          ""}) );

   set_intransient_list( 
      ({"seat/bench/rough", "table/patient", "counter/small", "curtain"}) );
}
