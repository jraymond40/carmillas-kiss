#include "/std_defs.h"

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("sitting room");
   set_long(
   "You find yourself within the sitting room, adjacent to the master " +
   "suite. It appears to have been designed with the chateaus matriarch " +
   "in mind, as a rocking chair, resting upon a handwoven rug, sits " +
   "before a pair of windows overlooking the courtyard below.\n" +
   "    With a closing of the shuttered windows, the area apparently " +
   "served as a dressing area, evidenced by the black oak vanity along " +
   "the western wall with it's trio of arched mirrors. The mirrors now, " +
   "however, primarily lie upon the floor in broken shards.");

   set_adjacent_locations(({ "loc+3+0+1"}),
                          ({ "east"}),
                          ({ "" }) );

   set_intransient_list(({"window/+2+0+1", "mirror", "bureau/vanity", 
                          "seat/chair/rocking", "rug"}));

}
