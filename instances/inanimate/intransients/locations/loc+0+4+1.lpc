#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("Room #3");
   set_long (
      "A full-sized bed sits beneath a pair of windows in the west wall, " + 
      "while a small bureau sits against the east wall, and a wooden " +
      "chair against the south wall.");

   set_adjacent_locations(
      ({ "loc+1+4+1"}),
      ({ "east"}),
      ({ "dr+0.5+4+1"}) );

   set_intransient_list( 
      ({"seat/chair/wooden", "bed/full-striped", "bureau/guests", "window/west"}) );
}
