#include <std_defs.h>

inherit "/classes/inanimate/intransients/inanm_intrns";

void
create()
{
   inanm_intrns::create();

   set_id        ( ({"design"}) );
   set_short        ("intricate design");
   set_long         (
      "An outer circle circumscribes a triangle, which contains a square.  " +
      "Inside the square lies yet another circle, within which dance a cunningly " +
      "carved royal couple.  The design is positioned on the pair of doors in such a " +
      "manner that when the doors are opened, the king is parted from his queen till " +
      "they are once again closed.\n");
   set_flammability (NONE);
   set_burn_duration(0);
   set_form         (SOLID);
   set_rigidity     (RIGID);
}
