#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/picture";

void
create()
{
   picture::create();

   set_id        ( ({"Coat-of-Arms"}) );// How sicose finds this item.
   set_short        ("Hapsburg Coat-of-Arms");	// The name of this item.

   // The in-depth description.
   set_long         (
      "The shield, the mark of the Hapsburg family, displays a pair of " +  
      "of open-winged crowned hawks, back to back under the royal crown. " + 
      "One hawk clutches a sword and sceptre, and the other a crowned " + 
      "sphere. Looking closer you see a ribbon is worn about both birds, " + 
      "and from it hangs a ram. Within this ribbon is yet another shield " + 
      "with a lion passant, and three doves. Below the inner shield hangs " + 
      "a maltese cross.");
}
