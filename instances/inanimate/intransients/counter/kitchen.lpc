#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/counter";

void
create()
{
   counter::create();

   set_long("Newly covered in formica, the counter holds a sink.");
   set_intransient_list(({"appliance/sink"}));
   set_transient_list(({"cutlery/fork", "cutlery/spoon-silver", 
                        "dish/plate/dinner", "dish/bowl/soup"}));
}
