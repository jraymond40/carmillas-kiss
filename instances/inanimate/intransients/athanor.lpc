#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns_holder";

void
create()
{
   inanm_intrns_holder::create();

   set_id        ( ({"oven"}) );	// How sicose finds this item.
   set_short        ("alchemist's oven"); // The name of this item.

   // The in-depth description.
   set_long("The mouth of the alchemists oven, or 'athanor', is blackened " + 
            "by many years of use, though now, long, long ago. Three tear " + 
            "drop shaped vessels are visible within it's brick walls.");	

   set_flammability (LOW);		// NONE | LOW | MEDIUM | HIGH
   set_burn_duration(600);  		// Sec. Burn duration in seconds 
   set_weight       (40);		// Kg.  (although, it is intransient)
   set_height       (100);		// cm.    
   set_width        (60);		// cm.   
   set_depth        (60);		// cm.   
   set_form         (SOLID);		// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);		// RIGID | FLEXIBLE
   set_dynamacy     (STATIC);          // Is it usable in some way?
   set_liquid_tight (FALSE);    	// Won't hold liquids
   set_max_bearable (INFINITE); 	// Strong enough to hold whatever
   set_manner_held  ("inside it's blakened mouth");  
}
