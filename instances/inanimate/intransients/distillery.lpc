#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns";

void
create()
{
   set_id        ( ({"distillery"}) );	// How sicose finds this item.
   set_short        ("Pelican distillery");	// The name of this item.

   // The in-depth description.
   set_long("Shaped like a bulbous glass figure eight, with a " + 
      "pair of arm-like tubes extending from the mouth on top to the " + 
      "midsection. The distillery or `Pelican' was used for the 'retorta " +
      "distillatio', or process of continuous refinement of a substance, " + 
      "such as Yliastrum."); 

   set_flammability (NONE);		// NONE | LOW | MEDIUM | HIGH
   set_burn_duration(0);  		// Sec. Burn duration in seconds 
   set_weight       (1);		// Kg.  (although, it is intransient)
   set_height       (35);		// cm.    
   set_width        (18);		// cm.   
   set_depth        (18);		// cm.   
   set_form         (SOLID);		// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);		// RIGID | FLEXIBLE
   set_dynamacy     (STATIC);           // Is it usable in some way? 
}
