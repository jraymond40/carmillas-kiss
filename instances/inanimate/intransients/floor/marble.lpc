#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/floor";

void
create()
{
   floor::create();

   set_long         (
      "Deep majestic veins intertwine throughout the marble blocks " +
      "comprising the floor. Gouges in the marble reveal the times this " +
      "chateau has weathered, and it's true age.");
}
