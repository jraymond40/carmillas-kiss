#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns";

void
create()
{
   inanm_intrns::create();

   set_id        ( ({"arches"}) );	// How sicose finds this item.
   set_short        ("arches");		// The full description of this item.

   set_long         ("A trio of crossed arches shoulder the weight of " +
                     "the floor above."); 

   set_flammability (NONE);		// NONE | LOW | MEDIUM | HIGH
   set_burn_duration(0);  		// Sec. Burn duration in seconds 
   set_weight       (1000);		// Kg.  (although, it is intransient)
   set_height       (300);		// cm.    
   set_width        (1000);		// cm.   
   set_depth        (1000);		// cm.   
   set_form         (SOLID);		// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);		// RIGID | FLEXIBLE
}
