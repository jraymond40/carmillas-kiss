#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns";

void
create()
{
   inanm_intrns::create();

    set_id        ( ({"fire"}) );
   set_short        ("fire");
   set_long         ("The flames leap and dance in a mesmerizing rhythm.");
   set_flammability (NONE);
   set_burn_duration(INFINITE);
   set_height       (100);
   set_width        (100);
   set_depth        (100);
   burn();
}

void 
fire_effects()
{
   switch (random(4))
   {
      case 0:
         effect(LOCAL, this_object(), "",
            "\"crrrackKK!\", cracks the wood in the fire.");
         break;
      case 1:
         effect(LOCAL, this_object(), "", 
            "\"chi-Ter chshTer\", crackles the fire.\n");
         break;
      case 2:
         effect(LOCAL, this_object(), "", "\">snap!<\"\n");
         break;
      case 3:
         effect(LOCAL, this_object(), "", "\"POP!\", an ember leaps from " + 
            "the fireplace and burns itself out upon the hearth.\n");
         break;
   }
 
   // Chances are the fire'll pop again.
   if (random(10) < 8)
      call_out("fire_effects", random(10) * 6 + 210);
   else return; 
}

/*
// Once someone enters the room, then the fire should be perceivable
*/
void 
init()
{
   call_out("fire_effects", random(10) * 6 + 60);
}
