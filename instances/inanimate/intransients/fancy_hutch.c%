#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns_container";

void
create()
{
   inanm_intrns_container::create();

   set_id        ( ({"hutch"}) );
   set_short        ("hutch");
   set_long         ("This elegant antique is a testimony to the skills of a more civilized " +
                     "age.  Fine hand carved scrollwork covers the sides in a web of intricate " +
                     "design.  The doors of the lower cabinet are worked in relief, showing a " +
                     "complex circular design.  Above the cabinet are two further sets of shelves.");
   set_flammability (LOW);
   set_burn_duration(1200); // Sec.    
   set_weight       (120);   // Kg.  (pointless since it's intransient)
   set_height       (100);  // cm.  These are looked at to see if the 
   set_width        (120);  // cm.  potential object to be contained will
   set_depth        (50);   // cm.  fit within.
   set_form         (SOLID);
   set_rigidity     (RIGID);
   set_dynamacy     (DYNAMIC); // It can be opened and closed.

   // Especially for holders.
   set_manner_held  ("in the bottom cabinet");

   // Especially for containers:
   set_closable     (TRUE);    

   set_transient_list( ({"orb"}) );

}

string*
open()
{
   theRoom = find_object(LOCATION_DIR + "loc+4+5+0");

   if (query_closed() == TRUE)  {
     effect(LOCAL, theRoom,
       "A musty smell of old oak momentarily fills the air.",
       "A faint smell of oak is in the air.",
       "You smell like oak.");
   }
   
   return inanm_intrns_container::open();
}