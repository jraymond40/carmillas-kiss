#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/table";

void
create()
{
   table::create();

   set_short        ("table");	// The name of this item.
   set_long         ("This sturdy table consists of thick wooden planks bolted to iron straps. " +
                     "The ironwork shows no great craftsmanship but is more than adequate " +
                     "to the task.  This same table may have stood here for well over a " +
                     "hundred years.");	

   set_height       (100);		// cm.    
   set_width        (50);		// cm.   
   set_depth        (150);		// cm.   
   set_manner_held  ("on the table");  
}

use(object tp, object recipient)
{
   if (!recipient)
      return ( ({
         ". The bench squeaks slightly as you sit down.",
         ".  The bench squeaks slightly.",
         ".",
         "sit",
         0,
         "at"}));
   else return (table::use(tp, recipient));
}

