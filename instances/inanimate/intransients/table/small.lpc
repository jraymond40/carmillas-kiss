#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/table";

void
create()
{
   table::create();

   set_short        ("small table");	// The name of this item.
   set_long         ("A small, cherrywood table.");	

   set_height       (100);		// cm.    
   set_width        (60);		// cm.   
   set_depth        (120);		// cm.   
   set_manner_held  ("on the table");  
}

use(object tp, object recipient)
{
   if (!recipient)
      return ( ({
         ", but discover there is no chair to sit in.",
         ", but discovers there is no chair to sit in.",
         ", but dicovers there is no chair to sit in.",
         "attempt",
         0,
         "to use"}));
   else return (table::use(tp, recipient));
}

