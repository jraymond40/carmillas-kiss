#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/bed";

void
create()
{
   bed::create();

   set_long         ("Cobwebs weave between the ceiling and the canopy " +
                     "of the great bed. Taking in it's large size, " +
                     "your fingers follow the intricately carved posts " +
                     "of onyx, then draw across its handsewn down " +
                      "comforter.");

   set_weight       (6000);     // Rather pointless since it's immoveable.
   set_height       (270);      // 2.7 M tall
   set_width        (200);      // 2 M wide
   set_depth        (250);      // 2.5 M long
}
