#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/window";

void
create()
{
   window::create();

   set_long ("Running your hand across the wooded surface, you note the " +
             "thoroughness with which it has been sealed, with no drafts " +
             "coming through.");
   set_closable(FALSE);
}
