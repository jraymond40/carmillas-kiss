#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/window";

void
create()
{
   window::create();

   set_long("You catch a magnificent glimpse of the Styrian Mountain " + 
      "range, set in hues of deep blue, except where the full moon " + 
      "reflects its pale light from icicle-laden trees.");
}
