#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/window";

void
create()
{
   window::create();

   set_long("Peering out through the cracked and aged panes of the " +
            "window, you're barely able to make out the outline of " + 
            "the tour bus below. Looking towards the chateau's vineyards, " + 
            "you become nearly certain you see small " +
            "blue spots scattered about the grounds.\n" +
            "     Rubbing your eyes, your not quite certain whether " +
            "they're just the illusionary flotsam that occurs in " +
            "poorly illuminated environments, or actually the " +
            "occasional blue flames they appear to be.");
}
