#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns_holder";

void
create()
{
   inanm_intrns_holder::create();

   set_id        ( ({"shelf,bottom"}) );
   set_short        ("bottom shelf");
   set_long         ("The well treated oak of the bottom shelf shows the polish of long use.");
   set_flammability (LOW);
   set_burn_duration(600);
   set_weight       (INFINITE); /* Rather pointless since it's immoveable */
   set_height       (50);
   set_width        (120);
   set_depth        (50);
   set_form         (SOLID);
   set_rigidity     (RIGID);
   set_liquid_tight (FALSE);    /* Won't hold water */
   set_max_bearable (INFINITE); /* But it's strong enough to hold whatever */
   set_manner_held  ("sitting on the bottom shelf.");
}
