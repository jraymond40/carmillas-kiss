#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/shelves";

void
create()
{
   shelves::create();
   set_manner_held("upon the shelves here");

   // Books held here.
   set_intransient_list( ({"book/Entwurfe", "book/Natura_Rerum"}) );
   set_transient_list( ({"canister/steel", "canister/copper", "canister/ceramic"}) );
}
