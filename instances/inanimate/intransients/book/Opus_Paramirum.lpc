#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/book_intrns";

void
create()
{
   book_intrns::create();

   set_id        ( ({"book,`Paramirum'"}) );	// How sicose finds this item.
   set_short        ("book, 'Opus Paramirum'"); // The name of this item.

   // The in-depth description.
   set_long         ("Flipping through it's pages, you find it " + 
                     "instructs physicians on the use of wax dummies " + 
                     "for medicinal applications.");	
}
