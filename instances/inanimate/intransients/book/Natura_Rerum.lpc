#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/book_intrns";

void
create()
{
   book_intrns::create();

   set_id        ( ({"book,`Rerum'"}) );	// How sicose finds this item.
   set_short        ("book titled 'De Natura Rerum'"); // The name of this item.

   // The in-depth description.
   set_long ("Amongst the interesting items within, you note a " + 
             "quaint recipe for making a homonculas, or miniature " +
             "artificial human in a bottle:\n" + 
             "'Enclose the spagyric substance within a glass vial " +
             "and digest for 40 days in horse-dung.'\n" + 
             "It continues with the care, feeding, and raising of them " +
             "which, if done properly, will make them visible to humans.");

}
