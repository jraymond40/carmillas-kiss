#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/book_intrns";

void
create()
{
   book_intrns::create();

   set_id        ( ({"comic,`Crow'"}) );	// How sicose finds this item.
   set_short        ("comic book titled `The Crow'"); // The name of this item.

   // The in-depth description.
   set_long ("Apparently the tragic story of a young couple from " + 
      "Detroit, and the struggle of the groom to exact justice for the " + 
      "brutal murder of his lovely bride.");	
}
