#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/book_intrns";

void
create()
{
   book_intrns::create();

   set_id        ( ({"comic,`Magic'"}) );	// How sicose finds this item.
   set_short        ("comic book titled `The Books of Magic'"); // The name of this item.

   // The in-depth description.
   set_long ("A story of a young man who sets out to discover his magical " + 
      "destiny, and in the process discovers the end of the universe as we " + 
      "know it.");	
}
