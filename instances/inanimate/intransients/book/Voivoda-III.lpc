#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/book_intrns";

void
create()
{
   book_intrns::create();

   set_id        ( ({"book,`III-Voivoda'"}) );	// How sicose finds this item.
   set_short        ("book entitled 'Voivoda Dracula, vol. III'"); // The name of this item.

   // The in-depth description.
   set_long ("'Soon even the Turks began to fear the terrible monster they " + 
      "put in power in Vallachia, and sent an army to remove him. " +
      "Raving like a mad man that he was invincible and immortal from his " +
      "bloody concoction, Tepes rushed headlong into battle, ignoring the " +
      "warnings of his advisors that he was not invincible, and only nearly " +
      "immortal. While he might of lived for thousands of years, we shall " + 
      "never know, for he was decapitated in the " +      
      "battle, a wound that even his concoction could not correct.'");

}
