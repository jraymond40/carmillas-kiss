#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/book_intrns";

void
create()
{
   book_intrns::create();

   set_id        ( ({"book,`Monster'"}) );	// How sicose finds this item.
   set_short        ("book titled 'The Great Monster'"); // The name of this item.

   // The in-depth description.
   set_long ("Written in 1491, it is apparently a semi-fictionalized " + 
             "account of Vlad Tepes, known as Vlad the Impaler. As the " + 
             "Voivode, or Prince of Vallachia, he was a ruthless ruler " + 
             "whom, amongst other unspeakable acts, mercilessly rid " + 
             "his kingdom of 'beggars, orphans, and cripples'. Near the " + 
             "end a great deal of illegible notes are scribbled, especially " +
             "surrounding the discussions of Tepes' blood-based concoctions.");	
}
