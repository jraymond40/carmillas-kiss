#include <std_defs.h>
#include <config.h>
#include <curses.h>
#include <pgui.h>

//#define UI_DEBUG 
#define MAP_HEIGHT      50
#define MAP_WIDTH       131
#define MAPBLOCK_WIDTH  10
#define MAPBLOCK_HEIGHT 5

#define SETUP_MODE      0
#define NORMAL_MODE     1
#define HELP_MODE       2
#define NOTICE_MODE     3

// Prototypes
void cmd_reset();
private void take_action();
private void build_users_cmdline();

private nosave portptr  cmdport, sayport, mapport, eventport;
private nosave portptr *menu;
private nosave winptr   n_dirwin, s_dirwin, e_dirwin, w_dirwin, cursorwin, noticewin, helpwin;
private nosave mixed   *key;
private nosave int      i, j, length, len, active_gadget, mode, previous_mode;
private nosave string  *cmd, *null_list, *list;
private nosave string   choice, said, users_cmd, systems_cmd;
private nosave int      prep_position;
private nosave string   prep;

void
initmapport()
{
   int x,y;
   int *dstloc_coord;

   primaryport(mapport); // Allow us to cat to this port.
   portattron(mapport, A_REVERSE | A_ALTCHARSET);
   cat(MAP);
   portattroff(mapport, A_REVERSE | A_ALTCHARSET);
   primaryport(eventport);

   dstloc_coord = find_object(STARTING_LOCATION)->query_coordinates();

   // Initial map location.
   x = (dstloc_coord[0] * MAPBLOCK_WIDTH) + dstloc_coord[2] * (MAP_WIDTH/2) + 3;
   y = (dstloc_coord[1] * MAPBLOCK_HEIGHT) + 8;
   scrollport(mapport, y, x);
}

void 
remove()
{
   delwin(n_dirwin); delwin(s_dirwin); delwin(e_dirwin); delwin(w_dirwin); delwin(cursorwin);
   if (noticewin) delwin(noticewin);
   delport(menu[0]);
   delport(menu[1]);
   delport(menu[2]);
   delport(cmdport);
   delport(sayport);
   delport(mapport);
   if (helpwin) delwin(helpwin);
   delport(eventport);
   endwin();
}

//
// In the event crap is sent down the line...
//
void
screen_redraw()
{
#ifdef UI_DEBUG
   write("Entered screen redraw.\n");
#endif
   wclear(curscr);
   wnoutrefresh(curscr);
   wclear(stdscr);
   wnoutrefresh(stdscr);
   
   
   if (mode == HELP_MODE)
   {
   	 touchwin(helpwin);   
   	 wrefresh(helpwin);
   	 return;
   }
     	
   touchport(menu[0]);   portnoutrefresh(menu[0]);
   touchport(menu[1]);   portnoutrefresh(menu[1]);
   touchport(menu[2]);   portnoutrefresh(menu[2]);
   touchport(cmdport);   portnoutrefresh(cmdport);
   touchport(sayport);   portnoutrefresh(sayport);
   touchport(mapport);   portnoutrefresh(mapport);
   touchport(eventport); portnoutrefresh(eventport);
   touchwin(n_dirwin);   wnoutrefresh(n_dirwin);
   touchwin(s_dirwin);   wnoutrefresh(s_dirwin);
   touchwin(e_dirwin);   wnoutrefresh(e_dirwin);
   touchwin(w_dirwin);   wnoutrefresh(w_dirwin);
   touchwin(cursorwin);   wnoutrefresh(cursorwin);
   if (mode == NOTICE_MODE) 
   {
   	 touchwin(noticewin);   wnoutrefresh(noticewin); 
   }
   doupdate();
}

public
void
create_info_window(winptr win, int size_y, int size_x, int orig_y, int orig_x, string str, int style)
{
   if ( (win = newwin(size_y, size_x, orig_y, orig_x)) == (winptr) NULL)
   {
      write_file(ERROR_LOG, "ui.c: Error, unable to open an info window.\n");
      remove();
   }
   wattron(win, style);   
   wprintw(win, str);
   wattroff(win, style);
   wrefresh(win);
}

public
void
remove_info_window(winptr win)
{
   mode = previous_mode;
   delwin(win);
   screen_redraw();      
}

public
void
create_notice_window(int size_y, int size_x, int orig_y, int orig_x, string str, int style)
{
   remove_info_window(helpwin);
   previous_mode = mode;
   mode = NOTICE_MODE;
   create_info_window(noticewin, size_y, size_x, orig_y, orig_x, str, style);
}

public
void
remove_notice_window(winptr win)
{
   remove_info_window(win);
}

void
help_screen()
{
   string str;
   
   previous_mode = mode;
   mode = HELP_MODE;
   str = read_file(INFO_DIR+"help.screen");
   
   if (str) create_info_window(helpwin, 24, 79, 0, 0, str, A_REVERSE);
}
      
// When and where the preposition is placed.
// (cmd0 pos0) (pos1 [cmd1) pos2] (pos3 cmd2)
void
set_preposition(int position, string preposition)
{
   prep_position = position;
   if (position > 0) prep = preposition;
}

ui_setup()
{
   said = ""; users_cmd = ""; systems_cmd = "";
   menu = allocate(3);
   cmd  = ({"","",""});
   key  = allocate(MAX_TEXT);
   null_list = ({" ", " ", " ", " ", " "});

   /* Initialize the terminal */
   raw();             /* Key-at-a-time, w/out interrupt, quit, control-flow */
   noecho();                /* Don't auto echo keys to terminal */
   curs_set(0);             // Don't want to see the cursor **N.B. Apparently not VT100 Supported
   leaveok(stdscr, TRUE);   /* Don't worry about the cursor location */
   scrollok(stdscr, FALSE); /* It's not okay to scroll the screen */
   clear(); refresh();      /* Clean the slate */

   /* Initialize the necessary u/i gadgets */
   menu[0] = newmenuport(7, 17, 0, 0);
   menu[1] = newmenuport(7, 18, 0, 18);
   menu[2] = newmenuport(7, 18, 0, 37);
   cmdport = newlineport(55,  7, 0, "  DO:");
   sayport = newlineport(79,  9, 0, " SAY:");
   // Add extra width below to avoid conflict w/ word wrap.
   mapport = newoutputport( 9, 23, 0, 56, MAP_HEIGHT, MAP_WIDTH + 5);
   n_dirwin = newwin(1, 2, 0, 66);
   s_dirwin = newwin(1, 1, 8, 67);
   e_dirwin = newwin(1, 1, 4, 78);
   w_dirwin = newwin(1, 1, 4, 56);
   cursorwin = newwin(1, 1, 23, 79);
   eventport = newscrollport(12, 79, 12, 0, 96, "EVENTS");

   if ((menu[0] == (portptr) NULL) ||
       (menu[1] == (portptr) NULL) ||
       (menu[2] == (portptr) NULL) ||
       (cmdport == (portptr) NULL) ||
       (sayport == (portptr) NULL) ||
       (mapport == (portptr) NULL) ||
       (n_dirwin == (winptr) NULL) ||
       (s_dirwin == (winptr) NULL) ||
       (e_dirwin == (winptr) NULL) ||
       (w_dirwin == (winptr) NULL) ||
       (cursorwin == (winptr) NULL) ||
       (eventport == (portptr) NULL) )
   {
      write_file(ERROR_LOG, "ui.c: Error, unable to open a window or port.\n");
      remove();
   }

   /* Setup the screen */
   primaryport(eventport); // This is where the engine should send it's output.
   keypad(stdscr, TRUE);   /* Allow us to read arrow keys as tokens */

   /* Initialize various ports */
   list = actions_list(commands());
   if ( initmenu(menu[0], "ACTIONS", list)  == ERR)
      write_file(ERROR_LOG, "Menu 0 returned ERR, may need to increase MAX_ENTRIES.\n");
   if ( initmenu(menu[1], "OBJECTS", objects_list(this_object(),
         INANIMATE | DYNAMIC | STATIC | TRANSIENT | INTRANSIENT, AND, 
         INVENTORY | IMMEDIATE)) == ERR)
      write_file(ERROR_LOG, "Menu 1 returned ERR, may need to increase MAX_ENTRIES.\n");
   list = living_list(this_object());
   if ( initmenu(menu[2], "PEOPLE", list) == ERR)
      write_file(ERROR_LOG, "Menu 2 returned ERR, may need to increase MAX_ENTRIES.\n");

   initmapport();

   wattron(n_dirwin, A_REVERSE);
   wattron(s_dirwin, A_REVERSE);
   wattron(e_dirwin, A_REVERSE);
   wattron(w_dirwin, A_REVERSE); 
   wattron(cursorwin, A_REVERSE); // The cursor ends up here, and auto-reverses it.
   mvwprintw(n_dirwin, 0, 0, "^N");
   mvwprintw(s_dirwin, 0, 0, "S");
   mvwprintw(e_dirwin, 0, 0, "E");
   mvwprintw(w_dirwin, 0, 0, "W");
   mvwprintw(cursorwin, 0, 0, " ");
   wattroff(n_dirwin, A_REVERSE);
   wattroff(s_dirwin, A_REVERSE);
   wattroff(e_dirwin, A_REVERSE);
   wattroff(w_dirwin, A_REVERSE);
   wattroff(cursorwin, A_REVERSE);

   /* And now the instruction and title lines */
   printport(eventport, A_REVERSE,
 "   .:::::::::::::::::::::::  Carmilla's Kiss  :::::::::::::::::::::::.   ");
   printport(eventport, A_NORMAL,
 " .: Copyright 1994, Raymond Interactive Theatre, All rights reserved. :. ");
   printport(eventport, A_REVERSE,
 "              Use arrow keys to select options; Type to talk.            ");
   printport(eventport, A_NORMAL, "\n\n");

   portnoutrefresh(menu[1]);
   portnoutrefresh(menu[2]);
   portnoutrefresh(cmdport);
   portnoutrefresh(sayport);
   portnoutrefresh(mapport);
   wnoutrefresh(n_dirwin);
   wnoutrefresh(s_dirwin);
   wnoutrefresh(e_dirwin);
   wnoutrefresh(w_dirwin);
   wnoutrefresh(cursorwin);
   portnoutrefresh(eventport);

   active_gadget = 1;
   activeport(menu[0], 1);
   portrefresh(menu[0]);

   while(getch() != ERR); // clear the input buffer
   mode = NORMAL_MODE;
   effect(LOCAL, this_player(), find_object(STARTING_LOCATION)->query_long(),
      this_player()->query_cap_name() + " walks on stage.\n");
}

process_input()
{
   if (mode != NORMAL_MODE)
   {
      if (mode == SETUP_MODE) ui_setup();
      else if (mode == HELP_MODE) 
      {
         int x;
         while(getch() != ERR && ++x < MAX_CHAR_INPUT); // Clear the stream.
      	 remove_info_window(helpwin);
         return;
      }
   }
   
   while((key[length++] = getch()) != ERR && length < MAX_CHAR_INPUT);
      
   while ( i < length && key[i] != ERR)
   {
      switch(key[i])
      {
         case KEY_UP:
            if (active_gadget > 0)  /* Scroll a menu */
            {
               if (active_gadget == 1) set_preposition(0,"");
               scrollmenu(menu[active_gadget - 1], -1);
               portrefresh(menu[active_gadget - 1]);
            }
            else                    /* Scroll the eventport */
            {
               // Jump scrolling, since the eventport scroll is so slow
               j = i;
               while(key[j++] == KEY_UP);
               scrollscrollport(eventport, - (j - i));
               i = j-1; // -1 because i will be inc'ed after this loop anyway
               scrollscrollport(eventport, -1);
               portrefresh(eventport);
            }
            break;
            
         case KEY_DOWN:
            if (active_gadget > 0)  /* Scroll a menu */
            {
               if (active_gadget == 1) set_preposition(0,"");
               scrollmenu(menu[active_gadget - 1], 1);
               portrefresh(menu[active_gadget - 1]);
            }
            else                    /* Scroll the eventport */
            {
               // Jump scrolling, since the eventport scroll is so slow
               j = i;
               while(key[j++] == KEY_DOWN);
               scrollscrollport(eventport, j - i);
               i = j-1; // -1 because i will be inc'ed after this loop anyway
               portrefresh(eventport);
            }
            break;
            
         case KEY_LEFT:
            if (active_gadget > 0)         /* Selected from w/in a menu */
            {
               // If leaving the action menu, _deactivate_ it, remove
               // cmd from cmdline and activate the event port .
               if (active_gadget == 1)
               {
                  activeport(menu[0], FALSE);
                  portnoutrefresh(menu[0]);
                  cmd[0] = "";
                  activeport(eventport, TRUE);
                  portnoutrefresh(eventport);
               }
               // If leaving an alternate menu, _blank_ it out, and
               // activate the new one.
               else
               {
                  if (active_gadget == 3 && prep_position == 4)
                     set_preposition(0, "");
                  if (active_gadget == 2 && 
                     (prep_position == 2 || prep_position == 3) )
                     set_preposition(0, "");
                  initmenu(menu[active_gadget-1], "    ", null_list);
                  portnoutrefresh(menu[active_gadget-1]);
                  activeport(menu[active_gadget-2], TRUE);
                  portnoutrefresh(menu[active_gadget-2]);
               }
               
               /* If not leaving menu 3, erase second cmd on cmdline */
               if (active_gadget != 3)  cmd[1] = "";
               
               /* Left arrow always erases the 3rd cmd on cmdline */
               cmd[2] = "";
               
               /* Show the updated results */
               build_users_cmdline();
            }
            else  /* Leaving eventport, activate action menu */
            {
               activeport(eventport, FALSE);
               portnoutrefresh(eventport);
               activeport(menu[0], TRUE);
               portnoutrefresh(menu[0]);
            }
            active_gadget--;
            if (active_gadget < 0) active_gadget = 1; /* bounded to eventport */
            doupdate(); 
            break;

         case KEY_RIGHT:
            if (active_gadget > 0)                 /* Selections from a menu */
            {
               choice = selectentry(menu[active_gadget-1]);
               if (active_gadget == 1)  /* Setup the second menu */
               {
                  cmd[0] = choice;
                  systems_cmd = cmd[0] + " *>[menu1]";
                  cmd[1] = ""; cmd[2] = "";
               }
               else if (active_gadget == 2) /* Setup the third menu */
               {
                  cmd[1] = choice;
                  systems_cmd = cmd[0] + " " +cmd[1] + " *>[menu2]";
                  cmd[2] = "";
               }
               else /* Right from the 3rd menu means select/reselect or else */
                    /* [RETURN] (if there's already a cmd in 3rd position.)  */
               {
                  if (cmd[2] == choice) /* Same as hitting return */
                  {
                     take_action();
                     break;
                  }
                  else cmd[2] = choice;
               }
               build_users_cmdline();
               if (active_gadget != 3)
               {
                  command(systems_cmd); 
#ifdef UI_DEBUG 
                  write(systems_cmd + "\n");
#endif
               }
            }
            else  /* Leaving eventport */
            {
               activeport(eventport, FALSE);
               portnoutrefresh(eventport);
               active_gadget = 1;
               activeport(menu[active_gadget-1], TRUE); 
               portnoutrefresh(menu[active_gadget - 1]);
            }
            doupdate(); 
            break;

         case KEY_RETURN:
            take_action();
            break;

         // Ways to signal Screen Redraw.
         case KEY_REFRESH:      // If the terminal supports it
         case KEY_CTRL_L:       // Unix Style
         case KEY_CTRL_R:       // Mnemonic, R for refresh or redraw.
            screen_redraw();
            break;
            
         // Ways to signal the Help Screen.
         case KEY_CTRL_QM:      // ^?
         case KEY_HELP:         // The Help key
         case KEY_SHELP:        // The shifted help key
            help_screen();
            break;
            
         case KEY_BACKSPACE: 
         case KEY_DC:
            /* Delete a character */
            len = strlen(said);
            if (len > 0)
            {
               if (len < 2) said = "";
               else said = extract( said, 0, len - 2);
               printport(sayport, A_NORMAL, "\n" + said + "_");
               portrefresh(sayport);
            }
            break;

         // The "quick move" hot keys
         case KEY_CTRL_T:      // The rosette up arrow
         case KEY_CTRL_N:      // The mnemonic for North
            command("move north");
#ifdef UI_DEBUG 
            write ("move north\n");
#endif
            cmd_reset();
            doupdate(); 
            break;

         case KEY_CTRL_V:      // The rosette down arrow
         case KEY_CTRL_S:      // The mnemonic for South - some systems choke on this
            command("move south");
#ifdef UI_DEBUG 
            write ("move south\n");
#endif
            cmd_reset();
            doupdate();
            break;

         case KEY_CTRL_G:      // The rosette right arrow  
         case KEY_CTRL_E:      // The mnemonic for East
            command("move east");
#ifdef UI_DEBUG 
            write ("move east\n");
#endif
            cmd_reset();
            doupdate();
            break;

         case KEY_CTRL_F:      // The rosette left arrow 
         case KEY_CTRL_W:      // The mnemonic for West
            command("move west");
#ifdef UI_DEBUG 
            write ("move west\n");
#endif
            cmd_reset();
            doupdate();
            break;

         case KEY_CTRL_U:
            command("move up");
#ifdef UI_DEBUG 
            write ("move up\n");
#endif
            cmd_reset();
            doupdate();  
            break;

         case KEY_CTRL_D:
            command("move down");
#ifdef UI_DEBUG 
            write ("move down\n");
#endif
            cmd_reset();
            doupdate();
            break;

         default:
            if ( isalnum(key[i]) || 
                 ispunct(key[i]) ||
                 isspace(key[i]) )
            {
               said = sprintf("%s%c", said, key[i]);
               if (strlen(said) == 1) activeport(sayport, TRUE);
               printport(sayport, A_NORMAL, "\n" + said + "_");
               portrefresh(sayport);
            }
            break;
      }
      key[i++] = ERR;
   }
   length = 0;
   i = length;
}

void
menu1(string title, string *items)
{
   activeport(menu[0], FALSE);
   portnoutrefresh(menu[0]);
   initmenu(menu[2], "    ", null_list);
   portnoutrefresh(menu[2]);
   initmenu(menu[1], title, items);
   active_gadget = 2;
   activeport(menu[active_gadget-1], TRUE); 
   portnoutrefresh(menu[active_gadget - 1]);
   doupdate();
}

void
menu2(string title, string *items)
{
   activeport(menu[1], FALSE);
   portnoutrefresh(menu[1]);
   initmenu(menu[2], title, items);
   active_gadget = 3;
   activeport(menu[2], TRUE); 
   portnoutrefresh(menu[2]);
   doupdate();
}

// Reset the menus and cmdport after a [RETURN] or a move CTRL-N,S,E,W 
private
void
cmd_reset()
{
   // Clear the cmdport.
   printport(cmdport, A_REVERSE, "\n");
   portnoutrefresh(cmdport);

   // Set menu0 as the active gadget.
   set_preposition(0, "");
   activeport(eventport, FALSE);
   portnoutrefresh(eventport);
   active_gadget = 1;
   activeport(menu[0], TRUE);
   portnoutrefresh(menu[0]);

   // Initialize default menus 1 and 2.
   initmenu(menu[1], "OBJECTS", objects_list(this_object(),
      INANIMATE | DYNAMIC | STATIC | TRANSIENT | INTRANSIENT, AND, 
      INVENTORY | IMMEDIATE) );
   activeport(menu[1], FALSE);
   portnoutrefresh(menu[1]);
   initmenu(menu[2], "PEOPLE", living_list(this_object()));
   activeport(menu[2], FALSE);
   portnoutrefresh(menu[2]);

   cmd[0] = ""; cmd[1] = ""; cmd[2] = "";
}


private
void
say_reset()
{
   printport(sayport, A_NORMAL, "\n");
   activeport(sayport, FALSE);
   portnoutrefresh(sayport);
   said = "";
}

//
//  What happens when you hit enter...
//
private
void
take_action()
{
   // Construct the cmd to be sent to the system.
   systems_cmd = sprintf("%s", cmd[0]);
   if(cmd[1] != "") systems_cmd = sprintf("%s %s", systems_cmd, cmd[1]);
   if(cmd[2] != "") systems_cmd = sprintf("%s %s", systems_cmd, cmd[2]);
   if (said != "")
   {
      if (systems_cmd != "") 
         systems_cmd = sprintf("%s *>[say] %s", systems_cmd, said);
      else systems_cmd = sprintf("*>[say] %s", said);
   }
   // Reset the cmd and say facilities.
   cmd_reset();
   say_reset();
#ifdef UI_DEBUG
   write (systems_cmd + "\n");
#endif 
   command(systems_cmd); 
   systems_cmd= ""; 
}


private
void 
build_users_cmdline()
{
   users_cmd = "";
   if (cmd[0] != "") 
   {
      users_cmd = sprintf("%s", cmd[0]);
      if (prep_position == 1) users_cmd = sprintf("%s %s", users_cmd, prep);
   }
   if (cmd[1] != "") 
   {
      if (prep_position == 2) users_cmd = sprintf("%s %s", users_cmd, prep);
      users_cmd = sprintf("%s %s", users_cmd, cmd[1]);
      if (prep_position == 3) users_cmd = sprintf("%s %s", users_cmd, prep);
   }
   if (cmd[2] != "")
   {
      if (prep_position = 4) users_cmd = sprintf("%s %s", users_cmd, prep);
      users_cmd = sprintf("%s %s", users_cmd, cmd[2]);
   }
   printport(cmdport, A_REVERSE, "\n");
   printport(cmdport, A_REVERSE, users_cmd);
   portnoutrefresh(cmdport);
}

void
scroll_map(object curloc, object dstloc)
{
   int *curloc_coord;
   int *dstloc_coord;
   int x,y;

   if(!curloc || !dstloc) return;
   if((int) curloc->query_object_type() != LOCATION ||
      (int) dstloc->query_object_type() != LOCATION) return;

   curloc_coord = curloc->query_coordinates();
   dstloc_coord = dstloc->query_coordinates();

#ifdef UI_DEBUG
   write("Curloc = " + curloc_name + "\nDstloc = " + dstloc_name + "\n");
#endif
   write("\n"); // Sticky map bug work around...?

   x = ((dstloc_coord[0] - curloc_coord[0]) * MAPBLOCK_WIDTH) +
       ((dstloc_coord[2] - curloc_coord[2]) * MAP_WIDTH/2);
   y = (dstloc_coord[1] - curloc_coord[1]) * MAPBLOCK_HEIGHT;

   scrollport(mapport, y, x);
   portrefresh(mapport);

   return;
}

// We've had a new action added.
void
actions_update()
{
   set_preposition(0,"");
   scrollmenu(menu[active_gadget - 1], -MAX_ENTRIES); // Sroll back to top. 
   if ( initmenu(menu[0], "ACTIONS", actions_list(commands()))  == ERR)
      write_file(ERROR_LOG, "Menu 0 returned ERR, may need to increase MAX_ENTRIES.\n");
   portrefresh(menu[active_gadget - 1]);
}

portptr
query_eventport()
{
   return eventport;
}

void
quit()
{
   printport(eventport, A_NORMAL, "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n");
   clear(); refresh(); doupdate(); wmove(stdscr, 23, 0); // endwin();
}

void
restart()
{
   // This should be inherited and acted upon after living::
   // since it resets the actions menu.
   actions_update();
}

