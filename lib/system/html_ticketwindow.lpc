#include "curses.h"
#include "ticketwindow.h"
#include "html.h"

// Will an embedded Expect command work here? Don't think so, but I'll try.
#define UI_HDR "<TITLE>Ticket Window</TITLE>" \
              + "<body background=\"" + THIS_URL + "book.JPG\" " \
              + "rgb=\"#000000\"  text=\"#000000\" link=\"#00ffff\" " \
              + "vlink=\"#ffff00\"> <BR><BR><BR><CENTER><H2>"

#define UI_FTR "</H2></CENTER>Back to <A HREF=" + THIS_URL \
              + "login.html> login <\A><P></BODY>" 

inherit "/classes/html_args";

void welcome();
void info_menu();
void show_in_progress();

private nosave int    failed_attempts; // Failed login attempt count  
private nosave string name;            // The users name                 
private nosave string user_class;      // The type of user logged in     
private nosave object user_obj;        // The object the caller will be 
                                       // forwarded to.                 
private nosave object new_user;        // Newly created player
private nosave string str;             //
private nosave string buf;             //
private nosave string ch, tmp;         //
private nosave mixed *key;             //
private nosave int i, length, len;     // Initialize only once, instead of 
private nosave int    stage;           // at each call to process_input 
private nosave int    boxoffice;       // The open/closed status of the boxoffice 
private nosave int    html_mode;       // Boolean: Are we in HTML mode? 
private nosave winptr hdrwin, eventwin, ftrwin;
 
// The following d_ (dual) commands mirror Curses commands, but also have
// an HTML form for Web users.
void
d_mvprintw(int y, int x, string str)
{
   if (html_mode) wprintw(eventwin, str);
   else mvprintw(y, x, str);
}

void
d_clear()
{
   if (html_mode) wclear(eventwin); 
   else clear();   
}

void
html_refresh()
{
   // Touch all windows and and send them (refresh).
   touchwin(hdrwin); touchwin(eventwin); touchwin(ftrwin);
   refresh();
}

void
d_refresh()
{
   if (html_mode) html_refresh();
   else refresh();
}


// Print all messages generated outside this object to the Event window
// then have the entire screen updated, HTML style.
void
handle_messages(string message)
{
   wprintw(eventwin, message);
   html_refresh();
}


void
show_clock(int secs_remaining, int y, int x, string text)
{
   int min, sec;
   string clock;

   min = secs_remaining/60;
   sec = secs_remaining - (min * 60);
   clock = text + (min < 10 && min > 0 ? "0" + min: min) + ":" + 
           (sec < 10 && min > 0 ? "0" + sec : sec);

   d_mvprintw(y, x, clock);
   d_refresh();
}

void
clock()
{
   if (boxoffice == CLOSED) 
   {
      // Open window if time, else display time until box_office opens.
      if ((int) (find_object(DIRECTOR_OBJ)->query_accepting_players()) == TRUE)
      {
         boxoffice = OPEN;
         welcome();
      }
      else
      {
         boxoffice = CLOSED;
         show_clock( GAME_LENGTH - (int) (find_object(DIRECTOR_OBJ)->gametime()) + 120,
            CLOSED_CLOCK_Y, CLOSED_CLOCK_X, CLOSED_STR);
      }
   }
   else
   {
      // Close window if time, else display time until show begins.
      if ((int) (find_object(DIRECTOR_OBJ)->query_accepting_players()) == FALSE)
      {
         boxoffice = CLOSED;
         show_in_progress();
      }
      else
      {
         boxoffice = OPEN;
         show_clock( (int) (find_object(DIRECTOR_OBJ)->seconds_until_showtime()),
            OPEN_CLOCK_Y, OPEN_CLOCK_X, OPEN_STR);
      }
   }
//   call_out("clock", CLOCK_UPDATE); // Auto-update the clock every n seconds // disabled
}

void
press_any_key()
{
   d_mvprintw(20, 0,
      "                                                                               ");
   d_mvprintw(21, 0,
      "     < Press any key to continue. >                                           ");
   d_mvprintw(22, 0,
      "                                                                               ");
   while(remove_call_out("clock") != -1); // Make sure there's no others running.
   clock();
}

// Who's in the theatre?
whos_in()
{
   object *player;
   int x, y, z;
   player = players();
   d_clear();
   d_mvprintw(0,0, "Characters currently in the theatre:\n" +
                 "====================================\n");
   for (y = 0, x = 0, z = 0; z < sizeof(player); y++, x++, z++)
   {
      if (x > 2) x = 0;
      d_mvprintw(to_int((y/3) + 0.1) + 3, x * 12, (string) player[z]->query_cap_name());
   }
   press_any_key(); // (includes refresh)
   stage = STG_INFO_MENU;
}

void
password_prompt()
{
   if (html_mode) return;
   d_mvprintw(PASSWORD_PROMPT_Y, 0, 
      "Password:                                                                       ");
   move(PASSWORD_PROMPT_Y, PASSWORD_PROMPT_X);
   d_refresh();
}

// Greet our users, and prompt for login.
void 
ticketholder_prompt()
{
   if (html_mode) return;
   d_mvprintw(TICKETHOLDER_PROMPT_Y, 0, 
      "Ticket Holder:                                    " +
      "                              ");
   // Cleanup the line below in the event we'd had a passwd line before.
   d_mvprintw(PASSWORD_PROMPT_Y, 0, 
      "                                                  " +
      "                             ");   
   move(TICKETHOLDER_PROMPT_Y, TICKETHOLDER_PROMPT_X);
   d_refresh();
}

void
welcome()
{
   d_clear(); 
   cat(INFO_DIR + "welcome");
   while(remove_call_out("clock") != -1); // Make sure there's no others running.
   clock();
   ticketholder_prompt();
   stage = STG_LOGIN;
}

void
show_in_progress()
{
   d_clear(); 
   cat(INFO_DIR + "show_in_progress" + (html_mode ? ".html" : ""));
   stage = STG_CLOSED;
   while(remove_call_out("clock") != -1); // Make sure there's no others running.
   clock(); // handles refresh()
}

//
// After so long of inactivity, or once logged in, destruct this object
// and the user object if loaded in.
//
void
timeout(object *objs)
{
   int x;
   
   if (failed_attempts >= MAX_FAILURES)
   {
      move(TICKETHOLDER_PROMPT_Y - 1, 0);
      effect(INDIV, objs[0], "You seem to be having difficulties.\nPlease contact us at " + 
         RIT_VOICE_PHONE + "\n or " + RIT_EMAIL_ADDRESS + " if they persist.");
      write_file(LOG_DIR+"failed_login.log", 
         "Failed login attempt from " + query_ip_number() + " at " + ctime(time()) + "\n");
   }
   else effect(INDIV, objs[0], "\nInactivity Timeout: ");
   while(remove_call_out("clock") != -1); // Make sure the clock's killed.
   while(remove_call_out("timeout") != -1); // Make sure the timeout's killed.
   delwin(hdrwin); delwin(eventwin); delwin(ftrwin);
   endwin();
   for (x = 0; x < sizeof(objs); x++)
      if (objs[x]) destruct(objs[x]);
}

void 
switch_to_user()
{
   int    res;
   object loc;

   loc = find_object(STARTING_LOCATION);
   if (!loc)
   {
      string err;
      err = catch(call_other(STARTING_LOCATION, "???"));
      if (err)
      { 
         if (TICKETWINDOW_DEBUG)
            write("** Fatal error :" + err + 
              " unable to load starting location: " + STARTING_LOCATION + "\n");
         write_file(ERROR_LOG, "ERROR: " + err + 
              ": logon.c unable to load starting location: " + 
              STARTING_LOCATION + "\n");
         shutdown();
      }
      loc = find_object(STARTING_LOCATION);
   }
   press_any_key();
   if (user_class == GUEST) user_obj->initialize(loc, this_object() );
   else user_obj->initialize(loc, name);
   res = exec(user_obj, this_object());
   user_obj = (object) NULL; // Set this to null, so it too isn't destructed at timeout.
   // Only guests need the ticketwindow.
   if (user_class != GUEST) timeout( (({this_object()})) );
   else while (remove_call_out("timeout") != -1);
   return;
}

void
show_file(string file)
{
   d_clear(); 
   cat(file);
   press_any_key();
}

void 
login_check(string str)
{
   int error;

   if (str == "guest" || str == "Guest") 
      user_class = (html_mode ? HTML_GUEST_OBJ : GUEST_OBJ);
   else if (str == "who" || str == "Who") 
   {
      whos_in();
      return;
   }
   else if (str == "admin" || str == "add")  
      user_class = (html_mode ? HTML_ADMIN_OBJ : ADMIN_OBJ);
   else  user_class = (html_mode ? HTML_PLAYER_OBJ : PLAYER_OBJ);
   
   name = str;
   stage = STG_VERIFY_PASSWD;   
   error = catch(user_obj = clone_object(user_class));
   
   if (TICKETWINDOW_DEBUG)
   { 
      if (!html_mode)
      {
      	 d_mvprintw(TICKETHOLDER_PROMPT_Y-1, 0, 
           "Looking for: " + name + "                                 " ); 
         d_refresh();
      }
      else write_file(ERROR_LOG, "Looking for: " + name + "\n");
   }

   if (error) 
   { 
      if (TICKETWINDOW_DEBUG && !html_mode) 
         d_mvprintw(TICKETHOLDER_PROMPT_Y-1, 0, 
         "** Fatal error #" + error + " at login.                   ");
      write_file(ERROR_LOG, "ERROR# " + error + 
         ": ticketwindow.c unable to clone user object: " + user_class + "\n");
      return;
   }
   else if (user_class == GUEST_OBJ || user_class == HTML_GUEST_OBJ)
   {
      switch_to_user();
      return;
   }
   // Note: In the event of a fail to load the object, the passwords will 
   // obviously never match. So whether it's an invalid ticketholder, 
   // password, or both, they'll get the same message - making it harder 
   // for crackers.
   else if ((int) user_obj->restore(str) != SUCCEED) 
   {
      // So here we just make note of it in debug mode.
      if (TICKETWINDOW_DEBUG) 
         d_mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0,  
         "No records found for that ticketholder.                ");
         
#ifdef BETAMODE
      // Here we are in betamode and there is no admin object, so
      // define it now.
      if (user_class == ADMIN_OBJ)
      {
         d_mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0,  
            "  - Define admin password -                         ");
         stage = STG_SET_PASSWD;
      }
#endif
   }
   password_prompt();
   return;
}

void passwd_check(string str)
{
#ifndef BETAMODE // If not in Betamode, players can only enter between shows.
   if ((user_class = PLAYER_OBJ || user_class = HTML_PLAYER_OBJ) &&
      (int) (find_object(DIRECTOR_OBJ)->query_accepting_players()) == FALSE)
   {
      boxoffice = CLOSED;
      show_in_progress();
   }
   else
#endif
   if ((int) user_obj->verify_password(str) != SUCCEED)
   {
      boxoffice = OPEN;
      destruct(user_obj);
      user_class = PLAYER_OBJ; // Reset to the default.
      stage = STG_LOGIN;
      if (++failed_attempts >= MAX_FAILURES) timeout( (({this_object(), user_obj})) );
      d_mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0,   
         "No such ticketholder with that password.                 ");
      ticketholder_prompt();
   }
   else 
   {
      // Assure this is a unique ticketholder.
      if (name == "add")
      {
         d_mvprintw(TICKETHOLDER_PROMPT_Y-1, 0, " - Add new ticketholder -"); 
         stage = STG_ADD_PLAYER;
         ticketholder_prompt();
         return;
         
      }
      else if (user_class == ADMIN_OBJ) 
      {
         d_mvprintw(23,0,
            "[Sicose Engine V#" + ENGINE_REV + 
            " Carmilla's Kiss Lib#" + LIBRARY_REV + "]");
         d_refresh();
      }
      else
      {
         int i;
         object *p;
         boxoffice = OPEN;
         p = players();
         for (i=0; i < sizeof(p); i++)
         {
            if (p[i]->query_ticketholder() == user_obj->query_ticketholder())
            {
               destruct(user_obj);
               stage = STG_LOGIN;
               if (++failed_attempts >= MAX_FAILURES) timeout( (({this_object(), user_obj})) );
               d_mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0, "Sorry, ticketholder already in theatre.              ");
               ticketholder_prompt();
               return;
            }
         }
     }
     switch_to_user();
     
   }
}

void
passwd_set(string str)
{
   if ((int) new_user->set_password(str) == FAIL)
   {
      d_mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0,  
         " - Invalid password, try another -                                          ");
      password_prompt();
   }
   else
   {
      new_user->quit();
      d_mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0,  
         "Ticketholder created, another?                                                ");
      stage = STG_ADD_PLAYER;
      ticketholder_prompt();
   }
}

void
info_menu()
{
   d_clear();
   cat(INFO_DIR + "info_menu");
   clock(); // Handles refresh
   stage = STG_MENU_SELECT;
}

void
add_player(string new_name)
{
   int    error;
   user_obj->destruct(); // We won't be needing this obj anymore.
    
   error = catch(new_user = clone_object(PLAYER_OBJ));
   if (error) 
   { 
      if (TICKETWINDOW_DEBUG) 
         d_mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0,  
         "** Fatal error #" + error + " at login.                               \n");
      write_file(ERROR_LOG, "ERROR# " + error + 
         ": logon.c unable to clone user object: " + user_class + "\n");
      return;
   }
   if ((int) new_user->restore(new_name) == SUCCEED)
   {

      d_mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0,  
         "* ERROR * Ticketholder already exists!                                         ");
      ticketholder_prompt();
      return;
   }
   new_user->initialize(this_object(), new_name);
   d_mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0,  
      "Now define users initial password.                                      ");
   password_prompt();
   stage = STG_SET_PASSWD;
}

// This is for simultaneously handeling WWW'ers with the current Telnet'ers
html_mode(mapping var)
{
   string value;
   if (! undefinedp(value = var["username"])) 
      login_check(var["username"]);
   if (! undefinedp(value = var["password"])) 
      passwd_check(var["password"]);
}

//
// This gets called every player input round
// so make sure we return as soon as possible
// so as not to slow everybody else down.
// 
void 
process_input()
{
   // Get MAX_CHAR_INPUT chars accumulated thus far.
   while((key[length++] = getch()) != ERR && 
          length < MAX_CHAR_INPUT &&
          key[length] != EOF);

   // Are we getting (or did we already get) the secret code for HTML access?
   if ((key[0] == KEY_CTRL_A && !html_mode) || html_mode)
   {
   	  html_mode = TRUE; 
      if (key[length] == EOF) // IS this all the data?
      {
         length = 0;
         wprintw(eventwin, key); wrefresh(eventwin);
         html_mode(process_html_args(key, ({}) ));
      }
      return;
   }   
   
   while ( i < length && key[i] != ERR)     // Now process them.
   {
      ch = sprintf("%c", (int) key[i]);
      switch (stage)
      {
         case STG_CLOSED :
            if (key[i] == '^') welcome();  // A backdoor for getting a login prompt.
            else if (key[i] == '?') info_menu();
            i = length; // Don't bother w/ the rest of the keys.  
            buf = "";
            break;
         case STG_LOGIN :   // Gather the name after solicitation by logon() 
            len = strlen(buf);
            if (len == 1)   // If there was an error message, clear it.
            {
               d_mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0,   
                  "                                                                       ");
               move(TICKETHOLDER_PROMPT_Y, TICKETHOLDER_PROMPT_X + 1);
               d_refresh();
            }
            if (key[i] == KEY_RETURN) 
            {
               if(len == 0) break;
               d_mvprintw(TICKETHOLDER_PROMPT_Y+1,0, " ");
               d_refresh();
               login_check(buf); // And check it.
               i = length; // Don't bother w/ the rest of the keys.
               buf = "";
            }
            else if (key[i] == KEY_CTRL_D) 
            {
               // Okay, we've decided not to login, so quit. 
               i = length; // Don't bother w/ the rest of the keys.
               timeout( ({this_object()}) );
               break;
            }
            else if (key[i] == '?')
            {
               i = length; // Don't bother w/ the rest of the keys.
               buf = "";
               info_menu();
               break;
            }
            else if (key[i] == KEY_BACKSPACE || key[i] == KEY_DC) 
            {
               if (len == 1) buf = "";
               else if (len > 1) buf = extract(buf, 0, len - 2);
               d_mvprintw(TICKETHOLDER_PROMPT_Y, TICKETHOLDER_PROMPT_X,
                  "                                                                     ");
               mvprintw(TICKETHOLDER_PROMPT_Y, TICKETHOLDER_PROMPT_X, "%s", buf);
               d_refresh();
            }
            else if (isalnum(key[i]) && len < 32)
            {
               buf = buf + ch;
               mvprintw(TICKETHOLDER_PROMPT_Y, TICKETHOLDER_PROMPT_X + len,"%s", ch);
               d_refresh();
            }
            break;

         case STG_VERIFY_PASSWD : /* Gather password after solicited by login_check */
            len = strlen(buf);
            if (key[i] == KEY_RETURN) 
            {
               if (len < 1) break;
               passwd_check(buf);
               buf = "";
            }
            else if (key[i] == KEY_CTRL_D) 
            {
               // Okay, we've decided not to login this ticketholder. 
               i = length; // Don't bother w/ the rest of the keys.
               buf = "";
               welcome();
               break;
            }
            else if (key[i] == KEY_BACKSPACE || key[i] == KEY_DC) 
            {
               d_mvprintw(PASSWORD_PROMPT_Y, PASSWORD_PROMPT_X, 
                  "                                                     " + 
                  "                ");
               if (len < 2) 
               {
                  buf = "";
                  move(PASSWORD_PROMPT_Y, PASSWORD_PROMPT_X);
               }
               else if (len > 1) 
               {
                  buf = extract(buf, 0, len - 2);
                  d_mvprintw(PASSWORD_PROMPT_Y, PASSWORD_PROMPT_X, 
                  extract("_________________________________________" + 
                  "_____________________________________________________", 0, len - 2));
               }
               d_refresh();
            }
            else if (isalnum(key[i]) || ispunct(key[i]))
            {
               buf = buf + ch;
               d_mvprintw(PASSWORD_PROMPT_Y, PASSWORD_PROMPT_X + len,"_");
               d_refresh();
            }
            break;

         case STG_ADD_PLAYER :
            len = strlen(buf);
            if (key[i] == KEY_RETURN) 
            {
               if (len < 1) break;
               add_player(buf);
               buf = "";
            }
            else if (key[i] == KEY_CTRL_D) 
            {
               // Okay, we've decided not to add a player, so quit. 
               i = length; // Don't bother w/ the rest of the keys.
               timeout( ({this_object()}) );
               break;
            }
            else if (key[i] == KEY_BACKSPACE || key[i] == KEY_DC) 
            {
               if (len == 1) buf = "";
               else if (len > 1) buf = extract(buf, 0, len - 2);
               d_mvprintw(TICKETHOLDER_PROMPT_Y, TICKETHOLDER_PROMPT_X,
                  "                                                                     ");
               mvprintw(TICKETHOLDER_PROMPT_Y, TICKETHOLDER_PROMPT_X, "%s", buf);
               d_refresh();
            }
            else if (isalnum(key[i]) && len < 32)
            {
               buf = buf + ch;
               mvprintw(TICKETHOLDER_PROMPT_Y, TICKETHOLDER_PROMPT_X + len,"%s", ch);
               d_refresh();
            }
            break;
         case STG_SET_PASSWD : // For defining an initial password.
            len = strlen(buf);
            if (key[i] == KEY_RETURN) 
            {
               if(len < 1) break;
               passwd_set(buf);
               buf = "";
            }
            else if (key[i] == KEY_CTRL_D) 
            {
               // Okay, we've decided not to add this player, so prepare to 
               // try again.
               i = length; // Don't bother w/ the rest of the keys.
               buf = "";
               stage = STG_ADD_PLAYER;
               new_user->destruct(); 
               d_mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0,  
                  "Ticketholder Canceled! Another?                                                ");
               ticketholder_prompt();
               break;
            }
            else if (key[i] == KEY_BACKSPACE || key[i] == KEY_DC) 
            {
               d_mvprintw(PASSWORD_PROMPT_Y, PASSWORD_PROMPT_X, 
                  "                                                     " + 
                  "                ");
               if (len < 2) 
               {
                  buf = "";
                  move(PASSWORD_PROMPT_Y, PASSWORD_PROMPT_X);
               }
               else if (len > 1) 
               {
                  buf = extract(buf, 0, len - 2);
                  d_mvprintw(PASSWORD_PROMPT_Y, PASSWORD_PROMPT_X, 
                  extract("_________________________________________" + 
                  "_____________________________________________________", 0, len - 2));
               }
               d_refresh();
            }
            else if (isalnum(key[i]) || ispunct(key[i]))
            {
               buf = buf + ch;
               d_mvprintw(PASSWORD_PROMPT_Y, PASSWORD_PROMPT_X + len,"_");
               d_refresh();
            }
            break;

         case STG_INFO_MENU :
            i = length; // Don't bother w/ the rest of the keys.
            info_menu();
            break;

         case STG_MENU_SELECT :
            i = length; // Don't bother w/ the rest of the keys.
            switch(key[0])
            {
                case '1': // What is RIT?
                   show_file(INFO_DIR + "whatis_RIT");
                   stage = STG_INFO_MENU;
                   break;
                case '2': // System requirements
                   show_file(INFO_DIR + "system_requirements");
                   press_any_key();
                   stage = STG_INFO_MENU;
                   break;
                case '3': // Login a guest user.
                   show_file(INFO_DIR + "guest_message");
                   login_check("guest");
                   break;
                case '4': // Whatsit cost?
                   show_file(INFO_DIR + "whatsit_cost");
                   press_any_key();
                   stage = STG_INFO_MENU;
                   break;
                case '5': // Payment_Methods?
                   show_file(INFO_DIR + "payment_methods1");
                   press_any_key();
                   stage = STG_MORE_PAYMENT_METHODS;
                   break;
                case '6': // Becoming a ticketholder
                   show_file(INFO_DIR + "getan_acct");
                   press_any_key();
                   stage = STG_INFO_MENU;
                   break;

                case '7': // Who's in?
                   whos_in();
                   break;

               case '9': // Go back to the ticket window
                 if ((int) (find_object(DIRECTOR_OBJ)->query_accepting_players()) == TRUE)
                 {
                    boxoffice = OPEN;
                    welcome();
                 }
                 else 
                 {
                    boxoffice = CLOSED;
                    show_in_progress();
                 }
                 break; 
            }
            break;

      case STG_MORE_PAYMENT_METHODS:
            i = length; // Don't bother w/ the rest of the keys.
            show_file(INFO_DIR + "payment_methods2");
            press_any_key();
            stage = STG_INFO_MENU;
            break;
         
      } // End stage switch.
      i++;
   }
   if (length > 1) // If there was activity, reset the timeout.
   {
      while (remove_call_out("timeout") != -1);
      call_out("timeout", TIMEOUT_TIME, ( ({this_object(), user_obj}) ) ); 
   }
   i = length = 0; // Set these for next time in.
   return;
}


//
// logon() is automatically called by the engine. 
// Set term basics and prompt the user for login.
//
int 
logon() 
{
   /* Initialize the terminal */
   raw();             /* Key@a-time, w/out interrupt, quit, control-flow */
   noecho();          /* We'll handle the echo, thanks. */
   scrollok(stdscr, FALSE); /* No scrolling */

   user_class = PLAYER_OBJ; /* The default user_class */
   ch = buf = "";
   i = length = 0;
   key = allocate(MAX_TEXT);

   hdrwin   = newwin(5, 80, 0, 0);
   eventwin = newwin(15, 32, 5, 0);
   ftrwin   = newwin(4, 80, 20, 0);

   if ((  hdrwin == (winptr) NULL) ||
       (eventwin == (winptr) NULL) ||
       (  ftrwin == (winptr) NULL) )
   {
      write_file(ERROR_LOG, "html_ticketwindow.c: Error, unable to open a window.\n");
      delwin(hdrwin); delwin(eventwin); delwin(ftrwin);
      endwin();
      timeout( ({this_object(), user_obj}) );
   }

   // Setup the HTML screen 
   // First set-up the multi-part x-replace and define page
   wprintw(hdrwin, HEADER + CTSTR + UI_HDR);
   
   // Now set-up the end of the page.
   wprintw(ftrwin,  UI_FTR + BOUNDARYSTR);

   if ((int) (find_object(DIRECTOR_OBJ)->query_accepting_players()) == TRUE)
   {
      boxoffice = OPEN;
      welcome();
   }
   else
   {
      boxoffice = CLOSED;
      show_in_progress();
   }
   call_out("timeout", TIMEOUT_TIME,  ( ({this_object(), user_obj}) ) ); // Drop line after TIMEOUT_TIME.
   return TRUE;
}

