/* Routine to convert from Ansi Mouse Output to Curses Altcharset chars */

#include <stdio.h>

void
main()
{
   int x;

   do
   {
      switch(x)
      {
         case  95:    /* Underscore to Scanline 9 */
            x = 115;
            break;
         case 179:
            x = 120;
            break;
         case 180:
            x = 117;
            break;
         case 191:    /* Upper Right Hand Corner */
            x = 107;
            break;
         case 192:
            x = 109;
            break;
         case 193:
            x = 118;
            break;
         case 194:
            x = 119;
            break;
         case 195:
            x = 116;
            break;
         case 196:
            x = 113;
            break;
         case 197:
            x = 110;
            break;
         case 217:
            x = 106;
            break;
         case 218:
            x = 108;
            break;
         case 255:    /* Upper Right Hand Corner */
            x = 107;
            break;
      }
      if (putchar(x) == EOF) exit(-1);
   }
   while((x = getchar()) != EOF);
}

