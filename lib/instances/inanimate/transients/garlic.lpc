#include <std_defs.h>

inherit "/classes/inanimate/transients/inanm_trns_vr";

void 
create()
{
   inanm_trns_vr::create();

   set_id        ( ({"garlic"}) );
   set_short        ("bulb of garlic");
   set_long         ("It's thin, brittle, white skin grasps its cloves tightly.");
   set_flammability (NONE);
   set_burn_duration(0);

   set_weight       (1);
   set_height       (4);
   set_width        (3);
   set_depth        (3);
   set_form         (SOLID);
   set_rigidity     (RIGID);
   set_vamp_repellant(0.6);
}

string
query_long()
{
   set_id( ({"holy-water"}) );
   set_short("vial of holy water" );
   return (inanm_trns_vr::query_long());
}

