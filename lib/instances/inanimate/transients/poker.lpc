#include <std_defs.h>

inherit "/classes/inanimate/transients/inanm_trns";

void 
create()
{
   inanm_trns::create();

   set_id        ( ({"poker"}) );
   set_short        ("poker");
   set_long         ("A fire poker, handled, hooked and pointed. It's " +
                     "quite long, apparently a necessity for large " +
                     "fireplaces.");
   set_flammability (NONE);
   set_burn_duration(0);

   set_weight       (10);
   set_height       (100);
   set_width        (6);
   set_depth        (11);
   set_form         (SOLID);
   set_rigidity     (RIGID);
}

string*
use(object tp, object recipient)
{
   if (!recipient) return (inanm_trns::use(tp, recipient));
   if ((string) recipient->query_short() == "fire" ||
       ((string) recipient->query_short() == "fireplace" &&             
                 locally_present("fire")) )
      return ( ({
         ", rearranging the burning logs.",
         ", rearranging the burning logs.",
         ", rearranging the burning logs.",
         "use",
         "in"}) );

   else return (inanm_trns::use(tp, recipient));
}

