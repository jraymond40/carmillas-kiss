#include <std_defs.h>

inherit "/classes/inanimate/transients/inanm_trns";

void 
create()
{
   inanm_trns::create();

   set_id        ( ({"fireiron"}) );
   set_short        ("fireiron");
   set_long         ("A straight piece of iron, obviously for stoking the fire.");
   set_flammability (NONE);
   set_burn_duration(0);
   set_weight       (10);
   set_height       (100);
   set_width        (6);
   set_depth        (6);
   set_form         (SOLID);
   set_rigidity     (RIGID);
}


string*
use(object tp, object recipient)
{
   if (!recipient) return (inanm_trns::use(tp, recipient));
   if ((string) recipient->query_short() == "fire" ||
       ((string) recipient->query_short() == "fireplace" &&             
                 locally_present("fire")) )
      return ( ({
         ", sending sparks and flames up the chimney.",
         ", sending sparks and flames up the chimney.",
         ", sending sparks and flames up the chimney.",
         "stab",
         "into"}) );

   else return (inanm_trns::use(tp, recipient));
}
