#include <std_defs.h>
#include <config.h>

//            This should match w/ below  ________  
//                                       V        V
inherit "/classes/inanimate/transients/inanm_trns_container";

void 
create()
{
//  ________  This should match the inherit filename above.
// V        V
   inanm_trns_container::create();

   set_id        ( ({"mortar"}) );  // How Sicose find this item.
   set_short        ("brass mortar");     // This items name.
   set_long         ("A large antique brass mortar, with a short stem " +
                     "and heavy base, decorated with the signs of the zodiac."); // It's full description.
   set_flammability (NONE);            // NONE | LOW | MEDIUM | HIGH
   set_burn_duration(0);            // Sec. Time in seconds it will burn.
   set_weight       (5);             // Kg.  Objects weight.
   set_height       (30);            // cm.  These are looked at to see if the 
   set_width        (25);             // cm.  potential object to be contained
   set_depth        (25);             // cm.  will fit within.
   set_form         (SOLID);          // GAS | LIQUID | SOLID
   set_rigidity     (RIGID);          // RIGID | LIMP
   set_dynamacy     (STATIC);         // Is it usable in some way? 

// Necessary for holders, containers, and vessels:
// (must append '_holder', '_container', '_vessel' to inherit string above.)
//
   set_liquid_tight (TRUE);     	// Won't hold liquids
   set_max_bearable (INFINITE); 	// Strong enough to hold whatever

   // How is the item held on/in this holder?   
   set_manner_held  ("inside");  
   set_transient_list  ( ({"pestle"}) ); // Transients held here.


// Necessary for containers and vessel:
// (must append '_container' or '_vessel' to inherit string above).
//
   set_closable     (FALSE); 		// Can it be closed/opened?
}
