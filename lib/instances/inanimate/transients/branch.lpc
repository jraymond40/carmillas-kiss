#include <std_defs.h>
#define  TORCH_DURATION 120

inherit "/classes/inanimate/transients/inanm_trns_vr";


void 
create()
{
   inanm_trns_vr::create();

   set_id        ( ({"branch"}) );
   set_short        ("branch");
   set_long         ("A branch the diameter of an oar handle, " + 
                     "a meter long and made of oak.");
   set_flammability (LOW);
   set_burn_duration(30);
   set_weight       (8);
   set_height       (100);
   set_width        (9);
   set_depth        (9);
   set_form         (SOLID);
   set_rigidity     (RIGID);
   set_vamp_repellant(0.0);
}

/*
// Overload the use_recipient function defined in inanimate.c
*/
string* use_recipient(object user, object recipient)
{
   string *reaction;

   reaction = allocate(5);
   reaction = inanm_trns_vr::use(user, recipient);

   if (query_flammability() == HIGH && query_burn_duration()>= TORCH_DURATION)
   {
      set_id( ({"torch"}) );
      set_short("torch");
      set_vamp_repellant(0.20);
   
      if (reaction)
      {
         reaction[0] = reaction[0] + " You've just created a torch."; 
         reaction[1] = reaction[1] + user->query_possessive() + " just created a torch.";
      }
      else
      {
         reaction[0] = ". You've just created a torch."; 
         reaction[1] = ". " + user->query_possessive() + " just created a torch.";
      }
   }

   return reaction;
}
