#include <commons.h>
#include <std_defs.h>

inherit "/classes/inanimate/transients/cutlery";

void 
create()
{
   cutlery::create();

   set_id ( ({"fork"}) );
   set_short ("fork");
   set_long  ("While certainly not a new utensil, it is apparently new " +
      "to the chateau, being made of stainless steel.");
}
