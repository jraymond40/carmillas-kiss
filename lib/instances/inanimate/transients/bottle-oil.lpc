#include <std_defs.h>

inherit "/classes/inanimate/transients/inanm_trns_vessel";

void 
create()
{
   inanm_trns_vessel::create();

   set_id        ( ({"bottle"}) );
   set_short        ("lamp oil bottle");
   set_long         ("An old, square bottle, made of thick glass. You " +
                     "can still make out the words \"Lamp Oil\" on " +
                     "it's stained and scuffed label.");

   set_flammability (NONE);
   set_burn_duration(0);
   set_weight       (1);
   set_height       (8);
   set_width        (4);
   set_depth        (4);
   set_rigidity     (RIGID);
   set_transient_list ( ({"oil-lamp"}) );
}

