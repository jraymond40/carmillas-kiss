#include <std_defs.h>

inherit "/classes/inanimate/transients/inanm_trns";
inherit "/classes/cloth";

void 
create()
{
   inanm_trns::create();
   cloth::create();

   set_id(         ({"rag"}) );
   set_short        ("rag");
   set_long         ("An old rag, yellowed, and stained.");
   set_flammability (LOW);
   set_burn_duration(300);
   set_weight       (1);
   set_height       (30);
   set_width        (30);
   set_depth        (1);
}
