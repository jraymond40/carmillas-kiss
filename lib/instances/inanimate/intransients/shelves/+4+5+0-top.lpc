#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns_holder";

void
create()
{
   inanm_intrns_holder::create();

   set_id        ( ({"shelf,top"}) );
   set_short        ("top shelf");
   set_long         ("The top shelf of the hutch is slightly above eye level.  " +
                     "A slight nick mars the fine scrollwork along its edge.");
   set_flammability (LOW);
   set_burn_duration(500);
   set_weight       (INFINITE); /* Rather pointless since it's immoveable */
   set_height       (50);
   set_width        (120);
   set_depth        (50);
   set_form         (SOLID);
   set_rigidity     (RIGID);
   set_liquid_tight (FALSE);    /* Won't hold water */
   set_max_bearable (INFINITE); /* But it's strong enough to hold whatever */
   set_manner_held  ("perched on the top shelf.");
}
