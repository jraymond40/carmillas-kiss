#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/door";

void
create()
{
   door::create();
   set_id( ({"door,oak"}) );

   set_long         (
      "Made from of varnished oak, the door provides access to the " + 
      "southern section of the armoury.");

   set_lock("armory south door key");
   lock();
}
