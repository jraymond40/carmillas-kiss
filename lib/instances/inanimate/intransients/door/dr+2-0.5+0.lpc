#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/door";

void
create()
{
   door::create();

   set_id        ( ({"doors"}) );	// How sicose finds this item.
   set_short        ("doors");	// The full description of this item.
   set_long         (
      "Intricately woven wraught iron bars reinforce oak planks of the " +
      "door. They appear as if they would have safely shielded the " +
      "chateaus inhabitants from unwanted 'guests', and look as though " +
      "they may have, a time or two.");	// The in-depth description.
   set_flammability (NONE);		//       NONE | LOW | MEDIUM | HIGH
   set_burn_duration(0);  		// Sec. Burn duration in seconds 
   set_weight       (300);		// Kg.  (although, it is intransient)
   set_height       (300);		// cm.    
   set_width        (300);		// cm.   
   set_depth        (20);		// cm.   
 
   // These doors are locked, only a master key should open them.
   set_lock("There is no key, you can't leave the chateau, bwhaa ha!");
   lock();
   set_aggregate(TRUE); // There's more than one object here.
}
