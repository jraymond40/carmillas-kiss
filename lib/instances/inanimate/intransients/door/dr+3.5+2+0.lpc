#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/door";

void
create()
{
   door::create();

   set_id( ({"door,oak"}) );

   set_long         (
      "Nicely varnished, the oak door provides access to and from the " + 
      "library, and matches nicely with the ballroom floors.");
}
