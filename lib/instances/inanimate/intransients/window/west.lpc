#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/window";

void
create()
{
   window::create();

   set_long("Through the aged panes of the window, you are barely able " + 
      "to make out the little town of Karnstein below. Small plumes of " + 
      "smoke curl from the chimneys, yet oddly little light can be seen " + 
      "from the town. There appears to be no activity, and all the " + 
      "shutters are closed up tight");
}
