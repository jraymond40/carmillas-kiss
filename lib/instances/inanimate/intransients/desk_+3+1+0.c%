   set_weight       (150);		// Kg.  (although, it is intransient)
   set_height       (100);		// cm.    
   set_width        (80);		// cm.   
   set_depth        (250);		// cm.   
   set_form         (SOLID);		// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);		// RIGID | FLEXIBLE
   set_manner_held  ("layed out across the desk");
//   set_intransient_list( ({"bell-service"}) );
