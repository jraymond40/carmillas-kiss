   set_id        ( ({"desk"}) );	// How sicose finds this item.
   set_short        ("writing desk");	// The full description of this item.
   set_long         (
     "This cherrywood antique must have seen Paracelsus himself " +
     "working at it. It's obviously been highly regarded over the " + 
     "years, as it's been well preserved.");

   set_flammability (LOW);		// NONE | LOW | MEDIUM | HIGH
