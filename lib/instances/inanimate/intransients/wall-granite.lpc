#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns";

void
create()
{
   inanm_intrns::create();

   set_id        ( ({"wall"}) );	// How sicose finds this item.
   set_short        ("wall");	// The name of this item.
   // The in-depth description.
   set_long         (
      "Running your finger along the wall, you ponder the great amount " +
      "of work that must have gone into carefully forming and stacking " +
      "the thousands of blocks of granite that form these walls.");	
   set_flammability (NONE);		//       NONE | LOW | MEDIUM | HIGH
   set_burn_duration(0);  		// Sec. Burn duration in seconds 
   set_weight       (INFINITE);		// Kg.  (although, it is intransient)
   set_height       (1000);		// cm.    
   set_width        (1000);		// cm.   
   set_depth        (1000);		// cm.   
   set_form         (SOLID);		// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);		// RIGID | FLEXIBLE
}
