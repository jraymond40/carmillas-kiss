#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns";

void
create()
{
   inanm_intrns::create();

   set_id        ( ({"pillars"}) );	// How sicose finds this item.
   set_short        ("pillars");	// The full description of this item.
   set_long         ("Carved from granite, the pillars here form the " +
                     "bases to the arches overhead."); 

   set_flammability (NONE);		//       NONE | LOW | MEDIUM | HIGH
   set_burn_duration(0);  		// Sec. Burn duration in seconds 
   set_weight       (1000);		// Kg.  (although, it is intransient)
   set_height       (600);		// cm.    
   set_width        (100);		// cm.   
   set_depth        (100);		// cm.   
   set_form         (SOLID);		// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);		// RIGID | FLEXIBLE
}
