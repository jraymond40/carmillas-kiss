#include <config.h>
#include <std_defs.h>
#define  FIREPLACE_OPEN_TIME  10
#define  FIREPLACE_STATE_STR  "turned inwards slightly, revealing a passage behind"

inherit "/classes/inanimate/intransients/inanm_intrns";

private void open_fireplace();
private void close_fireplace();

private nosave object Upper_FP, Lower_FP, Stairwell_base, Stairwell_top, 
                      SF_NE_Corner, MF_NE_Corner;

private nosave int state = CLOSED;

void
create()
{
   inanm_intrns::create();

   set_id        ( ({"dragon's_mouth"}) );
   set_short        ("dragon's mouth");
   set_long         ("It's dark, and slightly smaller than your fist.");
   set_flammability (NONE);
   set_burn_duration(0);
   set_form         (SOLID);
   set_rigidity     (RIGID);
}

string *use_recipient(object user, object agent)
{
   string agent_name;

   agent_name = specific_obj(agent);

   if (agent->query_width() >= 10 || agent->query_depth() >= 10)
   {
       return ({", but the mouth is too narrow.",
                ", but the mouth is too narrow.",
                ", but the mouth is too narrow.",
                "stick",
                "into", 0});
   }
   else if  ((int) agent->query_rigidity() != RIGID)
   {
       return ({
          ", but " + agent_name + " flops around within the mouth, making it" + 
          " impossible to feed down the dragons throat.",
          ", but " + agent_name + " flops around within the mouth, making it" + 
          " impossible to feed down the dragons throat.",
          ", but " + agent_name + " flops around within the mouth, making it" + 
          " impossible to feed down the dragons throat.",
                "stick",
                "into", 0});
   }
   else if (agent->query_height()> 80 && state == CLOSED)
   {
      open_fireplace();

      call_out("close_fireplace", FIREPLACE_OPEN_TIME);

      return ({". Suddenly, you hear a gravelly scraping sound as the " + 
                "fireplace begins to turn inwards, revealing a passageway " + 
                "to the north.",
                ". Suddenly, you hear a gravelly scraping sound as the " + 
                "fireplace begins to turn inwards, revealing a passageway " + 
                "to the north.",
                ". Suddenly, you hear a gravelly scraping sound as the " + 
                "fireplace begins to turn inwards, revealing a passageway " + 
                "to the north.",
                "stick",
                "into", 0});
   }
   else        return ({0, 0, 0, "stick", "into", 0});
}

void
open_fireplace()
{
  if (!Stairwell_base) Stairwell_base = find_object(LOCATION_DIR + "loc+4-1+0");
  if (!Stairwell_top) Stairwell_top  = find_object(LOCATION_DIR + "loc+4-1+1");
  if (!MF_NE_Corner) MF_NE_Corner = find_object(LOCATION_DIR + "loc+4+0+0"); 
  if (!SF_NE_Corner) SF_NE_Corner = find_object(LOCATION_DIR + "loc+4+0+1"); 
  if (!Lower_FP)
     Lower_FP = find_object(INTRANSIENT_OBJ_DIR + "fireplace/gothic"); 
  if (!Upper_FP)
     Upper_FP = find_object(INTRANSIENT_OBJ_DIR + "fireplace/large"); 

   MF_NE_Corner->set_adjacent_locations(
              ({"loc+4-1+0", "loc+4+1+0", "loc+3+0+0"}),
              ({"north",     "south",     "west"}),
              ({"",          "",          ""}) );

   SF_NE_Corner->set_adjacent_locations(
              ({"loc+4-1+1", "loc+4+1+1", "loc+3+0+1"}),
              ({"north",     "south",     "west"}),
              ({"",          "",          ""}) );

   Stairwell_base->set_adjacent_locations(
              ({"loc+4+0+0", "loc+4-1+1"}),
              ({"south",     "up"      }),
              ({"",          ""}) );

   Stairwell_top->set_adjacent_locations(
              ({"loc+4+0+1", "loc+4-1+0"}),
              ({"south",     "down"}),
              ({"",          ""}) );


   Stairwell_base->add_light(); // Light from the fireplace.
   Stairwell_top->add_light();  // Light from the fireplace.

   Upper_FP->add_delta_adjective(FIREPLACE_STATE_STR);
   Lower_FP->add_delta_adjective(FIREPLACE_STATE_STR);

   effect(LOCAL, SF_NE_Corner,
          "Suddenly, you hear a gravelly scraping sound as the " + 
          "fireplace begins to turn inwards, revealing a passageway " + 
          "to the north.",
          "Suddenly, you hear a gravelly scraping sound as the " + 
          "fireplace begins to turn inwards, revealing a passageway " + 
          "to the north.",
          "Suddenly, you hear a gravelly scraping sound as the " + 
          "fireplace begins to turn inwards, revealing a passageway " + 
          "to the north.");

   effect(LOCAL, Stairwell_base,
          "Suddenly, you hear a gravelly scraping sound as the " + 
          "fireplace begins to turn inwards, revealing a passageway " + 
          "to the south.",
          "Suddenly, you hear a gravelly scraping sound as the " + 
          "fireplace begins to turn inwards, revealing a passageway " + 
          "to the south.",
          "Suddenly, you hear a gravelly scraping sound as the " + 
          "fireplace begins to turn inwards, revealing a passageway " + 
          "to the south.");

   effect(LOCAL, Stairwell_top,
          "Suddenly, you hear a gravelly scraping sound as the " + 
          "fireplace begins to turn inwards, revealing a passageway " + 
          "to the south.",
          "Suddenly, you hear a gravelly scraping sound as the " + 
          "fireplace begins to turn inwards, revealing a passageway " + 
          "to the south.",
          "Suddenly, you hear a gravelly scraping sound as the " + 
          "fireplace begins to turn inwards, revealing a passageway " + 
          "to the south.");
}

void
close_fireplace()
{
   MF_NE_Corner->set_adjacent_locations(
              ({"loc+4+1+0", "loc+3+0+0"}),
              ({"south",     "west"}),
              ({"",          ""}) );

   SF_NE_Corner->set_adjacent_locations(
              ({"loc+4+1+1", "loc+3+0+1"}),
              ({"south",      "west"}),
              ({"",          ""}) );

   Stairwell_base->set_adjacent_locations(
                                     ({"loc+4-1+1"}),
                                     ({"up"}),
                                     ({"" }) );

   Stairwell_top->set_adjacent_locations(
                                     ({"loc+4-1+0"}),
                                     ({"down"}),
                                     ({"" }) );


   Stairwell_base->remove_light(); // No more light from the fireplace.
   Stairwell_top->remove_light();  // No more light from the fireplace.

   Lower_FP->remove_delta_adjective(FIREPLACE_STATE_STR);
   Upper_FP->remove_delta_adjective(FIREPLACE_STATE_STR);

   effect(LOCAL, MF_NE_Corner,
      "A loud scraping sound fills the room, as the fireplace draws closed.",
      "A loud scraping sound fills the room, as the fireplace draws closed.",
      "A loud scraping sound fills the room, as the fireplace draws closed.");

   effect(LOCAL, SF_NE_Corner,
      "A loud scraping sound fills the room, as the fireplace draws closed.",
      "A loud scraping sound fills the room, as the fireplace draws closed.",
      "A loud scraping sound fills the room, as the fireplace draws closed.");

   effect(LOCAL, Stairwell_base,
      "A loud scraping sound fills the room, as the fireplace draws closed. " + 
      "It's suddenly very dark in here.",
      "A loud scraping sound fills the room, as the fireplace draws closed. " + 
      "It's suddenly very dark in here.",
      "A loud scraping sound fills the room, as the fireplace draws closed. " + 
      "It's suddenly very dark in here.");

   effect(LOCAL, Stairwell_top,
      "A loud scraping sound fills the room, as the fireplace draws closed. " + 
      "It's suddenly very dark in here.",
      "A loud scraping sound fills the room, as the fireplace draws closed. " + 
      "It's suddenly very dark in here.",
      "A loud scraping sound fills the room, as the fireplace draws closed. " + 
      "It's suddenly very dark in here.");
}
