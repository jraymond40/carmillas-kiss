#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns";

void
create()
{
   inanm_intrns::create();

   set_id        ( ({"tower"}) );	// How sicose finds this item.
   set_short        ("tower");	// The name of this item.
   // The in-depth description.
   set_long         (
      "The Von Hohenheim tower is one of the four towers you recall " +
      "seeing on the perimeter of the chateau when you arrived.");	
   set_flammability (NONE);		// NONE | LOW | MEDIUM | HIGH
   set_burn_duration(0);  		// Sec. Burn duration in seconds 
   set_weight       (INFINITE);		// Kg.  (although, it is intransient)
   set_height       (2500);		// cm.    
   set_width        (1000);		// cm.   
   set_depth        (1000);		// cm.   
   set_form         (SOLID);		// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);		// RIGID | FLEXIBLE
}
