#include <std_defs.h>

inherit "/classes/inanimate/intransients/inanm_intrns";
inherit "/classes/cloth";

void 
create()
{
   inanm_intrns::create();
   cloth::create();
   set_id(         ({"tapestry"}) );
   set_short        ("tapestry");
   set_long         ("The silk of the tapestry forms a great black " +
                     "dragon, wings spread, fangs bared, upon a field " +
                     "of crimson. It resembles the art typically found "+
                     "in coats-of-arms of the 15th century.");
   set_flammability (LOW);
   set_burn_duration(300);
   set_weight       (30);
   set_height       (150);
   set_width        (200);
   set_depth        (1);
}
