#include <std_defs.h>
#include <config.h>

#define EFFECT_STR "cold"
#define EFFECT_DURATION 120

// Note: Should one day make into a container.

inherit "classes/closable";
inherit "/classes/inanimate/intransients/appliance";

void
restart()
{
   closable::restart();
   appliance::restart();
   turn_on();
}

void
create()
{
   appliance::create();
   set_id( ({"refrigerator"}) );// How sicose finds this item.
   set_short("refrigerator");   // The name of this item.
   set_long ("A single door, white refrigerator. A few `Calvin and Hobbes' " + 
       "cartoons have been cut-out and taped to the door.");	

   set_weight(100);		// Kg.  (although, it is intransient)
   set_height(200);		// cm.    
   set_width (80);		// cm.   
   set_depth (80);		// cm.
   set_manner_held("on the shelves");
   set_closable(TRUE);
   turn_on();
}
