#include <std_defs.h>
#include <config.h>

#define EFFECT_STR "hot"
#define EFFECT_DURATION 120

// Note: Should one day make into a container.

inherit "classes/closable";
inherit "/classes/inanimate/intransients/appliance";

void
restart()
{
   closable::restart();
   appliance::restart();
}

void
create()
{
   appliance::create();
   set_id( ({"oven"}) );// How sicose finds this item.
   set_short("oven");   // The name of this item.
   set_long ("It resides beneath the stove.");	

   set_weight(100);		// Kg.  (although, it is intransient)
   set_height(200);		// cm.    
   set_width (80);		// cm.   
   set_depth (80);		// cm.
   set_manner_held("on the rack");
   set_closable(TRUE);
}
