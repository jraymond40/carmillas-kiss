#include <std_defs.h>
#include <config.h>

#define EFFECT_STR "hot"
#define EFFECT_DURATION 120

inherit "/classes/inanimate/intransients/appliance";

void
create()
{
   appliance::create();
   set_id( ({"stove"}) );	// How sicose finds this item.
   set_short("stove");	        // The name of this item.
   set_long ("It appears to be a gas range.");	

   set_weight(50);		// Kg.  (although, it is intransient)
   set_height(100);		// cm.    
   set_width (75);		// cm.   
   set_depth (75);		// cm.`
   set_manner_held("on the burner");
}
