#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns_holder";

void
create()
{
   inanm_intrns_holder::create();

   set_id        ( ({"hearth"}) );
   set_short        ("hearth");
   set_long         ("The hearths charred surface has been well worn over the years.");
   set_flammability (NONE);
   set_burn_duration(0);
   set_weight       (INFINITE); /* Rather pointless since it's immoveable */
   set_height       (50);
   set_width        (600);
   set_depth        (600);
   set_form         (SOLID);
   set_rigidity     (RIGID);
   set_liquid_tight (FALSE);    /* Won't hold water */
   set_max_bearable (INFINITE); /* But it's strong enough to hold whatever */
   set_manner_held  ("scattered across it's granite surface");
   set_intransient_list( ({"firewood"}) );
   set_transient_list  ( ({"branch","branch","poker", "fireiron"}) );
}
