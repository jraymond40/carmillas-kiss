#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/book_intrns";

void
create()
{
   book_intrns::create();

   set_id        ( ({"magazine,`Chateaux'"}) );	// How sicose finds this item.
   set_short        ("magazine titled `Better Chateaux and Vineyards'"); // The name of this item.

   // The in-depth description.
   set_long         ("Flipping through the pictures, you see a variety " + 
      "of chateaux throughout Europe, all looking rather elegant. You also " + 
      "flip past a few recipes.");	
}
