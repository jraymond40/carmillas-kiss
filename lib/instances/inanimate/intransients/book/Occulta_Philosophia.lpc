#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/book_intrns";

void
create()
{
   book_intrns::create();

   set_id        ( ({"book,`Occulta'"}) );	// How sicose finds this item.
   set_short        ("book, 'De Occulta Philosophia'"); // The name of this item.

   // The in-depth description.
   set_long         ("Scanning through the book, a particular phase " + 
                     "stays with you after closing the book, you find " +
                     "yourself mumbling under your breath, \"Magic is " + 
                     "a great secret wisdom, just as reason is a great " + 
                     "public folly.\"");	
}
