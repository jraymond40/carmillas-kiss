#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/book_intrns";

void
create()
{
   book_intrns::create();

   set_id        ( ({"book,`II-Voivoda'"}) );	// How sicose finds this item.
   set_short        ("book entitled 'Voivoda Dracula, vol. II'"); // The name of this item.

   // The in-depth description.
   set_long ("'The Voivode, upon hearing the French diplomats refuse to " +
      "remove their hats to him, had them impaled on large stakes outside " + 
      "the castle walls, and proceeded to _nail_ their hats to their heads. " +
      "The Voivode then began a tradition he would follow for the rest of " +
      "his career, that of draining the blood from his victims, and using it " +
      "as both an alcholic mixer, as well as to bathe in, apparently a " + 
      "recipe for immortality passed on through the Order.'");
}
