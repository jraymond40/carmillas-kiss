#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/book_intrns";

void
create()
{
   book_intrns::create();

   set_id        ( ({"book,`I-Voivoda'"}) );	// How sicose finds this item.
   set_short        ("book entitled 'Voivoda Dracula, vol. I'"); // The name of this item.

   // The in-depth description.
   set_long ("Apparently written in the 16th century by Rumanian Mihai " + 
      "Sadovianu, this is the first of a three volume set outlining " +
      "the life of the Voivode of Vallachia. Indecipherable scrawlings are " + 
      "made throughout the margins of the book. Commonly refered to as 'The " +
      "Dragon', for the black velvet outfit which was adorned front and back " +
      "with a crimson dragon, he was a member of the secret Order of the " + 
      "Dragon (or 'Dracula', in Hungarian).");	
}
