#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/book_intrns";

void
create()
{
   book_intrns::create();

   set_id        ( ({"book,`Entwurfe'"}) );// How sicose finds this item.
   set_short        ("book, 'Entwurfe und vorlaufige Auserbeitungen zur Syphilis'"); // The name of this item.

   // The in-depth description.
   set_long         ("Written by Paracelsus, the book outlines his remedy " + 
                     "for the previously uncurable disease of syphilis, " + 
                     "based upon the use of mercury.");	
}
