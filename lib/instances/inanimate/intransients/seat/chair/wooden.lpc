#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/chair";

void
create()
{
   chair::create();

   set_short ("wooden chair");
   set_long  ("Well worn by use, the cherrywood chair looks comfortable.");
}

use(object tp, object recipient)
{
   if (!recipient)
      return ( ({
         ", and rest for a minute.",
         ", resting for a moment.",
         ", resting for a moment.",
         "sit",
         0,
         "in"}));
   else return (chair::use(tp, recipient));
}
