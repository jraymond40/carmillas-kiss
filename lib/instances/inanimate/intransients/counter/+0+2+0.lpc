#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/counter";

void
create()
{
   counter::create();

   set_transient_list(({"flask/uroscopy", "dish/bowl/bloodletting"}));
   set_intransient_list(({"book/Grosse_Wundartzney"}));
}
