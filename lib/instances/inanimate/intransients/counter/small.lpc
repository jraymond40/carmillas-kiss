#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/counter";

void
create()
{
   counter::create();

   set_short ("small counter");	// The full description of this item.
   set_long ("Two holes in the counter suggest some piece of equipment " + 
             "used to be mounted here.");

   set_weight(80);		// Kg.  (although, it is intransient)
   set_depth (140);		// cm.   (length).
}
