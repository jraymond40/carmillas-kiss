#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("northern hallway entrance");
   set_long (
      "A well worn, squeaky, wood covers the floor here at the northern " + 
      "hall. A sign on the wall points west for rooms 1-6 and east for " + 
      "rooms 7-13, while to the north exits the guest area.");

   set_adjacent_locations(({"loc+2+1+1", "loc+3+2+1", "loc+1+2+1"}),
                          ({"north",     "east",      "west" }),
                          ({"",          "",          ""}) );
}
