#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("southwestern dining hall");
   set_long ("In the southwestern dining hall, a hanging candelabra " + 
             "illuminates the dining table.");

   set_adjacent_locations(
      ({ "loc+1+4+0",   "loc+2+5+0"}),
      ({ "north",       "east"}),
      ({ "",            ""}) );

   set_intransient_list( 
      ({"candelabra/hanging-small", "table/dining"}) );
}
