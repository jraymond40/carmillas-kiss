#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("ballroom fireplace");
   set_long (
      "Here before the ballroom fireplace, you gaze at it's white marble " + 
      "masonry and realize that you can see another room through the " + 
      "mouth of the fireplace . A Coat-of-Arms hangs " + 
      "above the mantle, and is lit by the overhead candelabra.");

   set_adjacent_locations(
      ({ "loc+2+2+0", "loc+3+3+0", "loc+1+3+0"}),
      ({ "north",     "east",      "west"}),
      ({ "",          "",          "" }) );

   set_intransient_list( 
      ({"candelabra/hanging-large", "floor/parquet", "fireplace/white", 
        "picture/Coat-of-Arms/Hapsburg"}) );
}
