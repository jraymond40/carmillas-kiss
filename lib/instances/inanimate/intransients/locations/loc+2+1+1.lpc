#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("guest hall entryway");
   set_long (
      "A hallway heads south, while eastward, you note a door that " +
      "is slightly ajar. To the west lie the galleries. " +
      "Covering nearly the entire northern wall hangs a portrait, " +
      "labeled 'Mircalla, Countess Karnstein'.");

   set_adjacent_locations(({"loc+2+2+1", "loc+3+1+1", "loc+1+1+1"}),
                          ({"south",     "east",      "west" }),
                          ({"",          "",          ""}) );

   set_intransient_list( ({"picture/Carmilla"}) );

   set_npc_list( ({"Oma", "Junior", "Grandfeathers"}) );
}
