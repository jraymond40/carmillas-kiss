#include "/std_defs.h"
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("master suite's southeast corner");
   set_long(
      "Here in the in the southeast corner of the master suite, sits" + 
      " a nightstand, along the edge of the great canopied bed." + 
      " Another window is set into the eastern wall, but it too is" +
      " boarded over.");

   set_adjacent_locations(({"loc+4+0+1"}),
                          ({ "north" }),
                          ({ "" }) );

   set_intransient_list(
       ({"bed/master", "bureau/nightstand", "window/boarded2"}) );
}
