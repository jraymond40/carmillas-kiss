#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("galleries northeastern wing");
   set_long (
      "You find yourself standing in the northeastern wing of the " +
      "gallery. A solitary antique painting hangs upon wall, " +
      "apparently the work of a child.");

   set_adjacent_locations(({ "loc+1+1+1", "loc+0+0+1" }),
                          ({ "south",     "west"}),
                          ({ "",          ""}) );
   set_intransient_list( ({"picture/Els_Ochsner"}) );
}
