#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("fireplace of the dining hall");
   set_long (
      "A black marble fireplace fills the northern wall here, overhung by " + 
      "the Karnstein Coat-Of-Arms. The dining table would provide for an " + 
      "enormous banquet, seating nearly twenty.");

   set_adjacent_locations(
      ({ "loc+3+4+0",  "loc+1+4+0" }),
      ({ "east",       "west" }),
      ({ "",           "" }) );

   set_intransient_list( ({"table/dining", "seat/chair/mahogany", 
      "fireplace/black", "picture/Coat-of-Arms/Karnstein"}) );
}
