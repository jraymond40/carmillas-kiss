#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("Room #1");
   set_long (
      "A bit on the small side, but adequate for the task. A bed sits " +  
      "beneath a pair of windows, a chair sits against the southern wall " + 
      "and in the corner is a small bureau.");

   set_adjacent_locations(
      ({ "loc+1+2+1"}),
      ({ "east"}),
      ({ "dr+0.5+2+1"}) );

   set_intransient_list( 
      ({"seat/chair/wooden", "bed/full-white", "bureau/guests", "window/west"}) );
}
