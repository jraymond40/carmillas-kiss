#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("library's northern end");
   set_long (
      "Here in the northern section of the library, the walls are " +
      "lined with old, leather bound tomes. Volume after volume, shelf " + 
      "after shelf, filling the walls and the center of the room, " + 
      "there literally is no space left to place another book.");

   set_adjacent_locations(({ "loc+4+0+0", "loc+4+2+0", "loc+3+1+0"}),
                          ({ "north",     "south",     "west" }),
                          ({ "",          "",          ""}) );

   set_intransient_list( ({"shelves/+4+1+0"}) );
}
