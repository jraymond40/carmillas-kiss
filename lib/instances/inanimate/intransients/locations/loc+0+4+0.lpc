#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("kitchen's food preparation area");
   set_long (
      "In this section of the kitchen the food is prepared for cooking " + 
      "upon the counters here, the dishes washed in the sink, and " + 
      "stored in the cupboards.");

   set_adjacent_locations(
      ({ "loc+0+5+0", "loc+1+4+0"}),
      ({ "south",     "east"}),
      ({ "",          "dr+0.5+4+0"}) );

   set_intransient_list( ({"counter/kitchen", "cupboard"}) );
}
