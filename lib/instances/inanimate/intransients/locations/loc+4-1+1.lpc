#include <std_defs.h>
#include <config.h>

#define FIREPLACE_OPEN_TIME 8 // Better act quick...

inherit "/classes/inanimate/intransients/locations/location";

public
void 
create()
{   
   location::create();

   set_short("top of the hidden stairwell");
   set_long("You find yourself in the top of the stairwell behind " +
            "the fireplace. Cobwebs and dust fill the stagnate air " + 
            "here. A set of narrow, and very steep stairs lead " + 
            "downward into darkness.");

   set_adjacent_locations(({ "loc+4-1+0"}),
                          ({ "down"}),
                          ({ "" }) );

   set_light(-1);
}
 
public
void
init()
{
   find_object(INTRANSIENT_OBJ_DIR + "dragons_mouth")->open_fireplace();
   call_out("close_fireplace", FIREPLACE_OPEN_TIME);
}

public
void
close_fireplace()
{
   find_object(INTRANSIENT_OBJ_DIR + "dragons_mouth")->close_fireplace();
}
