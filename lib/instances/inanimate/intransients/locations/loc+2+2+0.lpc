#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("ballroom entrance");
   set_long (
      "The main entrance to the spacious ballroom provides a glimpse of " + 
      "the splendour the chateau once enjoyed. A huge candelabra hangs from " +
      "the ceiling from the center of the ballroom, while four smaller " + 
      "candelabrum fill each corner of the room. A parkay wood floor has " + 
      "recently been refinished and waxed. To the north lie the main " + 
      "entrance doors.");

   set_adjacent_locations(
      ({ "loc+2+1+0", "loc+2+3+0", "loc+3+2+0", "loc+1+2+0"}),
      ({ "north",     "south",     "east",      "west"}),
      ({ "dr+2+1.5+0","",          "",          ""}) );

   set_intransient_list( 
      ({"candelabra/hanging-large", "floor/parquet"}) );
}
