#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("ballroom's south eastern corner");
   set_long (
      "In the southeastern corner of the ballroom, a door to the south " + 
      "allows access to the dinning room, while another door resides in the " +
      "western wall.");

   set_adjacent_locations(
      ({ "loc+3+2+0",  "loc+3+4+0",  "loc+4+3+0",  "loc+2+3+0"}),
      ({ "north",      "south",      "east",       "west"}),
      ({ "",           "dr+3+3.5+0", "dr+3.5+3+0", ""}) );

   set_intransient_list( 
      ({"candelabra/hanging-small", "floor/parquet"}) );
}
