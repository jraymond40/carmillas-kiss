#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("hall outside Room #6");
   set_long (
      "In the southern end of the hall, room #6 is to the west, while " +
      "a set of stairs and more rooms are east of here. A sign on the " + 
      "wall points north to rooms 1-5.");

   set_adjacent_locations(
      ({ "loc+1+5+1", "loc+2+6+1",  "loc+0+6+1"}),
      ({ "north",     "east",       "west"}),
      ({ "",          "",           "dr+0.5+6+1"}) );
}
