#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("hall outside Room #5");
   set_long ("You stand in the hall outside Room #5.");

   set_adjacent_locations(
      ({"loc+1+4+1", "loc+1+6+1", "loc+0+5+1"}),
      ({"north",     "south",     "west"}),
      ({"",          "",          "dr+0.5+5+1"}) );
}
