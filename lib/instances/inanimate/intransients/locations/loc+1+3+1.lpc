#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("hall outside Room #2");
   set_long ("You're in the hall outside Room #2.");

   set_adjacent_locations(
      ({ "loc+1+2+1", "loc+1+4+1", "loc+0+3+1"}),
      ({ "north",     "south",     "west"}),
      ({ "",          "",          "dr+0.5+3+1"}) );
}
