#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("hall outside Room #1");
   set_long (
      "You're in the hall. To the west is room number 1, and to the " + 
      "east is the main entry to the hall. A sign points south for " + 
      "rooms 2-6 and east for rooms 7-13.");

   set_adjacent_locations(
      ({ "loc+1+3+1", "loc+2+2+1",  "loc+0+2+1"}),
      ({ "south",     "east",       "west"}),
      ({ "",          "",           "dr+0.5+2+1"}) );
}
