inherit "/classes/inanimate/intransients/locations/stages/stage";

void 
create()
{   
   stage::create();

   set_short("Stage 1");
   set_long ("Stage 1, now playing Carmilla's Kiss.");

   set_locations_list(({ 
      "loc+0+0+0", "loc+1+0+0", "loc+2+0+0", "loc+3+0+0", "loc+4+0+0",
      "loc+0+0+1", "loc+1+0+1", "loc+2+0+1", "loc+3+0+1", "loc+4+0+1",
      "loc+0+1+1", "loc+1+1+1", "loc+2+1+1", "loc+3+1+1", "loc+4+1+1"
   }));
}
