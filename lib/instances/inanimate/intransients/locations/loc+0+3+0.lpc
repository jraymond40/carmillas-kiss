#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("apotheca");
   set_long (
      "Here in the apotheca is where remedies and medicines were " + 
      "made, and their ingredients stored. Rows of various dusty, " + 
      "cobwebbed canisters and books fill the shelves. Several odd " + 
      "looking contraptions sit upon the counter here, and an oven " + 
      "sits along the southern wall, with a chair beside it.");

   set_adjacent_locations(({ "loc+0+2+0"}),
                          ({ "north"}),
                          ({ "" }) );

   set_intransient_list( ({"shelves/+0+3+0", "athanor", 
       "counter/+0+3+0", "seat/chair/wooden"}) );
}
