#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/locations/location";

void 
create()
{   
   location::create();

   set_short("Room #2");
   set_long (
      "A bed and a small wooden chair sit along the northern wall, while " + 
      "a bureau is along the southern wall. A pair of windows provide a " +  
      "view of the village below.");

   set_adjacent_locations(
      ({ "loc+1+3+1"}),
      ({ "east"}),
      ({ "dr+0.5+3+1"}) );

   set_intransient_list( 
      ({"seat/chair/wooden", "bed/full-flowered", "bureau/guests", "window/west"}) );
}
