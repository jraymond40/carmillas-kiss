#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns_holder";

void
create()
{
   inanm_intrns_holder::create();

   set_id        ( ({"mantle"}) );
   set_short        ("mantle");
   set_long         (
      "The mantles intricate sculpture seems to dance in the flickering " +
      "light of the flames and you begin to recognize gothic faces form " +
      "the pattern over the mantle, including one of a particularly " +
      "hideous dragon.\n");

   set_flammability (NONE);
   set_burn_duration(0);
   set_weight       (6000);   /* Rather pointless since it's immoveable */
   set_height       (600);
   set_width        (600);
   set_depth        (600);
   set_form         (SOLID);
   set_rigidity     (RIGID);
}
