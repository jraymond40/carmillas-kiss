#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/picture";

void
create()
{
   picture::create();

   set_id        ( ({"poster"}) );// How sicose finds this item.
   set_short        ("poster");	// The name of this item.

   // The in-depth description.
   set_long         (
      "The poster shows a character, bullet riddled and deeply scarred, " + 
      "looking almost as if crucified. It's titled `The Crow' and signed " + 
      "` J. O`Barr '.");
}
