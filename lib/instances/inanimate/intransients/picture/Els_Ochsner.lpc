#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/picture";

void
create()
{
   picture::create();

   set_id        ( ({"painting"}) );	// How sicose finds this item.
   set_short        ("painting");	// The name of this item.

   // The in-depth description.
   set_long         (
      "The painting of a peasant woman standing barefoot in a pond, as " +
      "the noonday sun is being eclipsed by a storm cloud, catches " +
      "your eye. Leaning closer, you notice the golden engraved " +
      "nameplate beneath. 'Els Ochner von Hohenheim' it reads, while " +
      "the signature reads 'Phillipus'.");
}
