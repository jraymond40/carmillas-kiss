#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/picture";

void
create()
{
   picture::create();

   set_id        ( ({"portrait"}) );	// How sicose finds this item.
   set_short        ("portrait");	// The name of this item.

   // The in-depth description.
   set_long         (
      "It's labeled: ALTERIVS NON SIT.QVU SVVS ESSE POTEST. at the top "
      "of the engravened image, and it shows a man in his forties, " +
      "balding, and apparently a doctor by his dress. His intense gaze " +
      "seems to reflect great intelligence. The bottom of the image is " +
      "labeled: AVREOLI THEOPHRASTIAB HOHENHAIM, EFFIGIES SVAE AETATIS 45");
}
