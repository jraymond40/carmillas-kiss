#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/floor";

void
create()
{
   floor::create();

   set_long         (
      "The white marble tiles are interspersed with an occasional tile " + 
      "engraved with a dot within a circle within a square, the alchemical " +
      "symbol `aurum foliatum`.");
}
