#include <std_defs.h>
#include <config.h>

//            This should match w/ below  __________  
//                                       V          V
inherit "/classes/inanimate/intransients/inanm_intrns";

void
create()
{

//  __________   This should match the inherit filename above.
// V          V
   inanm_intrns::create();

   set_id        ( ({"TEMPLATE"}) );	// How sicose finds this item.
   set_short        ("TEMPLATE");	// The name of this item.

   // The in-depth description.
   set_long         ("DESCRIPTION.");	

   set_flammability (LOW);		// NONE | LOW | MEDIUM | HIGH
   set_burn_duration(600);  		// Sec. Burn duration in seconds 
   set_weight       (40);		// Kg.  (although, it is intransient)
   set_height       (100);		// cm.    
   set_width        (60);		// cm.   
   set_depth        (60);		// cm.   
   set_form         (SOLID);		// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);		// RIGID | FLEXIBLE
   set_dynamacy     (DYNAMIC);          // Is it usable in some way? 

// Necessary for holders, containers, and vessels:
// (must append '_holder','_container', or '_vessel' to inherit string above)
//
   set_liquid_tight (FALSE);    	// Won't hold liquids
   set_max_bearable (INFINITE); 	// Strong enough to hold whatever

   // How is the item held on this holder?   
   set_manner_held  ("scattered across it's granite surface");  
   set_intransient_list( ({"item"}) );	// Intransients held here.
   set_transient_list  ( ({"item"}) );	// Transients held here.


// Necessary for containers and vessels:
// (must append '_container' or '_vessel' at end of inherit string above).
//
   set_closable     (TRUE); 		// Can it be closed/opened?   
}
