#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns_holder";

void
create()
{
   inanm_intrns_holder::create();

   set_id        ( ({"vase"}) );	// How sicose finds this item.
   set_short        ("glass vase");	// The name of this item.

   // The in-depth description.
   set_long("It's a rather small and unimpressive glass vase, yet someone " + 
      "has affixed it to the surface of the bureau as a theft deterent."); 

   set_flammability (NONE);		// NONE | LOW | MEDIUM | HIGH
   set_burn_duration(0);  		// Sec. Burn duration in seconds 
   set_weight       (1);		// Kg.  (although, it is intransient)
   set_height       (25);		// cm.    
   set_width        (12);		// cm.   
   set_depth        (12);		// cm.   
   set_form         (SOLID);		// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);		// RIGID | FLEXIBLE
   set_dynamacy     (STATIC);           // Is it usable in some way? 
   set_transient_list( ({"wolfs-bane"}) );
}
