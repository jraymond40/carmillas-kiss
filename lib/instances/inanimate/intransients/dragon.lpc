#include <std_defs.h>

inherit "/classes/inanimate/intransients/inanm_intrns";

void
create()
{
   inanm_intrns::create();

   set_id        ( ({"dragon", "hole"}) );
   set_short        ("dragon");
   set_long         (
      "Wild eyed and nostrils flared, you notice a gaping hole " +
      "behind the fangs bared.");
   set_flammability (NONE);
   set_burn_duration(0);
   set_form         (SOLID);
   set_rigidity     (RIGID);
}

