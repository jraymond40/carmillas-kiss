#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/table";

void
create()
{
   table::create();

   set_short ("dining table");	// The name of this item.
   set_long ("The table is immaculate, almost as if it's never " + 
      "been used. Carved from the richest mahagony, it's perimeter is " + 
      "adorned with a wide variety of figures, from the lion and ram " + 
      "headed, to the hooded and horned.");	

   set_height       (500);		// cm.    
   set_width        (2500);		// cm.   
   set_depth        (5000);		// cm.   
   set_manner_held  ("on the table");  
}

use(object tp, object recipient)
{
   if (!recipient)
      return ( ({
         ".",
         ".",
         ".",
         "pull",
         0,
         "up to"}));
   else return (table::use(tp, recipient));
}

