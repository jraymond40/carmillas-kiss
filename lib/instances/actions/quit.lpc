#include <config.h>
#include <std_defs.h>
#include <english.h>

inherit "/classes/living/actions";

//
// User has selected this cmd and possibly said something,
// here`s how to respond.
//
int
selected_cmd0(object tp, string said)
{
   if (said!="") tp->say(said);
   effect(LOCAL, tp,
        " QUIT aborted, use the right arrow -> to put the" +
        " 'Yes, quit' confirmation onto the `DO:` line.\n");
   return SUCCEED;
}

//
// When this cmd is selected, should I set up menu1, and if so, how?
//
int
setup_menu1(object tp)
{
   tp->set_preposition(1, "?");
   tp->menu1("Really?", ({"Yes, quit.", "No, don't."}) );
   return SUCCEED;
}

//
// Here`s where we attempt to take this action
//
int
action_main(string str, string *prefix_strs, int present_tense_form)
{
   string tmp;
    
   if (sscanf(str, "Yes, %s", tmp) > 0)
      this_player()->quit();
   return SUCCEED;
}
 
