#include <std_defs.h>
#include <english.h>

inherit "/classes/living/actions";

//
// User selected cmd0 and possibly said something.
//
int
selected_cmd0(object tp, string said)
{
   // Say users lines (if there), but tell them they haven't told us where
   // to go.
   if (said!="") tp->say(said);
   effect(LOCAL, tp,
        " You didn't move because you need to use the right" +
        " arrow -> to put the direction you'd like to move in, onto the" +
        " `DO:` line.\n");
   return SUCCEED;
}

//
// Upon selecting 'move' show the list of available directions
//
int
setup_menu1(object tp)
{
   // Handle the expressions menu.
   tp->menu1("DIRECTIONS", environment(tp)->query_possible_directions() );
   return SUCCEED;
}
   
//
// Move
// We have our own selection parse just so we can do nothing with what was said,
// except pass it off to player->say().
//
int
selection_parse(string str, object tp)
{
   string *action;
   string  actions, said;
   int     num_cmds, num_actions;

   // Merely cmd0 has been selected.
   if (!str) return selected_cmd0(tp, "");

   // Cmd0 and something said.
   else if (sscanf(str, "*>[say] %s", said) > 0) return selected_cmd0(tp, said);

   if (!valid_action(this_player())) return FAIL; 
   num_cmds = sscanf(str, "%s *>[say] %s", actions, said);
   if(!actions) actions = str;
   action = explode(actions, " ");
   num_actions = sizeof(action);
   if (said) tp->say(said);

   if (num_actions == 1)
   {
      if (action[0] == "*>[menu1]") return (setup_menu1(tp));

      // There appears to be a bug in the engine. When I get 4 objects 
      // deep in calls, garbage can be returned, so I'm breaking out the 
      // function here.
      else
      {
         object dest, door;
         dest = environment(tp)->query_destination(action[0]);
         door = environment(tp)->query_door(action[0]);
         if (!dest) return FAIL;
         if (door)
         {
            if (door->query_closed())
            {
               notify_fail("   The " + door->query_short() + " in that direction " +
                  forms_of_Be(THIRD_PERSON, PRESENT, door->query_aggregate() + 1) + 
                  " closed.\n");
               return FAIL;
            }
         }
         tp->move(dest, action[0]);

         return SUCCEED;
      }
   }
   else return setup_menu2(tp, str);
}

