#include <config.h>
#include <std_defs.h>
#include <english.h>
#include <commons.h>

inherit "/classes/living/actions";

#define BITERS_SATED_LENGTH 90

//
// User has selected this cmd and possibly said something,
// here`s how to respond.
//
int
selected_cmd0(object tp, string said)
{
   // Default action is:
   // Say users lines (if there), but tell them they haven't told us 
   // what to act on.
   string verb;
   verb = query_verb();

   if (said!="") tp->say(said);
   effect(LOCAL, tp,
        " Your attempts to '" + verb + 
        "' failed because you need to use the right arrow -> to put the" +
        " name of the object you'd like to " + verb + 
        " onto the `DO:` line.\n");
   return SUCCEED;
}

//
// When this cmd is selected, should I set up menu1, and if so, how?
//
int
setup_menu1(object tp)
{
   // Default action is:
   // Set up menu 1 to show the living around us.
   tp->menu1("WHOM?", living_list(tp) );
   return SUCCEED;
}

//
// User has selected this cmd and an option out of menu1,
// should I setup menu2 and if so, how?
//
int
setup_menu2(object tp, string direct_obj_name)
{
   // Default action is:
   // There is no menu2, just update the screen.
   tp->doupdate();
   return SUCCEED;
}

//
// Here`s where we attempt to take this action
//
int
action_main(string name, string *prefix_strs, int present_tense_form)
{
   int    bites;     /* Total number of bites returned from director */
   object victim;
   object vampire;

   vampire = this_player();

   if (! valid_action(vampire)) return FAIL;

   if (!name)
   {
      notify_fail("Bite what?\n");
      return FAIL;
   }
   if (!(victim = find_living(lower_case(name))) )
   {
      notify_fail("Bite who?\n");
      return FAIL;
   }
   if ((int) victim->query_human_type() == GUEST )
   {
      notify_fail((string) victim->query_long());
      return FAIL;
   }
   if (environment(vampire) != environment(victim))
   {
      write(victim->query_cap_name() + " is no longer here.\n");
      return SUCCEED; /* Succeeded in perceiving users cmd */
   }
   if ((int) vampire->query_role() != VAMPIRE)
   {
      effect(LOCAL, vampire,
             "Without gulping from the Yliastrum, you merely slobber on " + (string) victim->query_cap_name() +
              ".\n", 
              "For some odd reason, " + (string) vampire->query_cap_name() +
              " attempts to bite " + (string) victim->query_cap_name() + ", " +
              "but only succeeds in drooling on " + (string) victim->query_objective() + ".\n",
              victim,
              "Oddly enough, " + (string) vampire->query_cap_name() + " attempts to bite " +
              "you, but you brush " + (string) vampire->query_objective() + 
              " off, frowning at the drool left on your hand.\n");
      return SUCCEED;
   }
   if ((int) victim->query_role() == WITHDRAW || (int) victim->query_human_type() == NPC)
   {
      effect(LOCAL, vampire,
             "Since you're not entirely a vampire, your prey must have partaken "+
             "in the elixir. " + (string) victim->query_cap_name() + " has not, and " + 
             "easily avoids falling victim to your controlling stare.\n", 
              "A very strange look just overcame " + (string) vampire->query_cap_name() +
              "'s face.\n",
             "You can't be certain, but it appeared as if " + (string) vampire->query_cap_name() + 
             " was looking at you rather oddly.\n");
      return SUCCEED;
   }
   if (! (int) vampire->query_bite_enabled())
   {
       effect(INDIV, vampire,
              "Your recent attack leaves you completely sated, and unable to feast again just yet. You must wait.");
      return SUCCEED;
   }
   else // Let's do it.
   {
      int i, max_last_bitten, energy_xfer;
      object *player;
      player = players();

      // Find the max last bitten time.
      for (i=0; i < sizeof(player); i++)
         if ( ((int) player[i]->last_bitten() > max_last_bitten) &&
           ((int) player[i]->query_role() != WITHDRAW) )
            max_last_bitten = (int) player[i]->last_bitten();

      energy_xfer = ((int) victim->last_bitten())/max_last_bitten * MAX_BITERS_REWARD;

      find_object(DIRECTOR_OBJ)->bite_occurred(victim);
      victim->bitten(victim);
      energy_xfer = victim->add_energy(-energy_xfer, victim);
      vampire->add_energy(-energy_xfer, vampire);
      vampire->set_bite_enabled(FALSE);
      call_out("unsatiate", BITERS_SATED_LENGTH, vampire);

      return SUCCEED;
   }
}

void
unsatiate(object vampire)
{
   vampire->set_bite_enabled(TRUE);
   effect(INDIV, vampire, "Your blood satiation has subsided.\n");
}
