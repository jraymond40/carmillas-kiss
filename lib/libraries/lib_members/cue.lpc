#include <std_defs.h>
#include <config.h>


int cue(string str)
{
   string *word;
   string name;
   string cue;
   string extra_data;
   object npc;

   int ii;

   if (str == "") return FAIL;
   else 
   {
      word = explode( str, " ");
      extra_data = "";

      if (sizeof(word) < 2) return FAIL;
      else 
      {
         name = lower_case(word[0]);
         cue  = capitalize(word[1]);

         for (ii = 2; ii < sizeof(word); ii++)
         {
            if (word[ii] != "") extra_data = extra_data + word[ii];
         }
         if ( (npc = find_living(name)) == 0) 
         {
            notify_fail("Attempted to find " + name + " but got " + npc->query_name() + ".\n");
            return FAIL;
         }
         else
         {
            tell_object( npc, "*>[" + cue + "] \n" + extra_data);
            return SUCCEED;
         }
      }
   }
}
