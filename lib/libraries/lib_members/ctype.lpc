// It would appear that LPC doesn't recognize complex macros,
// so these are functionized for now...
// Note: LPC doesn't recognize octal... so these number that are 
// historically defined in octal, aren't here.
#include <std_defs.h>

int
isupper(int c)
{
   if (c>64 && c<91) 
      return TRUE;
   else return FALSE;
}

int
islower(int c)
{
   if (c>96 && c<123) 
      return TRUE;
   else return FALSE;
}

int
isalpha(int c)      
{
   if (isupper(c) || islower(c)) 
      return TRUE;
    else return FALSE;
}

int
isdigit(int c)
{
   if (c>47 && c<58)
      return TRUE;
   else return FALSE;
}

int
isxdigit(int c)
{
   if ((c>47 && c<58) || (c>64 && c<71) || (c>96 && c<103))
      return TRUE;
   else return FALSE;
}

int
isspace(int c)
{
   if (c==32 || c==9)
      return TRUE;
   else return FALSE; /* Incomplete? */
}

int
ispunct(int c)
{
   if ((c>32 && c<48) || (c>57 && c<65) || (c>90 && c<97) || (c>122 && c<127))
      return TRUE;
   else return FALSE;
}

int
isalnum(int c)
{
   if (isalpha(c) || isdigit(c)) 
      return TRUE;
   else return FALSE;
}


/*  TBD
isprint(c)      ((_ctype_+1)[c]&(_P|_U|_L|_N|_B))
isgraph(c)      ((_ctype_+1)[c]&(_P|_U|_L|_N))
iscntrl(c)      ((_ctype_+1)[c]&_C)
*/

int
isascii(int c)
{
   return (c<=127 ? TRUE : FALSE);
}

int
toascii(int c)
{
   return ((c)&127);
}
