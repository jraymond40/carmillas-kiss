#include <std_defs.h>

void 
create()
{
   this_object()->set_form     (SOLID);
   this_object()->set_rigidity (LIMP);
}

/*
// Redefine use function defined in inanimate.c
//
// Affordances of cloth that are supported:
//
// - Wrap it about any object of small enough diameter 
//   (to make a torch, etc.)
// - Otherwise use on a person to wipe away blood, sweat, etc.
// - Use it to dust off INTRANSIENT objects
*/
string* use(object user, object recipient)
{
   object agent;
   string *action;
   int    tmp;

   action   = allocate(6);

   agent = this_object();

   /*
   // For intransient objects, we'll dust them.
   */
   if ((int)recipient->query_transiency() == INTRANSIENT)
   {
      switch (random(3))
      {
         case 0:
            action[0] = ", brushing dust away.";
            action[1] = ", brushing dust away.";
            action[2] = ", brushing dust away.";
            action[3] = "sweep";
            action[4] = "over";
            break;
         case 1:
            action[0] = ", sending dust particles into the air.";
            action[1] = ", sending dust particles into the air.";
            action[2] = ", sending dust particles into the air.";
            action[3] = "wipe";
            action[4] = "across";
            break;
         case 2:
            action[0] = ", cleaning it up.";
            action[1] = ", cleaning it up.";
            action[2] = ", cleaning it up.";
            action[3] = "use";
            action[4] = "to dust";
            break;
      }
   }
   /*
   // Can we wrap the cloth around the object? 
   // If so, transfer some of it's attributes to the recipient.
   */
   else if ( ( ((int) recipient->query_width() * 2) + ((int) 
             recipient->query_depth() * 2)) < (int) agent->query_width()
        ||   ( ((int) recipient->query_width() * 2) + ((int)     
             recipient->query_height() * 2)) < (int) agent->query_width() 
        ||   ( ((int) recipient->query_height() * 2) + ((int)    
             recipient->query_depth() * 2)) < (int) agent->query_width() )
   {
      recipient->add_delta_adjective("wrapped in " + 
         how_many(1, agent->query_short()));
      action[0] = ".";
      action[1] = ".";
      action[2] = ".";
      action[3] = "wrap";
      action[4] = "around";

      tmp = (int) agent->query_burn_duration();
      if (tmp > (int) recipient->query_burn_duration()) 
         recipient->set_burn_duration(tmp);
   }
   else if ((int) recipient->query_object_type() == LIVING)
   {
      /* This is a short-cut for now.... */
      if (! (int) recipient->query_consciousness())
      {
         action[0] = ", sopping up the blood from " + (string) 
                      recipient->query_possessive() + " neck.";
         action[1] = ", sopping up the blood from " + (string) 
                      recipient->query_possessive() + " neck.";
         action[2] = ", sopping up the blood from your neck.";
         action[3] = "wipe";
         action[4] = "over";
      }
      else
      {
         action[0] = "forehead, dabbing the sweat from " + (string)  
                     recipient->query_possessive() + " brow.";
         action[1] = "forehead, dabbing the sweat from " + (string) 
                     recipient->query_possessive() + " brow.";
         action[2] = "forehead, dabbing the sweat from your brow.";
         action[3] = "pats";
         action[4] = "across";
      }
   }
   else
   {
      /* Wipe off the object, I guess. */
      action[0] = ".";
      action[1] = ".";
      action[2] = ".";
      action[3] = "use";
      action[4] = "to wipe off";
   }

   return action;
}
