#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/transients/dish";

void 
create()
{
   dish::create();

   set_id ( ({"plate"}) );

   set_weight (0.5);  // Kg.  Objects weight.
   set_height (2);    // cm.  These are looked at to see if the 
   set_width  (30);   // cm.  potential object to be contained will
   set_depth  (30);   // cm.  fit within.

}
