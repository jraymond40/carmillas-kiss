#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/transients/inanm_trns";

private nosave string key_str;

void   set_key(string str) { key_str = str; }
string query_key()         { return key_str; }

void 
create()
{
   inanm_trns::create();

   set_id        ( ({"key,master"}) );  // How Sicose find this item.
   set_short        ("master key");     // This items name.
   set_long         ("A silver key engraved with the word `MASTER'.");
   set_flammability (NONE);	// NONE | LOW | MEDIUM | HIGH
   set_burn_duration(0);	// Sec. Time in seconds it will burn.
   set_weight       (0.01);	// Kg.  Objects weight.
   set_height       (5);	// cm.  These are looked at to see if the 
   set_width        (2);	// cm.  potential object to be contained
   set_depth        (0.1);	// cm.  will fit within.
   set_form         (SOLID);	// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);	// RIGID | LIMP
   set_dynamacy     (DYNAMIC);	// Is it usable in some way? 
   set_key(MASTER_KEY_STR);	// By default opens everything.
}
