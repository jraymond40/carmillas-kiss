#include <std_defs.h>

// #define USE_RECIPIENT_DEBUG TRUE

inherit "/classes/obj";

create()
{
   set_object_type(INANIMATE);
}


// These are the affordances ("to be able to do") that all inanimate
// objects have available.
//
// When using objects together, the object that is the recipient of 
// the action is also called to find it's reaction.

string* use(object user, object recipient)
{
   int    tmp;
   string str;
   object agent;
   string agent_name;
   string recip_name;
   string *action;
   string *reaction;
   string *results;

   action   = allocate(6);
   reaction = allocate(6);
   results  = allocate(6);

   agent = this_object();
   agent_name  = specific_obj(agent);

   if (!recipient)
   {
      notify_fail("   Use " + agent_name + " with _what_?\n\n");
      return FAIL; 
   }

   recip_name = specific_obj(recipient);

   action   = obj::use(user, recipient);
   if (action == FAIL)
   {
      notify_fail("obj:use returned fail\n"); 
      return FAIL;
   }

   reaction = (string *) recipient->use_recipient(user, agent);  
   if (reaction == FAIL)
   {
      notify_fail("(indirect)obj:use_recipient returned fail\n"); 
      return FAIL;
   }

   if (action == FAIL || reaction == FAIL) return FAIL;

   results[0] = (action[0] ? action[0] : "") + (reaction[0] ? reaction[0] : "");
   results[1] = (action[1] ? action[1] : "") + (reaction[1] ? reaction[1] : "");
   results[2] = (action[2] ? action[2] : "") + (reaction[2] ? reaction[2] : "");

#ifdef USE_RECIPIENT_DEBUG 
  write(
      "action0 = " + action[0] + "\n" +
      "action1 = " + action[1] + "\n" +
      "action2 = " + action[2] + "\n" + 
      "action3 = " + action[3] + "\n" +
      "action4 = " + action[4] + "\n" +
      "action5 = " + action[5] + "\n"
   );
   write(
      "reaction0 = " + reaction[0] + "\n" +
      "reaction1 = " + reaction[1] + "\n" +
      "reaction2 = " + reaction[2] + "\n" + 
      "reaction3 = " + reaction[3] + "\n" +
      "reaction4 = " + reaction[4] + "\n" +
      "reaction5 = " + reaction[5] + "\n"
   );
 write(
      "result0 = " + results[0] + "\n" +
      "result1 = " + results[1] + "\n" +
      "result2 = " + results[2] + "\n" + 
      "result3 = " + results[3] + "\n" +
      "result4 = " + results[4] + "\n" +
      "result5 = " + results[5] + "\n"
   );
#endif

   if (results[0] == "" && results[1] == "" && results[2] == "")
      results[0] = results[1] = results[2] = 
         ", but nothing interesting happens.\n";

   results[3] = (action[3] ? action[3] : (reaction[3] ? reaction[3] : ""));
   results[4] = (action[4] ? action[4] : (reaction[4] ? reaction[4] : ""));
   results[5] = (action[5] ? action[5] : (reaction[5] ? reaction[5] : ""));

   return results;
}
