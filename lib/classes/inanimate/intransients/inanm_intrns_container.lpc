#include <std_defs.h>

inherit "/classes/inanimate/intransients/inanm_intrns";
inherit "/classes/container";

void
restart()
{
   inanm_intrns::restart();
   container::restart();
}

void
create()
{
   inanm_intrns::create();
   container::create();
}

void 
initialize(object where)
{
   inanm_intrns::initialize(where);
   container::initialize(this_object());
}

void 
remove()
{
   container::remove();
   inanm_intrns::remove();
}

string 
query_long()
{
   string str1, str2;
   str1 = inanm_intrns::query_long();
   str2 = container::query_long();
   return (str1 + (str2 ? str2 : "") ); 
}
