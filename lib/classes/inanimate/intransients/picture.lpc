#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns";

void
create()
{
   inanm_intrns::create();

   set_id        ( ({"picture"}) );	// How sicose finds this item.
   set_short        ("picture");	// The name of this item.

   // The in-depth description.
   set_long         ("It's blank!?");
	
   set_flammability (LOW);		//       NONE | LOW | MEDIUM | HIGH
   set_burn_duration(300);  		// Sec. Burn duration in seconds 
   set_weight       (40);		// Kg.  (although, it is intransient)
   set_height       (180);		// cm.    
   set_width        (100);		// cm.   
   set_depth        (6);		// cm.   
   set_form         (SOLID);		// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);		// RIGID | FLEXIBLE
}

string*
use_recipient(object obj1, object obj2)
{
   return ({", but thick glass protects the picture from vandalism.",
            ", but thick glass protects the picture from vandalism.",
            ", but thick glass protects the picture from vandalism.",
            "attempt",
            "use",
            "on"});
}
