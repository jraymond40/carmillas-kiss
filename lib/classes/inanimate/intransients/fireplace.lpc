#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns_holder";

void
create()
{
   inanm_intrns_holder::create();
   set_id        ( ({"fireplace"}) );
   set_short        ("fireplace");
   set_long         ("You note nothing particularly interesting.");
   set_flammability (NONE);
   set_burn_duration(0);
   set_weight       (6000);     // Rather pointless since it's immoveable
   set_height       (600);
   set_width        (600);
   set_depth        (600);
   set_volume       (8000000);  // The volume containable within the fireplace
   set_form         (SOLID);
   set_rigidity     (RIGID);
   set_liquid_tight (FALSE);    // Won't hold water 
   set_max_bearable (INFINITE); // But it's strong enough to hold whatever 
   set_manner_held  ("on the hearth");
}
