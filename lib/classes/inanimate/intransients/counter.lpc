#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns_holder";

void
create()
{
   inanm_intrns_holder::create();

   set_id        ( ({"counter"}) );	// How sicose finds this item.
   set_short        ("counter");	// The full description of this item.
   set_long         ("Made from oak, the surface has warped somewhat.");

   set_flammability (LOW);		// NONE | LOW | MEDIUM | HIGH
   set_burn_duration(600);  		// Sec. Burn duration in seconds 
   set_weight       (150);		// Kg.  (although, it is intransient)
   set_height       (100);		// cm.    
   set_width        (80);		// cm.   
   set_depth        (250);		// cm.   
   set_form         (SOLID);		// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);		// RIGID | FLEXIBLE
   set_manner_held  ("spread over the counter");
   set_max_bearable (600);
}
