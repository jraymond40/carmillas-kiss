#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns";

void
create()
{
   inanm_intrns::create();

   set_id        ( ({"candelabra"}) );	// How sicose finds this item.
   set_short        ("candelabra");	// The name of this item.
   // The in-depth description.
   set_long         ("It hangs from the ceiling.");	
   set_flammability (NONE);		// NONE | LOW | MEDIUM | HIGH
   set_burn_duration(0);  		// Sec. Burn duration in seconds 
   set_weight       (40);		// Kg.  (although, it is intransient)
   set_height       (100);		// cm.    
   set_width        (200);		// cm.   
   set_depth        (200);		// cm.   
   set_form         (SOLID);		// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);		// RIGID | FLEXIBLE
   set_dynamacy     (DYNAMIC);          // Is it usable in some way? 
}
