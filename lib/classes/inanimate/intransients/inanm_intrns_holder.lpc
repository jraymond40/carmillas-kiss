#include <std_defs.h>

inherit "/classes/inanimate/intransients/inanm_intrns";
inherit "/classes/holder";

void
restart()
{
   inanm_intrns::restart();
   holder::restart();
}

void
initialize(object where)
{
   inanm_intrns::initialize(where);
   holder::initialize(this_object());
}

void remove()
{
   holder::remove();
   inanm_intrns::remove();
}

string query_long()
{
   string str1, str2;
   str1 = inanm_intrns::query_long();
   str2 = holder::query_long();
   return (str1 + (str2 ? str2 : "")); 
}
