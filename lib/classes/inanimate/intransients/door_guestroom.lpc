#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/door";

string query_door_number() { return "??"; }

void
create()
{
   string num;

   door::create();

   num = query_door_number();
   set_id( ({"door,`#" + num + "'"}) );
   set_long("The door is marked `#" + num + "'.");
   set_lock(ROOM_KEY_STR + num);
   lock();
}

void
restart()
{
   door::restart();

   // At game begin, close & lock the doors to each guest room.
   close();
   lock();
}
