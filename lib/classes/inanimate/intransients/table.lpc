#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns_holder";

void
create()
{
   inanm_intrns_holder::create();

   set_id        ( ({"table"}) );	// How sicose finds this item.
   set_short        ("table");	        // The name of this item.
  
   // The in-depth description.
   set_long         ("A wooden table.");	

   set_flammability (LOW);		// NONE | LOW | MEDIUM | HIGH
   set_burn_duration(3000);  		// Sec. Burn duration in seconds 
   set_weight       (50);		// Kg.  (although, it is intransient)
   set_height       (100);		// cm.    
   set_width        (60);		// cm.   
   set_depth        (160);		// cm.   
   set_form         (SOLID);		// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);		// RIGID | FLEXIBLE
   set_dynamacy     (DYNAMIC);          // Interpreted to mean it's useable

// Necessary for holders:
   set_liquid_tight (FALSE);    	// Won't hold liquids
   set_max_bearable (INFINITE); 	// Strong enough to hold whatever

   // How is the item held on this holder?   
   set_manner_held  ("on the table");  
}

use(object tp, object recipient)
{
   if (!recipient)
      return ( ({
         ".",
         ".",
         ".",
         "lean",
         0,
         "against"}));
   else return (inanm_intrns_holder::use(tp, recipient));
}

