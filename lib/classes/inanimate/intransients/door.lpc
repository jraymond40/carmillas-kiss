#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns";
inherit "/classes/lockable";

void
restart()
{
   inanm_intrns::restart();
   lockable::restart();
}

void
create()
{
   inanm_intrns::create();
   lockable::create();

   set_id        ( ({"door"}) );	// How sicose finds this item.
   set_short        ("door"); 		// The full description of this item.

   // The in-depth description.
   set_long         ("A simple wooden door.");

   set_flammability (LOW);		// NONE | LOW | MEDIUM | HIGH
   set_burn_duration(300);  		// Sec. Burn duration in seconds 
   set_weight       (7);		// Kg.  (although, it is intransient)
   set_height       (200);		// cm.    
   set_width        (75);		// cm.   
   set_depth        (3);		// cm.   
   set_form         (SOLID);		// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);		// RIGID | FLEXIBLE
}

string*
use_recipient(object user, object agent)
{
   string *result; 

   result = lockable::use_recipient(user, agent);
   return (result ? result : inanm_intrns::use_recipient(user, agent));
}

