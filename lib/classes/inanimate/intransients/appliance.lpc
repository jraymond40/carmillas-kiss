#include <std_defs.h>
#include <config.h>

#define EFFECT_STR ""
#define EFFECT_DURATION 120

inherit "/classes/inanimate/intransients/inanm_intrns_holder";
inherit "/classes/activatable";

private nosave int i;
private nosave object *contents;

void
restart()
{
   inanm_intrns_holder::restart();
   activatable::restart();
}

void
create()
{
   inanm_intrns_holder::create();
   set_flammability (NONE);		// NONE | LOW | MEDIUM | HIGH
   set_burn_duration(0);  		// Sec. Burn duration in seconds 
   set_form         (SOLID);		// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);		// RIGID | FLEXIBLE
   set_dynamacy     (DYNAMIC);          // Is it usable in some way? 
   set_max_bearable (INFINITE);
}

void
remove_from_contents(object item)
{
   if(query_mode() == ON)
   {
      remove_delta_adjective(EFFECT_STR);
      add_timed_d_adjective(EFFECT_STR, 0, EFFECT_DURATION);
   }
   inanm_intrns_holder::remove_from_contents(item);
}

string
add_to_contents(object item)
{
   if(query_mode() == ON) add_delta_adjective(EFFECT_STR);
   inanm_intrns_holder::add_to_contents(item);
}

void
turn_on()
{
   activatable::turn_on();
   add_delta_adjective(EFFECT_STR);
   contents = accessible_inventory(ALL, AND, this_object());
   for (i = 0; i < sizeof(contents); i++)
      contents[i]->add_delta_adjective(EFFECT_STR);
}

void
turn_off()
{
   activatable::turn_off();
   call_out("remove_delta_adjective", EFFECT_DURATION, EFFECT_STR);
   for (i = 0; i < sizeof(contents); i++)
   {
      contents[i]->remove_delta_adjective(EFFECT_STR);
      contents[i]->add_timed_d_adjective(EFFECT_STR, 0, EFFECT_DURATION);
   }
}

string*
use(object tp, object recipient)
{
   if (!recipient) return(activatable::use());
   else return (inanm_intrns_holder::use(tp, recipient));
}
