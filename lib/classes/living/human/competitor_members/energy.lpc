#include <std_defs.h>

private nosave int energy;    /* Personal energy level of entity */

int
add_energy(int e, object tp)  
{
   energy += e;
   if (energy < 0)  // Oops e was neg. and we don't have that much.
   {
      e += energy;  // Make e the amount we really took.
      energy = 0;   // And set energy to min.
   } 
   effect( INDIV, tp,
      "Actual energy change: " + e + "\t\tTotal Energy: " + energy + "\n");

   return e; // Return the amount actually drained/gained.
}

void reset_energy() { energy = 0;}
int  query_energy() { return energy;}
void restart()      { reset_energy(); }
