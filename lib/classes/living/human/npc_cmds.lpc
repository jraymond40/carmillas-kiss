#include <std_defs.h>
#include <config.h>

int negotiate(string dir);

void 
init_actions()
{
   add_action("moveto", "moveto");
   add_action("cue_npc", "cue");
   add_action("cutto_loc", "cutto");
   add_action("end_cutto_loc", "end_cutto");
   add_action("negotiate", "negotiate");
}

void
cue_npc(string str)
{
   cue(str);
}

int
cutto_loc(string loc_name)
{
   cutto(loc_name);
   return SUCCEED;
}

int
end_cutto_loc(string loc_name)
{
   end_cutto(loc_name);
   return SUCCEED;
}

int
moveto(string destination)
{
   string  str, origin;
   string* action_list;
   int     i, result;
   int     index;
   object  obj;

   origin = LOCATION_NUMBER(environment(this_player()));
   
   // Is the destination the environment of a living object ? 
   obj = find_living(lower_case(destination));

   // It's not alive, so see if it's an inanimate object. 
   if (!obj) obj = find_object(INTRANSIENT_OBJ_DIR + destination);
   if (!obj) obj = find_object(TRANSIENT_OBJ_DIR + destination);

   // If the destination is the environment of some body/thing 
   // then set the destination to the location of that being.  
   if (obj) destination = LOCATION_NUMBER(environment(obj));

   if (origin == destination)
   {
      notify_fail ("You're already here.\n");
      return FAIL;
   }
   else 
   {
      write("Moving from: " + origin + " to: " + destination + "\n");

      str = find_object(NAVIGATE_OBJ)->query_route(origin, destination);

      if (str == "") 
      {
         notify_fail("Sorry, you can't get there from here.\n");
         return FAIL;
      }

      else 
      {
         action_list = explode(str, ",");
         for (i = 0; i < sizeof(action_list); i++) 
         {
            write("Moving " + action_list[i] + "\n");
            result = negotiate(action_list[i]);
            if (result == 0)
            {
               notify_fail("Unable to negotiate " + action_list[i] + "ward.\n");
               break;
            }
         }
         return result;
      }
   }
}

int
negotiate(string direction)
{
   int    was_locked, was_closed, result;
   object location, door;
   location = environment(this_object()); // Change this when stages come....
   result = SUCCEED;

   door = location->query_door(direction);
   if (door)
   {
      if ((int) door->query_locked() == TRUE)
      {
         was_locked = TRUE;
         result = command("use key,master " + door->query_primary_id());
      }
      if ((int) door->query_closed() == TRUE)
      {
         was_closed = TRUE;
         result = (result ? command("open " +  door->query_primary_id()) : 0);
      }
   }
   // an else here could allows us to  negotiate through secret passages
   // each location with such an exit would provide instructions
   // on how to negotiate the passage for NPCs, NPCAIs, admins

   result = (result ? command("move " +  direction) : 0);

   if (door)
   {
      if (was_closed) 
         result = (result ? command("close " +  door->query_primary_id()) : 0);
      if (was_locked) command("use key,master " + door->query_primary_id());
         result = (result ? command("use key,master " +  door->query_primary_id()) : 0);
   }
   return result;
}
