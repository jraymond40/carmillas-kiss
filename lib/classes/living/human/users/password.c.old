#include <std_defs.h>
#include <config.h>

private nosave string tmp;
private        string password;

/* Be warned of the idiotic redundancy contained herein due to
// the oddities of the input_to func. and more so, due to the 
// strange way that LPC continues to follow instructions in parallel
*/

/*
// These functions check passwords to the stored one
*/

void init_actions()
{
   add_action("redefine_password", "password");
}

int define_password(string str)
{
   if (str == "") return FAIL;
   password = str;
   return SUCCEED;
}

int verify_password(string str) 
{
   if (password != str) return FAIL;
   else return SUCCEED;
}

/* 
// The following allow the user to redefine their password.
*/

int redef_verify_newpass2(string str2)
{
   if (tmp != str2) 
   {
      notify_fail("** Passwords don't match - Password unchanged. **\n");
      return FAIL;
   }
   else 
   {
      password = crypt(str2, (string) this_player()->query_name());
      return SUCCEED;
   }
}

int redef_verify_newpass1(string str1)
{
   if (str1 == "") 
   {
      notify_fail("** Invalid password - Password unchanged. **\n");
      return FAIL;
   }
   else 
   {
      tmp = str1;
      write("Verify your entry by re-typing your selected password: ");
      return SUCCEED;
   }
}

int redef_verify_password(string str) 
{
   string tmp;

   if (str == "") 
   {
      notify_fail("** Password redefine failed. **\n");
      return FAIL;
   }
   else 
   {
      tmp = crypt(str, (string) this_player()->query_name());
      if (password != tmp) 
      {
         notify_fail("** Password redefine failed. **\n");
         return FAIL;
      }
      else 
      {
         write("Enter your new password: ");
         return SUCCEED;
      }
   }
}

redefine_password()
{
  write("Password: ");
}

