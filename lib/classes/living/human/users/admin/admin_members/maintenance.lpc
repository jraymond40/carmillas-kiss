#include <config.h>
#include <std_defs.h>

private int num_locations;

private string current_path;

init_actions() 
{
   os_cmds();
   maint_cmds();
}


/*
//=======================================================================\\
//  Pathname setting                                                     \\
//=======================================================================\\
*/


string find_class_path(string str)
{
   if ( file_size(TRANSIENT_OBJ_DIR+str) >= 0 )        return TRANSIENT_OBJ_DIR + str; 
   else if ( file_size(INTRANSIENT_OBJ_DIR+str) >= 0 ) return INTRANSIENT_OBJ_DIR + str; 
   else if ( file_size(NPCS_DIR+str) >= 0 )            return NPCS_DIR + str; 
   else if ( file_size(USERS_DIR+str) >= 0 )           return USERS_DIR + str; 
   else if ( file_size(LOCATION_DIR+str) >= 0 )        return LOCATION_DIR + str; 
   else return "";
}

string add_paths(string p1, string p2) 
{
    string *comp1, *comp2;
    int i;

    if (p2[0] == '/')
	return p2;
    comp1 = explode(p1, "/");
    comp2 = explode(p2, "/");
    for (i=0; i<sizeof(comp2); i++) {
	if (comp2[i] == "..") {
	    if (comp1 == 0)
		comp1 = ({});
	    continue;
	}
	comp1 += ({ comp2[i] });
    }
    return PATH_PREFIX + implode(comp1, "/");
}

nosave void init_current_path(string name) 
{
   current_path = LIBRARY_DIR;
}

string query_path() 
{
   return current_path;
}

/*
//======================================================================\\
//  Now the Unix like commands                                          \\
//======================================================================\\
*/

os_cmds()
{
   add_action("makedir", "mkdir");
   add_action("removedir", "rmdir");
   add_action("pwd", "pwd");
   add_action("more", "more");
   add_action("remove_file", "rm");
   add_action("list_files", "ls");
   add_action("cat_file", "cat");
   add_action("tail_file", "tail");
   add_action("cd", "cd");
   add_action("man", "man");
}

int pwd() 
{
    write(current_path + "\n");
    return SUCCEED;
}

int makedir(string str) {
    if (!str)
	return 0;
    if (mkdir(str))
	write("Ok.\n");
    else
	write("Fail.\n");
    return 1;
}

int removedir(string str) {
    if (!str)
	return 0;
    if (rmdir(str))
	write("Ok.\n");
    else
	write("Fail.\n");
    return 1;
}


#define CHUNK 16
nosave private string more_file;	/* Used by the more command */
nosave private int more_line;

int more(string str) 
{
   if (!str) return FAIL;
   more_file = str;
   more_line = 1;

   if (cat(more_file, more_line, CHUNK) == 0) 
   {
      write("No such file\n");
      return SUCCEED;
   }

   input_to("even_more");
   write("More: (line " + (CHUNK + 1) + ") ");
   return SUCCEED;
}


nosave void even_more(string str) 
{
   if (str == "" || str == "d")
      more_line += CHUNK;
   else if (str == "q") 
   {
      write("Ok.\n");
      return;
   } 
   else if (str == "u") 
   {
      more_line -= CHUNK;
      if (more_line < 1) more_line = 1;
   }
   if (cat(more_file, more_line, CHUNK) == 0) 
   {
      more_file = 0;
      write("EOF\n");
      return;
   }
   write("More: (line " + (more_line + CHUNK) + ") ");
   input_to("even_more");
}


nosave int remove_file(string str) 
{
   if (!str)
   {
      notify_fail("rm what file?\n");
      return FAIL;
   }
   else
   {
      rm(str);
      return 1;
   }
}


nosave int list_files(string path)
{
    if (!path) path = current_path;
    else path = add_paths(current_path, path);
    if (path != "/") path = path + "/.";
    get_dir(path);
    return SUCCEED;
}


cat_file(path)
{
    if (!path) return FAIL;
    if (!cat(add_paths(current_path, path))) write("No such file.\n");
    return SUCCEED;
}


tail_file(path)
{
   if (!path) return FAIL;
   if (!tail(add_paths(current_path, path))) return FAIL;
   else return SUCCEED;
}


nosave int cd(string str) 
{
    string old_path;

    if (!str) current_path = LIBRARY_DIR;
    else current_path = add_paths(current_path, str);
    write(current_path + "\n");
    return SUCCEED;
}

/*
//=======================================================================\\
// Maintenance commands                                                  \\
//=======================================================================\\
*/

maint_cmds()
{
   add_action("make_routing_tbl", "mk_rt_tbl");
   add_action("shut_down_game", "shut");
}

nosave shut_down_game(str)
{
    if (!str) {
	write("You must give a shutdown reason as argument.\n");
	return 1;
    }
    shout("Game is shut down by " +
	  (string)this_object()->query_cap_name() + ".\n");
#ifdef LOG_SHUTDOWN
    log_file("GAME_LOG", ctime(time()) + " Game shutdown by " + 
	     (string)this_object()->query_cap_name() +
	     "(" + str + ")\n");
#endif
    shutdown();
    return 1;
}

/*
// Navigate will find the quickest way to get from "origin" to
// destination, returning each instruction for doing so in a string.
*/

string navigate( string origin, string destination) /* , object caller)*/
{

/* These make for easier reading */
#define CONNECTION 0   /* The index to the adjacent locations to check for each  */
                       /* possible route.                                     */ 
#define INSTRUCTIONS 1 /* The index to the instructions to get to each of the */
                       /* possible routes.                                    */

   mixed*  crnt_pos_routes; /* A 2-D array containing connections & instructions */
                            /* to each possible route that we are currently      */
                            /* working on.                                       */
   mixed*  next_pos_routes; /* The next array of possible routes to work on.     */
   string* connection_list; 
   string* instructions_list;
   string* already_checked; /* The list of locations already checked.               */
   string* str;
   int     i,ii,iii;
   int     checked;
   int     route;
   int     index;
   int     num_crnt_routes;
   int     num_next_routes;
   int     num_already_checked;
   object  location;

   instructions_list = allocate(MAX_NUM_DIRECTIONS);
   connection_list = allocate(MAX_NUM_DIRECTIONS);
   if (origin == destination) return ("");
   else
   {
      /* I can't foresee the num of possible routes exceeding this: */ 
      crnt_pos_routes = allocate(2);
      crnt_pos_routes[0] = allocate(MAX_NUM_DIRECTIONS * num_locations);
      crnt_pos_routes[1] = allocate(MAX_NUM_DIRECTIONS * num_locations);

      next_pos_routes = allocate(2);
      next_pos_routes[0] = allocate(MAX_NUM_DIRECTIONS * num_locations);
      next_pos_routes[1] = allocate(MAX_NUM_DIRECTIONS * num_locations);

      already_checked = allocate(num_locations);

      already_checked[num_already_checked++] = 
         LOCATION_DIR + "p" + origin;
      crnt_pos_routes[CONNECTION][num_crnt_routes] = 
         LOCATION_DIR + "p" + origin;
      crnt_pos_routes[INSTRUCTIONS][num_crnt_routes++] = "";


      do
      {
         /* Cycle through the current possible routes */
         for (route = 0; route < num_crnt_routes; route++)
         {
            /* Load this location in, get it's connect list & throw it out again */
            location = clone_object(crnt_pos_routes[CONNECTION][route]);
            connection_list = (string *) location->query_exit_list();
            instructions_list = (string *) location->query_command_list();
            destruct(location);            
   
            /* Now, look at each adjacent location to determine if it is the    */
            /* destination or failing that, at least a valid possible route. */
            for (ii = 0; ii < sizeof(connection_list); ii++)
            {

write("Is " + connection_list[ii] + "==" + LOCATION_DIR + "p"+ destination + "?\n");
               /* If this adjacent location is the destination, return this route */
               if (connection_list[ii] == LOCATION_DIR + "p"+ destination) 
                  return (crnt_pos_routes[INSTRUCTIONS][route] + instructions_list[ii] + "\n");

               /* Okay the adjacent location isn't the destination, but it may       */
               /* lead us to it.                                                  */
               /* Have we checked the adjacent location as a potential route before? */
               /* If so, move onto checking the next adjacent location now           */   
               for (iii = 0, checked = FALSE; 
                    iii < num_already_checked && !checked; iii++)
               {
write("-not dest, is " + connection_list[ii] + " in the already checked list:" + already_checked[iii] +"?\n");
                  if (connection_list[ii] == already_checked[iii]) 
                     checked = TRUE;
               }
               if (!checked)
               {
                  /* Okay, it's a new potential route, so add it to our next list.   */
                  /* First record the room connections from here to there.           */
                  next_pos_routes[CONNECTION][num_next_routes] = connection_list[ii];

                  /* Second, record the instructions of how to get there from here. */
                  next_pos_routes[INSTRUCTIONS][num_next_routes++] =  
                     crnt_pos_routes[INSTRUCTIONS][route] + instructions_list[ii] + "\n";

                  /* Okay we've checked it, put it into the already_checked pile */
                  already_checked[num_already_checked++] = connection_list[ii];
               }
            }
         } 
         /* Okay, we've checked the current routes and made a list of future   */
         /* routes to check. So now lets make the future possible route list   */
         /* the current possible route list, and start checking all over again.*/
         str = crnt_pos_routes;
         crnt_pos_routes = next_pos_routes;
         num_crnt_routes = num_next_routes;
         next_pos_routes = str;
         num_next_routes = 0;
      } 
      while (num_crnt_routes != 0);
      
      /* Well if we've made it to this point, you simply can't get there from here. */
      return ("");
   }

}

/*
// This function generates a routing table so that NPC's can traverse 
// the quickest way possible from one location to another.
*/

int make_routing_tbl()
{

   string file_prefix;
   string *location_list;
   string *dir;
   string str;

   int i, ii;
   int dir_size;

   dir = get_dir(LOCATION_DIR+"p*.c");
   dir_size = sizeof(dir);

   location_list = allocate(dir_size);

   for (i = 0, ii = 0; i<dir_size; i++)
   {
      file_prefix = extract(dir[i], 0, 1);

      if (file_prefix == "p+" || file_prefix == "p-") 
         location_list[ii++] = extract(dir[i], 1, -3);         
   }
   num_locations = ii;

   rm(ROUTING_TBL);

   for (i = 0; i < num_locations; i++)
   {
      for (ii = 0; ii < num_locations; ii++)
      {
         str = str + location_list[i] + location_list[ii] + ",";
      }
   }

   str = str + "\n";

   for (i = 0; i < num_locations; i++)
   {
      for (ii = 0; ii < num_locations; ii++)
      {
         str = str + navigate(location_list[i], location_list[ii]) + ",";
      }
   }

   if (!write_file( ROUTING_TBL, navigate(location_list[i], location_list[ii]) + ",")) 
   {
      notify_fail("Error: Failed to write routing.tbl\n");
      return FAIL;
   }
   else return SUCCEED;
}
