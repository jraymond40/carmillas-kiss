public
void
create()
{
   player::create();
   set_transient_list( ({"key/master"}) );
}

public
void
initialize(object where, string name)
{
   player::initialize(where, name);
   set_human_type(ADMINISTRATOR);
   set_long("An administrator - rather dull looking lot, they are.");

