#include <config.h>
#include <std_defs.h>
#include <npc_defs.h>

inherit "/objects/living/conscious";
inherit "/objects/living/energy";
inherit "/objects/living/commons_role";
inherit "/objects/living/vampire";
inherit "/objects/living/victim";

inherit "/objects/living/npcs/npc";

int cue;

create()
{
   npc::create();
   npc::initialize("Typhorthet");
   set_gender("male");
}

add_energy(int e)   /* Catch Energy Change - this cues strategy evaluation*/ 
{
   mixed *ptntl_earnings;
   mixed *result;

   energy::add_energy(e);

   ptntl_earnings = MASTER_OBJ->potential_earnings;

   result[COOPERATE] = (ptntl_earnings[0] + ptntl_earnings[1]) / 2;
   result[EXPLOIT]   = (ptntl_earnings[2] + ptntl_earnings[3]) / 2;
   result[POLICE]    = (ptntl_earnings[4] + ptntl_earnings[5]) / 2;
   result[REWARD]    = ptntl_earnings[6];
   result[EITHDRAW]  = ptntl_earnings[7];

   /* Find the largest and go with it */
   if (result[EXPLOIT] > result[COOPERATE]) cue = EXPLOIT; 
   else cue = COOPERATE;
   if (result[POLICE] > result[cue])   cue == POLICE;
   if (result[REWARD] > result[cue])   cue == REWARD;
   if (result[WITHDRAW] > result[cue]) cue == WITHDRAW;
}


heart_beat(string str)
{

   switch (cue)
   {
      case SIP:
         command("sip");
         break;
      case GULP:
         begin looking for a victim....
         command("gulp");
         /*
         // command("scan");
         // command("bite " + potential_victim);
         */
         break;
      case INHALE:
         commnad("inhale");
         break;
      case BLOW_INTO:
         command("blow_into";
         break;
      case DO_NOTHING:
         break; 
   }

}









      command("say Hmmm... yes, yes... I'm going.");
      move_to(victim_location);
      command("yawn Yes, vhat is it voman, zhat you must vake an old man from his nap?"); 
      cue = "";
      set_heart_beat(OFF);
      command("cue oma A6");
   }
   else if (cue == "A7")
   {
      command("scoff Hmphh...");
      /* 
      // Leave the room - Go to the front desk, unless we're already there, 
      // in which case we can go virtually anywhere else. 
      */
      if (extract(file_name(environment(this_player())), 9, 15) != "+3+0+0") command("moveto +3+0+0");
      else command("moveto +4+1+1");
      cue = "";
      set_heart_beat(OFF);
      command("cue oma A8"); 
   }
   else if (cue == "C0")
   {
      /* Grandfeathers room will have a lock, ensuring no other players will be there */
      command("say Shhh... pretend I moved to my room (it doesn't exist yet).");
      cue = "";
      set_heart_beat(OFF);
      command("cue Oma C1");
   }
   else if (cue == "C2")
   {
      command("say Indeed.");
      command("read Archdoxis");
      cue = "";
      set_heart_beat(OFF);
      command("cue oma C3");
   }
   else if (cue == "C4")
   {
      command("say Voman, vill you hush for a moment? Listen to vhat I discovered in zhe " +
              "library - it vas written by Paracelsus himself.");
      command("say Vampyres: On the subject of these devilish creatures I have made a  " +
              "discovery of great importance. Utilizing the works of Kuritsinn, as well  " +
              "as those of Beheim and Sadovianu I began to discover the real life of the  " +
              "Voivode...");
      command("mumble");
      cue = "";
      set_heart_beat(OFF);
      command("cue oma C5");
   }
   else if (cue == "C6")
   {
      command("read While the traditional safeguards against these beasts have sometimes been " +
              "effective, they are seldom reliable. To ensure certain success against the " +
              "stalking beast, one must think and sense just as they. To this end, the  " +
              "hunter himself must symbollicly consume the liquid life source...");
      cue = "";
      set_heart_beat(OFF);
      command("cue oma C7");
   }
   else if (cue == "C8")
   {
      command("say No... now shhh! It says 'Inhalation of the plasma-based Yliastrum elixir  " +
              "provides greatly enhanced perception to the hunter. It will tax the  " +
              "stamina, but prove invaluable in such matters.");
      cue = "";
      set_heart_beat(OFF);
      command("cue oma C9");
   }
   else if (cue == "CA")
   {
      cue = "";
      set_heart_beat(OFF);
      command("read Archdoxis");
   }
   else if (cue == "D6")
   {
      command("moveto " + extract(file_name(environment(Junior)), 9, 15) );
      cue = "";
      set_heart_beat(OFF);
      command("cue oma D7");
   }
   else if (cue == "D8")
   {
      command("mumble Hmmph! Doesn't look like zhere's enough here for zhat...");
      cue = "";
      set_heart_beat(OFF);
      command("cue oma D9");
   }

   /* The section here is reserved for default actions. */
   else if (cue == "Z0")
   {
      move_to("+2+1+1");
      command("dust portrait");
      call_out("command", 8, ({"dust frame"}) );
      cue = "";
      set_heart_beat(OFF);
      call_out("command", 16, ({ "cue grandfeathers Z" + random(4)}) );
   }
   else if (cue == "Z1")
   {
      move_to("+0+1+1");
      command("dust nightstand");        
      call_out("command", 8, ({"dust bed"}) );
      cue = "";
      set_heart_beat(OFF);
      call_out("command", 16, ({ "cue grandfeathers Z" + random(4)}) );
   }
   else if (cue == "Z2")
   {
      move_to("+3+0+0");
      command("dust desk");
      call_out("command", 8, ({"dust bell"}) );
      cue = "";
      set_heart_beat(OFF);
      call_out("command", 16, ({ "cue grandfeathers Z" + random(4)}) );
   }
   else if (cue == "Z3")
   {
      command("sneeze");
      cue = "";
      set_heart_beat(OFF);
      call_out("command", 16, ({ "cue grandfeathers Z" + random(4)}) );
   }
   else 
   {
      command("yell Heartbeat has no instructions for the cue: " + cue + ".");
      cue = "";
      set_heart_beat(OFF);
   }
   
   return SUCCEED;
}     
