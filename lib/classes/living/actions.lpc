#include <config.h>
#include <std_defs.h>
#include <english.h>

inherit "/classes/living/communicate";

//
// User has selected this cmd and possibly said something,
// here`s how to respond.
//
int
selected_cmd0(object tp, string said)
{
   // Default action is:
   // Say users lines (if there), but tell them they haven't told us 
   // what to act on.
   string verb;
   verb = query_verb();

   if (said!="") tp->say(said);
   effect(LOCAL, tp,
        " Your attempts to '" + verb + 
        "' failed because you need to use the right arrow -> to put the" +
        " name of the object you'd like to " + verb + 
        " onto the `DO:` line.\n");
   return SUCCEED;
}

//
// When this cmd is selected, should I set up menu1, and if so, how?
//
int
setup_menu1(object tp)
{
   // Default action is:
   // Set up menu 1 to show inanimate objects in the environment.
   tp->menu1("Here", objects_list(tp, INANIMATE | TRANSIENT | DYNAMIC |
      STATIC, AND, IMMEDIATE) );
   return SUCCEED;
}

//
// User has selected this cmd and an option out of menu1,
// should I setup menu2 and if so, how?
//
int
setup_menu2(object tp, string str)
{
   // Default action is:
   // There is no menu2, just update the screen.
   tp->doupdate();
   return SUCCEED;
}

//
// Here`s where we attempt to take this action
//
int
action_main(string str, string *prefix_strs, int present_tense_form)
{
   // Default action is:
   // We succeeded in our default action.
   return SUCCEED;
}
 
//
// Parse through the users selection...
// 
int
selection_parse(string str, object tp)
{
   string *com_action_strs, *prefix_strs;
   string  action_str, said, verb;
   string  str1, str2;

   com_action_strs = ({"","",""});
   prefix_strs = ({"","",""});

   // Merely cmd0 has been selected.
   if (!str) 
      return selected_cmd0(tp, "");

   // Cmd0 and something said.
   else if (sscanf(str, "*>[say] %s", said) > 0)
      return selected_cmd0(tp, said);

   else if (sscanf(str, "%s *>[say] %s", action_str, said) < 2)
   {
      // Setting-up menu #1
      if (str == "*>[menu1]") 
         return setup_menu1(tp);

      // Setting-up menu #2
      else if (sscanf(str, "%s *>[menu2]%s", str1, str2) > 0)
         return setup_menu2(tp, str1);

      // Not a menu request, simply the command w/ nothing to say.
      else
      {
         prefix_strs[0] = "You";
         prefix_strs[1] = (string) tp->query_cap_name();
         prefix_strs[2] = (string) tp->query_cap_name();
         return action_main(str, prefix_strs, SIMPLE);
      }
   }
   else
   {
      // The user has something to say.
      verb =  assume_a_verb(said, com_action_strs);
      format_for_simple_verb(verb, com_action_strs);
      prefix_strs[0] = "\"" + said + "\", " +  com_action_strs[0] + ", while";
      prefix_strs[1] = "\"" + said + "\", " +  com_action_strs[1] + ", while";
      prefix_strs[2] = "\"" + said + "\", " +  com_action_strs[2] + ", while";
      return action_main(action_str, prefix_strs, CONTINUOUS);
    }
}
