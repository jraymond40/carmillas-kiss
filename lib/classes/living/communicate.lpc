#include <std_defs.h>

void 
init_actions() 
{
    add_action("say", "*>[say]");
    add_action("say_w_simple_action", "expressions:");
}

varargs
void 
communicate( int range, string said_str, string *action_strs, object doee)
{
   if (!doee)
      effect(range, this_player(),
             "\"" + said_str + "\", " + action_strs[0] + ".\n",
             "\"" + said_str + "\", " + action_strs[1] + ".\n");
   else
      effect(range, this_player(),
             "\"" + said_str + "\", " + action_strs[0] + ".\n",
             "\"" + said_str + "\", " + action_strs[1] + ".\n",
             doee,
             "\"" + said_str + "\", " + action_strs[2] + ".\n");
   return;
}

// Given a simple verb, this formats the sentences of the immediate
// user and surrounding viewers.
void
format_for_simple_verb(string verb, string *action_strs)
{
   action_strs[0] = 
      "you " + verb + (action_strs[0] != "" ? " " + action_strs[0] : "");
   if (random(10) < 5) 
      action_strs[1] = this_player()->query_cap_name() + " " + 
      verb + "s" + (action_strs[1] != "" ? " " + action_strs[1] : "");
   else 
      action_strs[1] = verb + "s " + 
         (action_strs[1] != "" ? action_strs[1] + " " : "") + 
         this_player()->query_cap_name();
   return;
}

// Generate a verb based upon how the user typed their statement.
string
assume_a_verb(string str, string *action_strs)
{
   string verb;     
   string moodifier;

   if (!str) return "";
   moodifier = extract(str, -1);

   if (random(10) < 5) verb = "say"; 
   else verb = "state"; /* The default verbs */

   if (moodifier == "!") verb = "exclaim";
   else if (moodifier == "?") 
   {
      switch (random(3))
      {
         case 0:
            verb = "question";
            break;
         case 1:
            verb = "ponder";
            break;
         case 2:
            verb = "ask";
            break;
      }
   }
   else if (lower_case(extract(str, 0, 2)) == "but") verb = "interject";
   else if (moodifier =="." && extract(str, -3, -2) == "..")
   {
      verb = "trail";
      action_strs[0]="away"; action_strs[1]="away"; action_strs[2]="away";
   }

   return verb;
}

// Handle communication.
int
say(string str)
{
   string *action_strs;
   action_strs = ({"", ""});
   format_for_simple_verb(assume_a_verb(str, action_strs), 
                          action_strs); 
   communicate(LOCAL, str, action_strs);
   return SUCCEED;
}

// Handle communication with actions.
int
say_w_simple_action(string str)
{
   object  tp, doee;
   string *action, *action_strs;
   string  actions, said;
   int     range, num_cmds, rndm, num_actions;

   rndm = random(10);
   tp   = this_player();
   action_strs = ({"", "", ""});
   range = LOCAL;

   if (!stringp(str))
   {
      notify_fail("Expression not fully selected.\n");
      doupdate();
      return FAIL;
   }

   num_cmds = sscanf(str, "%s *>[say] %s", actions, said);
   if(!actions) actions = str;
   action = explode(actions, " ");
   num_actions = sizeof(action);

   if (num_cmds > 1)
   {
      // The user has something to say.   
      if (action[0] == "*>[say]") 
      {
         // User didn't finish entering an expression.
         format_for_simple_verb(assume_a_verb(said, action_strs), action_strs);
         communicate(LOCAL, said, action_strs);
         notify_fail("Expression not fully selected.\n");
         return FAIL;
      }
      else if (num_actions == 1)
      {
         // Say and do it.
         switch(action[0])
         {
            case "yell" :
            case "scream" :
            case "shout" :
               format_for_simple_verb(action[0], action_strs);
               range = GLOBAL;
               break;

            case "mumble" :
               if (rndm < 5) 
                  format_for_simple_verb(action[0], action_strs);
               else 
               {
                  action_strs[0] = "you mumble under your breath"; 
                  action_strs[1] = tp->query_cap_name() + " mumbles under " 
                         + tp->query_possessive() + " breath";
               }
               break;

            default :
               format_for_simple_verb(action[0], action_strs);
               break;
         }
         communicate(range, said, action_strs);
      }
      else
      {
         // Direct this action toward someone.
         doee = find_living(action[1]);

         switch(action[0])
         {
            case "interrupt" :
               action_strs[0] = "you interrupt " + action[1];
               action_strs[1] = tp->query_cap_name() + " interrupts " + 
                                action[1];
               action_strs[2] = tp->query_cap_name() + " interrupts you";
               break;

            default :
               action_strs[0] = "you " + action[0] + " at " + action[1];
               action_strs[1] = tp->query_cap_name() + " " + action[0] + 
                                "s at " + action[1];
               action_strs[2] = tp->query_cap_name() + " " + action[0] + 
                                "s at you";
               break;
         }
         communicate(LOCAL, said, action_strs, doee);
      }
   }
   else if (action[0] == "*>[menu1]")
   {
      // Handle the expressions menu and clear the third.
      tp->menu1("EXPRESS",
      ({"glare", "interrupt", "laugh", "mutter", "nod", "scoff",
        "smile", "yawn", "mumble","sneeze", "scream", "yell", 
        "shout"}) );
   }
   else if (num_actions < 2)
   {
      // Nothing to say, just action.
      switch(action[0])
      {
         case "yell" :
         case "scream" :
         case "shout" :
            action_strs[0] = "You " + action[0] + ".\n";
            action_strs[1] = "You hear a " + 
               (string) tp->query_gender() + " voice " + 
               action[0] + "ing.\n";
            range = GLOBAL;
            break;
         case "sneeze" :
            if      (rndm < 4) said = "Achoooo!"; 
            else if (rndm < 8) said = "ha... Ha... HA-Choooo!"; 
            else               said = "achoo, achoo, HachooO!"; 
            format_for_simple_verb("sneeze", action_strs);
            communicate(LOCAL, said, action_strs); 
            return SUCCEED;
            break;
         case "mumble" :
            if (rndm < 5)
            {
               action_strs[0] = "You mumble under your breath.\n";
               action_strs[1] = tp->query_cap_name() + " mumbles under " +
                  tp->query_possessive() + " breath.\n";
            }
            else
            {
               action_strs[0] = "You begin mumbling.\n";
               action_strs[1] = tp->query_cap_name() + " begins mumbling.\n";
            }
            break;

         default :
            action_strs[0] = "You " + action[0] + ".\n", 
            action_strs[1] = tp->query_cap_name() + " " + action[0] + "s.\n";
            break;
      }
      effect(range, tp, action_strs[0], action_strs[1]);
   }
   else if (action[1] == "*>[menu2]")
   {
      // Handle the third menu (numbered 0-2).
      switch(action[0])
      {
         // Those actions that don't need another menu.
         case "mutter" :
         case "sneeze" :
         case "yawn" :
            doupdate();
            return SUCCEED;
            break;

         // We can interrupt someone (but not "at" them).
         case "interrupt" :
            tp->set_preposition(0, "");
            tp->menu2("People", living_list(tp) );
            break;

         // The rest can be directed "at" someone.
         default :
            tp->set_preposition(4, "at");
            tp->menu2("People", living_list(tp) );
            break;
      }
   }
   else
   {
      // Direct this action toward someone w/ nothing to say.
      doee = find_living(action[1]);
      switch(action[0])
      {
         case "*>[say]" :
            // User didn't finish entering an expression.
            notify_fail("Expression not fully selected.\n");
            command(str);
            return FAIL;
            break;

         case "interrupt" :
            action_strs[0] = "You interrupt " + action[1] + ".";
            action_strs[1] = tp->query_cap_name() + " interrupts " + 
               action[1] + ".";
            action_strs[2] = tp->query_cap_name() + " interrupts you.";
            break;

         default :
            action_strs[0] = "You " + action[0] + " at " + action[1] + ".";
            action_strs[1] = tp->query_cap_name() + " " + action[0] + 
               "s at " + action[1] + ".";
            action_strs[2] = tp->query_cap_name() + " " + action[0] + 
               "s at you.";
            break;
      }
      effect(LOCAL, tp, action_strs[0], action_strs[1], doee, action_strs[2]);
   }
   return SUCCEED;
}


// To be implemented elsewhere, or later , or something... TBD
int
read(string read_str)
{
   if (!read_str) 
   {
      notify_fail("What shall I read?\n");
      return FAIL;
   }
   else 
   {
      string *action_strs;
      action_strs = ({"you read aloud", 
              this_player()->query_cap_name() + " reads aloud"});
      communicate(LOCAL, read_str, action_strs );
      return SUCCEED;
   }
}   

