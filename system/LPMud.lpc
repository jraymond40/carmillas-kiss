int    save_ed_setup(object who, int code)                    { return 0; }
int    retrieve_ed_setup(object who)                          { return 0; }
string get_root_uid()                                         { return "root"; }
string creator_file(string str)                               { return "root"; }
string get_bb_uid()                                           { return "backbone"; }
string get_wiz_name(string file)                              { return 0; }
string master_create_wizard(string owner, string domain, object caller)   { return 0; }
