#pragma strict_types

#include <config.h>
#include "ticketwindow.h"

void welcome();
void info_menu();
void show_in_progress();
void ticketholder_prompt();
void password_prompt();
void process_input_line(string input_str);

private nosave int    failed_attempts;
private nosave string name;
private nosave string user_class;
private nosave object user_obj;
private nosave object new_user;
private nosave string buf;
private nosave int    stage;
private nosave int    boxoffice;

/* --- Curses Emulation Screen Buffer --- */
private nosave int    cursor_y = 0;
private nosave int    cursor_x = 0;
private nosave int    term_rows = 24;
private nosave int    term_cols = 80;
private nosave string *screen_buffer;

/*
 * Curses Emulation Primitives
 */
void clear() {
    screen_buffer = allocate(term_rows, (: sprintf("%-*s", term_cols, " ") :));
    cursor_y = 0;
    cursor_x = 0;
}

void move(int y, int x) {
    if (y >= 0 && y < term_rows) cursor_y = y;
    if (x >= 0 && x < term_cols) cursor_x = x;
}

varargs void mvprintw(int y, int x, string str, mixed a1, mixed a2, mixed a3, mixed a4) {
    if (a1) {
        str = sprintf(str, a1, a2, a3, a4);
    }
    move(y, x);
    if (cursor_y >= term_rows) return;

    string line = screen_buffer[cursor_y];
    int len = strlen(str);

    if (cursor_x + len > term_cols) {
        len = term_cols - cursor_x;
        if (len < 0) len = 0;
        str = str[0..len - 1];
    }

    screen_buffer[cursor_y] = line[0..cursor_x - 1] + str + line[cursor_x + len..];
    cursor_x += len;
    write(implode(screen_buffer, "\n"));
}

varargs void printw(string str, mixed a1, mixed a2, mixed a3, mixed a4) {
    mvprintw(cursor_y, cursor_x, str, a1, a2, a3, a4);
}

void refresh() {
    string out = CURS_HOME;
    for (int r = 0; r < term_rows; r++) {
        out += CURS_MOVE(r + 1, 1) + screen_buffer[r];
    }
    // Park hardware cursor at logical cursor coordinate (1-indexed)
    out += CURS_MOVE(cursor_y + 1, cursor_x + 1);
    tell_object(this_object(), out);
}

void raw()   { /* FluffOS handles raw socket stream */ }
void noecho() { /* Controlled via input_to() flag */ }
void scrollok(mixed win, int flag) { /* Virtual screen buffer handles boundary checks */ }

/*
 * Clock & Theater State
 */
void show_clock(int secs_remaining, int y, int x, string text) {
    int min, sec;
    string clock_str;

    min = secs_remaining / 60;
    sec = secs_remaining % 60;
    clock_str = sprintf("%s%02d:%02d", text, min, sec);
    mvprintw(y, x, clock_str);
    refresh();
}

void clock() {
    // object dir = find_object(DIRECTOR_OBJ);
    // if (!dir) return;

    // if (boxoffice == CLOSED) {
    //     if ((int)dir->query_accepting_players() == TRUE) {
    //         boxoffice = OPEN;
    //         welcome();
    //     } else {
    //         boxoffice = CLOSED;
    //         show_clock(GAME_LENGTH - (int)dir->gametime() + 120, CLOSED_CLOCK_Y, CLOSED_CLOCK_X, CLOSED_STR);
    //     }
    // } else {
    //     if ((int)dir->query_accepting_players() == FALSE) {
    //         boxoffice = CLOSED;
    //         show_in_progress();
    //     } else {
    //         boxoffice = OPEN;
    //         show_clock((int)dir->seconds_until_showtime(), OPEN_CLOCK_Y, OPEN_CLOCK_X, OPEN_STR);
    //     }
    // }
    object dir;
    int secs = 0;

    dir = find_object(DIRECTOR_OBJ);
    if (!dir) {
        catch(call_other(DIRECTOR_OBJ, "???"));
        dir = find_object(DIRECTOR_OBJ);
    }

    if (boxoffice == CLOSED) {
        if (dir && (int)dir->query_accepting_players() == TRUE) {
            boxoffice = OPEN;
            welcome();
            return;
        } else {
            boxoffice = CLOSED;
            if (dir) {
                secs = GAME_LENGTH - (int)dir->gametime() + 120;
            } else {
                secs = 120;
            }
            show_clock(secs, CLOSED_CLOCK_Y, CLOSED_CLOCK_X, CLOSED_STR);
        }
    }
}

void prompt_next_input(int hidden_echo) {
    input_to("process_input_line", hidden_echo ? 1 : 0);
}

void press_any_key() {
    mvprintw(20, 0, "                                                                               ");
    mvprintw(21, 0, "     < Press [Enter] to continue. >                                           ");
    mvprintw(22, 0, "                                                                               ");
    while (remove_call_out("clock") != -1);
    clock();
    prompt_next_input(0);
}

void whos_in() {
    object *plist;
    int x, y, z;

    plist = users();
    clear();
    mvprintw(0, 0, "Characters currently in the theatre:\n====================================\n");

    for (y = 0, x = 0, z = 0; z < sizeof(plist); y++, x++, z++) {
        if (x > 2) x = 0;
        mvprintw(to_int((y / 3) + 0.1) + 3, x * 12, (string)plist[z]->query_cap_name());
    }

    stage = STG_INFO_MENU;
    press_any_key();
}

void password_prompt() {
    mvprintw(PASSWORD_PROMPT_Y, 0, "Password:                                                                       ");
    move(PASSWORD_PROMPT_Y, PASSWORD_PROMPT_X);
    refresh();
    prompt_next_input(1); // Hidden input for password
}

void ticketholder_prompt() {
    mvprintw(TICKETHOLDER_PROMPT_Y, 0, "Ticket Holder:                                                                  ");
    mvprintw(PASSWORD_PROMPT_Y, 0, "                                                                                ");
    move(TICKETHOLDER_PROMPT_Y, TICKETHOLDER_PROMPT_X);
    refresh();
    prompt_next_input(0);
}

void show_file(string file) {
    clear();
    string content = read_file(file);
    if (content) {
        string *lines = explode(content, "\n");
        for (int i = 0; i < sizeof(lines) && i < term_rows - 3; i++) {
            mvprintw(i, 0, lines[i]);
        }
    }
    press_any_key();
}

void welcome() {
    clear();
    show_file(INFO_DIR + "welcome");
    while (remove_call_out("clock") != -1);
    clock();
    ticketholder_prompt();
    stage = STG_LOGIN;
}

void show_in_progress() {
    // clear();
    // debug_message("about to show contents of '"+INFO_DIR + "show_in_progress'\n");
    // string content = read_file(INFO_DIR + "show_in_progress");
    // debug_message(content + "\n");
    // if (content) {
    //     string *lines = explode(content, "\n");
    //     for (int i = 0; i < sizeof(lines) && i < term_rows - 3; i++) {
    //         mvprintw(i, 0, lines[i]);
    //     }
    // }
    // stage = STG_CLOSED;
    // while (remove_call_out("clock") != -1);
    // clock();
    // prompt_next_input(0);
    show_file(INFO_DIR + "show_in_progress");
    stage = STG_CLOSED;

    mvprintw(21, 0, "  Type ? for information:\n");

    while (remove_call_out("clock") != -1);
    clock();
    call_out("clock", CLOCK_UPDATE);

    refresh();
    move(21, 27);
    refresh();

    prompt_next_input(0);
}

void timeout(object *objs) {
    if (failed_attempts >= MAX_FAILURES) {
        tell_object(this_object(), "\nYou seem to be having difficulties.\nPlease contact us at " + RIT_VOICE_PHONE + "\n or " + RIT_EMAIL_ADDRESS + " if they persist.\n");
        write_file(LOG_DIR + "failed_login.log", "Failed login attempt from " + query_ip_number() + " at " + ctime(time()) + "\n");
    } else {
        tell_object(this_object(), "\nInactivity Timeout.\n");
    }

    while (remove_call_out("clock") != -1);
    while (remove_call_out("timeout") != -1);

    for (int x = 0; x < sizeof(objs); x++) {
        if (objs[x]) destruct(objs[x]);
    }
}

void switch_to_user() {
    object loc;
    int res;

    loc = find_object(STARTING_LOCATION);
    if (!loc) {
        string err = catch(call_other(STARTING_LOCATION, "???"));
        if (err) {
            write_file(ERROR_LOG, "ERROR: " + err + ": logon.c unable to load: " + STARTING_LOCATION + "\n");
            shutdown();
        }
        loc = find_object(STARTING_LOCATION);
    }

    // Restore terminal scroll and clear screen prior to handoff
    tell_object(this_object(), CURS_RESET_SCROLL + CURS_CLEAR + CURS_HOME);

    if (user_class == GUEST_OBJ) {
        user_obj->initialize(loc, this_object());
    } else {
        user_obj->initialize(loc, name);
    }

    res = exec(user_obj, this_object());
    user_obj = 0;

    if (user_class != GUEST_OBJ) {
        timeout(({ this_object() }));
    } else {
        while (remove_call_out("timeout") != -1);
    }
}

void login_check(string str) {
    int error;

    if (str == "guest" || str == "Guest") {
        user_class = GUEST_OBJ;
    } else if (str == "who" || str == "Who") {
        whos_in();
        return;
    } else if (str == "admin" || str == "add") {
        user_class = ADMIN_OBJ;
    } else {
        user_class = PLAYER_OBJ;
    }

    name = str;
    stage = STG_VERIFY_PASSWD;

    error = catch(user_obj = clone_object(user_class));
    if (error) {
        write_file(ERROR_LOG, "ERROR# " + error + ": ticketwindow.c unable to clone: " + user_class + "\n");
        ticketholder_prompt();
        return;
    }

    if (user_class == GUEST_OBJ) {
        switch_to_user();
        return;
    }

    if ((int)user_obj->restore(str) != SUCCEED) {
#ifdef BETAMODE
        if (user_class == ADMIN_OBJ) {
            mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0, "  - Define admin password -                         ");
            stage = STG_SET_PASSWD;
        }
#endif
    }

    password_prompt();
}

void passwd_check(string str) {
    if ((int)user_obj->verify_password(str) != SUCCEED) {
        boxoffice = OPEN;
        if (user_obj) destruct(user_obj);
        user_class = PLAYER_OBJ;
        stage = STG_LOGIN;

        if (++failed_attempts >= MAX_FAILURES) {
            timeout(({ this_object(), user_obj }));
            return;
        }

        mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0, "No such ticketholder with that password.                 ");
        ticketholder_prompt();
    } else {
        if (name == "add") {
            mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0, " - Add new ticketholder -");
            stage = STG_ADD_PLAYER;
            ticketholder_prompt();
            return;
        }

        object *p = users();
        for (int i = 0; i < sizeof(p); i++) {
            if (p[i] != this_object() && (string)p[i]->query_ticketholder() == (string)user_obj->query_ticketholder()) {
                destruct(user_obj);
                stage = STG_LOGIN;
                if (++failed_attempts >= MAX_FAILURES) {
                    timeout(({ this_object(), user_obj }));
                    return;
                }
                mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0, "Sorry, ticketholder already in theatre.              ");
                ticketholder_prompt();
                return;
            }
        }
        switch_to_user();
    }
}

void passwd_set(string str) {
    if ((int)new_user->set_password(str) == FAIL) {
        mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0, " - Invalid password, try another -                                          ");
        password_prompt();
    } else {
        new_user->quit();
        mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0, "Ticketholder created, another?                                                ");
        stage = STG_ADD_PLAYER;
        ticketholder_prompt();
    }
}

void add_player(string new_name) {
    int error;

    if (user_obj) destruct(user_obj);
    error = catch(new_user = clone_object(PLAYER_OBJ));
    if (error) {
        write_file(ERROR_LOG, "ERROR# " + error + ": ticketwindow.c unable to clone player object.\n");
        return;
    }

    if ((int)new_user->restore(new_name) == SUCCEED) {
        mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0, "* ERROR * Ticketholder already exists!                                         ");
        ticketholder_prompt();
        return;
    }

    new_user->initialize(this_object(), new_name);
    mvprintw(TICKETHOLDER_PROMPT_Y - 1, 0, "Now define users initial password.                                      ");
    password_prompt();
    stage = STG_SET_PASSWD;
}

void info_menu() {
    clear();
    show_file(INFO_DIR + "info_menu");
    clock();
    stage = STG_MENU_SELECT;
}

/*
 * Line Input Processing Hook
 */
void process_input_line(string input_str) {
    while (remove_call_out("timeout") != -1);
    call_out("timeout", TIMEOUT_TIME, ({ this_object(), user_obj }));

    if (!input_str) input_str = "";

    switch (stage) {
        case STG_WELCOME:
            welcome();
            break;

        case STG_CLOSED:
            if (input_str == "^") welcome();
            else if (input_str == "?") info_menu();
            else show_in_progress();
            break;

        case STG_LOGIN:
            if (input_str == "?") {
                info_menu();
            } else if (strlen(input_str) > 0) {
                login_check(input_str);
            } else {
                ticketholder_prompt();
            }
            break;

        case STG_VERIFY_PASSWD:
            passwd_check(input_str);
            break;

        case STG_ADD_PLAYER:
            if (strlen(input_str) > 0) {
                add_player(input_str);
            } else {
                ticketholder_prompt();
            }
            break;

        case STG_SET_PASSWD:
            passwd_set(input_str);
            break;

        case STG_INFO_MENU:
            info_menu();
            break;

        case STG_MENU_SELECT:
            switch (input_str) {
                case "1":
                    show_file(INFO_DIR + "whatis_RIT");
                    stage = STG_INFO_MENU;
                    break;
                case "2":
                    show_file(INFO_DIR + "system_requirements");
                    stage = STG_INFO_MENU;
                    break;
                case "3":
                    show_file(INFO_DIR + "guest_message");
                    login_check("guest");
                    break;
                case "4":
                    show_file(INFO_DIR + "whatsit_cost");
                    stage = STG_INFO_MENU;
                    break;
                case "5":
                    show_file(INFO_DIR + "payment_methods1");
                    stage = STG_MORE_PAYMENT_METHODS;
                    break;
                case "6":
                    show_file(INFO_DIR + "getan_acct");
                    stage = STG_INFO_MENU;
                    break;
                case "7":
                    whos_in();
                    break;
                case "9":
                    welcome();
                    break;
                default:
                    info_menu();
                    break;
            }
            break;

        case STG_MORE_PAYMENT_METHODS:
            show_file(INFO_DIR + "payment_methods2");
            stage = STG_INFO_MENU;
            break;

        default:
            ticketholder_prompt();
            break;
    }
}

int logon() {
    clear();
    raw();
    noecho();
    scrollok(0, 0);

    user_class = PLAYER_OBJ;
    buf = "";

    object dir = find_object(DIRECTOR_OBJ);
    if (dir && (int)dir->query_accepting_players() == TRUE) {
        boxoffice = OPEN;
        welcome();
    } else {
        boxoffice = CLOSED;
        show_in_progress();
    }

    call_out("timeout", TIMEOUT_TIME, ({ this_object(), user_obj }));
    return 1;
}