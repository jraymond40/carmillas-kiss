query_entrance_txt()
{
   return (
      "You find yourself at the chateaus front desk. " +
      "Behind the counter, a spectacled old woman greets you in a heavy accent. \n" +
      "   \"Velcome! Velcome, to Karnstein Chateau. Vell, " + 
      "such distinvished guests, and on such a dreadful evening.\" says Oma.\n" + 
      "   \"Vhile ve avait zhe rest of your party, I shall prepare zhe kitchen. " + 
      "You ring zhe bell, vhen zhey have arrived, ya?\", the old woman directs you, " +
      "as she smiles briefly, then scurries away.");
}


void 
curtain(mixed sign)
{
   effect(GLOBAL, 0,"",
      "\n" +
      "=======================================================================\n" +
      "|| | | || || || | | || | | | | || || || || || ||| || ||| | | | | | | ||\n" +
      "|| | | || || || | | || | | | | || || || || || ||| || ||| | | | | | | ||\n" +
      "|| | | || || || | | || | | | | || || || || || ||| || ||| | | | | | | ||\n" +
      "|| | | || || || | | || | | | | || || || || || ||| || ||| | | | | | | ||\n" +
      "|| | | || || || | | || | |------------------- ||| || ||| | | | | | | ||\n" +
      "|| | | || || || | | || | ||      "+ (string) sign[0] +"      | ||| || ||| | | | | | | ||\n" +
      "|| | | || || || | | || | ||                 | ||| || ||| | | | | | | ||\n" +
      "|| | | || || || | | || | ||     "+ (string) sign[1] +"     | ||| || ||| | | | | | | ||\n" +
      "|| | | || || || | | || | |------------------- ||| || ||| | | | | | | ||\n" +
      "|| | | || || || | | || | | | | || || || || || ||| || ||| | | | | | | ||\n" +
      "|| | | || || || | | || | | | | || || || || || ||| || ||| | | | | | | ||\n" +
      "\\|_|/-\\||_|/--\\_/\\|_||/--\\_|/-\\||/-\\_|/-/\\_||/-\\|_/\\_|/|/-\\|_/-\\_/\\/-\\/\n");
}

void
show_scores()
{
   int i;
   string results;
   object *player;

   results = "Player Scores:\n";
   player = players();
   for (i=0; i < sizeof(player); i++)
      results = results + player[i]->query_cap_name() + ":   " + player[i]->query_energy() + "\n";
         
   effect(GLOBAL, 0, "",  results); 
}
