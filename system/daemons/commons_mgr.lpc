#include <config.h>
#include <commons.h>
#include <std_defs.h>

//#define COMMONS_MGR_DEBUG

// Function Prototypes
void growth_manager(int x);

int actual_lvl  = COMMONS_STARTING_LEVEL;
int visible_lvl = COMMONS_STARTING_LEVEL;
int time_of_last_update;   // The time of the last commons update
int ttl_growth;            // The total amount the commons has grown in the game
int num_players;           // Number of active num_players  
int coopers;               // How many cooperators this round ? 
int exploiters;            // How many exploited this round ?
int policed;               // Is this round policed and by how many ?
int rewarded;              // How many rewarders this round ? 
object Director;           // The Director object

int  query_visible_level()    { return visible_lvl;       }
int  query_num_players()      { return sizeof(players()); }

void
create()
{
   Director = find_object(DIRECTOR_OBJ);
}

void
restart()
{
   ttl_growth = coopers = exploiters = rewarded = policed = 0;
   actual_lvl = visible_lvl = COMMONS_STARTING_LEVEL;
   num_players = query_num_players();   // Set for the entire game? 
   growth_manager(0);
}

mixed 
potential_earnings()
{
   int coop_min, coop_max; // Cooperators minimum and maximum energy yield
   int expl_min, expl_max; // Exploiters minimum and maximum energy yield 
   int polc_min, polc_max; // Policers minimum and maximum energy yield
   int rwrd_min, rwrd_max; // Rewarders energy yield 
   int wdra;               // Withdrawers energy yield

   num_players = query_num_players();   
   // Not currently accounting for bonus yield per sipper

   // Cooperaters min yield occurs when everyone else exploits
   coop_min = to_int(COOPERATERS_RETURN(visible_lvl));

   // Cooperaters max yield occurs when everyone sips and 1 blows in.
   coop_max = to_int(COOPERATERS_RETURN(visible_lvl) + REWARDERS_REWARD(num_players));

   /* Exploiters min yield occurs when we've been caught     */
   expl_min = to_int(EXPLOITERS_RETURN(1, visible_lvl, num_players));

   /* Exploiters max yield occurs when everyone else coops   */
   expl_max = to_int(EXPLOITERS_RETURN(0, visible_lvl, num_players));

   /* Policing is the most costly when we are the only one doing it */
   polc_min = to_int(POLICERS_RETURN(1, num_players));

   /* Policing costs the least when undertaken by everyone */
   polc_max = to_int(POLICERS_RETURN(num_players, num_players));

   // The cost of rewarding is split amongst the rewarders.
   rwrd_max = to_int(REWARDERS_RETURN(num_players, 1));
   rwrd_min = to_int(REWARDERS_RETURN(num_players, num_players));

   wdra = to_int(WITHDRAWERS_RETURN(num_players));

   return( ({ coop_min, coop_max, expl_min, expl_max, polc_min, polc_max, rwrd_min, rwrd_max, wdra }) );
}

//
// Update the 'actual' simulated biological commons resource.
// (but not necessarily the one visible to the player).
//
void 
grow_commons()
{
   int i, time_now, growth;
   set_eval_limit(0); // If it's been a long time since this has been calc'd
                 // it can cause problems w/ the eval limit test so disable it.
   time_now = Director->gametime();
#ifdef COMMONS_MGR_DEBUG
   write("time now: " + time_now + "   time of last commons update: " + time_of_last_update + "\n");
#endif

   // Grow the commons since last update.
   for (i=0; i< (time_now - time_of_last_update); i++)
   {
      // First take out whatever was taken at this second.
      actual_lvl -= exploiters * (EXPLOITERS_HARVEST/ELIXIR_EFFECT_LENGTH);
      visible_lvl -= exploiters * (EXPLOITERS_HARVEST/ELIXIR_EFFECT_LENGTH);

      growth = COMMONS_GROWTH_COEFF * actual_lvl *       
         (COMMONS_MAX_LEVEL -  actual_lvl);

      ttl_growth += growth;
      actual_lvl += growth;
   }
   time_of_last_update = time_now;
   set_eval_limit(STD_MAX_EVAL_LIMIT); // Now, re-inact the limit.
}

void
announce_change(int lvl_diff)
{
   string lvl_str;


   if (lvl_diff != 0)
   {
      lvl_str = "You suddenly realize that the flask feels ";
      if (lvl_diff > -3 * EXPLOITERS_HARVEST && lvl_diff < 3 * EXPLOITERS_HARVEST)  
         lvl_str =  lvl_str + "slightly ";
      else  
         lvl_str =  lvl_str + "significantly ";

      if (lvl_diff > 0)  
         lvl_str =  lvl_str + "heavier!\n";
      else  
         lvl_str =  lvl_str + "lighter...\n";
   }
   effect(GLOBAL, 0, 0, lvl_str);
}

// Player visible growth
// This occurs at irregular intervals, so that the user doesn't depend on them, 
// and because it mirrors nature.
void
growth_manager(int stage)
{
   int delay; 

   switch(stage)
   {
      case 0: delay = to_int(GAME_LENGTH * 1/10); break;
      case 1: delay = to_int(GAME_LENGTH * 3/10); break;
      case 2: delay = to_int(GAME_LENGTH * 2/10); break;
      case 3: delay = to_int(GAME_LENGTH * 1/10); break;
      case 4: delay = to_int(GAME_LENGTH * 2/10); break;
      default: return; break;
   }
   grow_commons();
   announce_change(actual_lvl - visible_lvl);
   visible_lvl = actual_lvl;
   call_out("growth_manager", delay, ++stage);
}

void
effect_wearoff(object tp, int yield)
{
   int rndm;
   rndm = random(10);

   if (rndm < 4)
      effect(INDIV, tp, "The elixir seems to have worn off."); 
   else if (rndm < 7)
      effect(INDIV, tp, "Your beginning to feel normal again.");
   else if (rndm < 9)
      effect(INDIV, tp, "Your system is now clear of the Yliastrum.");
   else 
      effect(INDIV, tp, "All of the elixirs side effects have subsided.");
   tp->add_energy(to_int(yield), tp);
   tp->set_role(WITHDRAW);
}

void
cooper_select(object tp)
{
   num_players = query_num_players();   
   coopers++;
   if (rewarded > 0)
   {
      object *p;
      int i;
      p = users();

      for (i=0; i< sizeof(p); i++)
         if ((int) p[i]->query_role() == REWARD)
            effect(INDIV, p[i], 
               "Blowing into the flask has provided a nearby sipper an increased energy yield.\n");
      effect(INDIV, tp, 
         "You instantly gain an additional energy yield... someone must have blown into the " + 
         "elixir recently.\n");
      tp->add_energy(to_int(REWARDERS_REWARD(num_players)), tp);
    }

//   tp->set_growth_at_consumpt_begin(ttl_growth);
  
   // When the effect wears off, determine the yield and bonus (if any) this player should receive.
   call_out("cooper_result", ELIXIR_EFFECT_LENGTH, ({tp, ttl_growth}));
}

void
cooper_result(mixed *data)
{
   int bonus, yield;

   num_players = query_num_players();   
   grow_commons();

   yield = COOPERATERS_RETURN(actual_lvl);
   effect_wearoff((object) data[0], yield);

   // Growth bonus.
   bonus = to_int((((ttl_growth - (int) data[1]) * 
      COMMONS_SAFE_HARVEST)/(coopers + exploiters)) * 0.6666666) * 
      BONUS_MULTIPLIER;

   effect(INDIV, (object) data[0], "You receive a bonus yield of ~" +
      (num_players - exploiters > 0 ? (bonus/(num_players - exploiters)) : 0) +
      " for each of the " + (num_players - exploiters) + " out of " + num_players + " users that didn't gulp.");

   (object) data[0]->add_energy(bonus, (object) data[0]);
   coopers--;
}

void
exploit_select(object tp)
{
   grow_commons(); // Update the commons to current w/ existing exploiters.
   exploiters++;   // From now - forward include this exploiter.
   if (policed > 0)
   {
      object *p;
      int i;
      p = users();

      for (i=0; i< sizeof(p); i++)
          if ((int) p[i]->query_role() == POLICE)
             effect(INDIV, p[i], 
                "Inhaling from the flask has prevented a nearby gulper from gaining energy from the "  +
                "elixir. All other benefits gulping provides, however, remain in effect.\n");
      effect(INDIV, tp, 
         "You realize that your efforts to gain energy have been thwarted, someone must have inhaled " + 
         "from the flask. The elixirs other effects, however, remain in effect.\n");
   }

   // When the effect wears off, determine the yield and bonus (if any) this player should receive.
   call_out("exploit_result", ELIXIR_EFFECT_LENGTH, ({tp, ttl_growth, policed}));
}

void
exploit_result(mixed *data)
{
   int bonus, yield;
   object tp;

   tp = (object) data[0];

   num_players = query_num_players();   
   grow_commons();

   // Whether policed now, or when we started, include that info here.
   yield =  
      to_int(EXPLOITERS_RETURN(policed + (int) data[2], actual_lvl, num_players));

   effect_wearoff(tp, yield);

   if (yield > 0)
   {
      // Bonus yield.
      if (num_players - exploiters < 1)
         effect( INDIV,tp, "Everyone must have gulped from the flask, because you " + 
            "realize you didn't experience an additional yield.\n");
      else
      {
         bonus = to_int((((ttl_growth - (int) data[1]) * 
                    COMMONS_SAFE_HARVEST)/(coopers + exploiters)) * 1.3333333) *
                    BONUS_MULTIPLIER;

         effect(INDIV, tp, "You receive an additional yield of ~" + 
      (num_players - exploiters > 0 ? (bonus/(num_players - exploiters)) : 0) +
            " for each of the " + (num_players - exploiters) + " out of " + num_players + 
            " users that didn't gulp.");

         tp->add_energy(bonus, tp);
      }
      announce_change(-yield); // Announce the amount we've been draining from the commons.
   }
   exploiters--;
}

void
police_select(object tp)
{
   policed++;
   if (exploiters > 0)
   {
      object *p;
      int i;
      p = users();

      for (i=0; i< sizeof(p); i++)
      {
          if ((int) p[i]->query_role() == EXPLOIT)
          {
             effect(INDIV, p[i],
                "You begin to feel rather odd... your energy is no longer increasing. In fact, " + 
                "it is beginning to drain. Someone must have inhaled from the flask! The elixirs " + 
                "other effects, however, still remain in effect.\n");
          }
      }

      effect(INDIV, tp, "You immediately stop " + how_many(exploiters, "gulper") + " from gaining " + 
                        "energy from the elixir. This, however, does not effect the other abilities " +
                        "the elixir might afford them.\n");
   }

   call_out("police_result", ELIXIR_EFFECT_LENGTH, tp);
}

void
police_result(object tp)
{
   num_players = query_num_players();   
   effect_wearoff(tp, to_int(POLICERS_RETURN(policed, num_players)));
   policed--;
}

void
reward_select(object tp)
{

   num_players = query_num_players();   
   rewarded++;
   if (exploiters > 0)
   {
      object *p;
      int i;

      p = users();

      for (i=0; i< sizeof(p); i++)
      {
          if ((int) p[i]->query_role() == COOPERATE)
          {
             effect(INDIV, p[i], 
                "You begin to feel an extra surge of energy. Someone must have put their energy " + 
                "into the elixir by blowing into the it.\n");
             p[i]->add_energy(to_int(REWARDERS_REWARD(num_players)), p[i]);
          }
      }
      effect(INDIV, tp, "Your energy begins to drain, as you immediately increase the energy " + 
                        "yield of those who have sipped from the elixir.\n");
   }

   call_out("reward_result", ELIXIR_EFFECT_LENGTH, tp);
}

void
reward_result(object tp)
{
   num_players = query_num_players();   
   effect_wearoff(tp, to_int(REWARDERS_RETURN(policed, num_players)));
   rewarded--;
}


