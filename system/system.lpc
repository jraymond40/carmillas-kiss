#pragma strict_types
#include "/includes/config.h"
#include "/includes/std_defs.h"

inherit "system/LPMud";
inherit "system/Amylaar";
inherit "system/MudOS";

int valid_save_binary(string filename) {return 1;}

// Driver refers to this routine to connect a user to the system.
//
// Order of events:
// 1. log in the user
// 2. Transfer to guest, player, or administrator as determined by login.
// 3. return the logged in object to sicose

object connect() 
{
   object user;
   mixed error;
    
   error = catch(user = clone_object(TICKETWINDOW_OBJ));

   if (error) 
   { 
      write("** Fatal error #" + error + " at login.\n");
      shutdown();
   }

   return user;
}

/*
// Function:    Epilog()
// Description:	Loads master data, including connection list & preloaded places
// Arguments:	load_empty: If true, epilog() does no preloading
// Return:      List of ".c" files to preload
*/
string *epilog(int load_empty)
{
   string *objs, str;
   int i;

   if (load_empty)
   {
      write("** Pre-loading not requested.\n");
      return ({});
   }

   if (! (str = read_file(PRELOAD_LST)) )  
   {
      write("** " + PRELOAD_LST + " not found.\n");
      return ({});
   }

   objs = explode(str, "\n");
   for (i=0; i < sizeof(objs); i++)
      if (objs[i][0] == '#') objs[i] = 0;

   return objs;
}

/*
// Preload objects
*/
void preload(string file)
{
    int t;
    string error;
    object obj;

    if (file_size(file + ".c") == -1) return;

    t = time();
    write("Preloading: " + file + "\n");
    error = catch(call_other(file, "??"));
    if (error != 0) 
	write("** Error #" + error + " encountered upon loading of " + 
              file + "\n");
    else 
    {
        obj = find_object(file);
        if (obj)
           if ((int) obj->query_object_type() == LOCATION || 
               (int) obj->query_object_type() == STAGE)
              obj->initialize(0);

	t = time() - t;
	write(">" + t/60 + "." + t % 60 + "<\n");
    }
}

string get_simul_efun() 
{
   string error;
   if (error = catch(call_other(LIBRARIES, "??"))) 
   {
      write("Failed to load " + LIBRARIES + "\n");
      write("error message :" + error + "\n");
      shutdown();
      return 0;
   }
   return LIBRARIES;
}

/*
 * Function name:   save_player
 * Description:     Saves a player object.
 */
int
save_player()
{
    int res;
    object pobj;

    pobj = previous_object();

    if (function_exists("save_player", pobj) !=  "/objects/living/users/player")
	  return 0;
    else
    {
	export_uid(pobj);
	res = (int)pobj->save_player(pobj->query_real_name());
	seteuid((string)pobj->query_real_name());
	export_uid(pobj);
	seteuid(get_root_uid());
	return res;
    }
}

int load_player_from_file(string name, object player) 
{
    int res;

    export_uid(player);
    res = (int)player->actually_restore_player(name);
    seteuid(name);
    export_uid(player);
    seteuid(get_root_uid());
    return res;
}

void save_player_to_file(string name, object player) 
{
    if (!seteuid(get_root_uid()))
	write("** Seteuid failed!\n");
    export_uid(player);
    player->actually_save_player(name);
    seteuid(name);
    export_uid(player);
    seteuid(get_root_uid());
}


/*
 * Define where the '#include' statement is supposed to search for files.
 * "." will automatically be searched first, followed in order as given
 * below. The path should contain a '%s', which will be replaced by the file
 * searched for.
//
// This should be called much sooner by the engine so that it can be used
// for all files inherited into master, for the simul_efun, etc.
*/
string *define_include_dirs()       { return ({"/includes/%s"}); }


/*
 * To test a new function xx in object yy, do
 * parse "-fcall yy xx arg" "-fshutdown"
 */
void 
flag(string str) 
{
    string file, arg;
    int num_arg;

    if (sscanf(str, "for %d", num_arg) == 1) {
	write("Got : " + catch(this_object()->xx(num_arg)) + "\n");
	return;
    }
    if (str == "shutdown") {
	shutdown();
	return;
    }
    // Call -fmk_rt_tbl once new locations have been added to
    // regenerate the routing table (or else just delete routing.tbl)
    if (str == "mk_rt_tbl") 
    {
       int error;
       object Navigate;

       error = catch(call_other(NAVIGATE_OBJ, "??"));
       if (error != 0) 
	  write("** Error #" + error + " encountered upon loading of navigate daemon.\n");
       else find_object(NAVIGATE_OBJ)->make_routing_tbl();
       return;
    }
    if (sscanf(str, "echo %s", arg) == 1) {
	write(arg + "\n");
	return;
    }
    if (sscanf(str, "call %s %s", file, arg) == 2) {
	arg = (string)call_other(file, arg);
	write("Got " + arg + " back.\n");
	return;
    }
    write("master: Unknown flag " + str + "\n");
}

