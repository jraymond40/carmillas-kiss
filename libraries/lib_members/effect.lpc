#pragma strict_types

#include <config.h>
#include <std_defs.h>

#define EFFECT_BANNER_ROW    11
#define EFFECT_BANNER_COLS   80

/* Terminal Sensory Controls */
#define TERM_BELL            "\007"
#define TERM_FLASH           CSI "?5h" CSI "?5l"       // Screen flash (reverse video toggle)
#define TERM_INVERT_ON       CSI "?5h"
#define TERM_INVERT_OFF      CSI "?5l"

#ifndef GLOBAL
#define GLOBAL               8  // Mudlib-wide / Everywhere
#endif
#define INDIVIDUAL           1  // Single target object
#define ROOM                 2  // Current room environment
#define VICINITY             4  // Room and adjacent locations

// Prototypes/* Effect Bitmask Types */
#define FX_NONE              0
#define FX_BELL              (1 << 0)  // 1
#define FX_FLASH             (1 << 1)  // 2
#define FX_SHAKE             (1 << 2)  // 4
#define FX_ALL               (FX_BELL | FX_FLASH | FX_SHAKE)

varargs void effect(int scope, object center, string visual_msg, string sound_or_audible_msg, int fx_type);
private void deliver_effect(object who, string visual_msg, string sound_or_audible_msg, int fx_type);
private void draw_effect_banner(object who, string text);
object *uniq_array(object *arr);


/*
 * Deliver effect to an individual user
 */
private void deliver_effect(object who, string visual_msg, string sound_or_audible_msg, int fx_type) {
    if (!who || !interactive(who)) return;

    string fx_packet = "";

    // 1. Audio / Bell cues
    if (fx_type & FX_BELL) {
        fx_packet += TERM_BELL;
    }

    // 2. Visual Strobe / Flash
    if (fx_type & FX_FLASH) {
        fx_packet += TERM_FLASH;
    }

    if (strlen(fx_packet)) {
        tell_object(who, fx_packet);
    }

    // 3. Visual Banner / Text Overlay
    if (visual_msg && strlen(visual_msg)) {
        if (function_exists("query_curses", who) && (int)who->query_curses()) {
            draw_effect_banner(who, visual_msg);
        } else if (function_exists("handle_messages", who)) {
            who->handle_messages(visual_msg);
        } else {
            tell_object(who, visual_msg + "\n");
        }
    }

    // 4. Ambient / Sound Description Text
    if (sound_or_audible_msg && strlen(sound_or_audible_msg)) {
        if (function_exists("handle_messages", who)) {
            who->handle_messages(sound_or_audible_msg);
        } else {
            tell_object(who, sound_or_audible_msg + "\n");
        }
    }
}

/*
 * Draw centered visual banner across row 11 in emulated curses mode
 */
private void draw_effect_banner(object who, string text) {
    if (!text || !who) return;

    string clean_text = replace_string(replace_string(text, "\r", ""), "\n", " ");
    int len = strlen(clean_text);
    int col = 1;

    if (len < EFFECT_BANNER_COLS) {
        col = (EFFECT_BANNER_COLS - len) / 2;
    } else {
        clean_text = clean_text[0..EFFECT_BANNER_COLS - 1];
    }

    // Move to designated banner line, render reverse video, then restore cursor
    string banner = CURS_SAVE +
                    CURS_MOVE(EFFECT_BANNER_ROW, 1) +
                    CURS_CLEAR_TO_EOL +
                    CURS_MOVE(EFFECT_BANNER_ROW, col) +
                    CURS_REVERSE + clean_text + CURS_RESET +
                    CURS_RESTORE;

    tell_object(who, banner);

    // Also push the notification into the scrolling event buffer
    if (function_exists("handle_messages", who)) {
        who->handle_messages("[EFFECT] " + clean_text);
    }
}

/*
 * Main entry point: effect()
 *
 * Scope definitions:
 *   GLOBAL    - Every interactive player online
 *   ROOM      - Players present in the current room/environment
 *   VICINITY  - Players in the room and adjacent coordinates
 *   INDIVIDUAL- Targets 'center' specifically
 */
varargs void effect(int scope, object center, string visual_msg, string sound_or_audible_msg, int fx_type) {
    object *recipients = ({ });

    switch (scope) {
        case GLOBAL:
            recipients = filter(users(), (: interactive($1) :));
            break;

        case INDIVIDUAL:
            if (center && interactive(center)) {
                recipients = ({ center });
            }
            break;

        case ROOM:
            if (center) {
                object env = environment(center);
                if (!env && center->is_location()) env = center;
                if (env) {
                    recipients = filter(all_inventory(env), (: interactive($1) :));
                }
            }
            break;

        case VICINITY:
            if (center) {
                object current_loc = environment(center);
                if (!current_loc && center->is_location()) current_loc = center;

                if (current_loc) {
                    // Collect occupants from current location
                    recipients = filter(all_inventory(current_loc), (: interactive($1) :));

                    // Query adjacent locations if supported by navigation/location classes
                    if (function_exists("query_adjacent_locations", current_loc)) {
                        object *adjacent = (object *)current_loc->query_adjacent_locations();
                        if (sizeof(adjacent)) {
                            foreach (object loc in adjacent) {
                                if (loc) {
                                    recipients += filter(all_inventory(loc), (: interactive($1) :));
                                }
                            }
                        }
                    }
                }
            }
            break;

        default:
            recipients = filter(users(), (: interactive($1) :));
            break;
    }

    // Deduplicate recipient list and deliver
    recipients = uniq_array(recipients);
    foreach (object target in recipients) {
        deliver_effect(target, visual_msg, sound_or_audible_msg, fx_type);
    }
}