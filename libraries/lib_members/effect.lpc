#include "/includes/config.h"   // Full include pathnames required here as
#include "/includes/std_defs.h" // the std path isn't known to the engine yet. 
#include "/includes/curses.h"

//#define EFFECT_DEBUG

private nosave int    between_acts;
private nosave int    cutto_in_effect;
private nosave object location_cutto;

//  The effects objects have on the environment.
//  effect(range, doer, doer_perception, 
//                viewer_perception, 
//                doee, doee_perception)
//
//  range	Range of effect... OUTSIDE | INDIV | GLOBAL | LOCAL | RADIUS (TBD) 
//	                             -3       -2      -1       0      (1-n)
//
//  OUTSIDE     Effects perceived by everyone outside the location_cutto
//  INDIV       Effects perceived by the individual only
//  GLOBAL      Effects perceived by everyone
//  LOCAL       Effects perceived by those in this location
//  Radius      Effects perceived by those in radially adjacent locations TBD
//
//  doer		Action initiater
//  doer_perception	Initiaters perception
//
//  viewer_percepetion	Everyone else's perception
//
// Optional:
//
//  doee		Action receiver
//  doee_perception 	Receivers perception
//
public
varargs
void 
effect(int range, object doer, string doer_perceptions, string viewer_perceptions, object doee, string doee_perceptions)
{
   int i;
   int rndm;
   object *character; /* The list of characters in the immediate environment */
   object loc; // This location.

   if (range == GLOBAL || 
      (cutto_in_effect && (doer ? environment(doer)==location_cutto : TRUE)) || 
       range == OUTSIDE)
   {
      // Find all the interactive users, and eliminate logon objects.
      object *tmp;
      int     j, character_size;
      tmp = users();
      for (i=0, character_size=0; i< sizeof(tmp); i++)
         if ((int) tmp[i]->query_human_type() != FALSE) character_size++;
      character = allocate(character_size);
      for (i=0, j=0; i< sizeof(tmp); i++)
         if ((int) tmp[i]->query_human_type() != FALSE) character[j++] = tmp[i];      
   }
   else if (range == LOCAL)
   {
      if (doer) loc = environment(doer);
      if (loc) character = all_inventory(loc);
      else if (doer) character = all_inventory(doer); // 'doer' is actually a loc.
   }
   else if (range == INDIV)
// was:      character = loc = doer;
      loc = doer;
   else { /* Set up a variable range function here. */ }

   /* If we've specified a doer ... */
   if (doer && loc)
   {
      /* Make sure they're conscious, otherwise... */
      if (! (int) doer->conscious() && ((int) doer->query_object_type() == LIVING)) 
      {
         doer_perceptions = "Despite your efforts, nothing happens.\n";
         rndm = random(10);
         if (rndm < 4)
            viewer_perceptions = doer->query_cap_name() + " twitches faintly.\n";
         else if (rndm < 8)
            viewer_perceptions = doer->query_cap_name() + " mumbles in " + 
            doer->query_possessive() + " unconscious state.\n";
         else
            viewer_perceptions = doer->query_cap_name() + " emits an ever so slight groan.\n";
      }
   }

   /* Handle all objective effects (LOCAL, GLOBAL, OUTSIDE, & Range) */
   if ( range != INDIV && character)
   {
      for (i=0; i < sizeof(character); i++) 
      {
#ifdef EFFECT_DEBUG
         write_file(ERROR_LOG, "Message sent to " + (string) character[i]->query_short() + "\n");
#endif
         /* Here's what I see and hear of what I do */
         if (character[i] == doer)
         { 
            if (doer_perceptions != "") tell_object(doer, "   " + doer_perceptions + "\n");
         }
         /* Here's what other unconscious participants perceive */
         else if (!(int) (character[i]->conscious()) && !cutto_in_effect ) 
         {
            tell_object(character[i], ".\n");
         }
         /* Here's what the action receiver perceives */
         else if (doee && character[i] == doee)
         { 
            tell_object(doee, "   " + doee_perceptions + "\n");
         }
         /* Here's how the rest of the conscious world perceives my actions */
         else if (viewer_perceptions)
         {
            if (cutto_in_effect && location_cutto != environment(character[i])) 
               tell_object(character[i], "   " + viewer_perceptions + "\n");
            else if (range == OUTSIDE && location_cutto == environment(character[i])) 
               {} /* No messages to people within this room */
            else
               tell_object(character[i], "   " + viewer_perceptions + "\n");
         }
      }
   }
   /* Handle subjectively perceived effects (INDIV) */
   else 
   {

#ifdef EFFECT_DEBUG
         write_file(ERROR_LOG, "Message sent to " + doer->query_short() + "\n");
#endif
      if (doer && doer_perceptions != "") 
         tell_object(doer, "   " + doer_perceptions + "\n");
   }

#ifdef EFFECT_DEBUG
         write_file(ERROR_LOG, "-----Effect complete.\n");
#endif
   return;
}

public
int
valid_action(object tp)
{
   int valid;

   valid = tp->conscious();

   if (! valid) 
      notify_fail("Despite your efforts, nothing happens.\n");

   /* No response to actions when in locations not in the "cut" */
   if ((cutto_in_effect && location_cutto != environment(tp)) || between_acts) 
   {
      notify_fail("");
      if ((int) tp->query_human_type() == NPC) valid = TRUE;
      else valid = FALSE;
   }

   return valid;
}

public
void
set_dfltport_mode(int s, int m)
{
   int     i;
   object *list;

   list = users();

   for (i = 0; i < sizeof(list); i++)
   {
      if (s == ON) portattron((portptr) list[i]->query_eventport(), m);
      else portattroff((portptr) list[i]->query_eventport(), m);
   }
}

public
void
cutto(string location_id)
{
   string location_desc;
   return;

   location_cutto = find_object(LOCATION_DIR + LOCATION_PREFIX + location_id);
   location_desc  = location_cutto->query_short();

   /* Freeze current Yliastrum state */
   find_object(DIRECTOR_OBJ)->set_game_mode(OFF);
   set_dfltport_mode(ON, A_REVERSE);
   effect(OUTSIDE, 0, "",
     "\n" +
     "--------------------------------------------------------------------\n" +
     "||  Meanwhile, in " + location_desc + ".\n" +
     "--------------------------------------------------------------------\n"); 
   cutto_in_effect = TRUE;
   return;
}

public
void
end_cutto()
{
   /* Freeze current Yliastrum state */
   find_object(DIRECTOR_OBJ)->set_game_mode(ON);
   effect(OUTSIDE, 0, "",
      "\n" +
      "--------------------------------------------------------------------\n" +
      "--------------------------------------------------------------------\n");
   set_dfltport_mode(OFF, A_REVERSE);
   cutto_in_effect = FALSE;
#ifdef EFFECT_DEBUG
   write("Effect Lib: end_cutto() completed.");
   write_file(ERROR_LOG, "Effect Lib: end_cutto() completed.");
#endif
   return;
}


public
void
between_acts(int state)
{
   between_acts = state;
}
