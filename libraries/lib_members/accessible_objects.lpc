//=======================================================================\\
//                                                                       \\  
// Filename:    accessible_inventory.c                                   \\
//                                                                       \\
// Description: Returns a pointer to a list of objects which are         \\
//              immediately accessible, that match ANY of the            \\
//              criteria flags in data_mask.                             \\
//                                                                       \\
//              The list functions provide an array of names of          \\
//              actions, people, and objects avaialable to the current   \\
//              user.                                                    \\
// History:                                                              \\
//                                                                       \\
// 09/23/93  jmr                                                         \\
// 12/31/93  jmr Added list functions, need to rename/reorganize this    \\
//               file. NOTE: this_object() is not valid here...          \\
// 01/18/94  jmr Added AND/OR modes.                                     \\
// 08/02/94  jmr Added Locally present, support for shared objects.      \\
// 08/02/94  jmr Added support for "yourself".                           \\
//                                                                       \\
//============== Copyright 1994 ===== Raymond Interactive Theatre, Ltd. =\\
//                                                                       \\
// object *accessible_inventory(int data_mask, int mode, object where)   \\
// string *actions_list()                                                \\
// string *objects_list(tp, int obj_mask, int mode, int where_mask)      \\
// string *living_list()                                                 \\
//                                                                       \\
//=======================================================================\\

#include "/includes/config.h"   // Full include paths are required here since
#include "/includes/std_defs.h" // the std path isn't known to the engine yet.

#define ACCESSIBLE_INVENTORY_DEBUG FALSE

//
// Returns a pointer to a list of objects which are immediately 
// accessible within 'where', and which fit the 'data_mask' 
// (ie. TRANSIENCY, DYNAMACY, LIVING). 
// 'mode' defines whether the object in question should fit:
// TRANSIENCY || DYNAMACY || LIVING to return (OR mode (non-exclusive))
// TRANSIENCY && DYNAMACY && LIVING to return (AND mode)
//
object *
accessible_inventory(int data_mask, int mode, object where) 
{
   int     i, j;
   int     closed, matches;
   int     holder_list_size;
   object *holder_list, *shared_objs, *visible_list, *return_list;
   object  tmp;

   if (!where) return 0;
   else if (!objectp(where)) return 0;

   if(ACCESSIBLE_INVENTORY_DEBUG == TRUE)
      write("Checking contents of " + (string) where->query_short() + "\n");

   // Provide for the shared objects concept.
   // Note: Doesn't provide for shared objects themselves having shared 
   //       objects, until we modify deep inventory.
   shared_objs = where->query_shared_objects();
   if (shared_objs)
   {
      int index, num_shared_objs;
      mixed  *shared_objs_invs;
      object *offspring_objs;
      
      num_shared_objs = sizeof(shared_objs);
      holder_list_size = num_shared_objs;
      shared_objs_invs = allocate(num_shared_objs);

      for (i = 0; i < num_shared_objs; i++)
      {
         // It is possible that the shared object really no longer exists.
         // It's our job to verify and remove it from the list, if it doesn't.
         if (shared_objs[i])
         {
            shared_objs_invs[i] = deep_inventory(shared_objs[i]);
            holder_list_size += sizeof(shared_objs_invs[i]);
         }
         else where->remove_shared_object(shared_objs[i]);
      }
         
      offspring_objs = deep_inventory(where); 
      holder_list_size += sizeof(offspring_objs);

      holder_list = allocate(holder_list_size);
 
      // Items accessible here are those in this items inventory...
      for (i = 0, index = 0; i < sizeof(offspring_objs); i++)
         holder_list[index++] = offspring_objs[i];

      // Plus any shared objects...
      for (i = 0; i < num_shared_objs; i++)
         holder_list[index++] = shared_objs[i];

      // Plus the inventories of the shared objects.
      for (i = 0; i < num_shared_objs; i++)
         for (j = 0; j < sizeof(shared_objs_invs[i]); j++)
            if (shared_objs_invs[i][j])
               holder_list[index++] = shared_objs_invs[i][j];
   }
   else
   {
      holder_list = deep_inventory(where);
      holder_list_size = sizeof(holder_list);
   }

   // Can't need any larger than this...
   visible_list = allocate(holder_list_size);
   for (i = 0; i < holder_list_size; i++)
   {
      closed = FALSE;
      tmp = holder_list[i];
      if (!tmp) continue;
      do
      {
         tmp = environment(tmp);
         if (tmp)
         {
            if (function_exists("query_closed", tmp))
               if ((int) tmp->query_closed() == TRUE) 
                  closed = TRUE;
         }
      }
      while (tmp && tmp != where && !closed);

      if (tmp == where || !tmp || !closed)
      {
         matches = 0;
         if (data_mask & (int) holder_list[i]->query_transiency())
         {
            if (ACCESSIBLE_INVENTORY_DEBUG == TRUE)
               write(holder_list[i]->query_short() + 
               " fits transiency criteria.\n");
            matches++;
         }
         if (data_mask & (int) holder_list[i]->query_dynamacy())    
         {
            if (ACCESSIBLE_INVENTORY_DEBUG == TRUE)
               write(holder_list[i]->query_short() + 
               " fits dynamacy criteria.\n");
            matches++;
         }
         if (data_mask & (int) holder_list[i]->query_object_type()) 
         {
            if (ACCESSIBLE_INVENTORY_DEBUG == TRUE)
               write(holder_list[i]->query_short() + 
               " fits living/inanimate criteria.\n");
            matches++;
         }

         if (  (mode == OR  && matches >  0) 
            || (mode == AND && matches == 3) )
         {
            if (ACCESSIBLE_INVENTORY_DEBUG == TRUE)
               write(holder_list[i]->query_short() + " fits criteria.\n");
            visible_list[j++] = holder_list[i];
         }
      }
   }
   // Assure the array is the _exact_ size we need - functions depend on it.
   return_list = allocate(j);
   for (i = 0; i < j; i++) return_list[i] = visible_list[i];
   return return_list;
}

//
// Find an accessible object that meets this 'id'.
// (a recursive present() ).
//
#define PRESENT_DEBUG  FALSE

object
locally_present(mixed what, mixed where) 
{
   int     i,j;
   object *holder_list, *contents_list;
   string  id_str;

   if (!what) return 0; 
   else if (stringp(what))
      id_str = what;
   else if (objectp(what))
      id_str = what->query_primary_id();
   else return 0;

   if (!where)
      holder_list = ({this_player(), environment(this_player()) });
   else if (objectp(where))
      holder_list = ({where});
   else if (pointerp(where))
      holder_list = where;
   else return 0;

   for (i = 0; i < sizeof(holder_list); i++)
   {
      if(PRESENT_DEBUG == TRUE)
         write("Checking " + (string) holder_list[i]->query_short() + 
         " for " + id_str + "\n");

      contents_list = accessible_inventory(ALL, OR, holder_list[i]); 

      for(j = 0; j < sizeof(contents_list); j++)
         if (member_array(id_str, (mixed *) (contents_list[j]->query_id()) ) != -1)
            return contents_list[j];
   }
   return 0;
}

string *
actions_list(mixed *commands_result)
{
   // This function will err if the *>[say] action is not available to the user
   int i, j;
   string *list;
   /* The *>[say] cmd is implied and not listed here. */
   list = allocate(sizeof(commands_result) - 1);
   if (sizeof(list) <= 0) return ({""});
   for (i = 0, j = 0; i < sizeof(commands_result); i++)
      if (commands_result[i][0] != "*>[say]")
         list[j++] = commands_result[i][0];
   return list;
}

string *
objects_list(object player, int obj_mask, int mode, int where_mask)
{
   object *result1, *result2;
   string *list;
   int i, j;

   if (where_mask & INVENTORY)
      result1 = accessible_inventory(obj_mask, mode, player);
   if (where_mask & IMMEDIATE)
      result2 = accessible_inventory(obj_mask, mode, environment(player));

   list = allocate(sizeof(result1) + sizeof(result2));

   for (i = 0, j = 0; i < sizeof(result1); i++)
   {
      if ((int) result1[i]->query_object_type() == LIVING)
      {
         if (player == result1[i]) list[j++] = "yourself";
         else list[j++] = result1[i]->query_cap_name();
      }
      else list[j++] = result1[i]->query_primary_id();
   }

   for (i = 0; i < sizeof(result2); i++)
   {
      if ((int) result2[i]->query_object_type() == LIVING)
      {
         if (player == result2[i]) list[j++] = "yourself";
         else list[j++] = result2[i]->query_cap_name();
      }
      else list[j++] = result2[i]->query_primary_id();
   }

   return (j == 0 ? ({""}) : list);
}

string *
living_list(object player)
{
   object *result;
   string *list;
   int i;

   result = accessible_inventory(LIVING, OR, environment(player));
   // Assuming we too are in this room... so return 'yourself'
   list = allocate(sizeof(result));
   for (i = 0; i < sizeof(result); i++)
   {
       if (result[i]->query_cap_name() == player->query_cap_name())
          list[i] = "yourself";
       else list[i] = result[i]->query_cap_name();
   }
   return list;
}


