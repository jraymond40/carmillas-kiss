// Add these to your mudlib's simul_efun.c file

/**
 * Emulates the ancient MudOS curses text positioning function.
 * Translates coordinates directly to standard ANSI terminal cursor positioning.
 */
void mvprintw(int y, int x, string str) {
    if (!this_player()) return;
    // ANSI: Escape[%d;%dH moves cursor to Line Y, Column X
    // Note: Curses is 0-indexed, ANSI is 1-indexed, so we add 1
    printf("\x1B[%d;%dH%s", y + 1, x + 1, str);
}

/**
 * Emulates clearing the entire terminal viewport.
 */
void clear() {
    if (!this_player()) return;
    // ANSI: Clear screen and reset cursor home position
    printf("\x1B[2J\x1B[H");
}

/**
 * Emulates refreshing the active window buffer to the terminal pipeline.
 */
int doupdate() {
    // Modern FluffOS flushes socket buffers immediately on write/printf operations, 
    // so we can simply treat this as an operational success.
    return 0; 
}

/**
 * Dummy handler to gracefully pass old screen pointer queries.
 */
mixed getstdscr() { 
    return 1; 
}
