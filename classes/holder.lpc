#include <std_defs.h>
#include <english.h>
#include <config.h>

private int liquid_tight;
private int max_bearable;
private int cumulative_weight;
private string *intransient_obj; // The intransients contained w/in this holder
private string *transient_obj;   // Transients initialized from w/in this holder
private string manner_held;      // How something is held by holder,
                                 //      ie "scattered across it's surface" 

// Can this object hold liquids? 
int  query_holder()                { return TRUE;             }
int  query_liquid_tight()          { return liquid_tight;     }
int  query_max_bearable()          { return max_bearable;     }
void set_liquid_tight(int setting) { liquid_tight = setting;  }
void set_max_bearable(int setting) { max_bearable = setting;  }
void set_manner_held(string str)   { manner_held = str;       }

void
load_object_list(string path_prefix, string *obj_list)
{
   int    i;
   object obj;
   string str, error;

   if (obj_list)
   {
      for (i = 0; i < sizeof(obj_list); i++)
      {
         str =  path_prefix + obj_list[i] + ".c";

         error = catch(obj = clone_object(str));

         if ((!obj || error) && LOCATION_DEBUG)
            write_file(LOCATION_LOG, this_object()->query_short() + 
            " couldn't clone: " + str + "\n");

         if (obj) obj->initialize(this_object());
      }
   }
}

void 
initialize(object here)
{
   load_object_list(INTRANSIENT_OBJ_DIR, intransient_obj);
   load_object_list(TRANSIENT_OBJ_DIR, transient_obj);
}

//
// Restart, resets objects to the game start state.
//   This means all inanimate/transients will self destruct, and
//   holders should reload those listed in our transients_list.
// Note: Inanimate/Transients are reloaded since we don't know from 
//   whence they came, nor do they. So, just remove what's
//   here, and replace as per the original transients_list.
// 
void
restart()
{
   load_object_list(TRANSIENT_OBJ_DIR, transient_obj);
}

// The affordance provided by a holder is to 
// be able to hold another object on or in it.
//
// There are a variety of different holders:
// 
// 1) Users with inventories
//
// 2) Locations
//
// 3) Containers, vessels, etc.
//


// Holder's can be initialized as already holding objects.
// Here's where to define that:
//
//    Define the list of intransient objects which are 
//    actually just discernable features of this object.
void 
set_intransient_list(string *name)
{
   intransient_obj = name;
}

//    Define the list of transient objects which are 
//    intially found on/in this holder, before they 
//    find themselves spread throughout the 'universe'.
void 
set_transient_list(string *name)
{
   transient_obj = name;
}

// transient.c calls the following when moving objects from one holder
// to another.
void
remove_from_contents(object item)
{
   cumulative_weight -= (int) item->query_weight();
}

string 
add_to_contents(object item)
{
   int    ptntl_load;

   ptntl_load = cumulative_weight + (int) item->query_weight();
 
   // If unable to bear INFINITE and unable to bear load then FAIL.
   if ((max_bearable != INFINITE) && (ptntl_load > max_bearable))
      return "too heavy for";
   else
   {
      cumulative_weight += (int) item->query_weight();
      return SUCCEED_STR;
   }  
}

// When destructing objects that hold others, it's important to either 
// drop their transient contents there, or if this object is not within 
// another (ie. as in destructing a place), then move the transient 
// contents to the default location.
//
// Note that intransient objects are destroyed w/ their holder.
void 
remove() 
{
   object environ;
   object this_obj;
   object *items_held;
   int i;

   this_obj = this_object();
   environ  = environment(this_obj);

   if (!environ) environ = find_object(DEFAULT_LOCATION);

   items_held = all_inventory(this_obj);
   for (i=0; i < sizeof(items_held); i++)
   {
     // Remove intransients w/ their holder 
     if ((int) items_held[i]->query_transiency() == INTRANSIENT) 
        items_held[i]->remove();
     else items_held[i]->move(environment(this_obj));
   }
   return;
}

string 
query_long()
{
   int     i;
   int     index;
   int     qty_items_held;
   int     total_unique_items;
   int     living_qty;
   int     intransients_qty;
   string *living_names;
   int    *unique_item_qty;
   string *unique_item_desc;
   object *items_held;
   string  item_desc;
   string  str;
   string  tmp;

   items_held = accessible_inventory(ALL, OR, this_object());
   if (! items_held) return 0;
   qty_items_held = sizeof(items_held);

   // Can't exceed this amount.
   unique_item_qty  = allocate(qty_items_held);
   unique_item_desc = allocate(qty_items_held);
   living_names     = allocate(qty_items_held);

   // Create the list of what and how many of each unique item.
   for (i=0; i < qty_items_held; i++)
   {
      // Keep a seperate list of the living.
      if (((int) items_held[i]->query_object_type() == LIVING) &&
                (function_exists("query_human_type", items_held[i])))
      {
         // Let's not count the viewer in the description.
         tmp = (string) items_held[i]->query_cap_name();
         if ( tmp != (string) this_player()->query_cap_name())
         {
            living_names[living_qty] = tmp;
            living_qty++;
         }
      }

      // Remember an intransient objects short description is 
      // implied in it's holders long description.        
      // But at least add them up for later use.
      else if ((int) items_held[i]->query_transiency() == INTRANSIENT)
      {
         intransients_qty++;
      }
      else
      {
         item_desc = (string) items_held[i]->query_short();
         if (total_unique_items == 0)
         {
            unique_item_desc[0] = item_desc;
            unique_item_qty[0] = 1;
            total_unique_items = 1;
         }
         else 
         {
            index = member_array(item_desc, unique_item_desc);
            if (index != -1)
            {
               // This item is already in our list, so increase it's count.
               unique_item_qty[index] = unique_item_qty[index] + 1;
            }
            else 
            {
               // Not in list, add a new one. 
               unique_item_desc[total_unique_items] = item_desc;
               unique_item_qty[total_unique_items] = 1;
               total_unique_items++;
            }
         }
      }
   } // End of looping thru objects.

   // Construct the sentence of objects here.
   if (total_unique_items > 0)
   {
      str = " ";
      for (i=0; i<total_unique_items; i++)
      {
         tmp = how_many(unique_item_qty[i], unique_item_desc[i]);
         str = str + ( i == 0 ? capitalize(tmp) : tmp);
         if (i == total_unique_items - 1) str = str + " ";
         else if (i == total_unique_items - 2 && total_unique_items > 1)
         {
            str = str + " and ";
         }
         else str = str + ", ";
      }
      // If this_player() is held in this object, don't count them as an object
      // since they are implied, and need not be in the description. Since living_qty
      // already reflects this, we must add 1 to it to subtract from the total number
      // of objects.
      str = str + forms_of_Be(THIRD_PERSON, PRESENT, qty_items_held - 
         ( (locally_present(this_player(), this_object()) ? 1 : 0) + 
           living_qty + intransients_qty));
      str = str + " ";
      str = str + manner_held;
      str = str + ". ";
   }

   // Construct the list of humans here.
   if (living_qty > 0)
   {
      if (!str) str = " ";
      for (i=0; i<living_qty; i++)
      {
         tmp = living_names[i];
         // First time around, there may or may not be a unique item str to add.
         str = str + tmp;
         if (i == (living_qty - 1)) str = str + " ";
         else if ((i == (living_qty - 2)) && (living_qty > 1))
            str = str + " and ";
         else str = str + ", ";
      }
      tmp = str + forms_of_Be(THIRD_PERSON, PRESENT, living_qty);
      str = tmp + " here.";
   }
   return (str ? str : 0);
}
