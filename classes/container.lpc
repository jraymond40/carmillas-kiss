#include <std_defs.h>

inherit "/classes/holder";
inherit "/classes/closable";

private int volume_contained;
 
// Forms of containers:
// 
// 1) Objects that contain others
// 2) Vessels that contain liquids
// 3) Users with inventories
//
void
restart()
{
   holder::restart();
   closable::restart();
}

int  query_container()         { return TRUE; }
int  query_volume_contained()  { return volume_contained;  }

void 
remove_from_contents(object item)
{
   volume_contained -= (int) item->query_volume();
   holder::remove_from_contents(item);
}

string 
add_to_contents(object item)
{
   int    max_volume;
   int    ptntl_volume;
   string str;
   string str1;
   string str2;

   max_volume   = (int) this_object()->query_volume();
   ptntl_volume = volume_contained + (int) item->query_volume();

   /* Will it fit ? If max_volume == INFINITE, then anything'll fit. */
   if ( (ptntl_volume > max_volume) && (max_volume != INFINITE) ) 
      str1 = "too large";
   else str1 = SUCCEED_STR;

   str2 = holder::add_to_contents(item);

   if (str1 != SUCCEED_STR && str2 != SUCCEED_STR) str = str1 + ", and " + str2;
   else if (str1 != SUCCEED_STR) str = str1;
   else if (str2 != SUCCEED_STR) str = str2;
   else
   {
      /* Okay, as long as this object is a suitable holder, then do it. */
      str = SUCCEED_STR;
      volume_contained += (int) item->query_volume();
   }
   return str;
}

string 
query_long()
{
   if (query_closed()) return 0;
   else return holder::query_long();
}


string*
open()
{
   string *result;
   string  content_str, contents;

   if (query_closed() == TRUE)
   {
      result = closable::open();

      // Okay we successfully opened it
      if (query_closed() == FALSE)
      {
         contents = holder::query_long();
         content_str = "." + (contents ? " " + contents : "");
         return ({content_str, result[1], result[2], result[3]});
      }
      return  result;
   }   
   else return closable::open();
}
