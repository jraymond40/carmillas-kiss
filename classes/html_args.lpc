//=======================================================================\\

string
strip2ascii(string str)
{
   string str1, str2;
   
   replace_string(str, "+", " ");
   while (sscanf(str, "%s\%%s", str1, str2) != 0)
      if (isxdigit(str2[0]) && isxdigit(str2[1]))
         str = str1 + toascii(str2[0]*16 + str2[1]) + extract(str2, 2);
   return str;
}

mapping
process_html_args(string buf, mapping html_var)
{
   string  *var_pairs, *pair;
   int     num_vars, i;
   
   // Parse the POSTed string... note hex escaped chars need to be converted back.
   var_pairs = explode(buf, "&");
   num_vars = sizeof(var_pairs);
   html_var = allocate_mapping(num_vars);
   for (i = 0; i < num_vars; i++)
   {
      pair = explode(var_pairs[i], "=");
      pair[0] = strip2ascii(pair[0]);
      html_var[pair[0]] = strip2ascii(pair[1]);
   }
   return html_var;
}
