#include <std_defs.h>
#include <config.h>

inherit "/classes/obj_members/description";
inherit "/classes/obj_members/flammability";
inherit "/classes/obj_members/physical";

void 
initialize(object where)
{
   if (where) move_object(where);
}

//
// Restart - reset this object to it's state at game start.
//           (faster and more efficient than destruct & re-create
//            as long as all objects are thorough about it.)
//
void
restart()
{
   description::restart();
   flammability::restart();
}

/*
// remove() is called to destruct an object, updating it's
//          environment at the same time.
*/
void remove() 
{
   object this_obj;
   object environ;

   this_obj = this_object();
   environ = environment(this_obj);

   /*
   // Update the environment so that it's no longer encumbered 
   // (weight and/or volume) by this obj.
   */
   if (environ) environ->remove_from_contents( this_obj );

   /* If crashing continues - remember destruct has had probs in past */
   destruct( this_obj );
}

// 
// When an object is used with this object, what does this object look for
// to report if there has been a reaction based on their mutual use.
//
string* use_recipient(object user, object agent)
{
   // By default, nothing happens.
   return ({0,0,0,0,0,0});  
}

//
// All objects can be saved and restored
//

// This allows path to be redefined by inheritors.
string 
instance_path(string file)
{ 
   string *dirs;
   string  tmp;

   // Ignore the passed in filename, instead:
   // Find the instance name of this object in memory.
   dirs = explode(file_name(this_object()), "/");

   // Strip off the instance number - this will cause all instances to
   // overwrite each other - but will not fill up disk with zillions
   // of instances that are essentially identical, but are given different 
   // instance numbers depending on load in order each time system is started. 
   sscanf(dirs[sizeof(dirs) - 1], "%s#%s", file, tmp);

   return (INSTANCE_BINARIES + file);
}

void
save()
{
   string *dirs;
   string path, file, tmp, instance_pathname;
   int i;
   
   instance_pathname = instance_path("");

   // Do directories exist? If not, create them.
   dirs = explode(instance_pathname, "/");
   path = "";
   for (i=0; i < sizeof(dirs) - 1; i++) 
   {
      path += "/" + dirs[i];
      if (file_size(path) == -1) mkdir(path);
   }
   if (! save_object(instance_pathname))
      write_file(ERROR_LOG, this_object()->query_short() + ": Unable to " + 
        "save an instance to " + instance_pathname + "\n");
}

int
restore(string instance)
{
   return restore_object(instance_path(instance));
}
