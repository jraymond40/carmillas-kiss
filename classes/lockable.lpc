#include <std_defs.h>
#include <config.h>
#include <english.h>

// #define LOCKABLE_DEBUG FALSE

inherit "/classes/closable";

private nosave int    locked = FALSE; // By default, it's not locked.
private nosave string lock_str;       // If set, this object has a lock.

void set_lock(string key)   { lock_str = key; }
int  query_locked()         { return locked;  }

void
lock()
{
   closable::close();
   locked = TRUE;
}

void
unlock()
{
   locked = FALSE;
}

string*
open()
{
   if (locked == TRUE)
      return ({", but discover " + this_object()->query_pronoun() + " " +
            forms_of_Be(THIRD_PERSON, PRESENT, 
               this_object()->query_aggregate() + 1) + " locked.",
               ", but discovers " + this_object()->query_pronoun() + " " +
            forms_of_Be(THIRD_PERSON, PRESENT, 
               this_object()->query_aggregate() + 1) + " locked.",
               ", but discovers you're locked.",
               "try", 0, "to open"});

   else return closable::open();
}

string*
use_recipient(object user, object agent)
{
   string key_str;

   key_str = agent->query_key();

#ifdef LOCKABLE_DEBUG
   write("Key string: " + key_str + "\n");
#endif

   if (! key_str) return 0; // This isn't a key.
   else if (! lock_str)     // This object doesn't have a lock.
   {
      return ({", but discover " + this_object()->query_pronoun() + 
                  " doesn't have a lock.",
               ", but discovers " + this_object()->query_pronoun() + 
                  " doesn't have a lock.",
               ", but discovers you don't have a lock.",
               "attempt",
               "in", "to use"});
   }
   else if (key_str == MASTER_KEY_STR || key_str == lock_str)
   {
      if(locked)
      {
         unlock();
         return ({", unlocking " + this_object()->query_pronoun() + ".",
                  ", unlocking " + this_object()->query_pronoun() + ".",
                  ", unlocking you.",
                  "insert",
                  "into", 0});
      }
      else
      {
         string str;

         if(query_closed() == FALSE) str = " closing and ";
         else str = " ";

         lock();

         return ({"," + str + "locking " + this_object()->query_pronoun() + ".",
                  "," + str + "locking " + this_object()->query_pronoun() + ".",
                  "," + str + "locking you.",
                  "insert",
                  "into", 0});
      }
   }
   else if (key_str)
   {
      return ({", but discover it doesn't fit the lock.",
               ", but discovers it doesn't fit the lock.",
               ", but discovers it doesn't fit your lock.",
               "attempt",
               "in", "to use"});
   }
}

void 
restart()              
{
   if (lock_str) // By default, if lockable, at restart close and lock this object.
   {
      close();
      lock();
   }
}
