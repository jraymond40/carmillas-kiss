#include <std_defs.h>

private int    burn_duration;
private int    flammability;
int burning;

void set_burn_duration(int dur)  { burn_duration = dur; } // In seconds.
int  query_burn_duration()       { return burn_duration;}

void set_flammability(int flam)  { flammability = flam; }
int  query_flammability()        { return flammability; } 

int  query_burning()             { return burning;      }

//
// Restart - reset this object to it's state at game start.
//           (faster and more efficient than destruct & re-create
//            as long as all objects are thorough about it.)
//
void
restart()
{
   while 
   (
       remove_call_out("extinguish") != -1 &&
       remove_call_out("burn_out") != -1
   );
   burning = FALSE; 
}

string *burn()
{
   string *str;
   string obj_name;
   object obj;

   str = allocate(6);  
   obj = this_object();
   obj_name = specific_obj(obj);

   switch (flammability)
   {
      case NONE:
         str[0] = ", yet has no effect.";
         str[1] = ", yet has no effect.";
         str[2] = ", yet has no effect."; 
         break;
      case LOW:
         str[0] = ", but " + obj_name + " never quite catches fire.";
         str[1] = ", but " + obj_name + " never quite catches fire.";
         str[2] = ", but you never quite catch fire.";
         break;
      case MEDIUM:
         str[0] = ". " + capitalize(obj_name) + " gradually becomes consumed in flames " + 
                  "and begins to burn on " + obj->query_possessive() + " own.";
         str[1] = ". " + capitalize(obj_name) + " gradually becomes consumed in flames " + 
                  "and begins to burn on " + obj->query_possessive() + " own.";
         str[2] = ". You gradually become consumed in flames, and " + 
                  "begin to burn on your own.";
         break;
      case HIGH:
         str[0] = ". Suddenly a ball of fire engulfs " + obj_name + 
                  ", and rapidly begins consuming " + obj->query_possessive() + 
                  " entirely.";
         str[1] = ". Suddenly a ball of fire engulfs " + obj_name + 
                  ", and rapidly begins consuming " + obj->query_possessive() + 
                  " entirely.";
         str[2] = ". Suddenly a ball of fire engulfs you, and you're rapidly " + 
                  "being consumed by flames.";
         break;
   }
   if (flammability > LOW)
   {
      call_out("burn_out", burn_duration);
      obj->remove_delta_adjective("extinguished");
      obj->add_delta_adjective("burning");
      burning = TRUE;
      set_light(set_light(0) + 1);
   }

   return str;
}

/*
// For prematurely extinguished fires, there's still some
// burn time left - 
*/
void extinguish()
{
   object this_obj;

   this_obj = this_object();

   set_burn_duration(remove_call_out("burn_out"));
   burning = FALSE;
   set_light(set_light(0) - 1);
   this_obj->remove_delta_adjective("burning");
   this_obj->add_delta_adjective("extinguished");
   this_obj->add_delta_adjective("charred");
   return;
}

void burn_out()
{
   string obj_name;
   object obj;
  
   obj = this_object();
   if ((int) obj->query_object_type() == LIVING)
      obj_name = (string) obj->query_cap_name();
   else obj_name = "The " + obj->query_short();

   obj->effect(LOCAL, 0, 0, obj_name + " has now completely burned away.\n");
   burning = FALSE;
   set_light(set_light(0) - 1);
   obj->remove_delta_adjective("burning");
   obj->add_delta_adjective("charred");
   obj->remove(); /* It's all burned out, now destruct */
}


/* 
// When dealing with another object that's burning, it's 
// possible this object may break into flames as well.
*/

string* use(object user, object other_obj)
{
   string *str;
   string *result;
   string other_obj_name;
   string this_obj_name;
   object this_obj;

   this_obj = this_object();

   if (!other_obj)
   {
      notify_fail("   Use " + (string) this_obj->query_short() + " with _what_ ?\n");
      return FAIL;
   }

   result = ({"","","",0,0,0});

   if (burning || ! other_obj->query_burning()) return result;

   if ((int) other_obj->query_object_type() == LIVING)
      other_obj_name = ". " + other_obj->query_cap_name() + ", who";
   else 
      other_obj_name = ". The " + other_obj->query_short() + ", which";

   this_obj_name = (string) this_obj->query_short();

   str = burn();

   result[0] = other_obj_name + " is burning, subjects " + 
      specific_obj(this_obj) + " to flames" + str[0];
   result[1] = other_obj_name + " is burning, subjects " + 
      specific_obj(this_obj) + " to flames" + str[1];
   result[2] = other_obj_name + " is burning, subjects you to " + 
      (string) other_obj->query_possessive() + " flames" + str[2];

   return result;
}
