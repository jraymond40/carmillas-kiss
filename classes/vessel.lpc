#include <std_defs.h>

inherit "/classes/container";

void
create()
{
   set_liquid_tight(TRUE);
}

// To use a vessel, means:
//
// 1) If this vessel isn't empty and the recipient object is an 
//    empty vessel, then transfer the liquid to the recipient 
//    vessel.
//
// 2) If this vessel isn't empty and neither is the recipient 
//    vessel, then use() the liquid to apply it to the
//    recipients liquid.
//
// 3) If this vessel isn't empty and the recipient object is not
//    a vessel, then use() the liquid to apply it to the
//    recipient object (and perhaps later, its inventory as well).
//
// 4) If this vessel IS empty, and the recipient object is a 
//    LIQUID, then transfer the liquid to this container.
//
// 5) If this vessel IS empty, and the recipient object is a 
//    vessel that is not empty, transfer its contents to this
//    ones.
//
// For now, only liquids are allowed into vessel.

string* use(object user, object recipient)
{
   object this_obj;
   object other_obj;
   object *this_vessels_contents;
   int     number_of_contents;
   int     i;
   int     move_result;
   string *action;
   string *reaction;
   string *result;

   action   = allocate(6);
   reaction = allocate(6);
   result   = allocate(6);

   this_obj = this_object();
   this_vessels_contents = all_inventory();
   number_of_contents    = sizeof(this_vessels_contents);

   // This vessel is empty, so fill it, if appropriate.
   if (number_of_contents ==  0)
   {
      // Is the other object a liquid ?
      if ((int) recipient->query_form() == LIQUID)
      {
         //
         // Yes, so move it over, if there's room.
         //
         move_result = (int) recipient->move(this_obj);
         switch (move_result)
         {
            case MOVE_OK:
               action[3] = "fill";
               action[4] = "with";
               break;

            case MOVE_NOT_ALLOWED:
               notify_fail("   You can't put that there.\n");
               return FAIL;
               break;

            case MOVE_NO_ROOM:
               action[0] = ", but there is no more room left in the " + recipient->query_short();
               action[1] = ", but there is no more room left in the " + recipient->query_short();
               action[3] = "attempt";
               action[5] = "to fill";
               action[4] = "with";
               break;

            case MOVE_DESTRUCTED:
               notify_fail("   ERROR...Move Destructed.\n");
               return FAIL;
               break;
         }
      }
      /*
      // No, so see if it holds one.
      */
      else if ( (other_obj = first_inventory(recipient)) )
      {
         if ((int) other_obj->query_form() == LIQUID)
         {
            move_result = (int) recipient->move(this_obj);
            switch (move_result)
            {
               case MOVE_OK:
                  action[3] = "fill";
                  action[4] = "with";
                  break;

               case MOVE_NOT_ALLOWED:
                  notify_fail("   You can't put that there.\n");
                  return FAIL;
                  break;

               case MOVE_NO_ROOM:
                  action[0] = ", but there is no more room left in this " + this_obj->query_short();
                  action[1] = ", but there is no more room left in the " + this_obj->query_short();
                  action[3] = "attempt";
                  action[5] = "to fill";
                  action[4] = "with";
                  break;

               case MOVE_DESTRUCTED:
                  notify_fail("   ERROR...Move Destructed.\n");
                  return FAIL;
                  break;
            }
         }
         else
         {
            action[0] = ", but it seems that only liquids fit into this " + this_obj->query_short();
            action[1] = ", but it seems that only liquids fit into the " + this_obj->query_short();
            action[2] = ", but it seems that only liquids fit into the " + this_obj->query_short();
            action[3] = "attempt";
            action[5] = "to fill";
            action[4] = "with";
         }
      }
      else
      {
         action[0] = ", but there are no liquids";
         action[1] = ", but there are no liquids";
         action[0] = ", but there are no liquids";
         action[3] = "attempt";
         action[5] = "to fill";
         action[4] = "with";
      }
   }

   /*
   // Okay let's empty the contents of this vessel.
   */
   else
   {
      /* Will we be dumping into another vessel? */
      if ((int) recipient->query_liquid_tight())
      {
         /* Is the destination vessel empty ? */
         if ( !(other_obj = first_inventory(recipient)) )
         {
            /*
            // Yes, so move it over, if there's room.
            */
            move_result = (int) this_vessels_contents[i]->move(recipient);
            switch (move_result)
            {
               case MOVE_OK:
                  action[0] = ", sloshing the " + this_vessels_contents[i]->query_short() + " about";
                  action[1] = ", sloshing the " + this_vessels_contents[i]->query_short() + " about";
                  action[3] = "pour";
                  action[4] = "into";
                  break;
                  break;
               case MOVE_NOT_ALLOWED:
                  notify_fail("   You can't put that there.\n");
                  return FAIL;
                  break;
               case MOVE_NO_ROOM:
                  action[0] = ", but there is no more room left in this " + this_obj->query_short();
                  action[1] = ", but there is no more room left in the " + this_obj->query_short();
                  action[3] = "attempt";
                  action[5] = "to pour";
                  action[4] = "into";
                  break;
               case MOVE_DESTRUCTED:
                  notify_fail("   ERROR...Move Destructed.\n");
                  return FAIL;
                  break;
            }
         }
         /*
         // The destination vessel already contains a liquid - mix 'em 
         //
         // Taking a short-cut, assuming only one liquid right now.
         */
         else
         {
            return (string *) this_vessels_contents[0]->use(user, first_inventory(recipient));
         }
      }
      /*
      // No, the recipient is not a vessel, so apply the liquid to it.
      */
      else
      {
         return (string *) this_vessels_contents[0]->use(user, recipient);
      }
   }      
/*
// Temporarily disabled...
//
   reaction = container::use(user, recipient);

   if (!reaction) return FAIL;
*/
   result[0] = (action[0] ? action[0] : "") + (reaction[0] ? reaction[0] : "");
   result[1] = (action[1] ? action[1] : "") + (reaction[1] ? reaction[1] : "");
   result[2] = (action[2] ? action[2] : "") + (reaction[2] ? reaction[2] : "");

   result[3] = action[3];
   result[4] = action[4];
   if (action[5]) result[5] = action[5]; 

   return result;
}
