#include <config.h>
#include <std_defs.h>

private nosave object *shared_objects;     // A list of shared objects.
//
// Shared objects don't actually reside in a location, but in terms of
// data management are siblings to locations, and are shared amongst 
// locations. They must appear to be in these locations, however.
//
// Shared objects currently are intransient and cannot themselves share
// objects.
// 
object*
query_shared_objects()
{
   return shared_objects;
}

void 
add_shared_object(object obj)
{
   shared_objects = add_to_array(shared_objects, obj);
}

void
remove_shared_object(object obj)
{
   shared_objects = remove_from_array(shared_objects, obj);
}


void
restart()
{
   int i;

   // Assure that all shared objects have had restart called in them.
   for (i=0; i<sizeof(shared_objects); i++) shared_objects[i]->restart();
}

void
load_object_list(string path_prefix, string *obj_list)
{
   int    i;
   object obj;
   string str, error;

   if (obj_list)
   {
      for (i = 0; i < sizeof(obj_list); i++)
      {
         // Is there a door to worry about?
         if (obj_list[i] != "")
         {
            str =  path_prefix + obj_list[i];
            obj = find_object(str);
            if (!obj) 
            {
               // Not loaded in yet, so it's our job.
               // (Only one, so don't clone. Just load it in.)
               error = catch(call_other(str, "??"));
               obj = find_object(str);

               if ((!obj || error) && LOCATION_DEBUG)
                  write_file(LOCATION_LOG, this_object()->query_short() + 
                     " couldn't clone: " + str + "\n");
               else if (obj) obj->initialize();
            }
            if(obj) add_shared_object(obj); // This is an object we're sharing
          } 
      }
   }
}
