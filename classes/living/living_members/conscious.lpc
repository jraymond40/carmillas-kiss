// unconscious         - Handles all to be done while in this state      \\  
// conscious           - Returns true if the player is conscious         \\  
// consciousness       - Allows the player to return to consciousness    \\  
//                                                                       \\  
//=======================================================================\\

#include <std_defs.h>

private nosave status conscious;    // Are we currently conscious?

// Hmm we should perceive nothing from our environment, but since I'm not 
// quite certain how to selectively filter info just yet, we'll just 
// make it so the player can't enter commands for the short time they
// unconscious.

void unconscious(int how_long)
{
   call_out("consciousness", how_long);   
   conscious = FALSE;
//   disable_commands(); // This will make us invisible to find_living() - bad
   return;
}

//
// We are alive and taking commands
//
void consciousness()
{
   enable_commands(); 
   conscious = TRUE;
   return;
}

//
// Are we conscious? 
//
status conscious()
{
   return(conscious);
}

void restart() { conscious(); }

