#include <std_defs.h>

private string gender = "";

int 
define_gender(string str)
{
   string first_char;

   if (!str) return FAIL;
   first_char = lower_case(extract( str, 0, 1));
   if ( first_char == "f" )
      gender = "female";
   else if ( first_char == "m")
      gender = "male";
   else return FAIL;

   return SUCCEED;
}

string query_gender() { return gender; }


//
// The following overrides same in the previously inherited description.c 
//
 
string query_pronoun() 
{
   if (gender == "male") return "he";
   else return "she";
}

string query_possessive() 
{
    if (gender == "male") return "his";
    else return "her";
}

string query_objective() 
{
    if (gender == "male") return "him";
    else return "her";
}

