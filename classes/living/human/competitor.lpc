inherit "/classes/living/human/competitor_members/energy";
inherit "/classes/living/human/competitor_members/commons_role";
inherit "/classes/living/human/competitor_members/vampire";
inherit "/classes/living/human/competitor_members/hunter";
inherit "/classes/living/human/competitor_members/victim";

private nosave int login_time;

int  query_age()  { return (login_time - time()); }
void initialize() { login_time = time();          }
void heart_beat() { vampire::check();                }

void
restart()
{
   commons_role::restart();
   energy::restart();
   vampire::restart();
   hunter::restart();
   victim::restart();
}
