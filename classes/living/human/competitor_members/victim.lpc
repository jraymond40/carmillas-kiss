#include <config.h>
#include <std_defs.h>

#define BLACKOUT_TIME 60

// Function prototypes
public  void bitten(object victim);
public  void restart();
public  int  last_bitten(); 
private void partial_consciousness(mixed tmp);
private void full_consciousness(mixed tmp);

private nosave int gametime_of_last_bite; // Just what it says

public
void
restart() 
{
   gametime_of_last_bite = 0;
   while(remove_call_out("partial_consciousness") != -1 &&
         remove_call_out("full_consciousness") != -1);
}

//
// How long since we were last bitten?
//
public
int
last_bitten()  
{
   return ((int) (find_object(DIRECTOR_OBJ)->gametime()) - 
                   gametime_of_last_bite);
}

//
// Almost awake... still no command input though.
//
private
void
partial_consciousness(mixed tmp)
{
   object victim;
   string pronoun;
   string name;

   victim = (object) tmp[0];
   name = victim->query_cap_name();

   pronoun = victim->query_pronoun();

   effect( LOCAL, victim,
          "You awaken, looking at what you slowly come to recognize is the ceiling. A " +
          "warm stickiness encompasses the hand that is holding your neck. Looking at " +
          "it, you realize it is your hand, and your blood. A sinking sick sensation " +
          "overcomes you, as you slump to the floor once more.\n",
          name + "'s eyes open, as " + pronoun + " returns to consciousness. " +
          "Blood appears to be trickling between " + name + "'s fingers on " + 
          victim->query_possessive() + " neck. Upon noticing this, " + pronoun + 
          " passes out again.\n");

   victim->unconscious(BLACKOUT_TIME/2);
   call_out("full_consciousness", BLACKOUT_TIME/2 + 2, ({victim}) );

   return;
}

//
// Okay, we should be awake now.
//
private
void
full_consciousness(mixed tmp)
{
   object victim;
   string name;

   victim = (object) tmp[0];
   name = victim->query_cap_name();

   effect( LOCAL, victim,
          "You come to and gradually make your way to standing.\n",
          name + " once again regains consciousness, and slowly makes " + 
          victim->query_possessive() + " way to standing .\n");

   return;
}

//
// Ackk! I've been bitten!
//
public
void
bitten(object victim) 
{ 
   int rndm;
   string name;
   string my_perception;

   rndm = random(10);

   name = victim->query_cap_name();

   gametime_of_last_bite = find_object(DIRECTOR_OBJ)->gametime();

   /* Okay, go through variety of things that happen upon being bitten */
   if (rndm < 4)
      my_perception = "Suddenly you feel very, very, weak. Darkness forces itself upon the edge " +
            "of consciousness until only a tiny vision tunnel remains. Or perhaps it " +
            "it doesn't.\n";
   else if (rndm < 7)
      my_perception = "A sharp sensation strikes your neck, bringing you to your knees. " +
            "Some one has turned out the lights.\n"; 
   else if (rndm < 9)
      my_perception = "A quick piercing numbness begins spreading about your neck, engulfing you " +
            "in a world of unconscious blackness.\n";
   else my_perception = "A sensation of two needles entering at your collar, at once and very deep, " +
            "comes to you, quickly followed by an extreme dizziness. You black out.\n";

   effect( LOCAL, victim, 
           my_perception, name + " grabs " + victim->query_possessive() + " neck, stumbles about, finally " +
           "slumping to the floor.\n");

   victim->unconscious(BLACKOUT_TIME/2);
   call_out("partial_consciousness", BLACKOUT_TIME / 2 + 2, ({victim}) );
   return;
}
