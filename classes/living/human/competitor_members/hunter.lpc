#include <commons.h>

private nosave float hunter_level;
 
void 
inc_hunter_level()   
{ 
   hunter_level++;
}

float 
query_hunter_level() 
{ 
   return hunter_level; 
}

void
restart()
{
   hunter_level = 0;
}
