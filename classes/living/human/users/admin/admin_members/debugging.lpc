#include <config.h>
#include <std_defs.h>

private nosave string *vars;
private nosave object *stores;
private nosave string *query_list;

string *init_query() 
{
   query_list = ({
      "query_invis", "query_path",
      "query_gender", "query_pronoun", "query_possessive", "query_objective",
      "query_holder", "query_liquid_tight", "query_closed", "query_volume_contained", "query_volume",
      "query_burn_duration", "query_flammability", "query_burning",
      "query_weight", "query_height", "query_width", "query_depth", "query_form", "query_rigidity",
      "vamp_repellant",
      "query_id", "query_object_type", "query_transiency", "query_dynamacy",
      "query_long", "query_short",
      "query_role", "query_energy", "query_hunter_level", "query_vamp_level", "last_bitten",
      "conscious",
      "query_age", "query_name", "query_cap_name", "query_human_type",
      "query_adjacent_locations", "query_possible_directions"
   });
   return query_list;
}

void init_actions() 
{
   vars = allocate(5);
   stores = allocate(5);
   query_list = init_query();

   add_action("clone",        "clone");
   add_action("load",         "load");
   add_action("In",           "in");
   add_action("Dump",         "dump");
   add_action("Deep",         "deep");
   add_action("Destruct",     "destruct");
   add_action("list_peoples", "who");
   add_action("Call",         "call");
   add_action("Tell",         "tell");
   add_action("Set",          "set");
   add_action("Clean",        "clean");
   add_action("Trans",        "trans");
   add_action("Goto",         "goto");
   add_action("lights",       "lights");
   add_action("Help",         "help");
}

/*
//=======================================================================\\
//  Find the objects pathname                                            \\
//=======================================================================\\
*/


string find_class_path(string str)
{
   string tmp1;
   string tmp;

   tmp1 = TRANSIENT_OBJ_DIR;
   tmp  = tmp1 + str;
   if ( file_size(tmp) >= 0 ) return tmp;
   tmp1 = INTRANSIENT_OBJ_DIR;
   tmp  = tmp1 + str;
   if ( file_size(tmp) >= 0 ) return tmp;
   tmp1 = NPCS_DIR;
   tmp  = tmp1 + str;
   if ( file_size(tmp) >= 0 ) return tmp;
   tmp1 = USERS_DIR;
   tmp  = tmp1 + str;
   if ( file_size(tmp) >= 0 ) return tmp;
   tmp1 = LOCATION_DIR;
   tmp  = tmp1 + str;
   if ( file_size(tmp) >= 0 ) return tmp;
   return "";
}


/*
//=======================================================================\\
//  The debugging commands                                               \\
//=======================================================================\\
*/

Dump(string str) 
{
   int tmp, i;
   object ob;
   string flag, path;

   if (str == 0) 
   {
      write("All variables:\n");
      while(i<sizeof(vars)) 
      {
         if (vars[i]) 
         {
            write(vars[i] + ":\t");
            write(stores[i]);
            write("\n");
	 }
	 i += 1;
      }
      return SUCCEED;
   }

   if (sscanf(str, "%s %s", path, flag) != 2) path = str;
   ob = parse_list(path);
   if (ob == 0)  return FAIL;
   if (flag == "list") 
   {
      ob = first_inventory(ob);
      while(ob) 
      {
         i += 1;
	 write(i + ":\t");
	 write(ob);
	 write("\t" + call_other(ob, "short") + "\n");
	 ob = next_inventory(ob);
      }
      return SUCCEED;
   }
   write(ob); 
   write(":\n");
   write(call_other(ob, "short"));

   if (living(ob))              write("(living) ");
   if (tmp = query_ip_name(ob)) write("(interactive) '" + query_ip_number(ob) + "' ");

   write("\n");

   if (tmp)                     write("query_idle:\t\t" + query_idle(ob) + "\n");

   tmp = MASTER_OBJ->creator_file(file_name(ob));
   if (tmp)                     write("Creator:\t\t" + tmp + "\n");

   tmp = query_snoop(ob);
   if (tmp)                     write("Snooped by " + tmp->query_real_name() + "\n");

   i = 0;
   while(i < sizeof(query_list)) 
   {
      tmp = call_other(ob, query_list[i]);
      if (tmp) 
      {
         string t;
	 t = query_list[i] + ":";

	 if (strlen(t) < 8)         t += "\t\t";
         else if (strlen(t) < 16)   t += "\t";

	 if (objectp(tmp))          tmp = file_name(tmp);
	 else if (pointerp(tmp))
         tmp = "<ARRAY>";
	 write(t + "\t" + tmp + "\n");
      }
      i += 1;
   }
   return SUCCEED;
}

Call(string str) 
{
   string with, what, item;
   int iwhat;
   object ob;
   int ret;
   object obj_data;

   if (!str) 
   {
      notify_fail("Call _what_?\n");
      return FAIL;
   }

   if (sscanf(str, "%s %s %d", item, with, what) == 3) iwhat = 1;
   else if (sscanf(str, "%s %s %s", item, with, what) != 3) 
   {
      if (sscanf(str, "%s %s", item, with) == 2)       iwhat = 0;
      else return FAIL;
   }

   ob = parse_list(item);
   if (!ob)
   {
      notify_fail("No such object found.\n");
      return FAIL;
   }
   if (!function_exists(with, ob)) 
   {
      notify_fail("No such function in that object.\n");
      return FAIL;
   }
   obj_data = parse_list(what);
   if (obj_data) ret = call_other(ob, with, obj_data);
   else ret = call_other(ob, with, what);

   if (intp(ret))           write("Got int " + ret + "\n");
   else if (pointerp(ret))  write("Array of size " + sizeof(ret) + "\n");
   else if (stringp(ret))   write("String: '" + ret + "'\n");
   else if (objectp(ret))   
   {
      write("Object: "); 
      write(ret);
      write("\n");
   }
   assign("ret", ret);
   write("Patched the internals of " + ob->query_short());
   return SUCCEED;
}

Tell(string str) 
{
   string item, what;
   object ob;

   if (!str) 
   {
      notify_fail("tell usage: tell object what\n");
      return FAIL;
   }

   if (sscanf(str, "%s %s", item, what) != 2)
   {
      notify_fail("tell usage: tell object what\n");
      return FAIL;
   }
   ob = parse_list(item);
   if (!ob)
   {
      notify_fail("No such object found.\n");
      return FAIL;
   }
   if (!living(ob)) 
   {
      notify_fail("Not a living object.\n");
      return FAIL;
    }

   tell_object(ob, call_other(this_player(), "query_name") +
		" tells you: " + what + "\n");
   return SUCCEED;
}

Clean(string str) 
{
   object ob, o, n;

   if (!str) 
   {
      notify_fail("clean usage: clean object\n");
      return FAIL;
   }

   ob = parse_list(str);
   if (!ob)
   {
      notify_fail("No such object found.\n");
      return FAIL;
   }

   for (n = first_inventory(ob); n; n = o) 
   {
      o = next_inventory(n);
      if (query_ip_number(n)) continue;
      destruct(n);
   }
   write("All contents destructed.\n");
   return SUCCEED;
}

Destruct(string str) 
{
   object ob;

   if (!str) 
   {
      notify_fail("clean usage: clean object\n");
      return FAIL;
   }

   ob = parse_list(str);
   if (!ob)
   {
      notify_fail("No such object found.\n");
      return FAIL;
   }

   destruct(ob);
   write(str + " destructed.\n");
   return SUCCEED;
}

Trans(string str) 
{
   string move_msg;
   object obj;

   if (!str)
   {
      notify_fail("trans usage: trans object\n");
      return FAIL;
   }

   obj = parse_list(str);
   if (!obj)
   {
      notify_fail("No such object found.\n");
      return FAIL;
   }
   else if ((int) obj->query_transiency() == INTRANSIENT)
   {
      obj->initialize(environment(this_player()));
   }
   else 
   {
      move_msg = (string) obj->move(this_player());
      if (move_msg != SUCCEED_STR) 
      {
         notify_fail("Move Failure#" + move_msg + ".\n");
         return FAIL;
      } 
      else
      {
         write("Ok.\n");
         return SUCCEED;
      }
   }
}

nosave find_item(prev, str) 
{
   object ob;
   string tmp;

   if (str == "here") return environment(this_player());
   if (str == "^")    return environment(prev);
   if (sscanf(str, "@%s", tmp) == 1)  return find_living(tmp);
   if (sscanf(str, "*%s", tmp) == 1) return find_player(tmp);
   if (sscanf(str, "/%s", tmp) == 1) 
   {
      call_other(tmp, "??");	/* Force load */
      return find_object(tmp);
   }
   if (sscanf(str, "$%d", tmp) == 1) 
   {
      object u;
      u = users();
      if (tmp >= sizeof(u) || tmp < 0) return FAIL;
      return u[tmp];
   }
   if (sscanf(str, "$%s", tmp) == 1) 
   {
      int i;
      while(i<sizeof(vars)) 
      {
         if (tmp == vars[i]) return stores[i];
	 i += 1;
      }
      return FAIL;
   }
   if (prev == 0) prev = environment(this_player());
   if (sscanf(str, "\"%s\"", tmp) == 1) 
   {
      ob = first_inventory(prev);
      while(ob && call_other(ob, "query_short") != tmp) 
         ob = next_inventory(ob);
      return ob;
   }
   if (sscanf(str, "#%d", tmp) == 1) 
   {
      if (prev == 0) return FAIL;
      ob = first_inventory(prev);
      while(tmp > 1) 
      {
         tmp -= 1;
         if (ob == 0) return FAIL;
         ob = next_inventory(ob);
      }
      return ob;
   }
   return present(str, prev);
}

parse_list(string str) 
{
   string tmp, rest;
   object prev;

   prev = environment(this_player());
   while(prev && str) 
   {
      if (sscanf(str, "%s:%s", tmp, rest) == 2) 
      {
         prev = find_item(prev, tmp);
	 str = rest;
	 /* disp(prev); */
	 continue;
      }
      prev = find_item(prev, str);
      /* disp(prev); */
      break;
   }
   assign("$", prev);
   if (objectp(prev))	disp(prev);
   return prev;
}

nosave disp(ob) 
{
   write(file_name(ob) + "\n");
}

Set(string str) 
{
    object ob;
    string item, var;

   if (!str)
   {
      notify_fail("set usage: set object variable value\n");
      return FAIL;
   }

   if (sscanf(str, "%s %s", var, item) != 2)
	return ;
   ob = parse_list(item);
   if (!ob)
   {
      notify_fail("No such object found.\n");
      return FAIL;
   }

   assign(var, ob);
   return SUCCEED;
}

assign(var, val) 
{
   int i;

   while(i<sizeof(vars)) 
   {
      if (vars[i] == var) 
      {
	 stores[i] = val;
	 return;
      }
      if (vars[i] == 0) 
      {
	 vars[i] = var;
	 stores[i] = val;
	 return;
      }
      i += 1;
   }
}

Goto(string str) 
{
   object tp;
   object ob;
   string move_msg;

   if (!str)
   {
      notify_fail("goto usage: goto 'item' ('help debug item' for item definition)\n");
      return FAIL;
   }
   tp = this_player();
   ob = parse_list(str);

   if (!ob)
   {
      notify_fail("No such item found.\n");
      return FAIL;
   }

   tp->move(ob);
   return SUCCEED;
}

Deep(string str) 
{
   object ob;
   object *inv;

   if (!str)
   {
      notify_fail("deep usage: deep 'item' ('help debug item' for item definition)\n");
      return FAIL;
   }
   ob = parse_list(str);
   if (!ob)
   {
      notify_fail("No such item found.\n");
      return FAIL;
   }

   inv = deep_inventory(ob);
   if (inv)
   {
      int i;
      str = "All objects contained within [" + (string) ob->query_short() + "]:\n";
      for (i = 0; i < sizeof(inv); i++)
      {
         str += "   ";
         str += (string) inv[i]->query_short();
         str += "\n";
      }
      write(str+"\n");
   }
   else write ("   Nothing found within [" + (string) ob->query_short() + "].\n");

   return SUCCEED;
}


In(string str) 
{
   string path, cmd;
   object ob, old_ob;

   if (!str)
   {
      notify_fail("in usage: in 'item' ('help debug item' for item definition)\n");
      return FAIL;
   }

   if (sscanf(str, "%s %s", path, cmd) != 2)
   {
      notify_fail("in usage: in 'item' ('help debug item' for item definition)\n");
      return FAIL;
   }

   ob = parse_list(path);
   if (!ob)
   {
      notify_fail("No such item found:" + path + "\n");
      return FAIL;
   }

   old_ob = environment(this_player());
   move_object(this_player(), ob);
   command(cmd, this_player());
   move_object(this_player(), old_ob);
   return SUCCEED;
}

Help(string str) 
{
   if (str == "debug") 
   {
      write("Debugging commands available:\n\n");

      write("goto     'item'             - teleport to a new location\n");
      write("deep     'item'             - complete list of _all_ objects on/in item\n");
      write("dump     'item'  list       - dumps the stats (queries) of an object\n");
      write("dump     'item'                                         \n");
      write("destruct 'item'             - destructs an object\n");
      write("call     'item' 'func'      - interactive call_other\n");
      write("call     'item' 'func' 'arg'- interactive call_other\n");
      write("tell     'item' 'str'       - interactive tell_object (living)\n");
      write("trans    'item'             - transfer an object into you posession\n");
      write("set       var   'item'      - set a variable in an object\n");
      write("in       'item'  cmd        - calls a command in an object\n");
      write("clean    'item'             - removes all the contents in an object\n");
      write("lights    on | off          - Turns locations lights on, off, or return qty\n");
      write("\nDo 'help debug item' for information on what an item can be.\n");
      return SUCCEED;
   }
   if (str == "debug item") 
   {
      write("An item is a list separated by ':'.\n An item in that list can be:\n");
      write("   @name  Name of a player or monster.\n");
      write("   *name  Name of player only. Can be invisible.\n");
      write("   \"str\"  Short description of an item.\n");
      write("   /obj   Name of an object or room.\n");
      write("   $var   Contents of a variable. ($$ will give last object used)\n");
      write("   $n     The 'n'th player in this location (according to order found in 'who').\n");
      write("   here   This room.\n");
      write("   #n     The 'n'th object found in this location.\n");
      write("   id     Name of an item.\n");
      return SUCCEED;
   }
   return FAIL;
}

int clone(string str) 
{
   int    tmp;
   string move_msg;
   object tp;
   object obj;
   mixed  res;

   tp = this_player();

   if (!str) 
   {
      write("clone usage: clone filename.c\n");
      return SUCCEED;
   }

   if ( (str = find_class_path(str)) == "")
   {
      write("clone object: " + str + " not found.\n");
      return SUCCEED;
   }

   res = catch(obj = clone_object(str));
   if (res != 0) 
   {
      write(res + " file: '" + str + "'\n");
      return SUCCEED;
   }
   if (!obj)
   {
      notify_fail("No such object found: " + str + "\n");
      return FAIL;
   }
   
   else tmp = (int) obj->query_transiency();

   if (tmp == INTRANSIENT)
   {
      obj->initialize(environment(tp));
      tp->effect(LOCAL, tp, "A stagehand runs up and places the " + str + " on stage.\n",
      (string) tp->query_name() + " claps " + tp->query_possessive() + " hands, and summons someone from off stage to bring on a " + str + "\n");
   }
   else
   {
      move_msg = (string) obj->move(tp);
      if (move_msg != SUCCEED_STR)
      {
         notify_fail("Move Failure#" + move_msg + ".\n");
         return FAIL;
      } 
      tp->effect(LOCAL, tp, "A stagehand runs up and hands it to you.\n",
         (string) tp->query_name() + " claps " + tp->query_possessive() + " hands, and summons someone from off stage to bring on " + str + "\n");
   }

   return SUCCEED;
}


/*
// Ack this load doesn't use the efun restore object... what's the difference
// between this and cloning?
//
// Okay, after a little digging about, I see the deal... "load"ing, brings in
// the original file, not a copy, as cloning does.
*/
nosave int load(string str)
{
   string tmp;

   if (!str) 
   {
      write("Load what object ?\n");
      return SUCCEED;
   }
   tmp = find_class_path(str);
   str = tmp;

   if (! str)
   {
      write("Object: " + str + " not found.\n");
      return SUCCEED;
   }

   /* We just call a non existing function in the object, and that way
   // force it to be loaded.
   //
   // Aha! I had seen this before, but didn't know what it did...
   */
 
   call_other(str, "???");
   write("Ok.\n");
   return SUCCEED;
}


list_peoples() 
{
   object list;
   int i, a;

   list = users();
   write("There are now " + sizeof(list) + " players");
   for (i=0, a=0; i < sizeof(list); i++)
      if (query_idle(list[i]) >= 5 * 60) a++;
   if (a) write(" (" + (sizeof(list) - a) + " active)");
   write(". " + query_load_average() + "\n");
   for(i=0; i<sizeof(list); i++) 
   {
      string name;
      name = list[i]->query_name();
      if (!name) name = "logon";
      name = capitalize(name);
      if (list[i]->query_short() == 0) name = "(" + name + ")";
      if (strlen(name) < 8)      name = name + "\t";

      write(query_ip_number(list[i]) + "\t" + name + "\t");
      a = list[i]->query_age();

      if (a / 86400 > 9)                  write(a / 86400 + " D");
      else if (a / 86400 > 0)             write(a / 86400 + "  D");
      else if (a / 3600 > 9)              write(a / 3600 + " h");
      else if (a / 3600 > 0)              write(a / 3600 + "  h");
      else if (a / 60 > 9)                write(a / 60 + " m");
      else                                write(a / 60 + "  m");
      if (query_idle(list[i]) >= 5 * 60)  write(" I\t");
      else                                write("\t");

      if (environment(list[i]))           write(file_name(environment(list[i])));
      write("\n");
   }
   return SUCCEED;
}

lights(string tmp)
{
   if (tmp)
   {
      string str;
      object tp;
      tp = this_player();
      str = lower_case(tmp);
      if (str == "on") 
      {
         set_light(1);
         effect(LOCAL, tp, "You signal to the lighting crew, and a flood light is aimed at this part of the stage.\n",
            tp->query_name() + " signals to the lighting crew in the rafters above the stage, and a floodlight illuminates this area.\n"); 
      }
      else 
      {
         while (set_light(0) > 0) set_light(-1);
         effect(LOCAL, tp, "You signal to the lighting crew, and all lights on this part of the set are turned off.\n",
            tp->query_name() + " signals to the lighting crew to shut out all lights in this part of the set. Suddenly you're engulfed in darkness.\n");
      }
   }
   else write ("   There are " + set_light(0) + " light sources in this location.\n");
   return SUCCEED;
}
