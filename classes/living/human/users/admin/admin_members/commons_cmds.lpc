#include <config.h>
#include <std_defs.h>
#include <commons.h>


init_actions()
{
   add_action("game_stats",  "stats");
   add_action("start_game",  "start");
   add_action("stop_game",   "stop");
   add_action("resume_game", "resume");
}

game_stats()
{
   object *list;
   object tp;
   int player, r, e;
   int co, ex, po, re;
   string stats;

   write("----------Last Round--------------\n");
   write("Cooperators: " + MASTER_OBJ->query_coopers() + "\n");
   write(" Exploiters: " + MASTER_OBJ->query_expltrs() + "\n");
   write("     Police: " + MASTER_OBJ->query_policed() + "\n");
   write("  Rewarders: " + MASTER_OBJ->query_rewarded() + "\n\n");
   write("----------This Round--------------\n");
   write("Round: " + MASTER_OBJ->query_round_num() + "\t" + "State: " + MASTER_OBJ->query_state() + "\t"
          + "Level: " + (MASTER_OBJ->query_level() % 5) + "\n\n");
      
   list = users();
   for (player = 0; player < sizeof(users()); player++)
   {
      stats = list[player]->query_user_cap_name();
      if (!stats)
         stats = "logon";
      stats = capitalize(stats);
      if (list[player]->query_short() == 0)
         stats = "(" + stats + ")";
      if (strlen(stats) < 8)
         stats = stats + "\t";

      r = list[player]->query_role();
      e = list[player]->query_energy();

      write(stats + "\t" + e + "\t");
      if (r == SIP) write("sip-cooperate");
      else if (r == GULP) write("gulp-exploit");
      else if (r == INHALE) write("inhale-police");
      else if (r == BLOW_INTO) write("blow-reward");
      else if (r == WITHDRAW) write("withdraw");
      else write(r);    
      write("\n");
   }
   return SUCCEED;
}

start_game()
{
   MASTER_OBJ->set_game_mode(START);
   tell_object(this_player(), "Game started.\n");
   return SUCCEED;
}

stop_game()
{
   MASTER_OBJ->set_game_mode(OFF);
   tell_object(this_player(), "Game stopped.\n");
   return SUCCEED;
}

resume_game()
{
   MASTER_OBJ->set_game_mode(ON);
   tell_object(this_player(), "Game resumed.\n");
   return SUCCEED;
}
