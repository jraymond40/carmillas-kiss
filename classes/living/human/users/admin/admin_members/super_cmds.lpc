//           - to all in the room                                        \\
//           - to all in the game                                        \\
//        Note: it can be indistinguishable from game generated events.  \\
//   emote - prepend a statement with your name - intended to allow      \\
//           realtime generated displays of emotion or events relative   \\
//           to that moment.                                             \\
//   review/setmmsgin/setmsgin/setmsgout/setmmsgout                      \\
//         - Set the message that appears to yourself and others as you  \\
//           move about.                                                 \\
//   home - immediately teleport to your home area.                      \\
//                                                                       \\  
//   Directors commands                                                  \\
//   ==================                                                  \\
//   cue - to cue an NPC into action "cue Oma Z9"                        \\
//                                                                       \\
//=======================================================================\\
*/ 

#include <std_defs.h>
#include <config.h>

private nosave string *orig_dest_tbl; /* An array of room connections             */
private nosave string *instructions;  /* A corresponding array of instructions    */
private nosave int    tbl_size;

private nosave string mmsgout, mmsgin, msgout, msgin;
init_actions()
{
   super_cmds();
   directors_cmds();
}

nosave super_cmds() 
{ 
    add_action("move_to", "moveto");

    add_action("force_player", "force");
    add_action("snoop_on", "snoop");
    add_action("invis", "invis");
    add_action("vis", "vis");
    add_action("emote", "emote");
    add_action("echo_to", "echoto");
    add_action("echo", "echo");
    add_action("echo_all", "echoall");
    add_action("Trans", "Trans");
    add_action("Goto", "Goto");
    add_action("setmmin", "setmmin");
    add_action("setmmout", "setmmout");
    add_action("setmin", "setmin");
    add_action("setmout", "setmout");
    add_action("review", "review");
}


/* Use the navigate function to traverse to a room, being, or object. */

int load_routing_tbl()
{
   string *str2, str1;

   if (! (str1 = read_file(ROUTING_TBL)) )  
   {
      write("** Warning: routing.tbl not loaded - navigational functions, won't. **\n");
      return FAIL;
   }
   else
   {
      str2 = explode(str1, "|");
      tbl_size = sizeof(explode( str2[0], ","));
      orig_dest_tbl = allocate(tbl_size);
      instructions  = allocate(tbl_size);
      orig_dest_tbl = explode( str2[0], ",");
      instructions  = explode( str2[1], ",");
   }
   return SUCCEED;
}


move_to(string destination)
{
   string  str, origin;
   string* action_list;
   int     i;
   int     index;
   object  obj;

   /* Temp solution    */
   /* /places/p+n+n+n# */
   /* 01234567890123456 */

   origin = extract(file_name(environment(this_player())), 9, 15);

   
   /* Is the destination the environment of a living object ? */
   obj = find_living(lower_case(destination));

   /* It's not alive, so see if it's an inanimate object. */
   if (obj != 0) obj = find_object("/objects/inanimate/" + destination);

   /* If the destination is the environment of some body/thing */
   /* then set the destination to the location of that being.  */
   if (obj != 0) destination = extract(file_name(environment(obj)), 9, 15);

   if (origin == destination)
   {
      notify_fail ("You're already here.\n");
      return FAIL;
   }
   else 
   {
      write("Moving from: " + origin + " to: " + destination + "\n");
      if (!orig_dest_tbl) 
         if (load_routing_tbl() == FAIL) return FAIL;


      if ( tbl_size == 0 )
      {
         notify_fail("** Warning: routing.tbl data not found - navigational functions, won't. **\n");
         return FAIL;
      }

      index = member_array( origin+destination, orig_dest_tbl);

      if (index != -1) str = instructions[index];
      else
      {
         notify_fail("** Warning: Location not found in routing table.\n");
         return FAIL;
      }

      if (str == "") 
      {
         notify_fail("Sorry, you can't get there from here.\n");
         return FAIL;
      }

      else 
      {
         action_list = explode(str, "\n");
         for (i = 0; i < sizeof(action_list); i++) 
         {
            write("Moving " + action_list[i] + "\n");
            command(action_list[i]);
         }
         return SUCCEED;
      }
   }
   
}


private int is_invis;

int invis()
{
    if (is_invis) {
	tell_object(this_object(), "You are already invisible.\n");
	return 1;
    }
    is_invis = 1;
    tell_object(this_object(), "You are now invisible.\n");
    say((string)this_object()->query_cap_name() +
	" " + mmsgout + ".\n", this_object());
    this_object()->set_short(0);
    return 1;
}


int vis()
{
    if (!is_invis) {
	tell_object(this_object(), "You are not invisible.\n");
	return 1;
    }
    is_invis = 0;
    tell_object(this_object(), "You are now visible.\n");
    say((string)this_player()->query_cap_name() +
	" " + mmsgin + ".\n", this_object());
    this_object()->set_short((string)this_player()->query_cap_name());
    return 1;
}


int query_invis() {
    return is_invis;
}


nosave int force_player(string str)
{
    string who, what;
    object ob;
    if (!str)
	return 0;
    if (sscanf(str, "%s to %s", who, what) == 2 ||
	sscanf(str, "%s %s", who, what) == 2) {
	ob = find_living(who);
	if (!ob) {
	    write("No such player.\n");
	    return 1;
	}
	tell_object(ob, (string)this_object()->query_cap_name()
		    + " force you to: " + what + "\n");
	ob->force_me(what);
	write("Ok.\n");
	return 1;
    }
    return 0;
}


nosave int snoop_on(string str)
{
    object ob;
    int ob_level;

    if (!str) {
	snoop();
	return 1;
    }
    ob = find_player(str);
    if (!ob) {
	write("No such player.\n");
	return 1;
    }

    snoop(ob);
    return 1;
}
   
nosave echo_all(str) {
    if (!str) {
       write("Echoall what?\n");
       return 1;
    }
    SHOUT(str + "\n");
    write("You echo: " + str + "\n");
    return 1;
}

nosave echo(str) {
    if (!str) {
       write ("Echo what?\n");
       return 1;
    }
    say (str + "\n");
    write ("You echo: " + str + "\n");
    return 1;
}

nosave echo_to(str)
{
    object ob;
    string who;
    string msg;
    if (!str || sscanf(str, "%s %s", who, msg) != 2) {
	write("Echoto what ?\n");
	return 1;
    }
    ob = find_living(lower_case(who));
    if (!ob) {
	write("No player with that name.\n");
	return 1;
    }
    tell_object(ob, msg + "\n");
    write("You echo: " + msg + "\n");
    return 1;
}

nosave emote(str) {
    if (!str) {
	write("emote what ?\n");
	return 1;
    }
    say((string)this_object()->query_cap_name() + " " + str + "\n");
    write("Ok.\n");
    return 1;
}


/* Some functions to set moving messages. */

int setmout(string m) { msgout = m; return 1; }
int setmin(string m) { msgin = m; return 1; }
int setmmout(string m) { mmsgout = m; return 1; }
int setmmin(string m) { mmsgin = m; return 1; }

int review() {
    write("mout:\t" + msgout +
	  "\nmin:\t" + msgin +
	  "\nmmout:\t" + mmsgout +
	  "\nmmin:\t" + mmsgin + "\n");
    return 1;
}

string query_msgin() { return msgin; }
string query_msgout() { return msgout; }
string query_mmsgin() { return mmsgin; }
string query_mmsgout() { return mmsgout; }

directors_cmds()
{
   add_action("cue", "cue");
   add_action("cutto", "cutto");
   add_action("end_cutto", "end_cutto");
}

/* For cueing NPC's */

cue(string str)
{
   string *word;
   string name;
   string cue;
   string extra_data;
   object npc;

   int ii;

   if (str == "") return FAIL;
   else 
   {
      word = explode( str, " ");
      extra_data = "";

      if (sizeof(word) < 2) return FAIL;
      else 
      {
         name = lower_case(word[0]);
         cue  = capitalize(word[1]);

         for (ii = 2; ii < sizeof(word); ii++)
         {
            if (word[ii] != "") extra_data = extra_data + word[ii];
         }
         if ( (npc = find_living(name)) == 0) 
         {
            notify_fail("Attempted to find " + name + " but got " + npc->query_name() + ".\n");
            return FAIL;
         }
         else
         {
            tell_object( npc, "*>[" + cue + "] \n" + extra_data);
            return SUCCEED;
         }
      }
   }
}

