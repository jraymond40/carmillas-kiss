#include <std_defs.h>
#include <config.h>

#define MAP_HEIGHT          50
#define MAP_WIDTH           131
#define MAPBLOCK_WIDTH      10
#define MAPBLOCK_HEIGHT     5

#define SETUP_MODE          0
#define NORMAL_MODE         1
#define HELP_MODE           2
#define NOTICE_MODE         3

#define TERM_ROWS           24
#define TERM_COLS           80
#define DEFAULT_TERM_WIDTH  80
#define DEFAULT_TERM_HEIGHT 24

/* --- ANSI Curses Macros --- */
#define CSI "\x1b["
#define CURS_CLEAR          (CSI + "2J")
#define CURS_HOME           (CSI + "H")
#define CURS_SET_SCROLL(t,b) sprintf("\x1b[%d;%dr", t, b)
#define CURS_RESET_SCROLL   (CSI + "r")
#define CURS_MOVE(r,c)      sprintf("\x1b[%d;%dH", r, c)
#define CURS_SAVE           ("\x1b" + "7")
#define CURS_RESTORE        ("\x1b" + "8")
#define CURS_REVERSE        (CSI + "7m")
#define CURS_RESET          (CSI + "0m")
#define CURS_CLEAR_TO_EOL   (CSI + "K")

// Prototypes
void cmd_reset();
private void take_action();
private void build_users_cmdline();
void screen_redraw();
void doupdate();
void update_status_bar();
void refresh_curses_screen();
void initmapport();

/* --- Menu Emulation Structure --- */
class MenuPort {
    string   title;
    string  *items;
    int      top_index;
    int      selected_index;
    int      height;
    int      width;
    int      start_y;
    int      start_x;
    int      is_active;
}

/* --- Virtual Window Buffers --- */
private nosave class MenuPort *menu;
private nosave string *event_lines;
private nosave string *map_lines;
private nosave int     map_view_y;
private nosave int     map_view_x;
private nosave int     event_scroll_pos;
private nosave string  said;
private nosave string  users_cmd;
private nosave string  choice;
private nosave string  systems_cmd;
private nosave string *cmd;
private nosave string *null_list;
private nosave int     active_gadget;
private nosave int     mode;
private nosave int     previous_mode;
private nosave int     prep_position;
private nosave string  prep;
private nosave string  help_text;
private nosave string  notice_text;

/* --- Curses Emulation State --- */
private nosave int    curses_mode    = 0;
private nosave int    term_width     = DEFAULT_TERM_WIDTH;
private nosave int    term_height    = DEFAULT_TERM_HEIGHT;

int  query_curses()      { return curses_mode; }
int  query_term_width()  { return term_width; }
int  query_term_height() { return term_height; }

/*
 * Terminal Geometry & Sizing
 */
void set_terminal_size(int width, int height) {
    if (width > 20)  term_width = width;
    if (height > 10) term_height = height;
    if (curses_mode) this_object()->refresh_curses_screen();
}

void window_size(int width, int height) {
    set_terminal_size(width, height);
}

/*
 * Screen Partitioning & Lifecycle
 */
void refresh_curses_screen() {
    string buf = "";
    int scroll_bottom = term_height - 3;

    buf += CURS_CLEAR + CURS_HOME;
    buf += CURS_SET_SCROLL(1, scroll_bottom);
    buf += CURS_MOVE(term_height - 2, 1);
    buf += repeat_string("-", term_width);
    buf += CURS_MOVE(term_height, 1) + "> ";

    tell_object(this_object(), buf);
    this_object()->update_status_bar();
    doupdate();
}

void enable_curses() {
    curses_mode = 1;
    refresh_curses_screen();
}

void disable_curses() {
    curses_mode = 0;
    tell_object(this_object(), CURS_RESET_SCROLL + CURS_CLEAR + CURS_HOME);
}

void update_status_bar() {
    if (!curses_mode) return;
    string status_line;
    string bar_output;
    object env = environment(this_object());
    string loc_name = env ? (string)env->query_short() : "Somewhere";
    string uname = this_object()->query_cap_name() ? (string)this_object()->query_cap_name() : "User";

    status_line = sprintf(" %s | %s | Term: %dx%d", uname, (loc_name ? loc_name : "Unknown"), term_width, term_height);

    bar_output  = CURS_SAVE;
    bar_output += CURS_MOVE(term_height - 1, 1);
    bar_output += CURS_REVERSE;
    bar_output += sprintf("%-*.*s", term_width, term_width, status_line);
    bar_output += CURS_RESET;
    bar_output += CURS_RESTORE;

    tell_object(this_object(), bar_output);
}

/*
 * Menu Helpers
 */
class MenuPort create_menu(int h, int w, int y, int x) {
    class MenuPort m = new(class MenuPort);
    m->height = h;
    m->width = w;
    m->start_y = y;
    m->start_x = x;
    m->items = ({});
    m->top_index = 0;
    m->selected_index = 0;
    m->is_active = 0;
    m->title = "";
    return m;
}

void initmenu(class MenuPort m, string title, string *items) {
    m->title = title;
    m->items = items ? items : ({});
    m->top_index = 0;
    m->selected_index = 0;
}

void scrollmenu(class MenuPort m, int delta) {
    int max_items = sizeof(m->items);
    if (!max_items) return;

    m->selected_index += delta;
    if (m->selected_index < 0) m->selected_index = 0;
    if (m->selected_index >= max_items) m->selected_index = max_items - 1;

    int visible_slots = m->height - 2;
    if (m->selected_index < m->top_index) {
        m->top_index = m->selected_index;
    } else if (m->selected_index >= m->top_index + visible_slots) {
        m->top_index = m->selected_index - visible_slots + 1;
    }
}

string selectentry(class MenuPort m) {
    if (sizeof(m->items) > m->selected_index) {
        return m->items[m->selected_index];
    }
    return "";
}

/*
 * Screen Rendering
 */
void render_menu(class MenuPort m) {
    string buf = "";
    int r, idx;
    int visible_slots = m->height - 2;

    buf += CURS_MOVE(m->start_y + 1, m->start_x + 1);
    if (m->is_active) buf += CURS_REVERSE;
    buf += sprintf("[%-*.*s]", m->width - 2, m->width - 2, m->title);
    if (m->is_active) buf += CURS_RESET;

    for (r = 0; r < visible_slots; r++) {
        idx = m->top_index + r;
        buf += CURS_MOVE(m->start_y + 2 + r, m->start_x + 1);
        if (idx < sizeof(m->items)) {
            if (m->is_active && idx == m->selected_index) {
                buf += CURS_REVERSE + sprintf(">%-*.*s", m->width - 1, m->width - 1, m->items[idx]) + CURS_RESET;
            } else {
                buf += sprintf(" %-*.*s", m->width - 1, m->width - 1, m->items[idx]);
            }
        } else {
            buf += repeat_string(" ", m->width);
        }
    }
    tell_object(this_object(), buf);
}

void render_events() {
    string buf = "";
    int start_row = 12;
    int visible_rows = term_height - 16; 
    if (visible_rows < 5) visible_rows = 5;
    int total = sizeof(event_lines);

    buf += CURS_MOVE(start_row, 1) + CURS_REVERSE + sprintf("%-*s", term_width, " EVENTS") + CURS_RESET;

    for (int i = 0; i < visible_rows; i++) {
        int idx = total - visible_rows + i - event_scroll_pos;
        buf += CURS_MOVE(start_row + 1 + i, 1) + CURS_CLEAR_TO_EOL;
        if (idx >= 0 && idx < total) {
            buf += event_lines[idx][0..term_width - 1];
        }
    }
    tell_object(this_object(), buf);
}

void render_map() {
    string buf = "";
    int r;
    int max_y = sizeof(map_lines);
    
    // Viewport dimensions: 9 rows, 23 cols (from orig: height 9, width 23)
    for (r = 0; r < 9; r++) {
        int line_y = map_view_y + r;
        string slice = "";
        
        if (line_y >= 0 && line_y < max_y) {
            int len = strlen(map_lines[line_y]);
            if (map_view_x < len) {
                // Slice 23 characters starting at X offset
                slice = map_lines[line_y][map_view_x .. map_view_x + 22];
            }
        }
        
        // Pad to ensure we always write exactly 23 characters
        slice = sprintf("%-23.*s", 23, slice);
        
        // Output at Row = r+1, Col = 57 (Orig: y=0, x=56)
        buf += CURS_MOVE(r + 1, 57);
        buf += CURS_REVERSE + slice + CURS_RESET;
    }
    tell_object(this_object(), buf);
}

void render_compass() {
    string buf = "";
    // Drawn over the map buffer 
    buf += CURS_MOVE(1, 67) + CURS_REVERSE + "^N" + CURS_RESET;
    buf += CURS_MOVE(9, 68) + CURS_REVERSE + "S" + CURS_RESET;
    buf += CURS_MOVE(5, 79) + CURS_REVERSE + "E" + CURS_RESET;
    buf += CURS_MOVE(5, 57) + CURS_REVERSE + "W" + CURS_RESET;
    tell_object(this_object(), buf);
}

void doupdate() {
    if (!curses_mode) return;

    if (mode == HELP_MODE && help_text) {
        tell_object(this_object(), CURS_CLEAR + CURS_HOME + CURS_MOVE(2, 2) + CURS_REVERSE + help_text + CURS_RESET);
        return;
    }
    if (mode == NOTICE_MODE && notice_text) {
        tell_object(this_object(), CURS_CLEAR + CURS_HOME + CURS_MOVE(4, 4) + CURS_REVERSE + notice_text + CURS_RESET);
        return;
    }

    render_menu(menu[0]);
    render_menu(menu[1]);
    render_menu(menu[2]);
    
    // Draw map then overlay compass
    render_map();
    render_compass();

    tell_object(this_object(), CURS_MOVE(8, 1) + CURS_REVERSE + "  DO: " + CURS_RESET + sprintf("%-50s", users_cmd));
    tell_object(this_object(), CURS_MOVE(10, 1) + " SAY: " + sprintf("%-70s", said + "_"));

    render_events();
    tell_object(this_object(), CURS_MOVE(term_height, 3)); 
}

void screen_redraw() {
    if (curses_mode) {
        tell_object(this_object(), CURS_CLEAR + CURS_HOME);
        doupdate();
    }
}

void printport(mixed port, int style, string message) {
    if (!event_lines) event_lines = ({});
    string *split_msg = explode(message, "\n");
    foreach (string line in split_msg) {
        if (strlen(line) > 0) event_lines += ({ line });
    }
    if (sizeof(event_lines) > 200) {
        event_lines = event_lines[<150..];
    }
    if (curses_mode) render_events();
    else tell_object(this_object(), message + "\n");
}

void catch_tell(string msg) {
    if (!curses_mode) {
        tell_object(this_object(), msg);
        return;
    }
    printport(0, 0, msg);
}

/*
 * Map Parsing & Initialization
 */
void initmapport() {
    string raw_map = read_file(MAP);
    if (raw_map) map_lines = explode(raw_map, "\n");
    else map_lines = ({ "Map file missing or unreadable." });

    object start_room = find_object(STARTING_LOCATION);
    if (start_room) {
        int *dstloc_coord = start_room->query_coordinates();
        if (dstloc_coord && sizeof(dstloc_coord) >= 3) {
            map_view_x = (dstloc_coord[0] * MAPBLOCK_WIDTH) + dstloc_coord[2] * (MAP_WIDTH/2) + 3;
            map_view_y = (dstloc_coord[1] * MAPBLOCK_HEIGHT) + 8;
        }
    }
}

void scroll_map(object curloc, object dstloc) {
    if (!curloc || !dstloc) return;
    
    int *dstloc_coord = dstloc->query_coordinates();
    if (dstloc_coord && sizeof(dstloc_coord) >= 3) {
        // Recalculate absolute offset based on new room
        map_view_x = (dstloc_coord[0] * MAPBLOCK_WIDTH) + dstloc_coord[2] * (MAP_WIDTH/2) + 3;
        map_view_y = (dstloc_coord[1] * MAPBLOCK_HEIGHT) + 8;
    }
    
    if (curses_mode) doupdate();
}

/*
 * Lifecycle & Setup
 */
void set_preposition(int position, string preposition) {
    prep_position = position;
    if (position > 0) prep = preposition;
}

void ui_setup() {
    said = "";
    users_cmd = "";
    systems_cmd = "";
    event_lines = ({});
    event_scroll_pos = 0;
    cmd = ({ "", "", "" });
    null_list = ({ " ", " ", " ", " ", " " });

    menu = allocate(3);
    menu[0] = create_menu(7, 17, 0, 0);
    menu[1] = create_menu(7, 18, 0, 18);
    menu[2] = create_menu(7, 18, 0, 37);

    initmenu(menu[0], "ACTIONS", actions_list(commands()));
    initmenu(menu[1], "OBJECTS", objects_list(this_object(), INANIMATE | DYNAMIC | STATIC | TRANSIENT | INTRANSIENT, AND, INVENTORY | IMMEDIATE));
    initmenu(menu[2], "PEOPLE", living_list(this_object()));

    active_gadget = 1;
    menu[0]->is_active = 1;
    
    initmapport();

    printport(0, 0, "   .:::::::::::::::::::::::  Carmilla's Kiss  :::::::::::::::::::::::.   ");
    printport(0, 0, " .: Copyright 1994, Raymond Interactive Theatre, All rights reserved. :. ");
    printport(0, 0, "              Use arrow keys to select options; Type to talk.            ");

    mode = NORMAL_MODE;
    enable_curses();

    effect(LOCAL, this_player(), find_object(STARTING_LOCATION)->query_long(), this_player()->query_cap_name() + " walks on stage.\n");
}

/*
 * Info / Help / Notice Windows
 */
void create_notice_window(int size_y, int size_x, int orig_y, int orig_x, string str, int style) {
    previous_mode = mode;
    mode = NOTICE_MODE;
    notice_text = str;
    screen_redraw();
}

void remove_notice_window(mixed win) {
    mode = previous_mode;
    notice_text = "";
    screen_redraw();
}

void help_screen() {
    previous_mode = mode;
    mode = HELP_MODE;
    help_text = read_file(INFO_DIR + "help.screen");
    screen_redraw();
}

void remove_info_window(mixed win) {
    mode = previous_mode;
    help_text = "";
    screen_redraw();
}

/*
 * Commands & Action Assembly
 */
private void build_users_cmdline() {
    users_cmd = "";
    if (cmd[0] != "") {
        users_cmd = cmd[0];
        if (prep_position == 1) users_cmd = sprintf("%s %s", users_cmd, prep);
    }
    if (cmd[1] != "") {
        if (prep_position == 2) users_cmd = sprintf("%s %s", users_cmd, prep);
        users_cmd = sprintf("%s %s", users_cmd, cmd[1]);
        if (prep_position == 3) users_cmd = sprintf("%s %s", users_cmd, prep);
    }
    if (cmd[2] != "") {
        if (prep_position == 4) users_cmd = sprintf("%s %s", users_cmd, prep);
        users_cmd = sprintf("%s %s", users_cmd, cmd[2]);
    }
}

private void cmd_reset() {
    set_preposition(0, "");
    active_gadget = 1;
    menu[0]->is_active = 1;
    menu[1]->is_active = 0;
    menu[2]->is_active = 0;

    initmenu(menu[1], "OBJECTS", objects_list(this_object(), INANIMATE | DYNAMIC | STATIC | TRANSIENT | INTRANSIENT, AND, INVENTORY | IMMEDIATE));
    initmenu(menu[2], "PEOPLE", living_list(this_object()));

    cmd[0] = "";
    cmd[1] = "";
    cmd[2] = "";
    build_users_cmdline();
}

private void say_reset() {
    said = "";
}

private void take_action() {
    systems_cmd = sprintf("%s", cmd[0]);
    if (cmd[1] != "") systems_cmd = sprintf("%s %s", systems_cmd, cmd[1]);
    if (cmd[2] != "") systems_cmd = sprintf("%s %s", systems_cmd, cmd[2]);

    if (said != "") {
        if (systems_cmd != "") systems_cmd = sprintf("%s *>[say] %s", systems_cmd, said);
        else systems_cmd = sprintf("*>[say] %s", said);
    }

    cmd_reset();
    say_reset();
    doupdate();
    command(systems_cmd);
    systems_cmd = "";
}

/*
 * Input Routing (Replaces process_input / getch loop)
 */
void process_user_input(string str) {
    if (!str || str == "") return;

    if (mode == HELP_MODE || mode == NOTICE_MODE) {
        mode = previous_mode;
        screen_redraw();
        return;
    }

    // Arrow keys & Special keys
    if (str == "\x1b[A") { // Up
        if (active_gadget > 0) scrollmenu(menu[active_gadget - 1], -1);
        else event_scroll_pos++;
        doupdate();
        return;
    }
    if (str == "\x1b[B") { // Down
        if (active_gadget > 0) scrollmenu(menu[active_gadget - 1], 1);
        else if (event_scroll_pos > 0) event_scroll_pos--;
        doupdate();
        return;
    }
    if (str == "\x1b[D") { // Left
        if (active_gadget > 1) {
            menu[active_gadget - 1]->is_active = 0;
            active_gadget--;
            menu[active_gadget - 1]->is_active = 1;
            cmd[active_gadget - 1] = "";
            build_users_cmdline();
        }
        doupdate();
        return;
    }
    if (str == "\x1b[C") { // Right
        if (active_gadget > 0 && active_gadget < 3) {
            choice = selectentry(menu[active_gadget - 1]);
            cmd[active_gadget - 1] = choice;
            menu[active_gadget - 1]->is_active = 0;
            active_gadget++;
            menu[active_gadget - 1]->is_active = 1;
            build_users_cmdline();
        } else if (active_gadget == 3) {
            choice = selectentry(menu[2]);
            if (cmd[2] == choice) take_action();
            else {
                cmd[2] = choice;
                build_users_cmdline();
            }
        }
        doupdate();
        return;
    }

    // Quick move hotkeys (Ctrl+N, S, E, W, U, D)
    switch(str[0]) {
        case 14: // Ctrl-N
            command("move north"); cmd_reset(); doupdate(); return;
        case 19: // Ctrl-S
            command("move south"); cmd_reset(); doupdate(); return;
        case 5:  // Ctrl-E
            command("move east"); cmd_reset(); doupdate(); return;
        case 23: // Ctrl-W
            command("move west"); cmd_reset(); doupdate(); return;
        case 21: // Ctrl-U
            command("move up"); cmd_reset(); doupdate(); return;
        case 4:  // Ctrl-D
            command("move down"); cmd_reset(); doupdate(); return;
        case 12: // Ctrl-L (Refresh)
        case 18: // Ctrl-R (Refresh)
            screen_redraw(); return;
        case 127: // DEL / Backspace
        case 8: {
            int len = strlen(said);
            if (len > 0) said = extract(said, 0, len - 2);
            doupdate();
            return;
        }
        case '\r':
        case '\n':
            take_action(); return;
    }

    // Standard Typing 
    if (str[0] >= 32 && str[0] <= 126) {
        said += str;
        doupdate();
    }
}

void menu1(string title, string *items) {
    menu[0]->is_active = 0;
    initmenu(menu[2], "    ", null_list);
    initmenu(menu[1], title, items);
    active_gadget = 2;
    menu[1]->is_active = 1;
    doupdate();
}

void menu2(string title, string *items) {
    menu[1]->is_active = 0;
    initmenu(menu[2], title, items);
    active_gadget = 3;
    menu[2]->is_active = 1;
    doupdate();
}

void actions_update() {
    set_preposition(0, "");
    if (menu && menu[0]) {
        initmenu(menu[0], "ACTIONS", actions_list(commands()));
        doupdate();
    }
}

mixed query_eventport() {
    return 0; // Legacy portptr stub
}

void restart() {
    actions_update();
}

int quit() {
    disable_curses();
    return 0; // Returning 0 lets inherited living/user `quit` execute if called via `::quit()`
}