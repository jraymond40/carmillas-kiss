#include <std_defs.h>
#include <config.h>

#define MAP_HEIGHT          50
#define MAP_WIDTH           131
#define MAPBLOCK_WIDTH      10
#define MAPBLOCK_HEIGHT     5

#define SETUP_MODE          0
#define NORMAL_MODE         1
#define HELP_MODE           2
#define NOTICE_MODE         3

#define TERM_ROWS           24
#define TERM_COLS           80

/* Key constants for emulation */
#define KEY_UP              1001
#define KEY_DOWN            1002
#define KEY_LEFT            1003
#define KEY_RIGHT           1004
#define KEY_RETURN          "\n"

// Prototypes
void cmd_reset();
private void take_action();
private void build_users_cmdline();
void screen_redraw();
void doupdate();

// --> gemini

/* --- Curses Emulation State --- */
private nosave int    curses_mode    = 0;
private nosave int    term_width     = DEFAULT_TERM_WIDTH;
private nosave int    term_height    = DEFAULT_TERM_HEIGHT;

int  query_curses()      { return curses_mode; }
int  query_term_width()  { return term_width; }
int  query_term_height() { return term_height; }

/*
 * Terminal Geometry & Sizing (FluffOS NAWS callback)
 */
void set_terminal_size(int width, int height) {
    if (width > 20)  term_width = width;
    if (height > 10) term_height = height;

    if (curses_mode) {
        this_object()->refresh_curses_screen();
    }
}

void window_size(int width, int height) {
    set_terminal_size(width, height);
}

/*
 * Screen Partitioning & Lifecycle
 */
void refresh_curses_screen() {
    string buf = "";
    int scroll_bottom = term_height - 3;

    // Reset screen & configure scrolling margins (rows 1 to term_height - 3)
    buf += CURS_CLEAR + CURS_HOME;
    buf += CURS_SET_SCROLL(1, scroll_bottom);

    // Separator line
    buf += CURS_MOVE(term_height - 2, 1);
    buf += repeat_string("-", term_width);

    // Park cursor on the bottom prompt line
    buf += CURS_MOVE(term_height, 1) + "> ";

    tell_object(this_object(), buf);
    this_object()->update_status_bar();
}

void enable_curses() {
    curses_mode = 1;
    refresh_curses_screen();
}

void disable_curses() {
    curses_mode = 0;
    // Reset DECSTBM margins and clear back to standard linear terminal
    tell_object(this_object(), CURS_RESET_SCROLL + CURS_CLEAR + CURS_HOME);
}

void toggle_curses() {
    if (curses_mode) disable_curses();
    else enable_curses();
}

/*
 * Sticky Status Bar (Row H-1)
 */
void update_status_bar() {
    if (!curses_mode) return;

    string status_line;
    string bar_output;
    object env = environment(this_object());
    string loc_name = env ? (string)env->query_short() : "Somewhere";
    string uname = query_cap_name ? (string)this_object()->query_cap_name() : "User";

    status_line = sprintf(" %s | %s | Term: %dx%d",
        uname,
        (loc_name ? loc_name : "Unknown"),
        term_width,
        term_height
    );

    // Save cursor position, jump to status row, write inverted text, restore cursor
    bar_output  = CURS_SAVE;
    bar_output += CURS_MOVE(term_height - 1, 1);
    bar_output += CURS_REVERSE;
    bar_output += sprintf("%-*.*s", term_width, term_width, status_line);
    bar_output += CURS_RESET;
    bar_output += CURS_RESTORE;

    tell_object(this_object(), bar_output);
}

/*
 * Output Hook (Routes all outgoing text into the scrolling region)
 */
void catch_tell(string msg) {
    if (!curses_mode) {
        tell_object(this_object(), msg);
        return;
    }

    string out = CURS_SAVE;
    out += CURS_MOVE(term_height - 3, 1);
    out += msg;
    out += CURS_RESTORE;

    tell_object(this_object(), out);
}

/*
 * Reset terminal margins on disconnect / quit
 */
void quit() {
    if (curses_mode) {
        tell_object(this_object(), CURS_RESET_SCROLL + CURS_CLEAR + CURS_HOME);
    }
}
// <-- gemini

/* --- Menu Emulation Structure --- */
class MenuPort {
    string   title;
    string  *items;
    int      top_index;
    int      selected_index;
    int      height;
    int      width;
    int      start_y;
    int      start_x;
    int      is_active;
};

/* --- Virtual Window Buffers --- */
private nosave class MenuPort *menu;
private nosave string *event_lines;
private nosave int     event_scroll_pos;
private nosave string  said;
private nosave string  users_cmd;
private nosave string  systems_cmd;
private nosave string *cmd;
private nosave string *null_list;
private nosave int     active_gadget;
private nosave int     mode;
private nosave int     previous_mode;
private nosave int     prep_position;
private nosave string  prep;
private nosave string  help_text;
private nosave string  notice_text;

/*
 * Menu Port Helpers
 */
class MenuPort create_menu(int h, int w, int y, int x) {
    class MenuPort m = new(class MenuPort);
    m->height = h;
    m->width = w;
    m->start_y = y;
    m->start_x = x;
    m->items = ({});
    m->top_index = 0;
    m->selected_index = 0;
    m->is_active = 0;
    m->title = "";
    return m;
}

void initmenu(class MenuPort m, string title, string *items) {
    m->title = title;
    m->items = items ? items : ({});
    m->top_index = 0;
    m->selected_index = 0;
}

void scrollmenu(class MenuPort m, int delta) {
    int max_items = sizeof(m->items);
    if (!max_items) return;

    m->selected_index += delta;
    if (m->selected_index < 0) m->selected_index = 0;
    if (m->selected_index >= max_items) m->selected_index = max_items - 1;

    int visible_slots = m->height - 2;
    if (m->selected_index < m->top_index) {
        m->top_index = m->selected_index;
    } else if (m->selected_index >= m->top_index + visible_slots) {
        m->top_index = m->selected_index - visible_slots + 1;
    }
}

string selectentry(class MenuPort m) {
    if (sizeof(m->items) > m->selected_index) {
        return m->items[m->selected_index];
    }
    return "";
}

/*
 * Screen Rendering
 */
void render_menu(class MenuPort m) {
    string buf = "";
    int r, idx;
    int visible_slots = m->height - 2;

    // Header border
    buf += CURS_MOVE(m->start_y + 1, m->start_x + 1);
    if (m->is_active) buf += CURS_REVERSE;
    buf += sprintf("[%-*.*s]", m->width - 2, m->width - 2, m->title);
    if (m->is_active) buf += CURS_RESET;

    // Item rows
    for (r = 0; r < visible_slots; r++) {
        idx = m->top_index + r;
        buf += CURS_MOVE(m->start_y + 2 + r, m->start_x + 1);
        if (idx < sizeof(m->items)) {
            if (m->is_active && idx == m->selected_index) {
                buf += CURS_REVERSE + sprintf(">%-*.*s", m->width - 1, m->width - 1, m->items[idx]) + CURS_RESET;
            } else {
                buf += sprintf(" %-*.*s", m->width - 1, m->width - 1, m->items[idx]);
            }
        } else {
            buf += repeat_string(" ", m->width);
        }
    }
    tell_object(this_object(), buf);
}

void render_events() {
    string buf = "";
    int start_row = 12;
    int visible_rows = 10;
    int total = sizeof(event_lines);

    buf += CURS_MOVE(start_row, 1) + CURS_REVERSE + sprintf("%-*s", TERM_COLS, " EVENTS") + CURS_RESET;

    for (int i = 0; i < visible_rows; i++) {
        int idx = total - visible_rows + i - event_scroll_pos;
        buf += CURS_MOVE(start_row + 1 + i, 1) + CURS_CLEAR_TO_EOL;
        if (idx >= 0 && idx < total) {
            buf += event_lines[idx][0..TERM_COLS - 1];
        }
    }
    tell_object(this_object(), buf);
}

void render_compass() {
    string buf = "";
    buf += CURS_MOVE(1, 67) + CURS_REVERSE + "^N" + CURS_RESET;
    buf += CURS_MOVE(9, 68) + CURS_REVERSE + "S" + CURS_RESET;
    buf += CURS_MOVE(5, 79) + CURS_REVERSE + "E" + CURS_RESET;
    buf += CURS_MOVE(5, 57) + CURS_REVERSE + "W" + CURS_RESET;
    tell_object(this_object(), buf);
}

void doupdate() {
    if (mode == HELP_MODE && help_text) {
        tell_object(this_object(), CURS_MOVE(6, 3) + CURS_REVERSE + help_text + CURS_RESET);
        return;
    }
    render_menu(menu[0]);
    render_menu(menu[1]);
    render_menu(menu[2]);
    render_compass();

    // DO: and SAY: lines
    tell_object(this_object(), CURS_MOVE(8, 1) + CURS_REVERSE + "  DO: " + CURS_RESET + sprintf("%-50s", users_cmd));
    tell_object(this_object(), CURS_MOVE(10, 1) + " SAY: " + sprintf("%-70s", said + "_"));

    render_events();
    tell_object(this_object(), CURS_MOVE(TERM_ROWS, 1));
}

void screen_redraw() {
    tell_object(this_object(), CURS_CLEAR + CURS_HOME);
    doupdate();
}

void printport(mixed port, int style, string message) {
    if (!event_lines) event_lines = ({});
    string *split_msg = explode(message, "\n");
    foreach (string line in split_msg) {
        if (strlen(line) > 0) event_lines += ({ line });
    }
    if (sizeof(event_lines) > 100) {
        event_lines = event_lines[<90..];
    }
    render_events();
}

void handle_messages(string message) {
    printport(0, 0, message);
}

/*
 * Lifecycle & Setup
 */
void ui_setup() {
    said = "";
    users_cmd = "";
    systems_cmd = "";
    event_lines = ({});
    event_scroll_pos = 0;
    cmd = ({ "", "", "" });
    null_list = ({ " ", " ", " ", " ", " " });

    menu = allocate(3);
    menu[0] = create_menu(7, 17, 0, 0);
    menu[1] = create_menu(7, 18, 0, 18);
    menu[2] = create_menu(7, 18, 0, 37);

    // Initial action population
    initmenu(menu[0], "ACTIONS", actions_list(commands()));
    initmenu(menu[1], "OBJECTS", objects_list(this_object(), INANIMATE | DYNAMIC | STATIC | TRANSIENT | INTRANSIENT, AND, INVENTORY | IMMEDIATE));
    initmenu(menu[2], "PEOPLE", living_list(this_object()));

    active_gadget = 1;
    menu[0]->is_active = 1;

    printport(0, 0, "   .:::::::::::::::::::::::  Carmilla's Kiss  :::::::::::::::::::::::.   ");
    printport(0, 0, " .: Copyright 1994, Raymond Interactive Theatre, All rights reserved. :. ");
    printport(0, 0, "  :: Arrow keys to select options; Type to talk;  Control-I for info ::  ");

    mode = NORMAL_MODE;
    screen_redraw();
}

void set_preposition(int position, string preposition) {
    prep_position = position;
    if (position > 0) prep = preposition;
}

private void build_users_cmdline() {
    users_cmd = "";
    if (cmd[0] != "") {
        users_cmd = cmd[0];
        if (prep_position == 1) users_cmd = sprintf("%s %s", users_cmd, prep);
    }
    if (cmd[1] != "") {
        if (prep_position == 2) users_cmd = sprintf("%s %s", users_cmd, prep);
        users_cmd = sprintf("%s %s", users_cmd, cmd[1]);
        if (prep_position == 3) users_cmd = sprintf("%s %s", users_cmd, prep);
    }
    if (cmd[2] != "") {
        if (prep_position == 4) users_cmd = sprintf("%s %s", users_cmd, prep);
        users_cmd = sprintf("%s %s", users_cmd, cmd[2]);
    }
    doupdate();
}

private void cmd_reset() {
    set_preposition(0, "");
    active_gadget = 1;
    menu[0]->is_active = 1;
    menu[1]->is_active = 0;
    menu[2]->is_active = 0;

    initmenu(menu[1], "OBJECTS", objects_list(this_object(), INANIMATE | DYNAMIC | STATIC | TRANSIENT | INTRANSIENT, AND, INVENTORY | IMMEDIATE));
    initmenu(menu[2], "PEOPLE", living_list(this_object()));

    cmd[0] = "";
    cmd[1] = "";
    cmd[2] = "";
    build_users_cmdline();
}

private void say_reset() {
    said = "";
    doupdate();
}

private void take_action() {
    systems_cmd = sprintf("%s", cmd[0]);
    if (cmd[1] != "") systems_cmd = sprintf("%s %s", systems_cmd, cmd[1]);
    if (cmd[2] != "") systems_cmd = sprintf("%s %s", systems_cmd, cmd[2]);

    if (said != "") {
        if (systems_cmd != "") systems_cmd = sprintf("%s *>[say] %s", systems_cmd, said);
        else systems_cmd = sprintf("*>[say] %s", said);
    }

    cmd_reset();
    say_reset();
    command(systems_cmd);
    systems_cmd = "";
}

/*
 * Input Dispatcher (translates keys and ANSI sequences)
 */
void process_user_input(string str) {
    if (!str) return;

    // Detect arrow escape keys (\033[A, \033[B, \033[C, \033[D)
    if (str == "\033[A") {
        if (active_gadget > 0) scrollmenu(menu[active_gadget - 1], -1);
        else event_scroll_pos++;
        doupdate();
        return;
    }
    if (str == "\033[B") {
        if (active_gadget > 0) scrollmenu(menu[active_gadget - 1], 1);
        else if (event_scroll_pos > 0) event_scroll_pos--;
        doupdate();
        return;
    }
    if (str == "\033[D") { // Left arrow
        if (active_gadget > 1) {
            menu[active_gadget - 1]->is_active = 0;
            active_gadget--;
            menu[active_gadget - 1]->is_active = 1;
            cmd[active_gadget - 1] = "";
            build_users_cmdline();
        }
        return;
    }
    if (str == "\033[C") { // Right arrow
        if (active_gadget > 0 && active_gadget < 3) {
            choice = selectentry(menu[active_gadget - 1]);
            cmd[active_gadget - 1] = choice;
            menu[active_gadget - 1]->is_active = 0;
            active_gadget++;
            menu[active_gadget - 1]->is_active = 1;
            build_users_cmdline();
        }
        return;
    }

    // Normal command execution or chat input
    if (str == "\r" || str == "\n" || str == "") {
        take_action();
    } else {
        said = str;
        take_action();
    }
}

void help_screen() {
    previous_mode = mode;
    mode = HELP_MODE;
    help_text = read_file(INFO_DIR + "help.screen");
    doupdate();
}

void actions_update() {
    set_preposition(0, "");
    initmenu(menu[0], "ACTIONS", actions_list(commands()));
    doupdate();
}

void quit() {
    tell_object(this_object(), CURS_CLEAR + CURS_HOME);
}

void restart() {
    actions_update();
}