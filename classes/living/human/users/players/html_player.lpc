#include <std_defs.h>
#include <config.h>

inherit "/classes/living/human/users/html_user";
inherit "/classes/living/human/competitor";
inherit "/classes/living/human/users/password";
inherit "/classes/living/human/users/costume";

private        string ticketholder_name;
private        int    total_usage;
private        int    usage_since_billing;
private nosave int    billing_start_time;
private nosave int    billing_mode = OFF;
private nosave int    time_of_login;

void   set_ticketholder(string str) { ticketholder_name = str; }
string query_ticketholder()         { return ticketholder_name; }

void 
create()
{
   user::create();
   set_human_type(PLAYER);
                             /*    Defaults for now:    */ 
                             /* ------------------------*/
   set_weight       (75);    /* Weight, in kilograms    */
   set_height       (182);   /* In centimeters          */
   set_width        (38);    /* "      "                */
   set_depth        (38);    /* "      "                */
   set_max_bearable (250);   /* Carriable, in kilograms */
}

void 
initialize(object where, string name) 
{
   if (! query_ticketholder())
   {
      set_ticketholder(name);
      add_costume_name(name);
      add_costume_description("A player named " + name + ".");
      set_dflt_costume(name);
   }
   competitor::initialize();
   user::initialize(where,  query_dflt_costume()); 
   set_long(query_costume_description());
   time_of_login = time();
}

void
billing(int mode)
{
   if (mode == billing_mode) return; // Already in that mode.
   if (mode == ON) billing_start_time = time();
   else usage_since_billing += (time() - billing_start_time);
}

string 
instance_path(string instance)
{ 
   if (!instance || instance == "") instance = query_ticketholder();
   return (PLAYER_INSTANCE + extract(instance, 0, 0) + "/" + instance);
}

void
save()
{
   total_usage += (time() - time_of_login);
   billing(OFF);
   user::save();
}

void
quit()
{
   save();
   user::quit();
}

void
restart()
{
   // Ready the user for a game restart.
   user::restart();
   competitor::restart();
   billing(OFF);
}
