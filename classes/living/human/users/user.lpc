#include <config.h>
#include <std_defs.h>

inherit "/classes/living/human/human";
inherit "/classes/living/human/users/ui";

void
restart()
{
   human::restart();
   ui::restart();
}

private nosave int time_of_login;

varargs void initialize(object where, string who)
{
   time_of_login = time();
   human::initialize(where, who);
}

int
query_time_of_login()
{
   return time_of_login;
}

void
init_actions()
{
   add_action("action_handler", "quit");
   human::init_actions();
}

string 
move(object dstloc, string dir) 
{
   object curloc;

   curloc = environment(this_object());
    string move_msg = human::move(dstloc, dir);

   // Scroll only if we've moved.
   if (curloc != environment(this_object()) )
      ui::scroll_map(curloc, dstloc);

   return move_msg;
}

void 
net_dead()
{
   command("quit Yes, quit.");
// Use this spot if we want to save stuff if someone's
// gone net dead w/out quitting.
   return;
}

void
quit()
{
   ui::quit();
   effect(LOCAL, this_player(), 
      "You walk off the set, and exit the theatre.\n",
       query_cap_name() + " walks off the set, and exits the theatre.\n");
   remove();
}
