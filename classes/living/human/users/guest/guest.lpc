#include <std_defs.h>
#include <config.h>

varargs void initialize(object where, object ticketwindow);
inherit "/classes/living/human/users/user";
nosave object ticketwindow; // The ticketwindow that passed us in.
private nosave int    pass_in_time;   // At what time.

create()
{
   user::create();
   set_human_type(GUEST);
}

void 
initialize(object where, object passed_in_from) 
{
   user::initialize(find_object(GUEST_STARTING_LOCATION), "fly"); 

   set_short  ("A fly");
   set_long   ("As you approach it, the fly buzzes about the room.");
   set_id  ( ({"fly"}) );
//   set_heart_beat(GUEST_DURATION/2); // 2 Seconds/heartbeat
   ticketwindow = passed_in_from;
   return;
}

// I don't get it.. I can never fucking count on call outs...
void
heart_beat()
{
   object guest;

   guest = this_player();

   if (time() < pass_in_time + GUEST_DURATION) return;
   {
      exec(ticketwindow, guest);
      ticketwindow->info_menu();
      destruct(guest);
   }
   return;
}

