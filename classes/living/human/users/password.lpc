//    set_password()  Allows the user to define a new password.       \\
//    verify_password()  Verifies a string matches password.             \\
//                                                                       \\
//=======================================================================\\

#include <std_defs.h>
#include <config.h>

#define PASSWORD_DEBUG FALSE

private string password;

int 
set_password(string str)
{
   if (str == "" || !str) return FAIL;
   password = crypt(str, 0);
   return SUCCEED;
}

int 
verify_password(string str) 
{
   if (PASSWORD_DEBUG) 
   {
      write_file(ERROR_LOG, "String passed to verify_password: " + str + "\n" + 
            "String encrypted:   " + crypt(str, password) + "\n" +
            "Encrypted password: " + password + "\n");
   }
   if (password != crypt(str, password)) return FAIL;
   else return SUCCEED;
}
