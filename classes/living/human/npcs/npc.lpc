#include <config.h>
#include <std_defs.h>

public void   catch_tell(string str);
public string query_Omas_location();
public string query_Juniors_location();
public string query_Grandfeathers_location(); 
public string query_victims_location(); 

inherit "/classes/living/human/human";
inherit "/classes/living/human/npc_cmds";

public nosave string  cue;              // The cue, scene# + cue#
public nosave string  cue_data;         // The last data to  accompany a cue.
public nosave object  Director;         // The director object
public nosave int     time_of_cue;      // Time of last action cued
public nosave int     event_num;        // which event are we doing?
public        mapping cmd;              // Here's the loaded in script.

private nosave string  victim_location;
private nosave object  victim;
private nosave object  Oma;
private nosave object  Junior;
private nosave object  Grandfeathers;

private nosave string  idx;      // So as not to be redeclared every heartbeat.
private nosave string  cmd_str, tmp1_str, tmp2_str, tmp3_str, tmp4_str;
   
void
restart()
{
   remove(); // Self-destruct, will be reloaded in start location.
}

void
create()
{
   human::create();
   set_human_type(NPC);
}

void initialize(object where, string who)
{
   human::initialize(where, who);
   set_long("A character named " + query_cap_name() + ".\n");
   if (NPC_DEBUG) rm(LOG_DIR + query_name() + ".log");
   init_actions();
   
   // If we can't restore this object, then reload script from
   // ascii file.
   if (!restore(query_name()) )
   {
      string   script, scene_num, cue_num, read_buf, idx_str;
      mixed   *cmd_array;
      int      line, event_num, delay;

      set_eval_limit(0); // Shut this test off during script load in.

      cmd = ([ "ZZ0" : ( ({0}) ) ]); // Initialize the mapping.
   
      script = NPCS_DIR + query_cap_name() + ".script";
   
      while( (read_buf = read_file(script, line++, 1) ) != 0)
      {
         scene_num = "";
         sscanf(read_buf,"[scene#%s]", scene_num);
      	 if  (scene_num == "") continue; // Not a scene command so skip it.
      	 else do // Okay, we've had a scene cmd.
      	 {
      	    cue_num = "";
            do   // Bypass any comments until the cue cmd.
            {
            	read_buf = read_file(script, line++, 1); 
                sscanf(read_buf,"[cue#%s]", cue_num);         
            }
            while(cue_num == "");
            event_num = 0;
            // Okay, now there should be no more comments, just events until [end_cue].
            read_buf = read_file(script, line++, 1);
            while( strcmp(extract(read_buf,0,8), "[end_cue]") != 0) 
            {
               cmd_array = explode(read_buf,";");
               if (sizeof(cmd_array) < 1)
               {
                  write_file(ERROR_LOG, query_cap_name() + " unable to read from script, line#" + line + "\n");
                  continue;
               }
               sscanf(cmd_array[0],"%d", delay);
               cmd_array[0] = delay;
               idx_str = scene_num + cue_num + sprintf("%d", event_num++);
               if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log", 
                  idx_str + " = " + read_buf + "\n");
               cmd[idx_str] = cmd_array;
               read_buf = read_file(script, line++, 1);
            }
            read_buf = read_file(script, line++, 1);
         }
         while( strcmp(extract(read_buf,0,10), "[end_scene]") != 0);
      }
      save();
      set_eval_limit(STD_MAX_EVAL_LIMIT); // Okay, turn it back on.
   }
}

void init_actions()
{
   human::init_actions();
   npc_cmds::init_actions();
   return;
}

public
void
catch_tell(string str)
{
   string *word;
   mixed  *tmp;

   // Log it all during debugging
   if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log", str);

   word = explode(str, " ");
   if (!Director) Director = find_object(DIRECTOR_OBJ);

   // See if it fits the model that cues are supposed to fit w/in.
   if ( extract(word[0], 0, 2) == "*>[" && extract(word[0], 5,5) == "]")
   {
      cue = extract( word[0], 3, 4);
      
      // Called at the end of each cue, or in case of error.
      if (cue == "ZZ")
      {
         // Cleanup
         time_of_cue = 0;
         cue = "";
         event_num = 0;
         set_heart_beat(OFF);
         set_eval_limit(STD_MAX_EVAL_LIMIT);
         return;
      }
      // Only valid cues can set variables and preempt previous cues.
      else if (undefinedp(tmp = cmd[cue + "0"]) )
      {
         if (NPC_DEBUG) command("expressions: yell *>[say] I don't know zhe cue: " + cue + ".");
         write_file(LOG_DIR + query_cap_name() + ".log", "Encountered unknown cue: " + cue = "\n");
         return;
      }
      // It's valid, so set up for it to be performed in heartbeat()
      else
      {
         time_of_cue = time();

         // First cue sets all the important variables  
         cue_data = extract(word[1], 1);
         
         // Do this cue at the next heartbeat
         set_heart_beat(ON);
         set_eval_limit(0); // In the event this action takes awhile.
      }

   }
   // Other event capturing
   else 
   {
      // Put an Eliza like routine here
   }
   return;
}     

heart_beat(string str)
{
   idx = sprintf("%s%d", cue, event_num);

   // If there are no more events defined, shutdown heartbeat.
   if (undefinedp(cmd[idx]) )
   {
      // Cleanup
      time_of_cue = 0;
      cue = "";
      event_num = 0;
      set_heart_beat(OFF);
      return;
   }

   // If it ain't time, return ASAP.
   if (time() < time_of_cue + cmd[idx][0]) return; 

   if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log",
      "Oma is in " + query_Omas_location() + ".\n" +
      "Junior is in " + query_Juniors_location() + ".\n" +
      "Grandfeathers is in " + query_Grandfeathers_location() + ".\n"); 

   switch(sizeof(cmd[idx]))
   {
      case 2:
         cmd_str = extract(cmd[idx][1], 0 , strlen(cmd[idx][1]) - 2);
         break;
      case 3: 
         tmp1_str = cmd[idx][1];
         tmp2_str = (string) call_other(this_object(),
            extract(cmd[idx][2], 0 , strlen(cmd[idx][2]) - 2) );
         if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log",
            "Function " + cmd[idx][2] + " returned [" + tmp2_str + "]\n");
         cmd_str = sprintf(tmp1_str, tmp2_str);
         break;
      case 4:
         tmp1_str = cmd[idx][1];
         tmp2_str = (string) call_other(this_object(),
            extract(cmd[idx][2], 0 , strlen(cmd[idx][2]) - 2) );
         if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log",
            "Function " + cmd[idx][2] + " returned [" + tmp2_str + "]\n");
         tmp3_str = (string) call_other(this_object(),
            extract(cmd[idx][3], 0 , strlen(cmd[idx][3]) - 2) );
         if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log",
            "Function " + cmd[idx][3] + " returned [" + tmp3_str + "]\n");
         cmd_str = sprintf(tmp1_str, tmp2_str, tmp3_str);
         break;
      case 5:
         tmp1_str = cmd[idx][1];
         tmp2_str = (string) call_other(this_object(),
            extract(cmd[idx][2], 0 , strlen(cmd[idx][2]) - 2) );
         if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log",
            "Function " + cmd[idx][2] + " returned [" + tmp2_str + "]\n");
         tmp3_str = (string) call_other(this_object(),
            extract(cmd[idx][3], 0 , strlen(cmd[idx][3]) - 2) );
         if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log",
            "Function " + cmd[idx][3] + " returned [" + tmp3_str + "]\n");
         tmp4_str = (string) call_other(this_object(),
            extract(cmd[idx][4], 0 , strlen(cmd[idx][4]) - 2) );
         if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log",
            "Function " + cmd[idx][4] + " returned [" + tmp4_str + "]\n");
         cmd_str = sprintf(tmp1_str, tmp2_str, tmp3_str, tmp4_str);
         break;
      default: return; // Too much or too little dynamic data? skip it.
   }
   if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log",
      idx + " [" + cmd_str + "]\n");
   command(cmd_str);
   event_num++;
   time_of_cue = time();
   return SUCCEED;
} 

string  
random_cue_num()
{
   return sprintf("%d", random(4) );
}

public
string
query_Omas_location()
{
   if (!Oma) Oma = find_living("oma");
   if (!Oma) 
      write_file(ERROR_LOG, query_cap_name() + " unable to find Oma.\n");
   return (LOCATION_NUMBER(environment(Oma)));
}

public
string
query_Grandfeathers_location()
{
   if (!Grandfeathers) Grandfeathers = find_living("grandfeathers");
   if (!Grandfeathers) 
      write_file(ERROR_LOG, query_cap_name() + " unable to find Grandfeathers.\n");
   return (LOCATION_NUMBER(environment(Grandfeathers)));
}

public
string
query_Juniors_location()
{
   if (!Junior) Junior = find_living("junior");
   if (!Junior) 
      write_file(ERROR_LOG, query_cap_name() + " unable to find Junior.\n");
   return (LOCATION_NUMBER(environment(Junior)));
}

object
find_victim()
{
   if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log", 
        "Now I'm looking for [" + lower_case(cue_data)  + "]\n");
   victim = find_living( lower_case(cue_data) );
   if (!victim)
   {
      if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log", 
         "I can't seem to find zhe victim, [" + lower_case(extract(cue_data, 1)) + "]\n");
      command("cue " + query_name() + " ZZ");
      return (object) NULL;
   }
   return victim;
}

public
string
query_victim_location()
{
   return LOCATION_NUMBER(environment( find_victim() ) );
}

public
string
victim_not_here()
{
   return (query_victim_location() == "+2+0+0" ? "+1+0+0" : "+2+0+0");
}

public
string
query_victim_name()
{
   return (string) (find_victim()->query_cap_name());
}

public
string
query_victim_possessive()
{
   return (string) (find_victim()->query_possessive());
}

public
string
query_Omas_location_name()
{
   return (string) (environment(Oma)->query_short());
}                  
