#include <config.h>
#include <std_defs.h>
#include <npc_defs.h>

public varargs void initialize(object where);

inherit "/classes/living/human/npcs/npc";

public
void
create()
{
   set_transient_list( ({"key/master"}) );
   npc::create();
}

public
void
initialize(object where)
{
   define_gender("male");
   npc::initialize(where, "junior");
   set_long("Rather tall and lanky from the cruelty of adolescence, the " + 
      "lad appears well mannered and quite bright.");
}



