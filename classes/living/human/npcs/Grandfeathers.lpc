#include <config.h>
#include <std_defs.h>
#include <npc_defs.h>

// Function prototypes
public varargs void initialize(object where);
inherit "/classes/living/human/npcs/npc";

public
void
create()
{
   set_transient_list( ({"key/master"}) );
   npc::create();
}

public
void
initialize(object where)
{
   npc::initialize(where, "grandfeathers");
   define_gender("male");
   set_long( "Somewhat hunched over and slow moving, the old mans eyes " +
      "twinkle with life.");
}

