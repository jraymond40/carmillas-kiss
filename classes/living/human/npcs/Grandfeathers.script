[scene#D]

[cue#6]
2;moveto %s;query_Juniors_location
4;cue oma D7
[end_cue]

[cue#8]
4;expressions: mumble *>[say] Hmmph! Doesn't look like zhere's enough here for zhat...
2;moveto +1+6+0
6;cue oma D9
[end_cue]
