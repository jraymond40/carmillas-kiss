#include <config.h>
#include <std_defs.h>
#include <npc_defs.h>

// Function prototypes
public varargs void initialize(object where);

inherit "/classes/living/human/npcs/npc";

private nosave string  idx;      // So as not to be redeclared every heartbeat.
private nosave string  cmd_str, tmp1_str, tmp2_str, tmp3_str, tmp4_str;
private nosave int     i;
private nosave object  *player;
private nosave object  yli_flask, key;


public
void
create()
{
   set_transient_list( ({"rag", "key/master"}) );
   npc::create();
}

public
void
initialize(object where)
{
   npc::initialize(where, "oma");
   define_gender("female");
   set_long(
      "A spectacled woman whose wiry hair seemingly refuses " +  
      "to be reigned in by hairpins. Maybe it's just this " +
      "evening, but her nervousness and small stature can't help " +
      "but remind one of a mouse.");
}


// Overload the npc.c definition so Oma can handle special cases.
heart_beat(string str)
{
   idx = sprintf("%s%d", cue, event_num);

   // If there are no more events defined, shutdown heartbeat.
   if (undefinedp(cmd[idx]) )
   {
      // Cleanup
      time_of_cue = 0;
      cue = "";
      event_num = 0;
      set_heart_beat(OFF);
      return;
   }

   // If it ain't time, return ASAP.
   if (time() < time_of_cue + cmd[idx][0]) return; 
   
   // Here's where the special cases that wouldn't quite fit into the 
   // scripting language, or were just-plain-quicker-to-implement-here-for-now are.
   switch(idx)
   {

      case "B41": // Assure the victim is conscious before proceeding past this point. 
         if ( (int) (find_victim()->conscious()) != TRUE ) return;

      case "D03": // Allow player access to the chateau.
         effect(LOCAL, this_object(),
            "You reach over and remove the ropes.\n",
            "Oma reaches over and removes the velveteen ropes.\n");
         environment(this_object())->add_exits();
         break;

      case "DB1": // A bit of a cheat here... give everyone a flask
         player = players();
         for (i = 0; i < sizeof(player); i++)
         {
            if (! locally_present("flask", player[i]))
            {
               yli_flask = clone_object(FLASK_YLIASTRUM);
               yli_flask->initialize(player[i]);
               key = clone_object(ROOM_KEY);
               key->initialize(player[i], sprintf("%d",i + 1) );
            }
         } 
         effect(LOCAL, this_player(),
            "You reach into the case and hand everyone a flask along with their key.\n",
            "Reaching into the case, Oma begins passing out room keys and " +
            "flasks to the guests. As she approaches, " +
            "Oma smiles and hands to you your room key and a flask.\n");
         Director->set_game_mode(START);
         break;
        
      case "A90": // Skip these actions if Grandfeathers is here or Junior isn't.
      case "A92":
         if ((query_Grandfeathers_location() == query_victim_location()) &&
             (query_Juniors_location() != query_victim_location()) )
             event_num++; // Jump ahead to the next event

      default:
         switch(sizeof(cmd[idx]))
         {
            case 2:
               cmd_str = extract(cmd[idx][1], 0 , strlen(cmd[idx][1]) - 2);
               break;
            case 3:
               tmp1_str = cmd[idx][1];
               tmp2_str = (string) call_other(this_object(),
                  extract(cmd[idx][2], 0 , strlen(cmd[idx][2]) - 2) );
               if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log",
                  "Function " + cmd[idx][2] + " returned [" + tmp2_str + "]\n");
               cmd_str = sprintf(tmp1_str, tmp2_str);
               break;
            case 4:
               tmp1_str = cmd[idx][1];
               tmp2_str = (string) call_other(this_object(),
                  extract(cmd[idx][2], 0 , strlen(cmd[idx][2]) - 2) );
               if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log",
                  "Function " + cmd[idx][2] + " returned [" + tmp2_str + "]\n");
               tmp3_str = (string) call_other(this_object(),
                  extract(cmd[idx][3], 0 , strlen(cmd[idx][3]) - 2) );
               if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log",
                  "Function " + cmd[idx][3] + " returned [" + tmp3_str + "]\n");
               cmd_str = sprintf(tmp1_str, tmp2_str, tmp3_str);
               break;
            case 5:
               tmp1_str = cmd[idx][1];
               tmp2_str = (string) call_other(this_object(),
                  extract(cmd[idx][2], 0 , strlen(cmd[idx][2]) - 2) );
               if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log",
                  "Function " + cmd[idx][2] + " returned [" + tmp2_str + "]\n");
               tmp3_str = (string) call_other(this_object(),
                  extract(cmd[idx][3], 0 , strlen(cmd[idx][3]) - 2) );
               if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log",
                  "Function " + cmd[idx][3] + " returned [" + tmp3_str + "]\n");
               tmp4_str = (string) call_other(this_object(),
                  extract(cmd[idx][4], 0 , strlen(cmd[idx][4]) - 2) );
               if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log",
                  "Function " + cmd[idx][4] + " returned [" + tmp4_str + "]\n");
               cmd_str = sprintf(tmp1_str, tmp2_str, tmp3_str, tmp4_str);
               break;
            default: return; // Too much or too little dynamic data? skip it.
         }
         if (NPC_DEBUG) write_file(LOG_DIR + query_cap_name() + ".log",
            idx + " [" + cmd_str + "]\n");
         command(cmd_str);
         time_of_cue = time();
   }
   event_num++;         
   return SUCCEED;
}     
