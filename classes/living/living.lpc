#include <std_defs.h>
#include <config.h>
#include <commons.h>

inherit "/classes/obj";
inherit "/classes/container";
inherit "/classes/transient";
inherit "/classes/living/living_members/conscious";
inherit "/classes/living/living_members/gender";

void
init_actions()
{
   add_action("action_handler", "look");
}

void
restart()
{
   int     i;
   string *actions;

   obj::restart();
   container::restart();
   conscious::restart();
   actions = actions_list(commands());

   // Remove the thus far accumulated actions.
   for (i = 0; i < sizeof(actions); i++)
      remove_action("action_handler", actions[i]);

   // Re-issue the standard actions.
   init_actions();
}

void 
create()
{
   transient::create();
   consciousness();
   set_object_type(LIVING);
   set_flammability (NONE);
   set_burn_duration(0);
   set_rigidity     (RIGID); /* (More or less... ) */
   set_closable     (TRUE);
   set_closed       (TRUE);
   set_liquid_tight (FALSE);
   remove_delta_adjective("closed"); // By default, all containers show this.
   init_actions();
}

void
initialize(object where)
{
   obj::initialize(where);
   container::initialize(this_object()); // Init whatever items we may be created w/.
}

action_handler(string str)
{
   string action_filename;
   object action_obj;

   action_filename = ACTION_INST_DIR + query_verb();
   action_obj      = find_object(action_filename);

   if (!action_obj) // Perhaps it hasn't been loaded yet....
   {
      catch(call_other(action_filename, "???"));
      action_obj = find_object(action_filename);
   }
   if (action_obj) return (int)action_obj->selection_parse(str, this_player());
   else
   { 
      // Ooops... some class calls this action_object,
      // but it's file isn't being found.
      notify_fail("Sorry, that action isn't currently functioning.\n");
      log_file(ERROR_LOG, "Action doesn't have matching file: " + 
         action_filename + "\n");
      return FAIL;
   }
}

void remove()
{
   container::remove();
   obj::remove();
   return;
}

//
// Move the living to another location. Give the appropriate
// message to on-lookers.
//
string 
move(object dest, string dir) 
{
   object obj;
   object loc_left;
   string move_msg;

   obj = this_object();
   loc_left = environment(obj);

   effect(LOCAL, obj, "", specific_obj(obj) + 
      " begins to leave" + (dest ? (dir ? " " + dir : "") +
      ", heading towards the " + (string) dest->query_short() : "") + 
   ".\n");

   if ((move_msg = transient::move(dest)) != SUCCEED_STR) 
      effect(LOCAL, obj, "You remain where you are, since you are " + move_msg 
         + (dest ? " " + specific_obj(dest) : "") + ".\n", 
         (string) obj->query_short() + 
         " can't seem to go that way and is still here.\n");

   else effect(LOCAL, obj, (string) dest->query_long(), 
      capitalize(specific_obj(obj)) + " enters" + 
      (loc_left ? " from the " + (string) loc_left->query_short() : "" )  + ".\n");

   return move_msg;
}

string *use_recipient(object user, object agent)
{
   object recipient;
   string agent_name, recipient_name;
   recipient = this_object();
   recipient_name = specific_obj(recipient);
   agent_name = specific_obj(agent);

   if  (agent->query_rigidity() == LIMP)
   {
       return ({
          ".",
          ".",
          ".",
          "wrap",
          "around", 
          ""});
   }
   else if (agent->query_width() < 100 && agent->query_depth() < 100 &&
            agent->query_height() > 66 &&
            agent->query_weight() < user->query_max_bearable() &&
            agent->query_vamp_repellant() == 0)
   {

      if ((int) this_player()->query_role() == VAMPIRE)
         return ({ ", but " + recipient_name + " swiftly steps aside.",
                   ", but " + recipient_name + " swiftly steps aside.",
                   ", but " + recipient_name + " swiftly steps aside.",
                   "swing",
                   "at",
                   ""
                });

      else return ({", in a playful gesture.",
               ", in a playful gesture.",
               ", in a playful gesture.",
               "swing",
               "toward",
               "" });
   }
   else
   {
      return ({
         ", nearly scaring " + recipient->query_objective() + 
         " out of " + recipient->query_possessive() + " wits. " + 
         recipient_name + 
         " glares at you to put that silly thing away.",

         ", nearly scaring " + recipient->query_objective() + 
         " out of " +  recipient->query_possessive() + " wits. " + 
         recipient_name + " glares at " + 
         user->query_cap_name() + " to put that silly thing away.",

         ", nearly scaring you out of your wits. You glare at " + 
         user->query_objective() + " to put the silly thing away.",

         "wield",
         "at",
         ""
      });
   }
}

string query_pronoun()    { return gender::query_pronoun(); }
string query_possessive() { return gender::query_possessive(); }
string query_objective()  { return gender::query_objective(); }
string query_long()       { return container::query_long(); }

