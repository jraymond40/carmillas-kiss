#include <std_defs.h>
#include <config.h>

//            This should match w/ below  ________  
//                                       V        V
inherit "/classes/inanimate/transients/inanm_trns_container";

void 
create()
{
//  ________   This should match the inherit filename above.
// V        V
   inanm_trns_container::create();

   set_id        ( ({"canister"}) );
   set_short        ("canister");
   set_long         ("A canister.");
   set_flammability (NONE); // NONE | LOW | MEDIUM | HIGH
   set_burn_duration(0);    // Sec. Time in seconds it will burn.
   set_weight       (1);    // Kg.  Objects weight.
   set_height       (20);   // cm.  These are looked at to see if the 
   set_width        (10);   // cm.  potential object to be contained will
   set_depth        (10);   // cm.  fit within.
   set_form         (SOLID);// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);   // RIGID | LIMP
   set_dynamacy     (DYNAMIC); // Is it usable in some way? 

// Necessary for holders:
// (must add '_holder' or '_container' at end of inherit string above,
//  as well as onto the 
   set_liquid_tight (TRUE);    	// Won't hold liquids
   set_max_bearable (INFINITE); 	// Strong enough to hold whatever

   // How is the item held on this holder?   
   set_manner_held  ("inside");  
//   set_intransient_list( ({"item"}) );	// Intransients held here.
//   set_transient_list  ( ({"item"}) );	// Transients held here.


// Necessary for containers:
// (must add '_container' at end of inherit string above).
//
   set_closable     (TRUE); 		// Can it be closed/opened?
}
