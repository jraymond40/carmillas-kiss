#include <commons.h>
#include <std_defs.h>

inherit "/classes/inanimate/transients/inanm_trns";


void 
create()
{
   inanm_trns::create();

   set_flammability (NONE);
   set_burn_duration(0);

   set_weight       (8);
   set_height       (20);
   set_width        (7);
   set_depth        (4);
   set_volume       (80); 
   set_form         (SOLID);
   set_rigidity     (RIGID);
}
