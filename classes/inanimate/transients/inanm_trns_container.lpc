inherit "/classes/inanimate/transients/inanm_trns";
inherit "/classes/container";

void
create()
{
   inanm_trns::create();
   container::create();
}

void 
initialize(object where)
{
   inanm_trns::initialize(where);
   container::initialize(this_object());
}

void 
remove()
{
   container::remove();
   inanm_trns::remove();
}

string 
query_long()
{
   string str1, str2;
   str1 = inanm_trns::query_long();
   str2 = container::query_long();
   return (str1 + (str2 ? str2 : "") ); 
}

void
restart()
{
   inanm_trns::restart();
   container::restart();
}

