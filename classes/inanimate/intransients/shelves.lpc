#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns_holder";

void
create()
{
   inanm_intrns_holder::create();

   set_id        ( ({"shelves"}) );
   set_short        ("shelves");
   set_long         ("Covered in a thick dust coat, book filled, oak shelves line the wall.");
   set_flammability (NONE);
   set_burn_duration(0);
   set_weight       (INFINITE); /* Rather pointless since it's immoveable */
   set_height       (300);
   set_width        (600);
   set_depth        (35);
   set_form         (SOLID);
   set_rigidity     (RIGID);
   set_liquid_tight (FALSE);    /* Won't hold water */
   set_max_bearable (INFINITE); /* But it's strong enough to hold whatever */
   set_manner_held  ("amongst the many unreadable volumes neatly filed here.");
}
