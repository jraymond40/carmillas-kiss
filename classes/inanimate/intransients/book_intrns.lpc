#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns";

void
create()
{
   inanm_intrns::create();

   set_id        ( ({"book"}) );	// How sicose finds this item.
   set_short        ("book");		// The name of this item.

   // The in-depth description.
   set_long         ("It's pages are blank.");	

   set_flammability (LOW);		// NONE | LOW | MEDIUM | HIGH
   set_burn_duration(180);  		// Sec. Burn duration in seconds 
   set_weight       (1);		// Kg.  (although, it is intransient)
   set_height       (25);		// cm.    
   set_width        (19);		// cm.   
   set_depth        (1);		// cm.   
   set_form         (SOLID);		// GAS | LIQUID | SOLID
   set_rigidity     (RIGID);		// RIGID | FLEXIBLE

// Eventually modify books to be opened and closed.
//   set_closable     (TRUE); 		// Can it be closed/opened?   
}
