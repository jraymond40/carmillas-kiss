#include <config.h>
#include <std_defs.h>
#define STAGE_DEBUG TRUE

inherit "/classes/inanimate/intransients/locations/location";

private string *locations_list;	// The locations inited on this stage.

void
create()
{
   location::create();
   set_object_type(STAGE);
}
//
// Initialize this stage w/ locations.
//
void 
initialize(object theatre)
{
   int    i;
   string result;
   string error;
   string str;
   object obj;

   location::initialize(theatre); 

   if (locations_list)
   {
      for (i = 0; i < sizeof(locations_list); i++)
      {
         str =  LOCATION_DIR + locations_list[i] + ".c";

         error = catch(obj = clone_object(str));

         if ((!obj || error) && STAGE_DEBUG)
            write_file(LOCATION_LOG, this_object()->query_short() + 
            " couldn't clone: " + str + "\n");
         if (obj) obj->initialize(this_object(), obj); 
      }
   }
}

// Location's can be initialized as already having NPC's in them.
void 
set_locations_list(string *list)
{
   locations_list = list;
}

string query_pronoun()    { return "this stage"; }
string query_possessive() { return "this stage's"; }
string query_objective()  { return "this stage"; }
