#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns_holder";

void
create()
{
   inanm_intrns_holder::create();
   set_id        ( ({"floor"}) );
   set_short        ("floor");
   set_long         ("It's made of stone.");
   set_flammability (NONE);    //       NONE | LOW | MEDIUM | HIGH
   set_burn_duration(0);       // Sec.  
   set_weight       (INFINITE);// Kg.  (pointless since it's intransient)
   set_height       (1000);    // cm.  These are looked at to see if the 
   set_width        (1000);    // cm.  potential object to be contained will
   set_depth        (100);     // cm.  fit within.
   set_form         (SOLID);
   set_rigidity     (RIGID);
   set_max_bearable(INFINITE);
}
