#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns_container";


void
create()
{
   inanm_intrns_container::create();

   set_id        ( ({"bureau"}) );
   set_short        ("bureau");
   set_long         ("A simple, small pine bureau with iron handles.");
   set_flammability (LOW);
   set_burn_duration(600);  // Sec.  
   set_weight       (40);   // Kg.  (pointless since it's intransient)
   set_height       (100);  // cm.  These are looked at to see if the 
   set_width        (100);  // cm.  potential object to be contained will
   set_depth        (60);   // cm.  fit within.
   set_form         (SOLID);
   set_rigidity     (RIGID);
   set_dynamacy     (DYNAMIC); // It can be opened & closed.

   set_max_bearable(600);

   // Especially for containers:
   set_closable     (TRUE);    
   set_manner_held  ("in the drawer");
}
