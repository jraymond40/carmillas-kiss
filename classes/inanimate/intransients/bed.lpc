#include <std_defs.h>
#include <config.h>

inherit "/classes/inanimate/intransients/inanm_intrns_holder";

void
create()
{
   inanm_intrns_holder::create();

   set_id        ( ({"bed"}) );
   set_short        ("bed");
   set_long         ("A full size bed, adorned in a simple white comforter.");

   set_flammability (LOW);      // Not easy to ignite.
   set_burn_duration(300);      // Smolder out after 5 minutes.
   set_weight       (80);       // Rather pointless since it's immoveable.
   set_height       (100);      // 1 M tall
   set_width        (200);      // 2 M wide
   set_depth        (250);      // 2.5 M long
   set_form         (SOLID);    // Not a gas, nor liquid.
   set_rigidity     (RIGID);    // Rigid for all intents and purposes.
   set_liquid_tight (FALSE);    // Won't hold water
   set_max_bearable (2000);     // Strong enough to hold most anything.
   set_dynamacy     (DYNAMIC);  // It's usable.
}

string*
use(object tp, object recipient)
{
   if (!recipient)
      return ( ({
         ", sending dust into the air.",
         ", sending dust into the air.",
         ", sending dust into the air.",
         "plop",
         0,
         "onto"}) );
   else return (inanm_intrns_holder::use(tp, recipient));
}

string *use_recipient(object user, object agent)
{
   object recipient;
   string agent_name, recipient_name;
   recipient = this_object();
   recipient_name = specific_obj(recipient);

   agent_name = specific_obj(agent);

   if (agent->query_width() < 100 && agent->query_depth() < 100 &&
       agent->query_height() > 66 &&
       agent->query_weight() < user->query_max_bearable() &&
       agent->query_vamp_repellant() == 0)
   {

      return ({", sending dust swirling about the room.",
               ", sending dust swirling about the room.",
               ", sending dust swirling about the room.",
               "beat",
               "against",
               "" });
   }
   else
   {
      return ({"","","",0,0, ""});
   }
}
