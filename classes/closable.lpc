#include <std_defs.h>
#include <config.h>
#include <english.h>

#define OPEN_STR  "open"
#define CLOSED_STR "closed"

private int closed;
private int closable;

void set_closed(int setting)   { closed = setting; }

int  
query_closed()            
{
   if (closable == TRUE) return closed;
   else return FALSE;
}

void 
set_closable(int setting) 
{ 
   closable = setting;
   //
   // By default, the object is set to closed
   // Setting things into a proper state.
   //
   closed = TRUE;
   this_object()->remove_delta_adjective(OPEN_STR);
   this_object()->add_delta_adjective(CLOSED_STR);
}

void
create()
{
   this_object()->set_dynamacy(DYNAMIC); // Open/close makes it considered dynamic.
   set_closable(TRUE);
}

string*
open()
{
  if (closable != TRUE) 
      return ({", but realize " + this_object()->query_pronoun() + " can't be opened.",
               ", but realizes " + this_object()->query_pronoun() + " can't be opened.",
               ", but realizes you can't be opened.",
               "attempt", 0, "to open"});
  else if (!query_closed()) 
      return ({", but realize " + this_object()->query_pronoun() + " " +
                  forms_of_Be(THIRD_PERSON, PRESENT, this_object()->query_aggregate() + 1) +
                  " already open.",
               ", but realizes " + this_object()->query_pronoun() + " " +
                  forms_of_Be(THIRD_PERSON, PRESENT, this_object()->query_aggregate() + 1) +
                  " already open.",
               ", but realizes you're already open.",
               "attempt", 0, "to open"});
   else
   {
      set_closed(FALSE);
      this_object()->remove_delta_adjective(CLOSED_STR);
      this_object()->add_delta_adjective(OPEN_STR);
      return ({".",".",".","open"});
   }   
}

string*
close()
{
  if (closable != TRUE) 
      return ({", but realize " + this_object()->query_pronoun() + " can't be closed.",
               ", but realizes " + this_object()->query_pronoun() + " can't be closed.",
               ", but realizes you can't be closed.",
               "attempt", 0 , "to close"});
  else if (query_closed()) 
      return ({", but realize " + this_object()->query_pronoun() + " " +
                  forms_of_Be(THIRD_PERSON, PRESENT, this_object()->query_aggregate() + 1) +
                  " already closed.",
               ", but realizes " + this_object()->query_pronoun() + " " +
                  forms_of_Be(THIRD_PERSON, PRESENT, this_object()->query_aggregate() + 1) +
                  " already closed.",
               ", but realizes you're already closed.",
               "attempt", 0 , "to close"});
  else
  {
      set_closed(TRUE);
      this_object()->remove_delta_adjective(OPEN_STR);
      this_object()->add_delta_adjective(CLOSED_STR);
      return ({".",".",".","close"});
   }
}

void
restart()
{
   close();
}
